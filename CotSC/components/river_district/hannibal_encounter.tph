// ====================================================================
// v4.8 QCHANN encounter: eight brigands, Hannibal, Cormack and two Blades.
// Keep all seven containers, v4.7 traps, v4.3 artwork and v4.4 collision frozen.
// Source-only extension inside the ONE existing WeiDU component.
// ====================================================================

// Verify every base creature and equipment resource. Never change originals.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~THIEF2.CRE~ BEGIN
  FAIL @20217
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~THIEF3.CRE~ BEGIN
  FAIL @20218
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~THIEF4.CRE~ BEGIN
  FAIL @20219
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~OHRHOJAR.CRE~ BEGIN
  FAIL @20220
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~OULAM.CRE~ BEGIN
  FAIL @20221
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~JAYLOS.CRE~ BEGIN
  FAIL @20222
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BOW05.ITM~ BEGIN
  FAIL @20223
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AROW05.ITM~ BEGIN
  FAIL @20224
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AROW07.ITM~ BEGIN
  FAIL @20225
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AROW04.ITM~ BEGIN
  FAIL @20226
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AROW10.ITM~ BEGIN
  FAIL @20227
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~POTN10.ITM~ BEGIN
  FAIL @20228
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~CLCK17.ITM~ BEGIN
  FAIL @20229
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SPCL152.SPL~ BEGIN
  FAIL @20230
END

COMPILE ~CotSC/qriv_hannibal/scripts/QHBRAI.baf~
COMPILE ~CotSC/qriv_hannibal/scripts/QHSTAI.baf~
COMPILE ~CotSC/qriv_hannibal/scripts/QHHNAI.baf~
COMPILE ~CotSC/qriv_hannibal/scripts/QHCMAI.baf~
COMPILE ~CotSC/qriv_hannibal/scripts/QHBLDAI.baf~
