// ------------------------------------------------------------
// QC: Drow Hunters - Viconia quest (original standalone Parse37)
// Kept original DH resource names to preserve all internal references.
// ------------------------------------------------------------
BEGIN @6022

// Parse 37: preserve Parse 36 frozen content; gate later letters and the final conversation behind the preceding clues.
REQUIRE_PREDICATE GAME_IS ~eet~ @1

LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG3300.BCS~ BEGIN
  FAIL @2
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~LINDIN.CRE~ BEGIN
  FAIL @3
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~TELKA.CRE~ BEGIN
  FAIL @4
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SCRLNEI.ITM~ BEGIN
  FAIL @5
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0011.BCS~ BEGIN
  FAIL @6
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG1603.BCS~ BEGIN
  FAIL @7
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG1803.BCS~ BEGIN
  FAIL @8
END
LOAD_TRA ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~

ADD_JOURNAL TITLE (@7006) @100 @101 @102 @103 @104 @105 USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~

COPY_EXISTING ~SCRLNEI.ITM~ ~override/DHNOTE1.ITM~
  SAY NAME1 @110
  SAY NAME2 @110
  SAY DESC @111
  SAY IDENTIFIED_DESC @111
COPY_EXISTING ~SCRLNEI.ITM~ ~override/DHNOTE2.ITM~
  SAY NAME1 @112
  SAY NAME2 @112
  SAY DESC @113
  SAY IDENTIFIED_DESC @113
COPY_EXISTING ~SCRLNEI.ITM~ ~override/DHNOTE3.ITM~
  SAY NAME1 @114
  SAY NAME2 @114
  SAY DESC @115
  SAY IDENTIFIED_DESC @115

COPY_EXISTING ~LINDIN.CRE~ ~override/DHDIMW9.CRE~
  SAY NAME1 @5009
  SAY NAME2 @5009
  // Dark Horizons / Tristan architecture: INITDLG in the override slot,
  // custom combat AI in the Default slot, and the dialogue assigned normally.
  WRITE_ASCII 0x2cc ~DHDIMW9~ #8
  WRITE_ASCII 0x248 ~INITDLG~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~DHDIMW9~ #8
  WRITE_ASCII 0x280 ~DH_DIMWO9_DEAD~ #32
  WRITE_BYTE 0x270 128
  ADD_CRE_ITEM ~DHNOTE1~ #1 #0 #0 ~IDENTIFIED~ ~INV~

COPY_EXISTING ~TELKA.CRE~ ~override/DHZEPH8.CRE~
  SAY NAME1 @5010
  SAY NAME2 @5010
  // Match the Dark Horizons Isolde CRE architecture: SHOUT in Override,
  // WTARSGT in General, and a shared combat script in Default.
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x248 ~SHOUT~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~WTARSGT~ #8
  WRITE_ASCII 0x268 ~DHDIMW9~ #8
  // Script name must match the object targeted by Dimwoork's dialogue.
  WRITE_ASCII 0x280 ~DHZEPH8~ #32
  // Remain neutral while Dimwoork speaks; his final dialogue action starts combat.
  WRITE_BYTE 0x270 128

// Do not statically install the later clue letters.
// BG1603.BCS and BG1803.BCS create them in their existing containers only
// after the previous clue has actually been collected. The DELETE_AREA_ITEM
// calls also clean up copies from earlier builds of this component.
COPY_EXISTING ~BG1603.ARE~ ~override/BG1603.ARE~
  LPF DELETE_AREA_ITEM
    STR_VAR item_to_delete = ~DHNOTE2~
  END
  BUT_ONLY

COPY_EXISTING ~BG1803.ARE~ ~override/BG1803.ARE~
  LPF DELETE_AREA_ITEM
    STR_VAR item_to_delete = ~DHNOTE3~
  END
  BUT_ONLY

// Compile Viconia first so its APPEND_EARLY VICONJ state exists before Dimwoork EXTERNs to it.
COMPILE ~CotSC/drow_hunters/viconia.d~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~
COMPILE ~CotSC/drow_hunters/dimwoork9.d~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~
COMPILE ~CotSC/drow_hunters/dimwoork9.baf~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~
COMPILE ~CotSC/drow_hunters/dhzepheira9.baf~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~

EXTEND_TOP ~BG3300.BCS~ ~CotSC/drow_hunters/bg3300.baf~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~
EXTEND_TOP ~BG0011.BCS~ ~CotSC/drow_hunters/bg0011.baf~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~
EXTEND_TOP ~BG1603.BCS~ ~CotSC/drow_hunters/bg1603.baf~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~
EXTEND_TOP ~BG1803.BCS~ ~CotSC/drow_hunters/bg1803.baf~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~

COMPILE ~CotSC/drow_hunters/interjections.d~ USING ~CotSC/translation/%LANGUAGE%/drow_hunters/drow_hunters.tra~

// ------------------------------------------------------------
// QC: Cure for Madness — BG1 Tiax and Arbolon
// Original standalone v0.1 Parse9, no changes to story or quest progression.
// ------------------------------------------------------------
BEGIN @6023

REQUIRE_PREDICATE GAME_IS ~eet~ ~This component requires a Baldur's Gate: Enhanced Edition EET installation.~

LOAD_TRA ~CotSC/translation/%LANGUAGE%/cure_for_madness/tra/english/cure_for_madness.tra~

// Give Arbolon a standard male BG1 farmer voice. The standalone's
// READ_SOUNDSET / WRITE_SOUNDSET macros were undefined; copy only the 100
// sound strrefs using the same tested method as QCCALPHY.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~FARM.CRE~ BEGIN
  FAIL @20148
END
COPY_EXISTING ~FARM.CRE~ ~override~
  FOR (qc_arbol_slot = 0; qc_arbol_slot < 100; qc_arbol_slot += 1) BEGIN
    READ_LONG (0xa4 + qc_arbol_slot * 4) qc_arbol_sound_strref
    SET $qc_arbol_sound("%qc_arbol_slot%") = qc_arbol_sound_strref
  END
  BUT_ONLY_IF_IT_CHANGES


// Use Bassilus only as a visual/statistical donor for a neutral male human priest.
// Arbolon's inherited AI is cleared; the original custom ARBOLON script
// remains assigned to the Override slot (0x248).
COPY_EXISTING ~FARM.CRE~ ~override/ARBOLON.CRE~
  FOR (qc_arbol_slot = 0; qc_arbol_slot < 100; qc_arbol_slot += 1) BEGIN
    WRITE_LONG (0xa4 + qc_arbol_slot * 4) $qc_arbol_sound("%qc_arbol_slot%")
  END
  SAY 0x08 @0
  SAY 0x0c @0
  REMOVE_CRE_ITEMS
  // EET/EE standard HUMAN_MALE_CLERIC, with leather armour visibly equipped.
  WRITE_LONG 0x28 0x6000
  ADD_CRE_ITEM ~LEAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~ EQUIP
  WRITE_ASCII 0x248 ~ARBOLON~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~ARBOLON~ #32
  WRITE_ASCII 0x2cc ~QCARBOL~ #8
BUT_ONLY_IF_IT_CHANGES

// Arbolon's personal behavior.
COMPILE ~CotSC/cure_for_madness/arbolon.baf~

// Main conversation.
COMPILE ~CotSC/cure_for_madness/qcarbol.d~ USING ~CotSC/translation/%LANGUAGE%/cure_for_madness/tra/english/cure_for_madness.tra~

// Tiax's post-fight line is kept in a separate dialogue resource so the
// existing BG1NPC Tiax dialogue remains untouched.
COMPILE ~CotSC/cure_for_madness/qcatiax.d~ USING ~CotSC/translation/%LANGUAGE%/cure_for_madness/tra/english/cure_for_madness.tra~

// Red Canyon event controller.
EXTEND_TOP ~BG3700.BCS~ ~CotSC/cure_for_madness/bg3700.baf~


// ------------------------------------------------------------
// QC: Coran's Old Flame — Annaebiel and Helm priest encounter
// Original Coran's Old Flame standalone (BG1 states restored).
// Retains original companion-script safeguards and dialog paths.
// ------------------------------------------------------------
BEGIN @6024

REQUIRE_PREDICATE GAME_IS ~eet~ @1

LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

LOAD_TRA ~CotSC/translation/%LANGUAGE%/coran/tra/english/coran_old_flame.tra~
ADD_JOURNAL TITLE (@7007) @1 @2 @3 USING ~CotSC/translation/%LANGUAGE%/coran/tra/english/coran_old_flame.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~


ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDACT04.CRE~ BEGIN
  FAIL @20149
END

// Restore only the BG1 override scripts if a previous installation changed them to BG2 scripts.
// This does NOT replace the characters and does not touch their dialogue files.
// EET's official NPC transition definitions use these BG1 override scripts:
// Imoen = IMOEN_, Jaheira = JAHEIRA_, Edwin = EDWIN_.
ACTION_IF GAME_IS ~eet~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~IMOEN.CRE~ BEGIN
    COPY_EXISTING ~IMOEN.CRE~ ~override~
      READ_ASCII 0x248 ~qca_old_script~ (8)
      PATCH_IF ~%qca_old_script%~ STRING_EQUAL_CASE ~IMOEN2~ BEGIN
        WRITE_ASCII 0x248 ~IMOEN_~ #8
      END
    BUT_ONLY_IF_IT_CHANGES
  END
  ACTION_FOR_EACH qca_imoen_cre IN IMOEN1.CRE IMOEN4.CRE IMOEN6.CRE BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%qca_imoen_cre%~ BEGIN
      COPY_EXISTING ~%qca_imoen_cre%~ ~override~
        READ_ASCII 0x248 ~qca_old_script~ (8)
        PATCH_IF ~%qca_old_script%~ STRING_EQUAL_CASE ~IMOEN2~ BEGIN
          WRITE_ASCII 0x248 ~IMOEN_~ #8
        END
      BUT_ONLY_IF_IT_CHANGES
    END
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~JAHEIRA_.CRE~ BEGIN
    COPY_EXISTING ~JAHEIRA_.CRE~ ~override~
      READ_ASCII 0x248 ~qca_old_script~ (8)
      PATCH_IF ~%qca_old_script%~ STRING_EQUAL_CASE ~JAHEIRA~ BEGIN
        WRITE_ASCII 0x248 ~JAHEIRA_~ #8
      END
    BUT_ONLY_IF_IT_CHANGES
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~EDWIN_.CRE~ BEGIN
    COPY_EXISTING ~EDWIN_.CRE~ ~override~
      READ_ASCII 0x248 ~qca_old_script~ (8)
      PATCH_IF ~%qca_old_script%~ STRING_EQUAL_CASE ~EDWIN~ BEGIN
        WRITE_ASCII 0x248 ~EDWIN_~ #8
      END
    BUT_ONLY_IF_IT_CHANGES
  END
END

// EET BG1 joined-dialogue resources only.
// Do not copy, replace, or patch the BG1 character CREs.
COPY_EXISTING ~BDACT04.CRE~ ~override/QCANNA.CRE~
  SAY NAME1 @5011
  SAY NAME2 @5011
  WRITE_ASCII 0x248 ~QCANNA~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  WRITE_ASCII 0x280 ~QCANNA~ #32
  WRITE_ASCII 0x2cc ~QCANNA~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/coran/QCANNA.D~ USING ~CotSC/translation/%LANGUAGE%/coran/tra/english/coran_old_flame.tra~
COMPILE ~CotSC/coran/QCANNA.BAF~
COMPILE ~CotSC/coran/QCANAE.BAF~


// Annaebiel's house interior, first floor. Actors are already removed
// from the bundled copy; containers are preserved exactly.
COPY ~CotSC/coran/QCANAE.ARE~ ~override/QCANAE.ARE~

// Annaebiel's house interior, second section. Actors are already removed
// from the bundled copy; containers are preserved exactly.
COPY ~CotSC/coran/QCANAE2.ARE~ ~override/QCANAE2.ARE~
COPY ~CotSC/coran/QCANAE2.BCS~ ~override/QCANAE2.BCS~

// Exterior entrance at BG1300 [1913,790]. Door cursor = 30.
// The region points into the QCANAE entrance named Exit0700.
COPY_EXISTING ~BG1300.ARE~ ~override/BG1300.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 1893
      fj_box_top = 760
      fj_box_right = 1933
      fj_box_bottom = 820
      fj_cursor_idx = 30
      fj_flags = 0
      fj_vertex_0 = 1893 + (760 << 16)
      fj_vertex_1 = 1933 + (760 << 16)
      fj_vertex_2 = 1933 + (820 << 16)
      fj_vertex_3 = 1893 + (820 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = ~QCAnaDoor~
      fj_destination_area = ~QCANAE~
      fj_destination_name = ~Exit0700~
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1913
      fj_loc_y = 790
      fj_orientation = 6
    STR_VAR
      fj_structure_type = entrance
      fj_name = ~QCAnaOutside~
  END
  ADD_MAP_NOTE #1913 #790 ~gray~ ~Annaebiel's house~

// Fix the two copied interior travel links.
// QCANAE first-floor entrance -> outside BG1300.
COPY_EXISTING ~QCANAE.ARE~ ~override/QCANAE.ARE~
  LPF ALTER_AREA_REGION
    INT_VAR
      type = 2
      cursor = 30
      flag_connect_to_door = 0
    STR_VAR
      region_name = ~Door0700~
      destination_area = ~BG1300~
      entrance_name = ~QCAnaOutside~
  END
  // QCANAE first floor -> upper section. Use the door cursor for a real usable transition.
  LPF ALTER_AREA_REGION
    INT_VAR
      type = 2
      cursor = 30
      flag_connect_to_door = 0
    STR_VAR
      region_name = ~Door0708~
      destination_area = ~QCANAE2~
      entrance_name = ~Exit0707~
  END

// QCANAE2 -> QCANAE downstairs.
COPY_EXISTING ~QCANAE2.ARE~ ~override/QCANAE2.ARE~
  LPF ALTER_AREA_REGION
    INT_VAR
      type = 2
      cursor = 30
      flag_connect_to_door = 0
    STR_VAR
      region_name = ~Door0707~
      destination_area = ~QCANAE~
      entrance_name = ~Exit0708~
  END
  // Ensure the downstairs destination entrance exists.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 425
      fj_loc_y = 350
      fj_orientation = 6
    STR_VAR
      fj_structure_type = entrance
      fj_name = ~Exit0708~
  END

