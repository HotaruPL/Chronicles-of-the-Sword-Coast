BEGIN QCDEREK

IF ~Global("QCDEREK_TALKED","LOCALS",1)~ THEN BEGIN QCD_INTRO
  SAY @34
  IF ~~ THEN REPLY @35 EXIT
  IF ~~ THEN REPLY @36 DO ~SetGlobal("QCDEREK_TALKED","LOCALS",2) Enemy()~ EXIT
  IF ~~ THEN REPLY @37 GOTO QCD_WARNING
END

IF ~~ THEN BEGIN QCD_WARNING
  SAY @38
  IF ~~ THEN REPLY @39 GOTO QCD_ESCAPE
  IF ~~ THEN REPLY @40 GOTO QCD_STORY
  IF ~~ THEN REPLY @41 GOTO QCD_GOLD
  IF ~~ THEN REPLY @42 GOTO QCD_KILL
END

IF ~~ THEN BEGIN QCD_STORY
  SAY @46
  IF ~~ THEN REPLY @39 GOTO QCD_ESCAPE
  IF ~~ THEN REPLY @41 GOTO QCD_GOLD
  IF ~~ THEN REPLY @42 GOTO QCD_KILL
END

IF ~~ THEN BEGIN QCD_ESCAPE
  SAY @43
  IF ~~ THEN DO ~SetGlobal("QCDEREK_ESCAPED","GLOBAL",1) ReputationInc(2) EscapeArea()~ UNSOLVED_JOURNAL @64 EXIT
END

IF ~~ THEN BEGIN QCD_GOLD
  SAY @44
  IF ~~ THEN DO ~SetGlobal("QCDEREK_ESCAPED","GLOBAL",1) GiveGoldForce(200) EscapeArea()~ UNSOLVED_JOURNAL @65 EXIT
END

IF ~~ THEN BEGIN QCD_KILL
  SAY @45
  IF ~~ THEN DO ~SetGlobal("QCDEREK_KILLED","GLOBAL",1) SetGlobal("QCDEREK_TALKED","LOCALS",2) Enemy()~ EXIT
END
