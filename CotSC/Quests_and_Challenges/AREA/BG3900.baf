IF
  Global("QCWIZSHADE_SPAWNED","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("QCWIZSHADE_SPAWNED","GLOBAL",1)
    CreateCreature("QCWIZSHD",[4490.378],0)
END

