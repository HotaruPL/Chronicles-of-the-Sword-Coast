// Cormack: OULAM mage, black cloak/robe with Evil Archmagi properties.
// Preserve original OULAM class AI + memorized spells for mage behavior.
COPY_EXISTING ~OULAM.CRE~ ~override/QHCMACK.CRE~
  SAY NAME1 @3022
  SAY NAME2 @3022
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x280 ~QHCMACK~ #32
  WRITE_ASCII 0x2cc ~~ #8
  WRITE_BYTE 0x270 255
  WRITE_BYTE 0x27b 35 // Chaotic Evil permits CLCK17 robe
  WRITE_BYTE 0x2c 30
  WRITE_BYTE 0x2d 30
  WRITE_BYTE 0x2e 30
  WRITE_BYTE 0x30 30
  WRITE_BYTE 0x31 30
  WRITE_ASCII 0x248 ~QHCMAI~ #8
