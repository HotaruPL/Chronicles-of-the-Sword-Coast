// Shante: use the exact CRE chassis of Lady Delcia Caan, a confirmed-working
// automatically-speaking BG1 NPC from Better Immersion, then copy only the
// courtesan visual/colour fields from the BG1/EET Beregost courtesan PROSBA_B.CRE.
// This avoids guessing at a creature-era chassis while retaining the intended look.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~DELCIA.CRE~ BEGIN
  FAIL @20501
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~PROSBA_B.CRE~ BEGIN
  FAIL @20502
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SEWERF1.CRE~ BEGIN
  FAIL @20503
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SEWERF3.CRE~ BEGIN
  FAIL @20504
END

COPY_EXISTING ~DELCIA.CRE~ ~override/QCSHANTE.CRE~
  SAY NAME1 @12001
  SAY NAME2 @12001
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QCSHANTE~ #8
  WRITE_ASCII 0x248 ~QCSHANTE~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  INNER_PATCH_FILE ~PROSBA_B.CRE~ BEGIN
    READ_LONG 0x28 shantee_animation
    READ_BYTE 0x2d shantee_color1
    READ_BYTE 0x2e shantee_color2
    READ_BYTE 0x30 shantee_color3
    READ_BYTE 0x31 shantee_color4
  END
  WRITE_LONG 0x28 "%shantee_animation%"
  WRITE_BYTE 0x2d "%shantee_color1%"
  WRITE_BYTE 0x2e "%shantee_color2%"
  WRITE_BYTE 0x30 "%shantee_color3%"
  WRITE_BYTE 0x31 "%shantee_color4%"
BUT_ONLY_IF_IT_CHANGES

// The two freed sewerfolk are hostile from the moment the area loads.
// Use standalone copies so the original SEWERF1/SEWERF3 creatures remain untouched.
COPY_EXISTING ~SEWERF1.CRE~ ~override/QSEWRF1.CRE~
  WRITE_BYTE 0x270 255
  WRITE_ASCII 0x280 ~QSEWRF1_DEAD~ #32
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~SEWERF3.CRE~ ~override/QSEWRF3.CRE~
  WRITE_BYTE 0x270 255
  WRITE_ASCII 0x280 ~QSEWRF3_DEAD~ #32
BUT_ONLY_IF_IT_CHANGES

// Torn letter found in QCSEWL container 2. SCRL2I is a native
// BG2/EET item whose physical icon is a letter rather than a book.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SCRL2I.ITM~ BEGIN
  FAIL @20505
END

COPY_EXISTING ~SCRL2I.ITM~ ~override/QCSHLTR.ITM~
  SAY NAME1 @12002
  SAY NAME2 @12002
  SAY DESC @12003
BUT_ONLY_IF_IT_CHANGES

// -----------------------------------------------------------------------------
// QCSEWL: independent copy of BG2613
//
// The installer ships with WeiDU 2.23. That version can use
// COPY_EXISTING_REGEXP, but it cannot safely use regexp capture groups
// in the destination filename here. Use explicit per-page copies instead.
// Only pages that actually exist in the installed game are copied.

ACTION_IF NOT FILE_EXISTS_IN_GAME ~B261300.PVRZ~ BEGIN
  FAIL @20506
END

