BEGIN QCLYDIA

IF ~Global("QCLYDIA","GLOBAL",2)~ THEN BEGIN QCL_DONE
  SAY @30
  IF ~~ THEN EXIT
END

IF ~Global("QCLYDIA","GLOBAL",1) PartyHasItem("QCLNECK")~ THEN BEGIN QCL_RETURN
  SAY @31
  IF ~~ THEN DO ~TakePartyItem("QCLNECK") GivePartyGold(10) ReputationInc(1) SetGlobal("QCLYDIA","GLOBAL",2)~ SOLVED_JOURNAL @22 EXIT
END

IF ~Global("QCLYDIA","GLOBAL",1)~ THEN BEGIN QCL_ACTIVE
  SAY @32
  IF ~~ THEN EXIT
END

IF ~Global("QCLYDIA","GLOBAL",3)~ THEN BEGIN QCL_DECLINED
  SAY @30
  IF ~~ THEN EXIT
END

IF ~Global("QCLYDIA","GLOBAL",0)~ THEN BEGIN QCL_START
  SAY @33
  IF ~~ THEN REPLY @34 GOTO QCL_HELP
  IF ~~ THEN REPLY @35 GOTO QCL_RUDE
  IF ~~ THEN REPLY @36 EXIT
END

IF ~~ THEN BEGIN QCL_HELP
  SAY @37
  IF ~~ THEN REPLY @38 DO ~SetGlobal("QCLYDIA","GLOBAL",1) CreateItem("QCLNECK",1,0,0) DropItem("QCLNECK",[1858.2059])~ UNSOLVED_JOURNAL @21 EXIT
  IF ~~ THEN REPLY @39 DO ~SetGlobal("QCLYDIA","GLOBAL",3)~ EXIT
END

IF ~~ THEN BEGIN QCL_RUDE
  SAY @40
  IF ~~ THEN EXIT
END
