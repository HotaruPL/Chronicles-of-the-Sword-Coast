BEGIN QCPPOPER

IF ~Global("QCPPOPER_MET","LOCALS",0)~ THEN BEGIN QCP_INTRO
  SAY @1
  IF ~~ THEN DO ~SetGlobal("QCPPOPER_MET","LOCALS",1)~ REPLY @2 GOTO QCP_1
  IF ~~ THEN REPLY @3 GOTO QCP_2
  IF ~~ THEN REPLY @4 DO ~StartStore("QCPPOPST",LastTalkedToBy())~ EXIT
  IF ~~ THEN REPLY @7 EXIT
END

IF ~Global("QCPPOPER_MET","LOCALS",1)~ THEN BEGIN QCP_MAIN
  SAY ~~
  IF ~~ THEN REPLY @2 GOTO QCP_1
  IF ~~ THEN REPLY @3 GOTO QCP_2
  IF ~~ THEN REPLY @4 DO ~StartStore("QCPPOPST",LastTalkedToBy())~ EXIT
  IF ~~ THEN REPLY @7 EXIT
END

IF ~~ THEN BEGIN QCP_1
  SAY @5
  IF ~~ THEN REPLY @2 GOTO QCP_1
  IF ~~ THEN REPLY @3 GOTO QCP_2
  IF ~~ THEN REPLY @4 DO ~StartStore("QCPPOPST",LastTalkedToBy())~ EXIT
  IF ~~ THEN REPLY @7 EXIT
END

IF ~~ THEN BEGIN QCP_2
  SAY @6
  IF ~~ THEN REPLY @2 GOTO QCP_1
  IF ~~ THEN REPLY @3 GOTO QCP_2
  IF ~~ THEN REPLY @4 DO ~StartStore("QCPPOPST",LastTalkedToBy())~ EXIT
  IF ~~ THEN REPLY @7 EXIT
END
