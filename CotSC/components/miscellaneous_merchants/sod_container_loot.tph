// ===========================================================
// Version 1.1: SIEGE OF DRAGONSPEAR CONTAINER PROVISIONS
// This optional Part VII only modifies area containers.
// Original contents and all merchants/NPCs/custom items preserved.
// Container closest to user-specified position receives each stack.
// The Part VI Xzar-only fix above broadens his search to unused
// quick-item slots if no backpack slot is free. No other companions
// or components are modified.
// ===========================================================
// Former WeiDU component: Miscellaneous Merchants - Part VII: Siege of Dragonspear Container Loot (17 locations)

// Copied from the v0.9 BG1 loot function with SoD-specific identifiers.
// It relies on the tested fj_are_structure helper and appends rather
// than replacing the container's existing items.
DEFINE_PATCH_FUNCTION QCMM_SOD_CONTAINER_LOOT
  INT_VAR x = 0 y = 0 charge = 1
  STR_VAR item = ~~
BEGIN
  READ_SHORT 0x74 qcmm_sod_cnt
  READ_LONG  0x70 qcmm_sod_off
  PATCH_IF (qcmm_sod_cnt > 0) BEGIN
    SET qcmm_sod_best = 0
    SET qcmm_sod_dist_best = 2147483647
    FOR (qcmm_sod_i = 0; qcmm_sod_i < qcmm_sod_cnt; qcmm_sod_i += 1) BEGIN
      READ_SHORT (qcmm_sod_off + qcmm_sod_i * 0xc0 + 0x20) qcmm_sod_x
      READ_SHORT (qcmm_sod_off + qcmm_sod_i * 0xc0 + 0x22) qcmm_sod_y
      SET qcmm_sod_dx = qcmm_sod_x - x
      SET qcmm_sod_dy = qcmm_sod_y - y
      SET qcmm_sod_dist = qcmm_sod_dx * qcmm_sod_dx + qcmm_sod_dy * qcmm_sod_dy
      PATCH_IF (qcmm_sod_dist < qcmm_sod_dist_best) BEGIN
        SET qcmm_sod_dist_best = qcmm_sod_dist
        SET qcmm_sod_best = qcmm_sod_i
      END
    END
    LPF fj_are_structure
      INT_VAR
        fj_con_itm_idx = qcmm_sod_best
        fj_charge0 = charge
        fj_flags = 1
      STR_VAR
        fj_structure_type = ~itm~
        fj_name = EVAL ~%item%~
    END
  END ELSE BEGIN
    PATCH_PRINT @20344
  END
END


ACTION_IF FILE_EXISTS_IN_GAME ~BD0109.ARE~ BEGIN
  COPY_EXISTING ~BD0109.ARE~ ~override~
    // Nearest existing container to X=653, Y=264.
    LPF QCMM_SOD_CONTAINER_LOOT INT_VAR x = 653 y = 264 charge = 1 STR_VAR item = ~QCBREAD~ END
    LPF QCMM_SOD_CONTAINER_LOOT INT_VAR x = 653 y = 264 charge = 1 STR_VAR item = ~QCMEAT~ END
END ELSE BEGIN

PRINT @20406

END

