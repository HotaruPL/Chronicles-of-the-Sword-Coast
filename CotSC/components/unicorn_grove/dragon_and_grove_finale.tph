COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTLOCKA.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTTRAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTCOREA.baf~

// Extend, do NOT replace, the proven temple ritual-area script and Eaglehorn's hut scripts.
EXTEND_TOP ~QBTAREA.BCS~ ~CotSC/qc_unicorn_grove/scripts/QBTLATE.baf~
EXTEND_TOP ~QCUEGAI.BCS~ ~CotSC/qc_unicorn_grove/scripts/QBTRETA.baf~
EXTEND_TOP ~QCUEMAI.BCS~ ~CotSC/qc_unicorn_grove/scripts/QBTEMHA.baf~
COMPILE ~CotSC/qc_unicorn_grove/dialogue/QBTEND.d~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QBTEND.tra~ ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/eaglehorn.tra~ ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/unicorn_grove.tra~ ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QBTEND.tra~
ADD_JOURNAL TITLE (@7016) @104 USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QBTEND.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~

// Only add the new container/Triss and relocate the room's existing exit.
COPY_EXISTING ~QCBTEM.ARE~ ~override/QCBTEM.ARE~
  READ_LONG 0x5c qbt24_regoff
  READ_SHORT 0x5a qbt24_regnum
  FOR (qbt24_i = 0; qbt24_i < qbt24_regnum; qbt24_i += 1) BEGIN
    SET qbt24_ro = qbt24_regoff + (qbt24_i * 0xc4)
    READ_ASCII qbt24_ro qbt24_rname (32) NULL
    PATCH_IF (~%qbt24_rname%~ STRING_EQUAL ~QBTEXIT~) BEGIN
      LPF fj_are_structure
        INT_VAR fj_delete_mode = qbt24_i
        STR_VAR fj_structure_type = region
      END
      SET qbt24_i = qbt24_regnum
    END
  END
  // Player returns outdoors only from the lower-right chamber doorway.
  LPF fj_are_structure
    INT_VAR fj_type = 2 fj_box_left = 1432 fj_box_top = 940
      fj_box_right = 1503 fj_box_bottom = 1007
      fj_cursor_idx = 30 fj_flags = 4
      fj_vertex_0 = 1432 + (940 << 16)
      fj_vertex_1 = 1503 + (940 << 16)
      fj_vertex_2 = 1503 + (1007 << 16)
      fj_vertex_3 = 1432 + (1007 << 16)
    STR_VAR fj_structure_type = region fj_name = QBTEXIT
      fj_destination_area = QCBHAL fj_destination_name = QCBTIN
  END
  // Original user-drawn tiny blue region at approximately 123–148, 660–709.
  // Use a real altar container with an engine-native key reference and magical lock.
  LPF fj_are_structure
    INT_VAR fj_type = 7 fj_loc_x = 180 fj_loc_y = 655
      fj_box_left = 121 fj_box_top = 658
      fj_box_right = 150 fj_box_bottom = 710
      fj_lock_diff = 100 fj_flags = 5
      fj_lockpick_strref = RESOLVE_STR_REF(~This lock cannot be opened without a key or ward.~)
      fj_vertex_0 = 130 + (659 << 16)
      fj_vertex_1 = 145 + (662 << 16)
      fj_vertex_2 = 150 + (671 << 16)
      fj_vertex_3 = 146 + (690 << 16)
      fj_vertex_4 = 132 + (708 << 16)
      fj_vertex_5 = 123 + (704 << 16)
      fj_vertex_6 = 121 + (678 << 16)
    STR_VAR fj_structure_type = container fj_name = QBTLOCK
      fj_key_resref = QBTKEY fj_trap_script = QBTLOCKA
    RET fj_return_offset
  END
  // Cannot bash this lock open. A non-damaging scripted release creates Core.
  WRITE_LONG (fj_return_offset + 0x80) 100
  WRITE_SHORT (fj_return_offset + 0x30) 1 // scripted trigger active
  WRITE_SHORT (fj_return_offset + 0x2c) 100 // hard to spot
  WRITE_SHORT (fj_return_offset + 0x2e) 100 // hard to disarm
  LPF fj_are_structure
    INT_VAR fj_loc_x = 1174 fj_loc_y = 787 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QBTTRI01 fj_cre_resref = QBTTRIS
  END
BUT_ONLY_IF_IT_CHANGES

// Public installer: development progress message omitted.

