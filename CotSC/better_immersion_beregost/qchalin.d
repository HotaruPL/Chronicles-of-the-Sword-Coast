  IF ~~ THEN REPLY @24 GOTO BORING
END

IF ~~ THEN BEGIN ULCASTER_GOOD
  SAY @25
  IF ~~ THEN GOTO MAIN
END

IF ~~ THEN BEGIN BORING
  SAY @26
  IF ~~ THEN GOTO MAIN
END

IF ~~ THEN BEGIN BEREGOST
  SAY @27
  IF ~~ THEN GOTO ILLITHID_2
END

IF ~~ THEN BEGIN ILLITHID_2
  SAY @28
  IF ~~ THEN GOTO ILLITHID_3
END

IF ~~ THEN BEGIN ILLITHID_3
