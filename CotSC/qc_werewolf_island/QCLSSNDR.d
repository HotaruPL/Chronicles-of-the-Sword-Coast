BEGIN QCLSSNDR

IF ~Global("Kaishas1","GLOBAL",0)~ THEN BEGIN BEFORE_KAISHAS
  SAY @4
  IF ~~ THEN EXIT
END

IF ~Global("Kaishas1","GLOBAL",1) Global("QCLessandra","GLOBAL",0)~ THEN BEGIN INTRO
  SAY @5
  IF ~~ THEN GOTO INTRO2
END

IF ~False()~ THEN BEGIN INTRO2
  SAY @6
  IF ~~ THEN REPLY @7 GOTO LOOKS
  IF ~~ THEN REPLY @8 GOTO REFUSE
  IF ~~ THEN REPLY @9 GOTO ACCEPT
END

IF ~False()~ THEN BEGIN LOOKS
  SAY @10
  IF ~~ THEN REPLY @11 GOTO REFUSE
  IF ~~ THEN REPLY @12 GOTO ACCEPT
END

IF ~False()~ THEN BEGIN REFUSE
  SAY @13
  IF ~~ THEN DO ~SetGlobal("QCLessandra","GLOBAL",3)~ EXIT
END

IF ~False()~ THEN BEGIN ACCEPT
  SAY @14
  IF ~~ THEN DO ~SetGlobal("QCLessandra","GLOBAL",1)~ UNSOLVED_JOURNAL @2 EXIT
END

IF ~Global("QCLessandra","GLOBAL",3)~ THEN BEGIN ANGRY
  SAY @15
  IF ~~ THEN EXIT
END

IF ~Global("QCLessandra","GLOBAL",1)~ THEN BEGIN RETURN
  SAY @16
  IF ~PartyHasItem("QCKAYBOD")~ THEN REPLY @17 GOTO FOUND
  IF ~~ THEN REPLY @18 GOTO SEARCHING
END

IF ~False()~ THEN BEGIN FOUND
  SAY @19
  IF ~~ THEN DO ~TakePartyItem("QCKAYBOD") GiveItemCreate("POTN13",Player1,1,0,0) AddExperienceParty(500) SetGlobal("QCLessandra","GLOBAL",2) EscapeArea()~ SOLVED_JOURNAL @2 EXIT
END

IF ~False()~ THEN BEGIN SEARCHING
  SAY @20
  IF ~~ THEN EXIT
END
