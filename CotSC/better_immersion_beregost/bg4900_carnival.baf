  Global("Branwen_Freed","GLOBAL",2)
  InParty("Branwen")
  !Global("BIC_STATUE_REACT","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("BIC_STATUE_REACT","GLOBAL",1)
    StartDialogue("BICSLVR",Player1)
END

