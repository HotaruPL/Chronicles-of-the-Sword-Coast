COMPILE ~CotSC/qc_unicorn_grove/dialogue/QCJVICO.d~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QCJVICO.tra~

COPY ~CotSC/qc_unicorn_grove/area/QCJHR1.ARE~ ~override/QCJHR1.ARE~
  READ_LONG 0xbc qcj_song
  PATCH_IF (qcj_song > 0) AND (qcj_song + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG (qcj_song + 0) %QCJ_AMBIENT%
    WRITE_LONG (qcj_song + 4) %QCJ_AMBIENT%
    WRITE_LONG (qcj_song + 8) %QCJ_VICTORY%
    WRITE_LONG (qcj_song + 12) %QCJ_BATTLE%
  END ELSE BEGIN
    PATCH_FAIL @20293
  END
  // BG2301 retained two original searchable containers: their old contents were replaced in source.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 1 charges1 = 15 STR_VAR item_to_add = ~AROW05~ END
  // Exact BG2301 staircase at (581,833), retained as a non-travelling marker.
  // Next memory area is not built yet. Later: change type to 2 and provide destination.
  LPF fj_are_structure
    INT_VAR fj_type = 1
      fj_box_left = 531 fj_box_top = 812
      fj_box_right = 656 fj_box_bottom = 858
      fj_cursor_idx = 28 // original BG2301 Stairs2302 cursor
      fj_loc_x = 581 fj_loc_y = 833
      fj_vertex_0 = 550 + (841 << 16)
      fj_vertex_1 = 624 + (857 << 16)
      fj_vertex_2 = 656 + (858 << 16)
      fj_vertex_3 = 613 + (816 << 16)
      fj_vertex_4 = 576 + (813 << 16)
      fj_vertex_5 = 531 + (812 << 16)
      fj_info_point_strref = RESOLVE_STR_REF(~The next memory lies beyond these stairs, but its path has not yet taken shape.~)
    STR_VAR fj_structure_type = region fj_name = QCJNEXT
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 1090 fj_loc_y = 845 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCJENT
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 805 fj_loc_y = 779 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCJX01 fj_cre_resref = QCJKHAL
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 828 fj_loc_y = 760 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCJX02 fj_cre_resref = QCJJAHR
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 679 fj_loc_y = 683 fj_orientation = 13 fj_flags = 0
    STR_VAR fj_structure_type = actor fj_name = QCJX03 fj_cre_resref = QCJOGRE
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 1115 fj_loc_y = 645 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCJX04 fj_cre_resref = QCJASHI
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 670 fj_loc_y = 889 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCJX05 fj_cre_resref = QCJASHI
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 819 fj_loc_y = 254 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCJX06 fj_cre_resref = QCJDEVS
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 328 fj_loc_y = 631 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCJX07 fj_cre_resref = QCJBHOR
  END
  LPF fj_are_structure
