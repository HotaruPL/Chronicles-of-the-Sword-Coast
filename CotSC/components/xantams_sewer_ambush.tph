LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCXANTAM.TRA~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0224.BCS~ BEGIN
  FAIL @65
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BEHOLD01.CRE~ BEGIN
  FAIL @66
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~LELLYN.CRE~ BEGIN
  FAIL @67
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BOW03.ITM~ BEGIN
  FAIL @68
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~AROW07.ITM~ BEGIN
  FAIL @69
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~POTN34.ITM~ BEGIN
  FAIL @70
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~PLOT01N.ITM~ BEGIN
  FAIL @71
END

COPY_EXISTING ~PLOT01N.ITM~ ~override/QCXLETER.ITM~
  SAY NAME1 @3
  SAY NAME2 @3
  SAY DESC @4

COPY_EXISTING ~BEHOLD01.CRE~ ~override/QCXANTAM.CRE~
  SAY NAME1 @1
  SAY NAME2 @1
  ADD_CRE_ITEM ~QCXLETER~ #1 #0 #0 ~IDENTIFIED~ ~INV~
  WRITE_ASCII 0x280 ~QCXANTAM_DEAD~ #32

COPY_EXISTING ~LELLYN.CRE~ ~override/QCXMIN01.CRE~
  SAY NAME1 @2
  SAY NAME2 @2
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~LEAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~ EQUIP
  ADD_CRE_ITEM ~BOW03~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~AROW07~ #10 #0 #0 ~IDENTIFIED~ ~QUIVER1~ EQUIP
  ADD_CRE_ITEM ~POTN34~ #1 #0 #0 ~IDENTIFIED~ ~INV~
  ADD_CRE_ITEM ~MISC07~ #50 #0 #0 ~IDENTIFIED~ ~INV~
  WRITE_ASCII 0x280 ~QCXMIN01_DEAD~ #32
  WRITE_BYTE 0x270 255

COPY_EXISTING ~LELLYN.CRE~ ~override/QCXMIN02.CRE~
  SAY NAME1 @2
  SAY NAME2 @2
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~LEAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~ EQUIP
  ADD_CRE_ITEM ~BOW03~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~AROW07~ #10 #0 #0 ~IDENTIFIED~ ~QUIVER1~ EQUIP
  ADD_CRE_ITEM ~POTN34~ #1 #0 #0 ~IDENTIFIED~ ~INV~
  ADD_CRE_ITEM ~MISC07~ #50 #0 #0 ~IDENTIFIED~ ~INV~
  WRITE_ASCII 0x280 ~QCXMIN02_DEAD~ #32
  WRITE_BYTE 0x270 255

EXTEND_TOP ~BG0224.BCS~ ~CotSC/Quests_and_Challenges/AREA/BG0224_XANTAM.BAF~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCXANTAM.TRA~
