COMPILE ~CotSC/qc_unicorn_grove/dialogue/QBTMEM.d~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QBTMEM.tra~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTAREA.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTALAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTMADAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTENMAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTGORAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTCHAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTBOYAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QBTGUAI.baf~

// Area-only patch: keep the successful v22.5 WED, TIS, PVRZ and collision map untouched.
COPY_EXISTING ~QCBTEM.ARE~ ~override/QCBTEM.ARE~
  WRITE_ASCII 0x94 ~QBTAREA~ #8
  READ_LONG 0xbc qbt_songs
  PATCH_IF (qbt_songs > 0) AND (qbt_songs + 0x10 <= SOURCE_SIZE) BEGIN
    WRITE_LONG (qbt_songs + 12) %QBT_BOSS%
  END ELSE BEGIN
    PATCH_FAIL @20300
  END
  // The temple's indoor doorway is at 1079,836; the separate arrival point is 1402,957.
  READ_LONG 0x5c qbt_reg_off
  READ_SHORT 0x5a qbt_reg_num
  FOR (qbt_ri = 0; qbt_ri < qbt_reg_num; qbt_ri += 1) BEGIN
    SET qbt_ro = qbt_reg_off + (qbt_ri * 0xc4)
    READ_ASCII qbt_ro qbt_rname (32) NULL
    PATCH_IF (~%qbt_rname%~ STRING_EQUAL ~QBTEXIT~) BEGIN
      LPF fj_are_structure
        INT_VAR fj_delete_mode = qbt_ri
        STR_VAR fj_structure_type = region
      END
      SET qbt_ri = qbt_reg_num
    END
  END
  LPF fj_are_structure
    INT_VAR fj_type = 2 fj_box_left = 1045 fj_box_top = 810
      fj_box_right = 1115 fj_box_bottom = 862
      fj_cursor_idx = 30 fj_flags = 4
      fj_vertex_0 = 1045 + (810 << 16)
      fj_vertex_1 = 1115 + (810 << 16)
      fj_vertex_2 = 1115 + (862 << 16)
      fj_vertex_3 = 1045 + (862 << 16)
    STR_VAR fj_structure_type = region fj_name = QBTEXIT
      fj_destination_area = QCBHAL fj_destination_name = QCBTIN
  END
  // The existing entrance QBTENTR from the forest now brings the party into the chamber.
  READ_LONG 0x68 qbt_entrance_offset
  READ_LONG 0x6c qbt_entrance_count
  FOR (qbt_i = 0; qbt_i < qbt_entrance_count; qbt_i += 1) BEGIN
    SET qbt_e = qbt_entrance_offset + qbt_i * 0x68
    READ_ASCII qbt_e qbt_nm (32) NULL
    PATCH_IF (~%qbt_nm%~ STRING_EQUAL ~QBTENTR~) BEGIN
      WRITE_SHORT (qbt_e + 0x20) 1402
      WRITE_SHORT (qbt_e + 0x22) 957
      WRITE_SHORT (qbt_e + 0x24) 0
    END
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 773 fj_loc_y = 689 fj_orientation = 2
    STR_VAR fj_structure_type = actor fj_name = QBTALI01 fj_cre_resref = QBTALIA
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 696 fj_loc_y = 814 fj_orientation = 0
    STR_VAR fj_structure_type = actor fj_name = QBTGEH01 fj_cre_resref = QBTGEHR
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 628 fj_loc_y = 663 fj_orientation = 4
    STR_VAR fj_structure_type = actor fj_name = QBTMAD01 fj_cre_resref = QBTMADE
  END
