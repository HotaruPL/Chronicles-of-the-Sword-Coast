// Half-Ogre — neutral, preserving its original AI.
COPY_EXISTING ~OGREHA.CRE~ ~override/BICOGRE1.CRE~
  SAY NAME1 @1050
  SAY NAME2 @1050
  WRITE_ASCII 0x2cc ~BICOGRE1~ #8
  WRITE_ASCII 0x280 ~BICOGRE1~ #32
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

