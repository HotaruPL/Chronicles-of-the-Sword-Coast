LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_remaining_major_items_npcs.tra~

// ============================================================
// Exterior: QCHALR
// ============================================================
COPY ~CotSC/halruaan_flying_ship/QCHALR.ARE~ ~override/QCHALR.ARE~
COPY ~CotSC/halruaan_flying_ship/QCHALR.WED~ ~override/QCHALR.WED~
COPY ~CotSC/halruaan_flying_ship/QCHALR.TIS~ ~override/QCHALR.TIS~
COPY ~CotSC/halruaan_flying_ship/QHALR00.PVRZ~ ~override/QHALR00.PVRZ~
COPY ~CotSC/halruaan_flying_ship/QHALR01.PVRZ~ ~override/QHALR01.PVRZ~
COPY ~CotSC/halruaan_flying_ship/QCHALRSR.BMP~ ~override/QCHALRSR.BMP~
COPY ~CotSC/halruaan_flying_ship/QCHALRLM.BMP~ ~override/QCHALRLM.BMP~
COPY ~CotSC/halruaan_flying_ship/QCHALRHT.BMP~ ~override/QCHALRHT.BMP~

COPY_EXISTING ~QCHALR.ARE~ ~override/QCHALR.ARE~
  WRITE_ASCII 0x94 ~~ #8
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 875
      fj_loc_y = 270
      fj_orientation = 8
    STR_VAR
      fj_structure_type = entrance
      fj_name = QCHALRSHIP
  END
BUT_ONLY_IF_IT_CHANGES

ACTION_IF GAME_IS ~eet~ BEGIN
  INCLUDE ~EET/other/EET_functions.tph~
  ACTION_DEFINE_ASSOCIATIVE_ARRAY toNewArea BEGIN
    "BG1000" => "Exitwmp"
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY fromNewArea BEGIN
    // BG1000's standard world-map entrance is the safe Ulgoth's Beard arrival
    // (around X=2970,Y=877).  ExitNW was the wrong entry and could place
    // the party outside the playable map.
    "BG1000" => "Exitwmp"
  END
  OUTER_SPRINT qc_wm_qchalr_name @19002
  OUTER_SPRINT qc_wm_qchalr_desc @19002
  LAF sc#addWmpAre
    INT_VAR
      // v68: default wilderness icon. The normalization pass below reads
      // BG3500 (Mutamin's Garden) and copies its real icon ID exactly.
      mapIcon = 16
      xCoord = 660
      yCoord = 1391
      tTime = 0
      visible = 0
      visibleAdjacent = 0
      reachable = 0
      visited = 0
      inclSv = 0
    STR_VAR
      areName = ~QCHALR~
      strName = EVAL ~%qc_wm_qchalr_name%~
      strDesc = EVAL ~%qc_wm_qchalr_desc%~
      worldmap = ~worldmap~
  END

  // Northern Wilderness uses the same world-map construction as Shandalar's Home.
  // Only the area resref/name/icon/coordinates differ.  It starts hidden and
  // unreachable and is revealed by Shandalar's dialogue.
  OUTER_SPRINT qc_wm_qchalf_name @19003
  OUTER_SPRINT qc_wm_qchalf_desc @19003
  LAF sc#addWmpAre
    INT_VAR
      mapIcon = 16
      xCoord = 660
      yCoord = 1291
      tTime = 0
      visible = 0
      visibleAdjacent = 0
      reachable = 0
      visited = 0
      inclSv = 0
    STR_VAR
      areName = ~QCHALF~
      strName = EVAL ~%qc_wm_qchalf_name%~
      strDesc = EVAL ~%qc_wm_qchalf_desc%~
      worldmap = ~worldmap~
  END

  // v68: use exactly the existing EET wilderness map icon of BG3500
  // (Mutamin's Garden / Sharp Teeth Plain). Read it from WORLDMAP.WMP
  // instead of guessing an index or modifying the shared MAPICONS.BAM.
  // Existing Torm's Hand coordinates stay at v67's approved position.
  COPY_EXISTING ~worldmap.wmp~ ~override/worldmap.wmp~
    SET q68_garden_icon = 16
    SET q68_icon_found = 0
    READ_LONG 0x08 q68_wcount
    READ_LONG 0x0c q68_woff
    FOR (q68_m = 0; q68_m < q68_wcount; q68_m += 1) BEGIN
      SET q68_wbase = q68_woff + q68_m * 0xb8
      READ_LONG (q68_wbase + 0x20) q68_acount
      READ_LONG (q68_wbase + 0x24) q68_aoff
      FOR (q68_a = 0; q68_a < q68_acount; q68_a += 1) BEGIN
        SET q68_p = q68_aoff + q68_a * 0xf0
        READ_ASCII q68_p q68_area (8) NULL
        PATCH_IF (~%q68_area%~ STRING_EQUAL_CASE ~BG3500~) BEGIN
          READ_LONG (q68_p + 0x34) q68_garden_icon
          SET q68_icon_found = 1
        END
      END
    END
    FOR (q68_m = 0; q68_m < q68_wcount; q68_m += 1) BEGIN
      SET q68_wbase = q68_woff + q68_m * 0xb8
      READ_LONG (q68_wbase + 0x20) q68_acount
      READ_LONG (q68_wbase + 0x24) q68_aoff
      FOR (q68_a = 0; q68_a < q68_acount; q68_a += 1) BEGIN
        SET q68_p = q68_aoff + q68_a * 0xf0
        READ_ASCII q68_p q68_area (8) NULL
        PATCH_IF (~%q68_area%~ STRING_EQUAL_CASE ~TORMHA~) BEGIN
          WRITE_LONG (q68_p + 0x38) 540
          WRITE_LONG (q68_p + 0x3c) 1475
        END
        PATCH_IF (~%q68_area%~ STRING_EQUAL_CASE ~QCHALR~) BEGIN
          WRITE_LONG (q68_p + 0x34) q68_garden_icon
        END
      END
    END
  BUT_ONLY_IF_IT_CHANGES
  ACTION_IF (q68_icon_found == 0) BEGIN
    WARN @20137
  END

  // Normalize any duplicate QCHALR/QCHALF entries in the master WMP to the
  // same hidden/unreachable state. This never touches saved-game WMPs.
  COPY_EXISTING ~worldmap.wmp~ ~override/worldmap.wmp~
    READ_LONG 0x08 qce_map_count
    READ_LONG 0x0c qce_map_offset
    FOR (qce_m = 0; qce_m < qce_map_count; ++qce_m) BEGIN
      SET qce_map_pos = qce_map_offset + (qce_m * 0x0b8)
      READ_LONG (qce_map_pos + 0x20) qce_area_count
      READ_LONG (qce_map_pos + 0x24) qce_area_offset
      FOR (qce_a = 0; qce_a < qce_area_count; ++qce_a) BEGIN
        SET qce_area_pos = qce_area_offset + (qce_a * 0x0f0)
        READ_ASCII qce_area_pos qce_area_resref (8) NULL
        PATCH_IF (~%qce_area_resref%~ STRING_EQUAL_CASE ~QCHALR~) BEGIN
          WRITE_LONG (qce_area_pos + 0x30) 0
        END
        PATCH_IF (~%qce_area_resref%~ STRING_EQUAL_CASE ~QCHALF~) BEGIN
          WRITE_LONG (qce_area_pos + 0x30) 0
        END
      END
    END
  BUT_ONLY_IF_IT_CHANGES
END

// ============================================================
// Forest quest area: QCHALF
// ============================================================
COPY ~CotSC/halruaan_forest/QCHALF.ARE~ ~override/QCHALF.ARE~
// CotSC v43: Northern Wilderness was outdoor + forest (0x11), but lacked
// the day/night lighting flag (bit 1). Preserve all other area-type flags.
COPY_EXISTING ~QCHALF.ARE~ ~override/QCHALF.ARE~
  READ_SHORT 0x48 qc_halw_are_type
  WRITE_SHORT 0x48 (qc_halw_are_type BOR 0x0002)
BUT_ONLY_IF_IT_CHANGES
COPY ~CotSC/halruaan_forest/QCHALF.WED~ ~override/QCHALF.WED~
COPY ~CotSC/halruaan_forest/QCHALF.TIS~ ~override/QCHALF.TIS~
COPY ~CotSC/halruaan_forest/QCHALFHT.BMP~ ~override/QCHALFHT.BMP~
COPY ~CotSC/halruaan_forest/QCHALFLM.BMP~ ~override/QCHALFLM.BMP~
COPY ~CotSC/halruaan_forest/QCHALFSR.BMP~ ~override/QCHALFSR.BMP~
COPY ~CotSC/halruaan_forest/QHALF00.PVRZ~ ~override/QHALF00.PVRZ~
COPY ~CotSC/halruaan_forest/QHALF01.PVRZ~ ~override/QHALF01.PVRZ~

// ============================================================
// Northern Wilderness: world-map arrival + forest soundscape
// ============================================================
COPY_EXISTING ~QCHALF.ARE~ ~override/QCHALF.ARE~
  // Existing Exitwmp entrance starts at 0xE4 in the minimal ARE.
  WRITE_SHORT 0x104 1120
  WRITE_SHORT 0x106 913
  WRITE_SHORT 0x108 0

BUT_ONLY_IF_IT_CHANGES

// QCHALF collision/occlusion is frozen at Forest v1.4.
// Do not alter QCHALFSR.BMP unless explicitly reopening the component.

// ============================================================
// QCHALF / QCHALR exits: direct return to Ulgoth's Beard
// ============================================================
// v7.19 uses the same proven pattern as Better Immersion QCCARN -> BG4900:
// a normal ARE travel region points directly at a named destination entrance.
// The original 4-bit search maps are preserved byte-for-byte except that only
// the old colour-index 14 world-map travel cells at these exits are changed to
// ordinary index 0 cells.  The BMPs remain genuine 4-bit IE search maps, so
// collision is preserved.  No Pillow/8-bit conversion is used.
// The travel regions below send the whole party directly to BG1000 at
// X=2970,Y=877 without opening the world map.
//
// This keeps the WMP entries themselves intact so the quest areas can still
// be reached through the world map when the quest calls for it; only the
// *exit* behaviour is changed.

// Safe Ulgoth's Beard destination used by both QCHALF and QCHALR.
COPY_EXISTING ~BG1000.ARE~ ~override/BG1000.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 2970
      fj_loc_y = 877
      fj_orientation = 8
    STR_VAR
      fj_structure_type = entrance
      fj_name = QCHALRET
  END
BUT_ONLY_IF_IT_CHANGES

// Northern Wilderness: bottom and right visible exits.
COPY_EXISTING ~QCHALF.ARE~ ~override/QCHALF.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 1184
      fj_box_top = 996
      fj_box_right = 1263
      fj_box_bottom = 1023
      fj_cursor_idx = 34
      fj_flags = 4
      fj_vertex_0 = 1184 + (996 << 16)
      fj_vertex_1 = 1263 + (996 << 16)
      fj_vertex_2 = 1263 + (1023 << 16)
      fj_vertex_3 = 1184 + (1023 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = QCFEXIT1
      fj_destination_area = BG1000
      fj_destination_name = QCHALRET
  END
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 1472
      fj_box_top = 528
      fj_box_right = 1535
      fj_box_bottom = 587
      fj_cursor_idx = 34
      fj_flags = 4
      fj_vertex_0 = 1472 + (528 << 16)
      fj_vertex_1 = 1535 + (528 << 16)
      fj_vertex_2 = 1535 + (587 << 16)
      fj_vertex_3 = 1472 + (587 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = QCFEXIT2
      fj_destination_area = BG1000
      fj_destination_name = QCHALRET
  END
BUT_ONLY_IF_IT_CHANGES

// Shandalar's Home exterior: former bottom world-map exit.
COPY_EXISTING ~QCHALR.ARE~ ~override/QCHALR.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 720
      fj_box_top = 816
      fj_box_right = 815
      fj_box_bottom = 895
      fj_cursor_idx = 34
      fj_flags = 4
      fj_vertex_0 = 720 + (816 << 16)
      fj_vertex_1 = 815 + (816 << 16)
      fj_vertex_2 = 815 + (895 << 16)
      fj_vertex_3 = 720 + (895 << 16)
    STR_VAR
      fj_structure_type = region
