BEGIN QACOVER

IF ~Global("QAC_LASLO_OVERLY_CONFRONTED","GLOBAL",0)~ THEN BEGIN 0
    SAY @5
    IF ~~ THEN REPLY @6 EXIT
    IF ~Global("QAC_LASLO_SUSPECT_QUESTION","GLOBAL",0)~ THEN REPLY @7 GOTO 1
END

IF ~~ THEN BEGIN 1
    SAY @8
    IF ~InParty("Minsc") !StateCheck("Minsc",CD_STATE_NOTVALID)~ THEN EXTERN MINSCJ_ QAC_LASLO_MINSC
    IF ~!InParty("Minsc")~ THEN GOTO 2
    IF ~InParty("Minsc") StateCheck("Minsc",CD_STATE_NOTVALID)~ THEN GOTO 2
END

IF ~~ THEN BEGIN 2
    SAY @9
    IF ~~ THEN REPLY @10 GOTO 3
    IF ~~ THEN REPLY @11 DO ~SetGlobal("QAC_LASLO_SUSPECT_QUESTION","GLOBAL",1)~ GOTO 4
    IF ~~ THEN REPLY @12 EXIT
END

IF ~~ THEN BEGIN 3
    SAY @13
    IF ~~ THEN GOTO 5
END

IF ~~ THEN BEGIN 4
    SAY @14
    IF ~~ THEN REPLY @15 GOTO 3
    IF ~~ THEN REPLY @16 EXIT
END

IF ~~ THEN BEGIN 5
    SAY @17
    IF ~~ THEN DO ~GiveItemCreate("QCLASLO",Player1,1,0,0) SetGlobal("QAC_LASLO_OVERLY_CONFRONTED","GLOBAL",1) SetGlobal("QAC_LASLO_OVERLY_FAINTED","GLOBAL",1) PlayDead(900)~ EXIT
END

IF ~Global("QAC_LASLO_OVERLY_FAINTED","GLOBAL",1) Global("QAC_LASLO_RECOVERED","GLOBAL",0)~ THEN BEGIN QAC_LASLO_INSPECT
    SAY @18
    IF ~~ THEN DO ~SetGlobal("QAC_LASLO_RECOVERED","GLOBAL",1)~ GOTO QAC_LASLO_INSPECT_CHOICES
END

IF ~~ THEN BEGIN QAC_LASLO_INSPECT_CHOICES
    SAY @19
    IF ~InParty("jaheira") !StateCheck("Jaheira",CD_STATE_NOTVALID)~ THEN REPLY @20 EXTERN JAHEIJ QAC_LASLO_JAHEIRA
    IF ~~ THEN REPLY @21 EXIT
END

IF ~~ THEN BEGIN QAC_LASLO_AFTER_JAHEIRA
    SAY @22
    IF ~~ THEN REPLY @23 EXIT
END

APPEND MINSCJ_
IF ~~ THEN BEGIN QAC_LASLO_MINSC
        SAY @24
        IF ~~ THEN EXTERN QACOVER 2
    END
END

APPEND JAHEIJ
IF ~~ THEN BEGIN QAC_LASLO_JAHEIRA
        SAY @25
        IF ~~ THEN EXTERN QACOVER QAC_LASLO_AFTER_JAHEIRA
    END
END
