BACKUP ~weidu_external/backup/CotSC~
AUTHOR ~HOTARU & MAPEK~
VERSION ~1.4~

LANGUAGE ~English~ ~english~ ~CotSC/translation/english/Quests_and_Challenges/DLG/Setup.tra~ ~CotSC/translation/english/installer_component_names_journal_titles.tra~ ~CotSC/translation/english/installer_native_eet_worldmap.tra~ ~CotSC/translation/english/installer_diagnostics.tra~

LANGUAGE ~Simplified Chinese~ ~schinese~
  ~CotSC/translation/schinese/Quests_and_Challenges/DLG/Setup.tra~
  ~CotSC/translation/schinese/installer_component_names_journal_titles.tra~
  ~CotSC/translation/schinese/installer_native_eet_worldmap.tra~
  ~CotSC/translation/schinese/installer_diagnostics.tra~

BEGIN @6000

REQUIRE_PREDICATE
  GAME_IS ~eet~
  @1

LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/Setup.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG2600.BCS~ BEGIN
  FAIL @2
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~NOBLEW2.CRE~ BEGIN
  FAIL @3
END

COPY_EXISTING ~NOBLEW2.CRE~ ~override/QCLYDIA.CRE~
  SAY NAME1 @10
  SAY NAME2 @10
  WRITE_ASCII 0x2cc ~QCLYDIA~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8

COPY_EXISTING ~AMUL11.ITM~ ~override/QCLNECK.ITM~
  SAY NAME1 @11
  SAY NAME2 @11
  SAY DESC @12

COMPILE ~CotSC/Quests_and_Challenges/DLG/QCLYDIA.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCLYDIA.TRA~

ADD_JOURNAL TITLE (@20) @21 @22 USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/Setup.tra~

EXTEND_TOP ~BG2600.BCS~ ~CotSC/Quests_and_Challenges/AREA/BG2600.baf~

BEGIN @6001

