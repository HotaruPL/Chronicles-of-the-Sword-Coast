// BG0607 - FLAMING FIST GAOL ADDITIONS
// ---------------------------------------------------------------------------

// Drow prisoner — male drow chassis, stripped of all equipment and AI.
COPY_EXISTING ~DADROW2.CRE~ ~override/BIBDRO07.CRE~
  SAY NAME1 @2041
  SAY NAME2 @2041
  WRITE_ASCII 0x2cc ~BIBDRO07~ #8
  WRITE_ASCII 0x280 ~BIBDRO07~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

// Troll prisoner — normal troll chassis, with AI removed and allegiance set to neutral.
// Its native troll mechanics are retained.
COPY_EXISTING ~TROLL01.CRE~ ~override/BIBTROL7.CRE~
  SAY NAME1 @2042
  SAY NAME2 @2042
  WRITE_ASCII 0x2cc ~BIBTROL7~ #8
  WRITE_ASCII 0x280 ~BIBTROL7~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

// High Constable — noble-looking human chassis, stripped of AI/equipment.
COPY_EXISTING ~ENTAR.CRE~ ~override/BIBHCON7.CRE~
  SAY NAME1 @2043
  SAY NAME2 @2043
  WRITE_ASCII 0x2cc ~BIBHCON7~ #8
  WRITE_ASCII 0x280 ~BIBHCON7~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  // Clear the CRE sound-set strrefs inherited from Entar so the High Constable
  // does not use Entar's voiced selection lines (e.g. the line about Skie).
  FOR (i = 0; i < 100; ++i) BEGIN
    WRITE_LONG (0xa4 + (i * 4)) 0
  END
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

// Kobold Commoner — BG1114, weaponless and static.
COPY_EXISTING ~KOBCOMM.CRE~ ~override/BIBKOB19.CRE~
  SAY NAME1 @2013
  SAY NAME2 @2013
  WRITE_ASCII 0x2cc ~BIBKOB19~ #8
  WRITE_ASCII 0x280 ~BIBKOB19~ #32
  WRITE_ASCII 0x248 ~QCKOB114~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

