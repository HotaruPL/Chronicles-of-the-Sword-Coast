// Part V. BG1 container additions requested 24 October 2026.
// This component does not modify items, merchants, creatures, stores or dialogue.
// Each item is added to the existing container whose ARE position is nearest to
// the coordinates supplied by the user. Original container loot is retained.
// Quantities are encoded as item stack counts (fj_charge0), including 12 gold.
// Former WeiDU component: Miscellaneous Merchants - Part V: BG1 Container Loot (73 placements)

// Independent of the Part III SoA container helper, so the earlier frozen
// component need not be reinstalled or executed for Part V to work.
DEFINE_PATCH_FUNCTION QCMM_BG1_CONTAINER_LOOT
  INT_VAR x = 0 y = 0 charge = 1
  STR_VAR item = ~~
BEGIN
  READ_SHORT 0x74 qcmm_bg1_cnt
  READ_LONG  0x70 qcmm_bg1_off
  PATCH_IF (qcmm_bg1_cnt > 0) BEGIN
    SET qcmm_bg1_best = 0
    SET qcmm_bg1_dist_best = 2147483647
    FOR (qcmm_bg1_i = 0; qcmm_bg1_i < qcmm_bg1_cnt; qcmm_bg1_i += 1) BEGIN
      READ_SHORT (qcmm_bg1_off + qcmm_bg1_i * 0xc0 + 0x20) qcmm_bg1_x
      READ_SHORT (qcmm_bg1_off + qcmm_bg1_i * 0xc0 + 0x22) qcmm_bg1_y
      SET qcmm_bg1_dx = qcmm_bg1_x - x
      SET qcmm_bg1_dy = qcmm_bg1_y - y
      SET qcmm_bg1_dist = qcmm_bg1_dx * qcmm_bg1_dx + qcmm_bg1_dy * qcmm_bg1_dy
      PATCH_IF (qcmm_bg1_dist < qcmm_bg1_dist_best) BEGIN
        SET qcmm_bg1_dist_best = qcmm_bg1_dist
        SET qcmm_bg1_best = qcmm_bg1_i
      END
    END
    LPF fj_are_structure
      INT_VAR
        fj_con_itm_idx = qcmm_bg1_best
        fj_charge0 = charge
        fj_flags = 1
      STR_VAR
        fj_structure_type = ~itm~
        fj_name = EVAL ~%item%~
    END
  END ELSE BEGIN
    PATCH_PRINT @20344
  END
END

// Areas absent from an installation are reported, rather than silently
// causing the whole component to roll back. See the manifest for all 73 targets.

ACTION_IF FILE_EXISTS_IN_GAME ~BG2617.ARE~ BEGIN
  COPY_EXISTING ~BG2617.ARE~ ~override~
    // Requested nearest container: 213, 358
    LPF QCMM_BG1_CONTAINER_LOOT INT_VAR x = 213 y = 358 charge = 1 STR_VAR item = ~QCSAUSG~ END
END ELSE BEGIN

PRINT @20345

END

