LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

// Build NEW QC-prefixed creatures from the requested originals.
// No original CRE is overwritten or modified.

// Mervin in BG2304
COPY_EXISTING ~FUMIN.CRE~ ~override/QCRPMERV.CRE~
  SAY NAME1 @5051
  SAY NAME2 @5051
  WRITE_ASCII 0x2cc ~QCRPMERV~ #8
  WRITE_ASCII 0x280 ~QCRPMERV~ #32
  WRITE_ASCII 0x248 ~~ #40 // Remove inherited AI scripts
  WRITE_BYTE 0x270 128 // Neutral allegiance, can initiate dialogue
  WRITE_BYTE 0x32 0 // Dark/black hair colour gradient

COMPILE ~CotSC/QCRPA/dialogue/QCRPMERV.d~ USING ~CotSC/translation/%LANGUAGE%/QCRPA/dialogue/QCRPMERV.tra~

COPY_EXISTING ~BG2304.ARE~ ~override~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 491
      fj_loc_y = 287
      fj_dest_x = 491
      fj_dest_y = 287
      fj_orientation = 2
      fj_wander_dist_actor = 0
      fj_mvmt_dist_actor = 0
    STR_VAR
      fj_structure_type = ~actor~
      fj_name = ~QCRPMERV_Actor~
      fj_cre_resref = ~QCRPMERV~
  END

