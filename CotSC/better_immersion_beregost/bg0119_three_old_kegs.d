// ---------------------------------------------------------------------------
// BETTER IMMERSION FOR BALDUR'S GATE - BG0119 / THREE OLD KEGS
// ---------------------------------------------------------------------------

APPEND BDCHARRA
IF WEIGHT #-1 ~Global("BIB_BG0119_CHARRA_TALKED","LOCALS",0)~ THEN BEGIN BIB_CHARRA_BG0119
  SAY @1
  ++ @2 GOTO BIB_CHARRA_BG0119_DRINK
  ++ @3 GOTO BIB_CHARRA_BG0119_INFO
  ++ @4 EXIT
END

IF ~~ THEN BEGIN BIB_CHARRA_BG0119_DRINK
  SAY @5
  IF ~~ THEN DO ~SetGlobal("BIB_BG0119_CHARRA_TALKED","LOCALS",1)~ EXIT
END

IF ~~ THEN BEGIN BIB_CHARRA_BG0119_INFO
  SAY @6
  IF ~~ THEN DO ~SetGlobal("BIB_BG0119_CHARRA_TALKED","LOCALS",1)~ EXIT
END
END

APPEND BDKATHEE
IF WEIGHT #-1 ~Global("BIB_BG0119_KATHEERA_TALKED","LOCALS",0)~ THEN BEGIN BIB_KATHEERA_BG0119
  SAY @7
  ++ @8 DO ~SetGlobal("BIB_BG0119_KATHEERA_TALKED","LOCALS",1) StartStore("INN0119",LastTalkedToBy(Myself))~ EXIT
  ++ @9 EXIT
END
END
