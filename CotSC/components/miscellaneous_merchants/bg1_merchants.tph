COPY ~CotSC/QCMM/stores/QCMS06.STO~ ~override/QCMS06.STO~
  SAY 0x0c @4071
COPY_EXISTING ~FTOWBE_B.CRE~ ~override/QCMM06.CRE~
  SAY NAME1 @4072
