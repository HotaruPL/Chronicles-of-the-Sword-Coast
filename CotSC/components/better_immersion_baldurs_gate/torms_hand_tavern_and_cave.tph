      fj_flags = 3
    STR_VAR
      fj_structure_type = ambient
      fj_name = PWYFORESTAMB
      fj_wav_resref0 = AMB_E07A
  END

  // Cloakwood-style outdoor music. BG(2)EE songlist.2da maps Area1600 to 28;
  // BF1 (51) is the standard BG2EE battle track.
  LPF fj_are_structure
    INT_VAR
      fj_song_day = 28
      fj_song_night = 28
      fj_song_victory = 0
      fj_song_battle = 51
      fj_song_defeat = 0
      fj_song_day_vol = 100
      fj_song_night_vol = 100
      fj_song_reverb = 0
    STR_VAR
      fj_structure_type = songs
  END

  // Return entrance used by the cave's travel region.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1402
      fj_loc_y = 171
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name = PWYTR1BACK
  END
BUT_ONLY_IF_IT_CHANGES

