// Dwarf Commoner - QUINNE is not present in EET; use verified SAILAL dwarf chassis, weaponless, green/white palette.
COPY_EXISTING ~SAILAL.CRE~ ~override/QCAWDW2.CRE~
  SAY NAME1 @3109
  SAY NAME2 @3109
  WRITE_ASCII 0x2cc ~QCAWDW2~ #8
  WRITE_ASCII 0x280 ~QCAWDW2~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  // Two-tone green/white clothing. Skin and hair are preserved from the dwarf chassis.
  WRITE_BYTE 0x2d 5
  WRITE_BYTE 0x2e 15
  WRITE_BYTE 0x30 5
  WRITE_BYTE 0x31 15
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Patch AR0700 in place. The uploaded ARE is reference-only; never replace the game area.
COPY_EXISTING ~AR0700.ARE~ ~override~
  // X=3042 Y=721 - Gnome, facing south.
  LPF fj_are_structure INT_VAR fj_loc_x=3042 fj_loc_y=721 fj_dest_x=3042 fj_dest_y=721 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWGNO fj_cre_resref=QCAWGNO fj_dlg_resref=QCAWGNO END
  // X=3044 Y=737 - SARELF01, facing north.
  LPF fj_are_structure INT_VAR fj_loc_x=3044 fj_loc_y=737 fj_dest_x=3044 fj_dest_y=737 fj_orientation=8 STR_VAR fj_structure_type=actor fj_name=QCAWEL1 fj_cre_resref=QCAWEL1 fj_dlg_resref=QCAWEL1 END
  // X=3003 Y=111 - female human, red palette, facing east.
  LPF fj_are_structure INT_VAR fj_loc_x=3003 fj_loc_y=111 fj_dest_x=3003 fj_dest_y=111 fj_orientation=12 STR_VAR fj_structure_type=actor fj_name=QCAWFEM fj_cre_resref=QCAWFEM fj_dlg_resref=QCAWFEM END
  // X=3524 Y=1514 - roaming male halfling.
  LPF fj_are_structure INT_VAR fj_loc_x=3524 fj_loc_y=1514 fj_dest_x=3524 fj_dest_y=1514 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWHAL fj_cre_resref=QCAWHAL fj_dlg_resref=QCAWHAL fj_bcs_override=QCAWAND END
  // X=2040 Y=845 - roaming dog.
  LPF fj_are_structure INT_VAR fj_loc_x=2040 fj_loc_y=845 fj_dest_x=2040 fj_dest_y=845 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWDOG fj_cre_resref=QCAWDOG fj_bcs_override=QCAWAND END
  // X=1539 Y=983 - Cattleman.
  LPF fj_are_structure INT_VAR fj_loc_x=1539 fj_loc_y=983 fj_dest_x=1539 fj_dest_y=983 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWCOW fj_cre_resref=QCAWCOW fj_dlg_resref=QCAWCOW END
  // X=1738 Y=1637 - roaming Kobold Commoner.
  LPF fj_are_structure INT_VAR fj_loc_x=1738 fj_loc_y=1637 fj_dest_x=1738 fj_dest_y=1637 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWKOB fj_cre_resref=QCAWKOB fj_dlg_resref=QCAWKOB fj_bcs_override=QCAWAND END
  // X=2191 Y=2271 - SARELF04, silver, facing south-east.
  LPF fj_are_structure INT_VAR fj_loc_x=2191 fj_loc_y=2271 fj_dest_x=2191 fj_dest_y=2271 fj_orientation=14 STR_VAR fj_structure_type=actor fj_name=QCAWEL2 fj_cre_resref=QCAWEL2 fj_dlg_resref=QCAWEL2 END
  // X=2349 Y=2598 - roaming SARELF03.
  LPF fj_are_structure INT_VAR fj_loc_x=2349 fj_loc_y=2598 fj_dest_x=2349 fj_dest_y=2598 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWEL3 fj_cre_resref=QCAWEL3 fj_dlg_resref=QCAWEL3 fj_bcs_override=QCAWAND END
  // X=5003 Y=2466 - Dwarf Commoner, rotated 180 degrees: now facing west.
  LPF fj_are_structure INT_VAR fj_loc_x=5003 fj_loc_y=2466 fj_dest_x=5003 fj_dest_y=2466 fj_orientation=4 STR_VAR fj_structure_type=actor fj_name=QCAWDW1 fj_cre_resref=QCAWDW1 fj_dlg_resref=QCAWDW1 END
  // X=4970 Y=2465 - RINNIE-based Half-Elf, red, rotated 180 degrees: now facing east.
  LPF fj_are_structure INT_VAR fj_loc_x=4970 fj_loc_y=2465 fj_dest_x=4970 fj_dest_y=2465 fj_orientation=12 STR_VAR fj_structure_type=actor fj_name=QCAWHLF fj_cre_resref=QCAWHLF fj_dlg_resref=QCAWHLF END
  // X=4874 Y=553 - cat.
  LPF fj_are_structure INT_VAR fj_loc_x=4874 fj_loc_y=553 fj_dest_x=4874 fj_dest_y=553 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWCAT fj_cre_resref=QCAWCAT END
  // X=194 Y=1197 - static Kobold Commoner, facing south.
  LPF fj_are_structure INT_VAR fj_loc_x=194 fj_loc_y=1197 fj_dest_x=194 fj_dest_y=1197 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCAWKO2 fj_cre_resref=QCAWKO2 fj_dlg_resref=QCAWKO2 END
  // X=1480 Y=754 - human male, facing north-west.
