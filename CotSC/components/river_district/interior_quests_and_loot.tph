// QRHO01: exact requested loot; other containers remain empty.
COPY_EXISTING ~QRHO01.ARE~ ~override/QRHO01.ARE~
  PATCH_IF (SHORT_AT 0x74 != 2) BEGIN PATCH_FAIL ~Wrong container count in QRHO01: expected original cloned inventory sections~ END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 1
      charges1 = 20
    STR_VAR
      item_to_add = ~AROW01~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 2
      charges1 = 14
    STR_VAR
      item_to_add = ~BULL01~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 2
      charges1 = 15
    STR_VAR
      item_to_add = ~MISC07~
  END
  // No named owner and no container lock/theft flags on Larissa's chests.
  READ_LONG 0x70 q24co
  FOR (i = 0; i < 2; ++i) BEGIN
    WRITE_LONG (q24co + i * 0xc0 + 0x28) 0
    WRITE_ASCII (q24co + i * 0xc0 + 0x58) ~~ #32
    WRITE_SHORT (q24co + i * 0xc0 + 0x26) 0
    WRITE_SHORT (q24co + i * 0xc0 + 0x30) 0
  END
BUT_ONLY_IF_IT_CHANGES

