// Part I: original Baldur's Gate (EET area resources BGxxxx).
// Former WeiDU component: Miscellaneous Merchants - Part I: Baldur's Gate (10 merchants)

COPY ~CotSC/QCMM/stores/QCMS01.STO~ ~override/QCMS01.STO~
  SAY 0x0c @4067
COPY_EXISTING ~MERCH2.CRE~ ~override/QCMM01.CRE~
  SAY NAME1 @4068
  SAY NAME2 @4068
  WRITE_ASCII 0x2cc ~QCMM01~ #8
  WRITE_ASCII 0x280 ~QCMM01~ #32
  WRITE_ASCII 0x248 ~~ #40 // clear reused creature AI scripts
  WRITE_BYTE 0x270 128 // neutral

