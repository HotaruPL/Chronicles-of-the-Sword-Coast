END

// v1.33 migration for saves already tested with v1.32. Remove any existing
// QCFLOWV (VISUALRANGE 1) once, then apply the slightly larger range-2 version.
// This runs only once per saved game and does not create a refresh/pulse cycle.
IF
  Global("QCFIR_VIS33_MIGRATED","GLOBAL",0)
THEN
  RESPONSE #100
    ApplySpellRES("QCFVRES",Player1)
    ApplySpellRES("QCFVRES",Player2)
    ApplySpellRES("QCFVRES",Player3)
    ApplySpellRES("QCFVRES",Player4)
    ApplySpellRES("QCFVRES",Player5)
    ApplySpellRES("QCFVRES",Player6)
    ApplySpellRES("QCFLOWV",Player1)
    ApplySpellRES("QCFLOWV",Player2)
    ApplySpellRES("QCFLOWV",Player3)
    ApplySpellRES("QCFLOWV",Player4)
    ApplySpellRES("QCFLOWV",Player5)
    ApplySpellRES("QCFLOWV",Player6)
    SetGlobal("QCFIR_LOWVIS_ACTIVE","GLOBAL",1)
    SetGlobal("QCFIR_VIS33_MIGRATED","GLOBAL",1)
END

// Tight dungeon visibility. Apply the visual-range effect ONCE on entry.
// QCFLOWV uses opcode 262 with flat VISUALRANGE 8 and a very long duration.
// It is explicitly removed in BG5201 on exit, so there is no expiry/reapply
// cycle and therefore no pulsing or changing radius.
IF
  Global("QCFIR_LOWVIS_ACTIVE","GLOBAL",0)
THEN
  RESPONSE #100
    ApplySpellRES("QCFLOWV",Player1)
    ApplySpellRES("QCFLOWV",Player2)
    ApplySpellRES("QCFLOWV",Player3)
    ApplySpellRES("QCFLOWV",Player4)
    ApplySpellRES("QCFLOWV",Player5)
    ApplySpellRES("QCFLOWV",Player6)
    SetGlobal("QCFIR_LOWVIS_ACTIVE","GLOBAL",1)
END
