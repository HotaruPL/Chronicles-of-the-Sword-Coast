// TORM'S HAND - cavern network baseline (artwork only; details to follow)
COPY ~CotSC/better_immersion_beregost/area/TORMCR.ARE~ ~override/TORMCR.ARE~
COPY_EXISTING ~TORMCR.ARE~ ~override/TORMCR.ARE~
  WRITE_ASCII 0x94 ~TCRCRSCN~ #8
COPY ~CotSC/better_immersion_beregost/area/TORMCR.WED~ ~override/TORMCR.WED~
