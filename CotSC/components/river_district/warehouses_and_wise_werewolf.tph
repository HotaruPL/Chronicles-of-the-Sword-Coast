// River District v2.9: map notes only. Existing entry regions, WED, art,
// collision, music, containers and actors are deliberately not changed.
COPY_EXISTING ~QCRIVD.ARE~ ~override/QCRIVD.ARE~
  ADD_MAP_NOTE #2353 #342 ~blue~ ~Baldie's Goods~
  ADD_MAP_NOTE #2109 #1476 ~blue~ ~Delgado's House~
  ADD_MAP_NOTE #1072 #1458 ~blue~ ~Thylion's House~
  ADD_MAP_NOTE #694 #1469 ~blue~ ~Larissa's House~
  ADD_MAP_NOTE #285 #630 ~blue~ ~Warehouse~
  ADD_MAP_NOTE #1559 #505 ~blue~ ~Temple of Helm~
BUT_ONLY_IF_IT_CHANGES


// ====================================================================
// v3.1: River District world-map arrival at the southern gate.
// Reposition the existing one entrance, leaving all region/door/actor records intact.
COPY_EXISTING ~QCRIVD.ARE~ ~override/QCRIVD.ARE~
  READ_LONG 0x68 qr_arrive_off
  READ_LONG 0x6c qr_arrive_count
  PATCH_IF (qr_arrive_count < 1) OR (qr_arrive_off + 0x68 > SOURCE_SIZE) BEGIN
    PATCH_FAIL @20241
  END
  WRITE_ASCII qr_arrive_off ~ARRIVE~ #32
  WRITE_SHORT (qr_arrive_off + 0x20) 1670
  WRITE_SHORT (qr_arrive_off + 0x22) 1593
BUT_ONLY_IF_IT_CHANGES

// v3.1: River District exploration music in private houses and warehouses.
// The shop and temple are intentionally EXCLUDED. No other ARE fields touched.
ACTION_FOR_EACH qr_indoor IN ~QRHO01~ ~QRHO02~ ~QRHO03~ ~QRHO04~ ~QRHO05~ ~QRWH01~ ~QRWH02~ ~QRWH03~ BEGIN
  COPY_EXISTING ~%qr_indoor%.ARE~ ~override/%qr_indoor%.ARE~
    READ_LONG 0xbc qr_indoor_songs
    PATCH_IF (qr_indoor_songs > 0) AND (qr_indoor_songs + 0x90 <= SOURCE_SIZE) BEGIN
      WRITE_LONG qr_indoor_songs %QRIV_THEME%
      WRITE_LONG (qr_indoor_songs + 4) %QRIV_THEME%
    END ELSE BEGIN
      PATCH_FAIL @20242
    END
  BUT_ONLY_IF_IT_CHANGES
END

