// The guard retains HURGAN's original armor, inventory, dialogue and AI.
// Only the 100 creature soundset slots are copied from Quinn, the existing
// Dwarf Commoner voice source also used for BIBDWR16 in this component.
COPY_EXISTING ~QUINN.CRE~ ~override~
  FOR (qc_ng_slot = 0; qc_ng_slot < 100; qc_ng_slot += 1) BEGIN
    READ_LONG (0xa4 + (qc_ng_slot * 4)) qc_ng_soundref
    SET $qc_nashkel_guard_voice("%qc_ng_slot%") = qc_ng_soundref
  END
BUT_ONLY_IF_IT_CHANGES

// Guard — based on HURGAN, retaining armor and equipment.
COPY_EXISTING ~HURGAN.CRE~ ~override/BNGUARD0.CRE~
  FOR (qc_ng_slot = 0; qc_ng_slot < 100; qc_ng_slot += 1) BEGIN
    WRITE_LONG (0xa4 + (qc_ng_slot * 4)) $qc_nashkel_guard_voice("%qc_ng_slot%")
  END
  SAY NAME1 @1043
  SAY NAME2 @1043
  WRITE_ASCII 0x2cc ~BNGUARD0~ #8
  WRITE_ASCII 0x280 ~BNGUARD0~ #32
  WRITE_ASCII 0x248 ~BNGUARD0~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/better_immersion_beregost/nashkel_citizens.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/nashkel_citizens.tra~
COMPILE ~CotSC/better_immersion_beregost/bg4800_nashkel.baf~
EXTEND_TOP ~BG4800.BCS~ ~CotSC/better_immersion_beregost/bg4800_nashkel.baf~

// Bouncer and Guard additions remain part of THIS Nashkel component.
COMPILE ~CotSC/better_immersion_beregost/bnbouncer.baf~
COMPILE ~CotSC/better_immersion_beregost/bnguard.baf~
COMPILE ~CotSC/better_immersion_beregost/nashkel_extras.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/nashkel_extras.tra~
COMPILE ~CotSC/better_immersion_beregost/bg4801_nashkel_extras.baf~
EXTEND_TOP ~BG4801.BCS~ ~CotSC/better_immersion_beregost/bg4801_nashkel_extras.baf~
COMPILE ~CotSC/better_immersion_beregost/bg4803_nashkel_extras.baf~
EXTEND_TOP ~BG4803.BCS~ ~CotSC/better_immersion_beregost/bg4803_nashkel_extras.baf~

// ---------------------------------------------------------------------------

// CotSC optional BG1/EET interjections added after the original dialogue resources.
COMPILE ~CotSC/better_immersion_beregost/QCNWAND.baf~
COMPILE ~CotSC/better_immersion_beregost/qc37_nashkel_interjections.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/qc37_nashkel_interjections.tra~
