// ---------------------------------------------------------------------------
// TORM'S HAND - TORMCH / TORMCR FIRST-STAGE GAMEPLAY
// ---------------------------------------------------------------------------

// Restore the frozen TORMCH -> TORMFO route without changing the TORMHA route.
// The existing TORMFO_RETURN region is retargeted from TORMBACK to the new
// dedicated TORMCHBACK entrance created above.
COPY_EXISTING ~TORMCH.ARE~ ~override/TORMCH.ARE~
  READ_LONG 0x5c tormch_reg_off
  READ_SHORT 0x5a tormch_reg_count
  FOR (i = 0; i < tormch_reg_count; ++i) BEGIN
    READ_ASCII (tormch_reg_off + (i * 0xc4)) tormch_reg_name (32)
    PATCH_IF "%tormch_reg_name%" STRING_EQUAL ~TORMFO_RETURN~ BEGIN
      WRITE_ASCII (tormch_reg_off + (i * 0xc4) + 0x40) ~TORMCHBACK~ #32
    END
  END

  // TORMCH -> TORMCR uses the proven native travel-region implementation.
  // This is the same type-2 region that was working before the scripted
  // TriggerActivation experiment was introduced.
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 475
      fj_box_top = 453
      fj_box_right = 515
      fj_box_bottom = 493
      fj_cursor_idx = 34
      fj_flags = 4
      fj_vertex_0 = 475 + (453 << 16)
      fj_vertex_1 = 515 + (453 << 16)
      fj_vertex_2 = 515 + (493 << 16)
      fj_vertex_3 = 475 + (493 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = TORMCR_TRIG
      fj_destination_area = TORMCR
      fj_destination_name = TORMCRIN
  END
BUT_ONLY_IF_IT_CHANGES

// CotSC v62: close the cave entrance after Alma's scroll returns the party.
COMPILE ~CotSC/better_immersion_beregost/TCRSEAL.baf~
COPY_EXISTING ~TORMCH.ARE~ ~override/TORMCH.ARE~
  WRITE_ASCII 0x94 ~TCRSEAL~ #8
BUT_ONLY_IF_IT_CHANGES

// TORMCR is a dungeon. Use the dungeon area flag so the engine treats the
// cavern as a dungeon rather than an outdoor/forest-type area.
// TORMCR dungeon atmosphere. In EET, the BG1 DUNG1 track is appended after the BG2EE song table; DUNG1 is entry 121.
// Keep the existing BG2EE cave battle music (48) for combat.

// Dedicated cavern entry point. TORMCR deliberately receives NO travel region,
// so there is no normal way out until the later Alma/barrier stage is implemented.
COPY_EXISTING ~TORMCR.ARE~ ~override/TORMCR.ARE~
  READ_LONG 0x14 tormcr_flags
  WRITE_LONG 0x14 (tormcr_flags BOR 0x20)
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1378
      fj_loc_y = 183
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name = TORMCRIN
  END

  // Dungeon atmosphere. Dung1 music is slot 121 in EET; keep cave battle music (48).
  READ_LONG 0xBC tormcr_song_off
  WRITE_LONG "%tormcr_song_off%" 121
  WRITE_LONG ("%tormcr_song_off%" + 0x04) 121
  WRITE_LONG ("%tormcr_song_off%" + 0x08) 0
  WRITE_LONG ("%tormcr_song_off%" + 0x0C) 48
  WRITE_LONG ("%tormcr_song_off%" + 0x10) 0
  // AMB_D01A/B are the standard BG1 dungeon ambience pair.
  WRITE_ASCII ("%tormcr_song_off%" + 0x28) ~ ~ #8
  WRITE_ASCII ("%tormcr_song_off%" + 0x30) ~ ~ #8
  WRITE_LONG ("%tormcr_song_off%" + 0x38) 0
  WRITE_ASCII ("%tormcr_song_off%" + 0x3C) ~ ~ #8
  WRITE_ASCII ("%tormcr_song_off%" + 0x44) ~ ~ #8
  WRITE_LONG ("%tormcr_song_off%" + 0x4C) 0

  // Fell Ghasts.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 895
      fj_loc_y = 188
      fj_dest_x = 895
      fj_dest_y = 188
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRFELL1
      fj_cre_resref = GHASTF01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 803
      fj_loc_y = 160
      fj_dest_x = 803
      fj_dest_y = 160
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRFELL2
      fj_cre_resref = GHASTF01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 781
      fj_loc_y = 220
      fj_dest_x = 781
      fj_dest_y = 220
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRFELL3
      fj_cre_resref = GHASTF01
  END

  // Zombies.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 823
      fj_loc_y = 249
      fj_dest_x = 823
      fj_dest_y = 249
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRZOMB1
      fj_cre_resref = ZOMBIE01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 715
      fj_loc_y = 537
      fj_dest_x = 715
      fj_dest_y = 537
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRZOMB2
      fj_cre_resref = ZOMBIE01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 748
      fj_loc_y = 563
      fj_dest_x = 748
      fj_dest_y = 563
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRZOMB3
      fj_cre_resref = ZOMBIE01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 166
      fj_loc_y = 404
      fj_dest_x = 166
      fj_dest_y = 404
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRZOMB4
      fj_cre_resref = ZOMBIE01
  END

  // Ghoul Lord, Ghast, Ghoul.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 229
      fj_loc_y = 164
      fj_dest_x = 229
      fj_dest_y = 164
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRGHOR
      fj_cre_resref = GHOLOR01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 199
      fj_loc_y = 144
      fj_dest_x = 199
      fj_dest_y = 144
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRGHAS
      fj_cre_resref = GHAST01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1351
      fj_loc_y = 536
      fj_dest_x = 1351
      fj_dest_y = 536
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRGHOUL
      fj_cre_resref = GHOUL01
  END

  // Greater Basilisk facing north-east (orientation 10).
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 204
      fj_loc_y = 876
      fj_dest_x = 204
      fj_dest_y = 876
      fj_spawned = 1
      fj_orientation = 10
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRBASIL
      fj_cre_resref = BASILG
