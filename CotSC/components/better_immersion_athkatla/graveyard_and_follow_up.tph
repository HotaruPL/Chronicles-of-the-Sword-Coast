// ---------------------------------------------------------------------------
// GRAVEYARD DISTRICT - AR0800
// ---------------------------------------------------------------------------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0800.ARE~ BEGIN
  FAIL @20337
END

COMPILE ~CotSC/qc_better_immersion_athkatla/dialogue/QCGRA.d~ USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCGRA.tra~

// Suicidal Commoner - male commoner, green/blue palette, no equipment.
COPY_EXISTING ~FARM.CRE~ ~override/QCGSUI.CRE~
  SAY NAME1 @3134
  SAY NAME2 @3134
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QCGSUI~ #8
  WRITE_ASCII 0x280 ~QCGSUI~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  // Green and blue clothing.
  WRITE_BYTE 0x2d 5
  WRITE_BYTE 0x2e 17
  WRITE_BYTE 0x30 5
  WRITE_BYTE 0x31 17
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Daytime-only Elven Mourner.
COPY_EXISTING ~SARELF01.CRE~ ~override/QCGMOUR.CRE~
  SAY NAME1 @3135
  SAY NAME2 @3135
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QCGMOUR~ #8
  WRITE_ASCII 0x280 ~QCGMOUR~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~AR0800.ARE~ ~override~
  // X=2714 Y=900 - Suicidal Commoner, north-east.
  LPF fj_are_structure INT_VAR fj_loc_x=2714 fj_loc_y=900 fj_dest_x=2714 fj_dest_y=900 fj_orientation=10 STR_VAR fj_structure_type=actor fj_name=QCGSUI fj_cre_resref=QCGSUI fj_dlg_resref=QCGSUI END
  // X=1866 Y=1473 - Elven Mourner, north-east. Added last so its actor schedule can be patched below.
  LPF fj_are_structure INT_VAR fj_loc_x=1866 fj_loc_y=1473 fj_dest_x=1866 fj_dest_y=1473 fj_orientation=10 STR_VAR fj_structure_type=actor fj_name=QCGMOUR fj_cre_resref=QCGMOUR fj_dlg_resref=QCGMOUR END
  // Actor records are 0x110 bytes. The mourner is the actor just appended above.
  // Enable only bits 6-19: 06:30 through 20:29. He therefore disappears at night.
  READ_LONG 0x54 qc80_actor_offset
  READ_SHORT 0x58 qc80_actor_count
  WRITE_LONG (qc80_actor_offset + ((qc80_actor_count - 1) * 0x110) + 0x40) 0x000fffc0
BUT_ONLY_IF_IT_CHANGES

// ---------------------------------------------------------------------------
// DOCKS DISTRICT - AR0300 + AR0313
// Final district pass. All new resources use QC prefixes.
// ---------------------------------------------------------------------------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0300.ARE~ BEGIN
  FAIL @20338
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0313.ARE~ BEGIN
  FAIL @20339
END

COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCEULIA.baf~
COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCGERAI.baf~
ADD_JOURNAL TITLE (@1) @2 @3 @4 @5 USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCDOCK.tra~
COMPILE ~CotSC/qc_better_immersion_athkatla/dialogue/QCDOCK.d~ USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCDOCK.tra~

