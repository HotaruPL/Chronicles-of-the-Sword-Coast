LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_bg1_towns_carnivals.tra~

// Amnian Guards — retain armor/equipment, neutral until they see an enemy.
COPY_EXISTING ~AMNIS4.CRE~ ~override/BICGRD01.CRE~
  SAY NAME1 @1044
  SAY NAME2 @1044
  WRITE_ASCII 0x2cc ~BICGRD01~ #8
  WRITE_ASCII 0x280 ~BICGRD01~ #32
  WRITE_ASCII 0x248 ~BICGRDSC~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
BUT_ONLY_IF_IT_CHANGES

