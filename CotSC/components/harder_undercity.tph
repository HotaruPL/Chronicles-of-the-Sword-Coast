// BG0123 Undercity creature placements.
EXTEND_BOTTOM ~BG0123.BCS~ ~CotSC/harder_undercity/BG0123_QCHU.baf~

// BG0125 Kazhmira placement.
EXTEND_BOTTOM ~BG0125.BCS~ ~CotSC/harder_undercity/BG0125_QCHU.baf~

// Kazhmira is a direct adaptation of Dark Horizons' Isolde creature.
// Preserve Isolde's original thief AI: SHOUT remains the override script and
// WTARSGT remains the general/default combat AI. A separate class script is
// used only to make the invisibility behaviour reliable with the three
// supplied potions; it does not replace WTARSGT.
COPY ~CotSC/harder_undercity/creatures/qckazhm_base.cre~ ~override/QCKAZHM.CRE~
  SAY NAME1 @5023
  SAY NAME2 @5023
  WRITE_ASCII 0x248 ~SHOUT~ #8
  WRITE_ASCII 0x250 ~QCKAZHM~ #8
  WRITE_ASCII 0x260 ~WTARSGT~ #8
  WRITE_ASCII 0x268 ~WTARSGT~ #8
  WRITE_ASCII 0x280 ~QCKAZHM~ #32
  WRITE_ASCII 0x2cc ~~ #8
  WRITE_BYTE 0x270 255
  WRITE_BYTE 0x2e 5
  // Raise Kazhmira to 11th level and give her a substantially larger HP pool.
  WRITE_BYTE 0x234 11
  WRITE_SHORT 0x24 70
  WRITE_SHORT 0x26 70
  REPLACE_CRE_ITEM ~SW1H10~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~POTN10~ #1 #0 #0 ~IDENTIFIED~ ~QITEM2~
  ADD_CRE_ITEM ~POTN10~ #1 #0 #0 ~IDENTIFIED~ ~QITEM3~
  ADD_CRE_ITEM ~POTN10~ #1 #0 #0 ~IDENTIFIED~ ~INV1~

// No Dark Horizons component is required at runtime. The bundled Isolde CRE
// is build material only and is transformed into QCKAZHM.CRE above.

COMPILE ~CotSC/harder_undercity/QCKAZHM.BAF~
