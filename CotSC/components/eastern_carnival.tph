  WRITE_LONG (0x0a4 + (93 * 4)) %mummy_sound_93%
  WRITE_LONG (0x0a4 + (94 * 4)) %mummy_sound_94%
  WRITE_LONG (0x0a4 + (95 * 4)) %mummy_sound_95%
  WRITE_LONG (0x0a4 + (96 * 4)) %mummy_sound_96%
  WRITE_LONG (0x0a4 + (97 * 4)) %mummy_sound_97%
  WRITE_LONG (0x0a4 + (98 * 4)) %mummy_sound_98%
  WRITE_LONG (0x0a4 + (99 * 4)) %mummy_sound_99%
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~QCTENT01.ARE~ ~override/QCTENT01.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 252
      fj_loc_y       = 228
      fj_dest_x      = 252
      fj_dest_y      = 228
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name           = QCZARA
      fj_dlg_resref     = QCZARA
      fj_cre_resref     = QCZARA
  END
  BUT_ONLY_IF_IT_CHANGES

// Clear the three existing QCTENT01 containers, then refill two of them.
// Container 1: 11 gold coins. Container 2: empty. Container 3: History of Amn.
COPY_EXISTING ~QCTENT01.ARE~ ~override/QCTENT01.ARE~
  LPF DELETE_AREA_ITEM
    STR_VAR item_to_delete = ~.*~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 1
      charges1 = 11
    STR_VAR
      item_to_add = ~MISC07~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 3
    STR_VAR
      item_to_add = ~BOOK45~
  END
  BUT_ONLY_IF_IT_CHANGES

// Zara's merchant inventory.
COPY_EXISTING ~QCFERGIE.STO~ ~override/QCZARA.STO~
  LPF DELETE_STORE_ITEM
    STR_VAR item_to_delete = ~.*~
  END
  ADD_STORE_ITEM ~GBERRY~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~SCRL5L~ #1 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~SCRL5M~ #1 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~WAND08~ #50 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~WAND09~ #50 #0 #0 ~IDENTIFIED~ #1
BUT_ONLY_IF_IT_CHANGES

// Sandrine in BG4900 reveals the custom Eastern Carnival on the world map.
// Stock EET registration is performed only when BP-BGT Worldmap is not yet
// installed. BP-BGT Worldmap builds its own QCCARN entry from CotSC tables.
// Sandrine's translated dialogue also enables all required travel flags.
COPY_EXISTING ~LANTAN.CRE~ ~override/QCSANDRI.CRE~
  SAY NAME1 @1015
  SAY NAME2 @1015
  WRITE_ASCII 0x2cc ~QCSANDRI~ #8
  WRITE_ASCII 0x280 ~QCSANDRI~ #32
  WRITE_ASCII 0x248 ~QCSANDRI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Sandrine approaches the party in BG4900 when she sees them.
COPY_EXISTING ~BG4900.ARE~ ~override/BG4900.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 2966
      fj_loc_y       = 3233
      fj_dest_x      = 2966
      fj_dest_y      = 3233
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name           = QCSANDRI
      fj_dlg_resref     = QCSANDRI
      fj_bcs_override   = QCSANDRI
      fj_cre_resref     = QCSANDRI
  END
  BUT_ONLY_IF_IT_CHANGES

// Add the custom Eastern Carnival to the EET/BG1 world map.
// The actual Nashkel Carnival worldmap area in this EET WMP is BG4900.
// QCCARN is reached through its Exitwmp entrance; returning from QCCARN
// uses the existing BG4900 entrance CDWestExit.
ACTION_DEFINE_ASSOCIATIVE_ARRAY toNewArea BEGIN
  "BG4900" => "Exitwmp"
END
ACTION_DEFINE_ASSOCIATIVE_ARRAY fromNewArea BEGIN
  "BG4900" => "CDWestExit"
END
// Keep the stock EET WMP update when BP-BGT Worldmap is absent.
// Once BP-BGT Worldmap is installed, only its own built WMP and the CotSC
// registration tables should control QCCARN (avoid stock-map coordinates).
ACTION_IF MOD_IS_INSTALLED ~bp-bgt-worldmap/setup-bp-bgt-worldmap.tp2~ 0 BEGIN
  PRINT @20013
END ELSE BEGIN
  OUTER_SPRINT qc_wm_qccarn_name @19000
  OUTER_SPRINT qc_wm_qccarn_desc @19000
  LAUNCH_ACTION_FUNCTION sc#addWmpAre
    INT_VAR
      mapIcon         = 72
      xCoord          = 1150
      yCoord          = 2072
      tTime           = 0
      inclSv          = 1
      visible         = 0
      visibleAdjacent = 0
      reachable       = 0
      visited         = 0
    STR_VAR
      areName         = ~QCCARN~
      strName         = EVAL ~%qc_wm_qccarn_name%~
      strDesc         = EVAL ~%qc_wm_qccarn_desc%~
  END
END

// World-map arrival entrance. This is a new entrance only; existing Carnival
// transitions and collision are untouched.
COPY_EXISTING ~QCCARN.ARE~ ~override/QCCARN.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 393
      fj_loc_y       = 1877
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name           = Exitwmp
  END
  BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/Quests_and_Challenges/Eastern_Carnival/qccarncol/qcsandri.baf~
COMPILE ~CotSC/Quests_and_Challenges/Eastern_Carnival/qccarncol/qcsandri.d~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/Eastern_Carnival/qccarncol/qcsandri.tra~

// Virage - a polymorphed illusionist trapped in cat form inside QCTENT04.
// His human form is based on ARKION; his initial animation is copied from CAT.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~ARKION.CRE~ BEGIN
  FAIL @20014
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~CAT.CRE~ BEGIN
  FAIL @20015
END

COPY_EXISTING ~ARKION.CRE~ ~override/QCVIRAGE.CRE~
  SAY NAME1 @1016
  SAY NAME2 @1016
  WRITE_ASCII 0x2cc ~QCVIRAGE~ #8
  WRITE_ASCII 0x280 ~QCVIRAGE~ #32
  WRITE_ASCII 0x248 ~QCVIRAGE~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  INNER_PATCH_FILE ~CAT.CRE~ BEGIN
    READ_LONG 0x28 virage_cat_animation
  END
  WRITE_LONG 0x28 %virage_cat_animation%
BUT_ONLY_IF_IT_CHANGES

// Place Virage where the original merchant stood inside the supplied BG4905 interior.
COPY_EXISTING ~QCTENT04.ARE~ ~override/QCTENT04.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 290
      fj_loc_y       = 250
      fj_dest_x      = 290
      fj_dest_y      = 250
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name           = QCVIRAGE
      fj_dlg_resref     = QCVIRAGE
      fj_cre_resref     = QCVIRAGE
  END
  BUT_ONLY_IF_IT_CHANGES

// Stable return point for QCCARN's lower-left exit. The prior exit pointed
// at CDWestExit, which isn't added or guaranteed to exist in BG4900. Create
// our own destination so the region never resolves a missing entrance.
COPY_EXISTING ~BG4900.ARE~ ~override/BG4900.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 784
      fj_loc_y       = 3643
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name           = QCCRET
  END
  BUT_ONLY_IF_IT_CHANGES

// SAFE RETURN TO NASHKEL CARNIVAL
// Do not create custom QCCARN -> world-map edge regions. Those regions have
// repeatedly crashed the EET engine when clicked. Instead, QCCARN returns
// to the normal Nashkel Carnival area. The player can use BG4900's existing
// world-map travel from there. This keeps the QCCARN world-map entry/reveal
// intact while avoiding the unstable custom edge-region mechanism.
COPY_EXISTING ~QCCARN.ARE~ ~override/QCCARN.ARE~
  // Remove the inherited, unregistered southern BG5100 world-map connection.
  // The working eastern route is left untouched, as is the lower-left region.
  WRITE_ASCII 0x30 ~~ #8
  WRITE_LONG  0x38 0
  LPF fj_are_structure
    INT_VAR
      fj_type       = 2
      fj_box_left   = 641
      fj_box_top    = 1987
      fj_box_right  = 737
      fj_box_bottom = 2083
      fj_cursor_idx = 34
      fj_flags      = 4
      fj_vertex_0   = 641 + (1987 << 16)
      fj_vertex_1   = 737 + (1987 << 16)
      fj_vertex_2   = 737 + (2083 << 16)
      fj_vertex_3   = 641 + (2083 << 16)
    STR_VAR
      fj_structure_type  = region
      fj_name            = QCCARN_RETURN
      fj_destination_area = BG4900
      fj_destination_name = QCCRET
  END
  BUT_ONLY_IF_IT_CHANGES

// QCTENT04 already has a dedicated QCCARN return entrance in the supplied ARE.
// Keep QCCARN's original TENT03 entrance intact for the outbound transition.

COMPILE ~CotSC/Quests_and_Challenges/Eastern_Carnival/qccarncol/qcvirage.baf~
COMPILE ~CotSC/Quests_and_Challenges/Eastern_Carnival/qccarncol/qcvirage.d~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/Eastern_Carnival/qccarncol/qc_carn_quests.tra~

COMPILE ~CotSC/Quests_and_Challenges/Eastern_Carnival/qccarncol/qczara.d~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/Eastern_Carnival/qccarncol/qczara.tra~
