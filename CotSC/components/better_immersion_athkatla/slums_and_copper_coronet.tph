COPY_EXISTING ~AR0400.ARE~ ~override~
  // X=2026 Y=2889 - Orc Beggar, north.
  LPF fj_are_structure INT_VAR fj_loc_x=2026 fj_loc_y=2889 fj_dest_x=2026 fj_dest_y=2889 fj_orientation=8 STR_VAR fj_structure_type=actor fj_name=QC40OBEG fj_cre_resref=QC40OBEG fj_dlg_resref=QC40OBEG END
  // X=285 Y=2580 - Kobold Commoner, east.
  LPF fj_are_structure INT_VAR fj_loc_x=285 fj_loc_y=2580 fj_dest_x=285 fj_dest_y=2580 fj_orientation=12 STR_VAR fj_structure_type=actor fj_name=QC40KOB fj_cre_resref=QC40KOB fj_dlg_resref=QC40KOB END
  // X=495 Y=1674 - Gnoll Commoner, south-west.
  LPF fj_are_structure INT_VAR fj_loc_x=495 fj_loc_y=1674 fj_dest_x=495 fj_dest_y=1674 fj_orientation=2 STR_VAR fj_structure_type=actor fj_name=QC40GNOL fj_cre_resref=QC40GNOL fj_dlg_resref=QC40GNOL END
  // X=314 Y=962 - weaponless Orc, south.
  LPF fj_are_structure INT_VAR fj_loc_x=314 fj_loc_y=962 fj_dest_x=314 fj_dest_y=962 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC40ORC fj_cre_resref=QC40ORC fj_dlg_resref=QC40ORC END
  // X=1302 Y=700 - Gnome Commoner, east.
  LPF fj_are_structure INT_VAR fj_loc_x=1302 fj_loc_y=700 fj_dest_x=1302 fj_dest_y=700 fj_orientation=12 STR_VAR fj_structure_type=actor fj_name=QC40GNOM fj_cre_resref=QC40GNOM fj_dlg_resref=QC40GNOM END
  // X=3050 Y=1764 - Elven Beggar, east.
  LPF fj_are_structure INT_VAR fj_loc_x=3050 fj_loc_y=1764 fj_dest_x=3050 fj_dest_y=1764 fj_orientation=12 STR_VAR fj_structure_type=actor fj_name=QC40EBEG fj_cre_resref=QC40EBEG fj_dlg_resref=QC40EBEG END
  // X=3458 Y=2105 - Aggressive Dog, north. Starts neutral; dialogue turns it hostile.
  LPF fj_are_structure INT_VAR fj_loc_x=3458 fj_loc_y=2105 fj_dest_x=3458 fj_dest_y=2105 fj_orientation=8 STR_VAR fj_structure_type=actor fj_name=QC40DOG fj_cre_resref=QC40DOG fj_dlg_resref=QC40DOG fj_bcs_override=QCAHOST END
  // X=2925 Y=1895 - Dwarf Commoner.
  LPF fj_are_structure INT_VAR fj_loc_x=2925 fj_loc_y=1895 fj_dest_x=2925 fj_dest_y=1895 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC40DWAR fj_cre_resref=QC40DWAR fj_dlg_resref=QC40DWAR END
  // X=1046 Y=1939 - Halfling Commoner.
  LPF fj_are_structure INT_VAR fj_loc_x=1046 fj_loc_y=1939 fj_dest_x=1046 fj_dest_y=1939 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC40HALF fj_cre_resref=QC40HALF fj_dlg_resref=QC40HALF END
BUT_ONLY_IF_IT_CHANGES

// ---------------------------------------------------------------------------
// COPPER CORONET - AR0406
// ---------------------------------------------------------------------------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0406.ARE~ BEGIN
  FAIL @20325
END

// Requested ENDER-based Elven Warrior. Preserve ENDER's normal equipment and
// add/select a standard scimitar plus dagger off-hand.
COPY_EXISTING ~ENDER.CRE~ ~override/QC46ELF.CRE~
  SAY NAME1 @3117
  SAY NAME2 @3117
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QC46ELF~ #8
  WRITE_ASCII 0x280 ~QC46ELF~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  ADD_CRE_ITEM ~SW1H20~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~DAGG01~ #0 #0 #0 ~IDENTIFIED~ ~SHIELD~
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

