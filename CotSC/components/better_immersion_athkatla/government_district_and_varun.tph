COPY_EXISTING ~AR1000.ARE~ ~override~
  // X=2767 Y=615 - roaming female Halfling.
  LPF fj_are_structure INT_VAR fj_loc_x=2767 fj_loc_y=615 fj_dest_x=2767 fj_dest_y=615 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC10HAL fj_cre_resref=QC10HAL fj_dlg_resref=QC10HAL fj_bcs_override=QCAWAND END
  // X=3074 Y=1434 - Varun.
  LPF fj_are_structure INT_VAR fj_loc_x=3074 fj_loc_y=1434 fj_dest_x=3074 fj_dest_y=1434 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC10VAR fj_cre_resref=QC10VAR fj_dlg_resref=QCVVARUN END
  // X=463 Y=1346 - Kobold Commoner, south-west.
  LPF fj_are_structure INT_VAR fj_loc_x=463 fj_loc_y=1346 fj_dest_x=463 fj_dest_y=1346 fj_orientation=2 STR_VAR fj_structure_type=actor fj_name=QC10KOB fj_cre_resref=QC10KOB fj_dlg_resref=QC10KOB END
  // X=1806 Y=3033 - Nobleman, north-east.
  LPF fj_are_structure INT_VAR fj_loc_x=1806 fj_loc_y=3033 fj_dest_x=1806 fj_dest_y=3033 fj_orientation=10 STR_VAR fj_structure_type=actor fj_name=QC10NOB fj_cre_resref=QC10NOB fj_dlg_resref=QC10NOB END
  // X=1825 Y=3020 - Noblewoman, south-west.
  LPF fj_are_structure INT_VAR fj_loc_x=1825 fj_loc_y=3020 fj_dest_x=1825 fj_dest_y=3020 fj_orientation=2 STR_VAR fj_structure_type=actor fj_name=QC10NOL fj_cre_resref=QC10NOL fj_dlg_resref=QC10NOL END
  // X=4140 Y=3459 - brown-palette Half-Elf.
  LPF fj_are_structure INT_VAR fj_loc_x=4140 fj_loc_y=3459 fj_dest_x=4140 fj_dest_y=3459 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC10HLF fj_cre_resref=QC10HLF fj_dlg_resref=QC10HLF END
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~AR1005.ARE~ ~override~
  // X=670 Y=837 - Hobgoblin Prisoner.
  LPF fj_are_structure INT_VAR fj_loc_x=670 fj_loc_y=837 fj_dest_x=670 fj_dest_y=837 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC10PRS fj_cre_resref=QC10PRS fj_dlg_resref=QC10PRS END
