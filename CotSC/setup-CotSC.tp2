BEGIN @6002

REQUIRE_PREDICATE
  GAME_IS ~eet~
  @1

LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/Setup.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0705.BCS~ BEGIN
  FAIL @40
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BANDIT.CRE~ BEGIN
  FAIL @42
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~MISC97.ITM~ BEGIN
  FAIL @46
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~KEY01.ITM~ BEGIN
  FAIL @45
END

// Remove the old nine-character Nebbish resource from earlier prototypes, if present.
ACTION_IF FILE_EXISTS_IN_GAME ~QCNEBBISH.CRE~ BEGIN
  DELETE ~override/QCNEBBISH.CRE~
END

// Fresh Nebbish: eight-character CRE resref, copied directly from the known-working male BANDIT base.
COPY_EXISTING ~BANDIT.CRE~ ~override/QCNBBISH.CRE~
  SAY NAME1 @26
  SAY NAME2 @26
  WRITE_ASCII 0x2cc ~QCNBBISH~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCNBBISH_DEAD~ #32

COPY_EXISTING ~BANDIT.CRE~ ~override/QCETHON.CRE~
  SAY NAME1 @27
  SAY NAME2 @27
  WRITE_ASCII 0x2cc ~QCETHON~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~QCNKEY~ #0 #0 #0 ~IDENTIFIED~ ~INV~
  WRITE_ASCII 0x280 ~QCETHON_DEAD~ #32

// Nebbish cellar key has its own resource; Auntie Ethel retains QCEKEY.
COPY_EXISTING ~KEY01.ITM~ ~override/QCNKEY.ITM~
  SAY NAME1 @28
  SAY NAME2 @28
  SAY DESC @29

COPY_EXISTING ~POTN08.ITM~ ~override/QCCORMYR.ITM~
  SAY NAME1 @30
  SAY NAME2 @30
  SAY DESC @31
  WRITE_SHORT 0x1c 9
  LPF ADD_ITEM_EFFECT
    INT_VAR
      opcode = 49
      target = 1
      timing = 1
      parameter1 = 1
      parameter2 = 0
      header = 1
      type = 3
  END

COMPILE ~CotSC/Quests_and_Challenges/DLG/QCNBBISH.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCNBBISH.TRA~
COMPILE ~CotSC/Quests_and_Challenges/DLG/QCETHON.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCETHON.TRA~

ADD_JOURNAL TITLE (@23) @24 @25 USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCNBBISH.TRA~

EXTEND_TOP ~BG0705.BCS~ ~CotSC/Quests_and_Challenges/AREA/BG0705.baf~


BEGIN @6003

REQUIRE_PREDICATE
  GAME_IS ~eet~
  @32

LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCWIZSHD.TRA~

// Required resources are native to the EET game. COPY_EXISTING below will
// fail normally if a required resource is unavailable; no preflight ACTION_IF
// checks are needed here.
// Wizshade: based on the stable Vampiric Mist chassis.
// The old mist's weapon is removed so it cannot level-drain the party.
// RING95 is retained as a hidden source of immunity to normal weapons and several
// undead protections. Magic resistance is set to 25%, matching the classic lore.
COPY_EXISTING ~MISTVA01.CRE~ ~override/QCWIZSHD.CRE~
  SAY NAME1 @1
  SAY NAME2 @1
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x248 ~QCWIZSHD~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 255
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~RING95~ #0 #0 #0 ~IDENTIFIED~ ~RRING~
  ADD_MEMORIZED_SPELL ~SPWI112~ #0 ~wizard~ ( 2 )
  ADD_MEMORIZED_SPELL ~SPWI116~ #0 ~wizard~ ( 1 )
  ADD_MEMORIZED_SPELL ~SPWI118~ #0 ~wizard~ ( 1 )
  ADD_MEMORIZED_SPELL ~SPWI212~ #1 ~wizard~ ( 1 )
  LPF ADD_CRE_EFFECT
    INT_VAR
      opcode = 166
      target = 1
      timing = 1
      parameter1 = 25
      parameter2 = 0
      probability1 = 100
  END
  WRITE_ASCII 0x280 ~QCWIZSHD_DEAD~ #32

// Cedric Shan: rebuilt as a clean, standalone male elf CRE.
// KIVAN.CRE is used only as a binary chassis for a valid EET CRE; all
// NPC-specific script/dialogue resources are explicitly cleared and replaced.
LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCCEDRIC.TRA~
// Reuse ORDULI appearance only; preserve Cedric equipment, statistics, dialogue, AI.
COPY_EXISTING ~ORDULI.CRE~ ~override~
  READ_LONG 0x28 qc_cedric_animation
  FOR (qc_cedric_color = 0; qc_cedric_color < 7; qc_cedric_color += 1) BEGIN
    READ_BYTE (0x2c + qc_cedric_color) qc_cedric_palette_value
    SET $qc_cedric_palette("%qc_cedric_color%") = qc_cedric_palette_value
  END
COPY_EXISTING ~KIVAN.CRE~ ~override/QCCEDRIC.CRE~
  WRITE_LONG 0x28 qc_cedric_animation
  FOR (qc_cedric_color = 0; qc_cedric_color < 7; qc_cedric_color += 1) BEGIN
    WRITE_BYTE (0x2c + qc_cedric_color) $qc_cedric_palette("%qc_cedric_color%")
  END
  SAY NAME1 @2
  SAY NAME2 @2
  WRITE_ASCII 0x2cc ~QCCEDRIC~ #8
  WRITE_ASCII 0x248 ~QCCEDRIC~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x271 0
  WRITE_BYTE 0x272 2
  WRITE_BYTE 0x273 12
  WRITE_BYTE 0x274 0
  WRITE_BYTE 0x275 1
  WRITE_BYTE 0x27b 0x12
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~PLAT06~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~ EQUIP
  ADD_CRE_ITEM ~BOW03~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  WRITE_ASCII 0x280 ~QCCEDRIC_DEAD~ #32

COMPILE ~CotSC/Quests_and_Challenges/DLG/QCCEDRIC.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCCEDRIC.TRA~
COMPILE ~CotSC/Quests_and_Challenges/AREA/QCCEDRIC.BAF~
COMPILE ~CotSC/Quests_and_Challenges/AREA/QCWIZSHD.BAF~

EXTEND_TOP ~BG3900.BCS~ ~CotSC/Quests_and_Challenges/AREA/BG3900.baf~


BEGIN @6004

REQUIRE_PREDICATE
  GAME_IS ~eet~
  @32

LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCPPOPER.TRA~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG4900.ARE~ BEGIN
  FAIL @34
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~KOBOLD.CRE~ BEGIN
  FAIL @35
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~MISC9Y.ITM~ BEGIN
  FAIL @36
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BOOT02.ITM~ BEGIN
  FAIL @37
END

// Popper: clean neutral kobold merchant based on the native kobold chassis.
COPY_EXISTING ~KOBOLD.CRE~ ~override/QCPPOPER.CRE~
  SAY NAME1 @5001
  SAY NAME2 @5001
  WRITE_ASCII 0x2cc ~QCPPOPER~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_SHORT 0x244 0x4000
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCPPOPER_DEAD~ #32

// Potion of Clear Consiousness: Brine Potion mechanics, new name and description.
COPY_EXISTING ~MISC9Y.ITM~ ~override/QCPCLEAR.ITM~
  SAY NAME1 @8
  SAY NAME2 @8
  SAY DESC @11

// Boots of NightCrawler: based on Boots of Stealth, retaining its native +15 Hide in Shadows
// and adding another +15 Hide in Shadows plus +10 Set Traps. The resulting in-game bonus is +30 Hide in Shadows.
COPY_EXISTING ~BOOT02.ITM~ ~override/QCPNIGHT.ITM~
  SAY NAME1 @9
  SAY NAME2 @9
  SAY DESC @12
  LPF DELETE_ITEM_EQEFFECT INT_VAR opcode_to_delete = 59 END
  LPF ADD_ITEM_EQEFFECT
    INT_VAR opcode = 275 target = 1 timing = 2 parameter1 = 15 parameter2 = 0
  END
  LPF ADD_ITEM_EQEFFECT
    INT_VAR opcode = 277 target = 1 timing = 2 parameter1 = 10 parameter2 = 0
  END

// Gloves 'Beautification': +5 Charisma while equipped.
// BRAC07 provides a wearable hand-slot chassis in the EE item system.
COPY_EXISTING ~BRAC07.ITM~ ~override/QCPBEAUT.ITM~
  SAY NAME1 @10
  SAY NAME2 @10
  SAY DESC @13
  LPF ADD_ITEM_EQEFFECT
    INT_VAR opcode = 6 target = 1 timing = 2 parameter1 = 5 parameter2 = 0
  END

// Popper's dedicated shop. STO4901 is a native Nashkel Carnival shop chassis.
// Clear its sale list first so Popper does not inherit another merchant's stock.
COPY_EXISTING ~STO4901.STO~ ~override/QCPPOPST.STO~
  REMOVE_STORE_ITEM ~.+~
  ADD_STORE_ITEM ~POTN08~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN52~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN20~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN02~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN27~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN45~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN09~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN10~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN37~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN14~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN04~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~QUIVER01~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~QCPCLEAR~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~QCPNIGHT~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~QCPBEAUT~ #0 #0 #0 ~IDENTIFIED~ #1

COMPILE ~CotSC/Quests_and_Challenges/DLG/QCPPOPER.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCPPOPER.TRA~

// Add Popper to BG4900 at the requested coordinates, facing NE (orientation 10).
COPY_EXISTING ~BG4900.ARE~ ~override/BG4900.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 2495
      fj_loc_y = 3260
      fj_dest_x = 2495
      fj_dest_y = 3260
      fj_spawned = 1
      fj_orientation = 10
    STR_VAR
      fj_structure_type = actor
      fj_name = Popper
      fj_cre_resref = QCPPOPER
      fj_dlg_resref = QCPPOPER
  END



BEGIN @6005

REQUIRE_PREDICATE
  GAME_IS ~eet~
  @32

LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/Setup.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG2302.BCS~ BEGIN
  FAIL @38
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~NATASH.CRE~ BEGIN
  FAIL @39
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~WAND11.ITM~ BEGIN
  FAIL @110
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~HALBAZ.DLG~ BEGIN
  FAIL @111
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~DYNAHJ.DLG~ BEGIN
  FAIL @43
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~EDWINJ_.DLG~ BEGIN
  FAIL @46
END

LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCCALPHY.TRA~

// Adding CD_STATE_NOTVALID for dialogue validity checks before Alphyra dialogue is compiled.
APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~ UNLESS ~CD_STATE_NOTVALID~

// Alphyra's voice only: borrow the 100 CRE sound-slot strrefs from a normal BG1
// female commoner. The original commoner and Natash CREs are never altered.
// Alphyra keeps Natash's appearance, animations, stats, spells and scripts.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~FTOWBE_B.CRE~ BEGIN
  FAIL @20000
END
COPY_EXISTING ~FTOWBE_B.CRE~ ~override~
  FOR (qc_alphy_voice_slot = 0; qc_alphy_voice_slot < 100; qc_alphy_voice_slot += 1) BEGIN
    READ_LONG (0xa4 + (qc_alphy_voice_slot * 4)) qc_alphy_voice_strref
    SET $qc_alphyra_commoner_voice("%qc_alphy_voice_slot%") = qc_alphy_voice_strref
  END
  BUT_ONLY_IF_IT_CHANGES

// Create Alphyra from the native Natash CRE, but keep all resource references within the 8-character engine limit.
COPY_EXISTING ~NATASH.CRE~ ~override/QCCALPHY.CRE~
  // The CRE 0xa4..0x233 soundset block only; leave every other CRE field alone.
  FOR (qc_alphy_voice_slot = 0; qc_alphy_voice_slot < 100; qc_alphy_voice_slot += 1) BEGIN
    WRITE_LONG (0xa4 + (qc_alphy_voice_slot * 4)) $qc_alphyra_commoner_voice("%qc_alphy_voice_slot%")
  END
  SAY NAME1 @33
  SAY NAME2 @33
  WRITE_ASCII 0x2cc ~QCCALPHY~ #8
  WRITE_ASCII 0x248 ~QCCALPHY~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCCALPHY_DEAD~ #32

COMPILE ~CotSC/Quests_and_Challenges/DLG/QCCALPHY.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCCALPHY.TRA~

// Associate each stage with one active/completed EE quest.
ADD_JOURNAL TITLE (@38) @35 @39 @36 USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCCALPHY.TRA~

// Spawn Alphyra through the area script rather than modifying BG2302.ARE. This avoids altering the native actor table.
EXTEND_BOTTOM ~BG2302.BCS~ ~CotSC/Quests_and_Challenges/AREA/QCCALPHY.BAF~

