LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_bg2_quests_and_districts.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0700.ARE~ BEGIN
  FAIL @20321
END

// ---------------------------------------------------------------------------
// WAUKEEN'S PROMENADE - AR0700
// All new resources use the QC prefix.
// ---------------------------------------------------------------------------

COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCAWAND.baf~
COMPILE ~CotSC/qc_better_immersion_athkatla/dialogue/QCAWAUK.d~ USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCAWAUK.tra~
COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCAHOST.baf~
COMPILE ~CotSC/qc_better_immersion_athkatla/dialogue/QCASLUM.d~ USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCASLUM.tra~

// Gnome Commoner - BENTLY chassis.
COPY_EXISTING ~BENTLY.CRE~ ~override/QCAWGNO.CRE~
  SAY NAME1 @3105
  SAY NAME2 @3105
  WRITE_ASCII 0x2cc ~QCAWGNO~ #8
  WRITE_ASCII 0x280 ~QCAWGNO~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

