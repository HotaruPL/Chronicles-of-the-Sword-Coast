      fj_loc_x = 1426
      fj_loc_y = 525
      fj_dest_x = 1426
      fj_dest_y = 525
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRSHAD1
      fj_cre_resref = SHADOW01
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1397
      fj_loc_y = 548
      fj_dest_x = 1397
      fj_dest_y = 548
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRSHAD2
      fj_cre_resref = SHADOW01
  END

  // Isaac Wildflame, based on the BG1 Magreb CRE.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1020
      fj_loc_y = 524
      fj_dest_x = 1020
      fj_dest_y = 524
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = TCRISAC
      fj_cre_resref = TCRISAC
      fj_dlg_resref = TCRISAC
  END

  // Asmodeus symbol interaction: use a native ARE door object as the click target.
  // The door is intentionally tiny and has no visual door resource; its native
  // door cursor is used only as the interaction cue at the symbol.
  LPF fj_are_structure
    INT_VAR
      fj_flags = 0x00000180
      fj_open_box_left = 1118
      fj_open_box_top = 807
      fj_open_box_right = 1164
      fj_open_box_bottom = 853
      fj_closed_box_left = 1118
      fj_closed_box_top = 807
      fj_closed_box_right = 1164
      fj_closed_box_bottom = 853
      fj_cursor_idx = 34
      fj_trap_loc_x = 1141
      fj_trap_loc_y = 830
      fj_open_loc_x = 1141
      fj_open_loc_y = 830
      fj_closed_loc_x = 1141
      fj_closed_loc_y = 830
      fj_door_open_vert_0 = 1118 + (807 << 16)
      fj_door_open_vert_1 = 1164 + (807 << 16)
      fj_door_open_vert_2 = 1164 + (853 << 16)
      fj_door_open_vert_3 = 1118 + (853 << 16)
      fj_door_closed_vert_0 = 1118 + (807 << 16)
      fj_door_closed_vert_1 = 1164 + (807 << 16)
      fj_door_closed_vert_2 = 1164 + (853 << 16)
      fj_door_closed_vert_3 = 1118 + (853 << 16)
    STR_VAR
      fj_structure_type = door
      fj_name = TCRASMOD
      fj_door_wed_id = ~ ~
      fj_door_script = TCRDOOR
  END

  // Invisible type-0 trigger directly overlaps the hidden door. The door
  // supplies the gear cursor; this region supplies the reliable Clicked()
  // event without requiring a WED door entry.
  LPF fj_are_structure
    INT_VAR
      fj_type = 0
      fj_box_left = 1118
      fj_box_top = 807
      fj_box_right = 1164
      fj_box_bottom = 853
      fj_cursor_idx = 34
      fj_flags = 0x40
      fj_vertex_0 = 1118 + (807 << 16)
      fj_vertex_1 = 1164 + (807 << 16)
      fj_vertex_2 = 1164 + (853 << 16)
      fj_vertex_3 = 1118 + (853 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = TCRASMODR
      fj_reg_script = TCRDOOR
  END


// After Alma's death the cave entrance is sealed from TORMCH; no TORMCR return route is installed.

// The existing interjection pattern uses this shared validity-state symbol.
// Define it before compiling the new TORMCR dialogue; the later existing APPEND
// remains in place for the tavern dialogue and is harmless because of UNLESS.
APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~ UNLESS ~CD_STATE_NOTVALID~

// Unique modified creature resources used by the TORMCR actors above.
COPY_EXISTING ~DAITEL.CRE~ ~override/TCRGHOST.CRE~
  SAY NAME1 @2068
  SAY NAME2 @2068
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x248 ~TCRGHST~ #8
  WRITE_BYTE 0x270 255
  WRITE_BYTE 0x2d8 255
  REMOVE_MEMORIZED_SPELL ~SPWI505~
  ADD_CRE_ITEM ~CLCK16~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/better_immersion_beregost/tcrghost.baf~

COPY_EXISTING ~NEMAGREB.CRE~ ~override/TCRISAC.CRE~
  SAY NAME1 @2069
  SAY NAME2 @2069
  // Non-hostile Isaac must survive accidental attacks and remain available for
  // the Torm's Hand quest. Existing hostility option and all AI are untouched.
  READ_LONG 0x96 qc_isaac_attributes
  WRITE_LONG 0x96 (qc_isaac_attributes BOR 0x200) // CRE attribute: Invulnerable
  WRITE_ASCII 0x280 ~TCRISAC~ #32
  WRITE_ASCII 0x2cc ~TCRISAC~ #8
BUT_ONLY_IF_IT_CHANGES

// Alma's escape scroll. Use MISCA5 as the physical template so the item
// keeps the normal miscellaneous/scroll presentation and is usable by anyone.
// The item does NOT try to MoveToArea directly. Instead, using it sets a
// short global flag; the TORMCR area script then performs an exact party
// teleport with LeaveAreaLUA to the validated TORMFO entrance point.
COPY_EXISTING ~MISCA5.ITM~ ~override/TCRSCROL.ITM~
  SAY NAME1 @2070
  SAY NAME2 @2070
  SAY DESC @2071
  LPF DELETE_ITEM_EFFECT
    INT_VAR
      opcode_to_delete = "-1"
  END
  LPF ADD_ITEM_EFFECT
    INT_VAR
      opcode = 265
      target = 1
      parameter1 = 1
      timing = 1
      probability1 = 100
    STR_VAR
      resource = ~TCRSCRLU~
  END
  // Consume the scroll from the inventory when it is used. Opcode 123 is the
  // BGEE inventory-item removal opcode; the resource key is the scroll itself.
  LPF ADD_ITEM_EFFECT
    INT_VAR
      opcode = 123
      target = 1
      timing = 1
      probability1 = 100
    STR_VAR
      resource = ~TCRSCROL~
  END
BUT_ONLY_IF_IT_CHANGES

// Bow of Silent Leaves - Stage 22.
// Use a completely new item resref so an older broken Bow of Silent Leaves
// can never be mistaken for the corrected item in an existing save.  BOW03 is
// used only as the clean vanilla bow chassis/icon; the custom item itself has
// its own resref and its inherited effects are explicitly stripped.
COPY_EXISTING ~BOW03.ITM~ ~override/BOWSIL4.ITM~
  SAY NAME1 @2072
  SAY NAME2 @2072
  SAY DESC @2073
  // Force the item to remain an ordinary bow chassis: no inherited weapon
  // enchantment and no inherited on-hit/global effects from earlier variants.
  WRITE_SHORT 0x001c 0x000f
  WRITE_LONG 0x0060 0
  WRITE_SHORT 0x0042 0
  LPF DELETE_ITEM_EFFECT
    INT_VAR
      opcode_to_delete = "-1"
  END
  LPF DELETE_ITEM_EQEFFECT
    INT_VAR
      opcode_to_delete = "-1"
  END
  // Global equipped effects: +1 cumulative Luck and +1 cumulative Dexterity.
  // Timing 2 means the effects are active while the bow is equipped.
  LPF ADD_ITEM_EQEFFECT
    INT_VAR
      opcode = 22
      target = 1
      timing = 2
      parameter1 = 1
      parameter2 = 0
      probability1 = 100
  END
  LPF ADD_ITEM_EQEFFECT
    INT_VAR
      opcode = 15
      target = 1
      timing = 2
      parameter1 = 1
      parameter2 = 0
      probability1 = 100
  END
BUT_ONLY_IF_IT_CHANGES

// Second Alma: use RUMAR01 as the visual/spellcasting basis, but make her
// a hostile necromancer and give her a black robe palette. Her RUMAR01
// spellbook is deliberately preserved.
// Second Alma: clone RUMAR01 as faithfully as possible for combat behavior.
// Keep Umar's original Override/Class/General scripts, memorized spells, and
// inventory. Only change the name, dialogue resource, hostile faction, kit,
// and robe palette. This deliberately avoids replacing her proven mage AI.
COPY_EXISTING ~RUMAR01.CRE~ ~override/TCRALMA.CRE~
  SAY NAME1 @2065
  SAY NAME2 @2065
  WRITE_ASCII 0x280 ~TCRALMA~ #32
  WRITE_ASCII 0x2cc ~TCRALMA~ #8
  WRITE_BYTE 0x0314 255
  WRITE_LONG 0x0244 0x10000000
  WRITE_BYTE 0x2d 0
  WRITE_BYTE 0x2e 0
  WRITE_BYTE 0x30 0
  WRITE_BYTE 0x31 0
  ADD_CRE_ITEM ~TCRSCROL~ #1 #0 #0 ~IDENTIFIED~ ~INV1~
BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/better_immersion_beregost/tcrcrscn.baf~
COMPILE ~CotSC/better_immersion_beregost/tormfosc.baf~
COMPILE ~CotSC/better_immersion_beregost/tcrdoor.baf~
COMPILE ~CotSC/better_immersion_beregost/tcralma_dialog.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/tcralma_dialog.tra~
COMPILE ~CotSC/better_immersion_beregost/tormcr_npcs.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/tormcr_npcs.tra~

