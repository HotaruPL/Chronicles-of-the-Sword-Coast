// ---------------------------------------------------------------------------
// Kaeira: Red Fang Marauders Cave - custom cave interior
// ---------------------------------------------------------------------------
// Palette-based TIS/WED implementation matching the proven custom-area
// structure used by QCCARN/QCVELM/Purple Wyrm. No PVRZ pages are required.

// The cave can be installed independently, so make sure the quest item exists here too.
COPY_EXISTING ~BDMISC40.ITM~ ~override/PWYSPICE.ITM~
  READ_LONG 0x18 pwyspice_flags
  SAY NAME1 @2076
  SAY NAME2 @2076
  SAY DESC @2077
  WRITE_LONG 0x18 (pwyspice_flags BOR 1)
  WRITE_SHORT 0x38 1
  WRITE_LONG 0x4c 1
