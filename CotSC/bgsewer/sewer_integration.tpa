LOAD_TRA ~CotSC/translation/%LANGUAGE%/bgsewer/sewer_installer.tra~

// Install the supplied working QCSEWR area before modifying it.
COPY ~CotSC/bgsewer/QCSEWR.ARE~ ~override/QCSEWR.ARE~
COPY ~CotSC/bgsewer/QCSEWR.WED~ ~override/QCSEWR.WED~
COPY ~CotSC/bgsewer/QCSEWR.TIS~ ~override/QCSEWR.TIS~
COPY ~CotSC/bgsewer/QSEWR00.PVRZ~ ~override/QSEWR00.PVRZ~
COPY ~CotSC/bgsewer/QSEWR01.PVRZ~ ~override/QSEWR01.PVRZ~
COPY ~CotSC/bgsewer/QSEWR02.PVRZ~ ~override/QSEWR02.PVRZ~
COPY ~CotSC/bgsewer/QSEWR03.PVRZ~ ~override/QSEWR03.PVRZ~
COPY ~CotSC/bgsewer/QSEWR04.PVRZ~ ~override/QSEWR04.PVRZ~
COPY ~CotSC/bgsewer/QSEWR05.PVRZ~ ~override/QSEWR05.PVRZ~
COPY ~CotSC/bgsewer/QSEWR06.PVRZ~ ~override/QSEWR06.PVRZ~
COPY ~CotSC/bgsewer/QCSEWRSR.BMP~ ~override/QCSEWRSR.BMP~
COPY ~CotSC/bgsewer/QCSEWRHT.BMP~ ~override/QCSEWRHT.BMP~
COPY ~CotSC/bgsewer/QCSEWRLM.BMP~ ~override/QCSEWRLM.BMP~
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SHVERT.CRE~ BEGIN
  FAIL @20496
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~GHOUL.CRE~ BEGIN
  FAIL @20497
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~JELLMU.CRE~ BEGIN
  FAIL @20498
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~CARRIO.CRE~ BEGIN
  FAIL @20499
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~OTYUGH.CRE~ BEGIN
  FAIL @20500
END
// Cadok: standalone copy of the native SHVERT creature, retaining its appearance/chassis.
// Scripts are cleared so he remains stationary until the player talks to him.
COPY_EXISTING ~SHVERT.CRE~ ~override/QCCADOK.CRE~
  SAY NAME1 @12000
  SAY NAME2 @12000
  WRITE_ASCII 0x2cc ~QCCADOK~ #8
  WRITE_ASCII 0x248 ~QCCADOK~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_SHORT 0x244 0x4000
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCCADOK_DEAD~ #32

// Cadok at 1627,782, facing NE (10).
COPY_EXISTING ~QCSEWR.ARE~ ~override/QCSEWR.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1627
      fj_loc_y = 782
      fj_dest_x = 1627
      fj_dest_y = 782
      fj_spawned = 1
      fj_orientation = 10
    STR_VAR
      fj_structure_type = actor
      fj_name = Cadok
      fj_cre_resref = QCCADOK
      fj_dlg_resref = QCCADOK
      fj_bcs_override = QCCADOK
  END

