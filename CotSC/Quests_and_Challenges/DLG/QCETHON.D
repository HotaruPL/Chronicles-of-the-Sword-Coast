BEGIN QCETHON

IF ~Global("QCNEBBISH","GLOBAL",0)~ THEN BEGIN QCE_START
  SAY @1
  IF ~~ THEN REPLY @2 GOTO QCE_LOOKING
  IF ~~ THEN REPLY @4 EXIT
END

IF ~Global("QCNEBBISH","GLOBAL",1) Global("QCETHON_TOLD","GLOBAL",0)~ THEN BEGIN QCE_START_QUEST
  SAY @1
  IF ~~ THEN REPLY @2 GOTO QCE_LOOKING
  IF ~~ THEN REPLY @3 DO ~SetGlobal("QCETHON_TOLD","GLOBAL",1) SetGlobal("QCNEBBISH","GLOBAL",2) AddexperienceParty(150)~ SOLVED_JOURNAL @25 GOTO QCE_TOLD
  IF ~~ THEN REPLY @4 EXIT
END

IF ~Global("QCNEBBISH","GLOBAL",1) Global("QCETHON_TOLD","GLOBAL",1)~ THEN BEGIN QCE_ALREADY_TOLD
  SAY @7
  IF ~~ THEN EXIT
END

IF ~Global("QCNEBBISH","GLOBAL",2)~ THEN BEGIN QCE_DONE
  SAY @1
  IF ~~ THEN REPLY @2 GOTO QCE_LOOKING
  IF ~~ THEN REPLY @4 EXIT
END

IF ~~ THEN BEGIN QCE_LOOKING
  SAY @5
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN QCE_TOLD
  SAY @6
  IF ~~ THEN EXIT
END
