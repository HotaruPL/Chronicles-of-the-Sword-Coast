LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_remaining_major_items_npcs.tra~

// The eleven previously separate installation sections now run sequentially as one transaction.
// Keep this order: item resources -> merchants -> voices -> containers -> companion CRE patches -> more containers.

COPY ~CotSC/QCMM/bam~ ~override~

COPY ~CotSC/QCMM/items/QCMEAT.ITM~ ~override/QCMEAT.ITM~
  SAY 0x08 @4045
  SAY 0x0c @4045
  SAY 0x50 @4046
  SAY 0x54 @4046
  WRITE_LONG 0x4c 0
  WRITE_SHORT 0x38 99

COPY ~CotSC/QCMM/items/QCSAUSG.ITM~ ~override/QCSAUSG.ITM~
  SAY 0x08 @4047
  SAY 0x0c @4047
  SAY 0x50 @4048
  SAY 0x54 @4048
  WRITE_LONG 0x4c 0
  WRITE_SHORT 0x38 99

