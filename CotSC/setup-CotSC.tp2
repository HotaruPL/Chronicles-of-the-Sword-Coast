// Helshara: unique identity/dialogue while retaining her supplied CRE data.
COPY ~CotSC/halruaan_ice/HELSHA.CRE~ ~override/QCHLICE.CRE~
COPY_EXISTING ~QCHLICE.CRE~ ~override/QCHLICE.CRE~
  SAY NAME1 @4012
  SAY NAME2 @4012
  WRITE_ASCII 0x280 ~QCHLICE~ #32
  WRITE_ASCII 0x2cc ~QCHLICE~ #8
BUT_ONLY_IF_IT_CHANGES
COMPILE ~CotSC/halruaan_ice/qcice_helshara.baf~

// Delorna: two clones to prevent old/new area actors from colliding by resref.
COPY ~CotSC/halruaan_ice/DELORN.CRE~ ~override/QCDELI.CRE~
COPY_EXISTING ~QCDELI.CRE~ ~override/QCDELI.CRE~
  WRITE_ASCII 0x280 ~QCDELI~ #32
  WRITE_ASCII 0x2cc ~QCDELI~ #8
  // GOODBUTBLUE = party-friendly allegiance with a blue selection circle.
  WRITE_BYTE 0x270 29
  WRITE_ASCII 0x248 ~QCDLNEU~ #8
  LPF DELETE_CRE_EFFECT
    INT_VAR opcode_to_delete = 208
  END
  LPF ADD_CRE_EFFECT
    INT_VAR opcode=208 target=1 timing=9 parameter1=1 resist_dispel=0
  END
  // Shandalar carries Flesh to Stone. Minimum-HP immunity does not stop
  // petrification (opcode 134), so block that death route explicitly.
  LPF ADD_CRE_EFFECT
    INT_VAR opcode=101 target=1 timing=9 parameter2=134 resist_dispel=0
  END
  // QCSHICE is assigned Specific=250 below. This protection prevents only
  // that final Shandalar clone from targeting Delorna; player attacks remain
  // possible and QCDLNEU still restores her blue/friendly state.
  LPF ADD_CRE_EFFECT
    INT_VAR opcode=100 target=1 timing=9 parameter1=250 parameter2=6 resist_dispel=0
  END
BUT_ONLY_IF_IT_CHANGES
COPY_EXISTING ~QCDELI.CRE~ ~override/QCDELIF.CRE~
  WRITE_ASCII 0x280 ~QCDELIF~ #32
  WRITE_ASCII 0x2cc ~QCDELIF~ #8
  WRITE_BYTE 0x270 29
  WRITE_ASCII 0x248 ~QCDLNEU~ #8
  LPF DELETE_CRE_EFFECT
    INT_VAR opcode_to_delete = 208
  END
  LPF ADD_CRE_EFFECT
    INT_VAR opcode=208 target=1 timing=9 parameter1=1 resist_dispel=0
  END
BUT_ONLY_IF_IT_CHANGES
COMPILE ~CotSC/halruaan_ice/qcice_delorna.baf~
COMPILE ~CotSC/halruaan_ice/QCDLNEU.baf~
// Ozeroth keeps Narcillicus's original SHOUT override behaviour. The short
// custom blocks are inserted at the top, then the original SHOUT blocks follow.
COPY_EXISTING ~SHOUT.BCS~ ~override/QCOZTALK.BCS~
EXTEND_TOP ~QCOZTALK.BCS~ ~CotSC/halruaan_ice/QCOZTALK.baf~
// Vesnam's short override owns only the pre-fight conversation. Once hostile,
// QCVSMAG supplies reliable mage combat while WTASIGHT remains his default AI.
COMPILE ~CotSC/halruaan_ice/QCVSTALK.baf~
COMPILE ~CotSC/halruaan_ice/QCVSMAG.baf~

// Ozeroth: NARCIL base. Preserve every original NARCIL script so he keeps
// his normal automatic approach/dialogue/combat behaviour. Only the identity
// and dialogue resource are changed.
COPY_EXISTING ~NARCIL.CRE~ ~override/QCOZEROT.CRE~
  SAY NAME1 @4013
  SAY NAME2 @4013
  WRITE_ASCII 0x280 ~QCOZEROT~ #32
  WRITE_BYTE 0x2c 84
  WRITE_BYTE 0x2d 84
  WRITE_BYTE 0x2e 60
  WRITE_BYTE 0x2f 20
  WRITE_BYTE 0x30 84
  WRITE_BYTE 0x31 84
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QCOZER~ #8
  WRITE_ASCII 0x248 ~QCOZTALK~ #8
BUT_ONLY_IF_IT_CHANGES

// Vesnam: Davaeorn base. Preserve Davaeorn's stats/spellcasting chassis, but
// use a dedicated class script because DAVAEORN.BCS depends on the original
// Cloakwood encounter state and was not casting reliably in QCICEC.
COPY_EXISTING ~DAVAEO.CRE~ ~override/QCVESNAM.CRE~
  SAY NAME1 @4014
  SAY NAME2 @4014
  WRITE_ASCII 0x280 ~QCVESNAM~ #32
  WRITE_BYTE 0x2c 180
  WRITE_BYTE 0x2d 180
  WRITE_BYTE 0x2e 180
  WRITE_BYTE 0x2f 20
  WRITE_BYTE 0x30 180
  WRITE_BYTE 0x31 180
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QCVESNAM~ #8
  WRITE_ASCII 0x248 ~QCVSTALK~ #8
  // Davaeorn's original class script is highly encounter-specific. Vesnam
  // gets a dedicated mage class script so he reliably casts in QCICEC.
  WRITE_ASCII 0x250 ~QCVSMAG~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~STAF01~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~CLCK17~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~ EQUIP
  ADD_CRE_ITEM ~SCRL06~ #0 #0 #0 ~IDENTIFIED~ ~INV~
BUT_ONLY_IF_IT_CHANGES

// Final Shandalar: unique clone of SHANDAL2 so the QCHALI actor can disappear
// without affecting the final Ice Island actor.
COPY_EXISTING ~SHANDAL2.CRE~ ~override/QCSHICE.CRE~
  SAY NAME1 @4015
  SAY NAME2 @4015
  WRITE_ASCII 0x280 ~QCSHICE~ #32
  WRITE_BYTE 0x270 255
  // SHANDAL2 is class INNOCENT (155).  BGEE applies the normal innocent-
  // murder reputation penalty from CLASS.IDS even when the EE per-kill
  // reputation byte at 0x7f is zero.  This quest clone is an actual mage,
  // so class him as MAGE and keep the explicit per-kill value at zero.
  WRITE_BYTE 0x273 1
  WRITE_BYTE 0x274 250
  WRITE_BYTE 0x27b 0x23
  WRITE_BYTE 0x7f 0
  WRITE_ASCII 0x2cc ~QCSHICE~ #8
BUT_ONLY_IF_IT_CHANGES

// Silent Ogre Mage creature chassis. Use the common HOSTILE ogre mages
// (A/B/C), not the neutral/dialogue variants D and OGRMBA. Preserve their
// original combat scripts; only clear their dialogue resource.
COPY_EXISTING ~OGREMA_C.CRE~ ~override/OGRMAGE1.CRE~
  WRITE_ASCII 0x2cc ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~OGREMA_A.CRE~ ~override/OGRMAGE2.CRE~
  WRITE_ASCII 0x2cc ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~OGREMA_B.CRE~ ~override/OGRMAGE3.CRE~
  WRITE_ASCII 0x2cc ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Creature actors (polar bears, winter wolves, mephits, ogres, golems) use their
// original CRE resources and do not need QC-prefixed actor names.
// Human/unique actors keep QC-prefixed CREs and actor names so original game
// characters are never overwritten.

// ------------------------------------------------------------
// QCICEB actors
// ------------------------------------------------------------
// Actors are baked into CotSC/halruaan_ice/QCICEB.ARE so the original BG1009
// actor block is physically gone before installation reaches this point.
COPY_EXISTING ~QCICEB.ARE~ ~override/QCICEB.ARE~
  LPF ALTER_AREA_ACTOR
    STR_VAR actor_name=GORMIST1 cre_file=MEPICE01
  END
  LPF ALTER_AREA_ACTOR
    STR_VAR actor_name=GORMIST2 cre_file=MEPICE01
  END
  LPF ALTER_AREA_ACTOR
    STR_VAR actor_name=QCHELSICE script_general=qcice_helshara dlg_file=QCHLICE
  END
  LPF ALTER_AREA_ACTOR
    INT_VAR flag_invulnerable=1 flag_override_script_name=1
    STR_VAR actor_name=QCDELI script_override=QCDLNEU dlg_file=QCDELI
  END
BUT_ONLY_IF_IT_CHANGES

// ------------------------------------------------------------
// QCICEC actors
// ------------------------------------------------------------
// QCICEC.ARE is a clean rebuild of BG1010 with the original Dezkiel,
// winter wolves and polar bears removed before the intended Ice Island
// actor table was inserted.
// Do not recopy the source here: that would erase the area patches above.
COPY_EXISTING ~QCICEC.ARE~ ~override/QCICEC.ARE~
  LPF ALTER_AREA_ACTOR
    STR_VAR actor_name=QCOZEROT dlg_file=QCOZER cre_file=QCOZEROT
  END
  LPF ALTER_AREA_ACTOR
    STR_VAR actor_name=QCVESNAM dlg_file=QCVESNAM cre_file=QCVESNAM
  END
  LPF ALTER_AREA_ACTOR
    INT_VAR flag_invulnerable=1 flag_override_script_name=1
    STR_VAR actor_name=QCDELIF script_override=QCDLNEU dlg_file=QCDELIF
  END
  // New exit near X=552,Y=2716 -> QCICEA.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 552
      fj_loc_y = 2716
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name = QCICEAOUT
  END
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 520
      fj_box_top = 2684
      fj_box_right = 584
      fj_box_bottom = 2748
      fj_cursor_idx = 34
      fj_flags = 4
      fj_vertex_0 = 520 + (2684 << 16)
      fj_vertex_1 = 584 + (2684 << 16)
      fj_vertex_2 = 584 + (2748 << 16)
      fj_vertex_3 = 520 + (2748 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = QCICEAEXIT
      fj_destination_area = QCICEA
      fj_destination_name = QCICEAIN
  END
BUT_ONLY_IF_IT_CHANGES

