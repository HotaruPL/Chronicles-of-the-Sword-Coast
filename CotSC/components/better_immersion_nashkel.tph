LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_bg1_towns_carnivals.tra~

// Fisherman 1 — normal human commoner chassis, with a distinct palette.
COPY_EXISTING ~FARM.CRE~ ~override/BNFISH01.CRE~
  SAY NAME1 @1035
  SAY NAME2 @1035
  WRITE_ASCII 0x2cc ~BNFISH01~ #8
  WRITE_ASCII 0x280 ~BNFISH01~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_BYTE 0x2d 2
  WRITE_BYTE 0x2e 7
  WRITE_BYTE 0x2f 6
  WRITE_BYTE 0x30 4
  WRITE_BYTE 0x32 5
BUT_ONLY_IF_IT_CHANGES

// Fisherman 2 — same chassis, different palette.
COPY_EXISTING ~FARM.CRE~ ~override/BNFISH02.CRE~
  SAY NAME1 @1035
  SAY NAME2 @1035
  WRITE_ASCII 0x2cc ~BNFISH02~ #8
  WRITE_ASCII 0x280 ~BNFISH02~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_BYTE 0x2d 4
  WRITE_BYTE 0x2e 10
  WRITE_BYTE 0x2f 4
  WRITE_BYTE 0x30 3
  WRITE_BYTE 0x32 2
BUT_ONLY_IF_IT_CHANGES

// Neutral dog.
COPY_EXISTING ~DOGWIL01.CRE~ ~override/BINDOG01.CRE~
  SAY NAME1 @1033
  SAY NAME2 @1033
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~BINDOG01~ #32
  WRITE_ASCII 0x248 ~QCNWAND~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

