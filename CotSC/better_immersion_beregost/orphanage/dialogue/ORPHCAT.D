BEGIN ORPHCAT

IF ~Global("ORPHAN_PET_PROMISE","GLOBAL",1) !Global("ORPHAN_PET_DONE","GLOBAL",1) Global("ORPHAN_CAT_TAKEN","GLOBAL",0)~ THEN BEGIN ORPHCAT_PROMISED
  SAY @1
  IF ~~ THEN REPLY @2 GOTO ORPHCAT_PET
  IF ~~ THEN REPLY @3 EXIT
END

IF ~Global("ORPHAN_PET_PROMISE","GLOBAL",0)~ THEN BEGIN ORPHCAT_NORMAL
  SAY @4
  IF ~~ THEN REPLY @5 EXIT
END

IF ~Global("ORPHAN_PET_DONE","GLOBAL",1)~ THEN BEGIN ORPHCAT_COMPLETE
  SAY @6
  IF ~~ THEN REPLY @7 EXIT
END

IF ~~ THEN BEGIN ORPHCAT_PET
  SAY @8
  IF ~~ THEN REPLY @9 DO ~SetGlobal("ORPHAN_CAT_TAKEN","GLOBAL",1) GiveItemCreate("ORPHCAT",Player1,1,0,0) ActionOverride("ORPHCAT",DestroySelf())~ EXIT
  IF ~~ THEN REPLY @10 EXIT
END
