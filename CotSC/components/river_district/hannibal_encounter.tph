// v4.9: Reproduce the music and ambience *configuration* of the user-
// supplied AR0404.ARE (not AR0404's irrelevant sound positions).
// Original songs: day=12, night=12, victory=0, battle=-2, defeat=0.
// Use the current EET songlist references exactly as AR0404 specifies.
// No extra music files are needed: these are existing base-game tracks.
COPY_EXISTING ~QCHANN.ARE~ ~override/QCHANN.ARE~
  READ_LONG 0xbc qh_songs_off
  PATCH_IF (qh_songs_off < 0x11c) OR (qh_songs_off + 0x90 > BUFFER_LENGTH) BEGIN
    PATCH_FAIL @20231
  END
  // Use explicit unsigned 32-bit values for -2 and -1.  Bare negative
  // WRITE_LONG operands can produce a WeiDU GLR parse error here.
  WRITE_LONG (qh_songs_off + 0x00) 12
  WRITE_LONG (qh_songs_off + 0x04) 12
  WRITE_LONG (qh_songs_off + 0x08) 0
  WRITE_LONG (qh_songs_off + 0x0c) 0xFFFFFFFE // -2, AR0404 battle song
  WRITE_LONG (qh_songs_off + 0x10) 0
  WRITE_LONG (qh_songs_off + 0x14) 0xFFFFFFFF // -1, unused
  WRITE_LONG (qh_songs_off + 0x18) 0xFFFFFFFF
  WRITE_LONG (qh_songs_off + 0x1c) 0xFFFFFFFF
  WRITE_LONG (qh_songs_off + 0x20) 0xFFFFFFFF
  WRITE_LONG (qh_songs_off + 0x24) 0xFFFFFFFF
  // QCHANN source contains no ambients; this is an add-only operation.
  PATCH_IF (SHORT_AT 0x82 != 0) BEGIN
    PATCH_FAIL @20232
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1560
      fj_loc_y = 1160
      fj_radius = 500
      fj_volume = 100
      fj_sound_num = 1
      fj_delay = 0
      fj_variation = 0
      fj_flags = 7
    STR_VAR
      fj_structure_type = ambient
      fj_name = ~QH_MAIN~
      fj_wav_resref0 = ~AM0404~
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1020
      fj_loc_y = 1090
      fj_radius = 500
      fj_volume = 80
      fj_sound_num = 5
      fj_delay = 18
      fj_variation = 7
      fj_flags = 13
    STR_VAR
      fj_structure_type = ambient
      fj_name = ~QH_RATS~
      fj_wav_resref0 = ~AM0400B1~
      fj_wav_resref1 = ~AM0400B2~
      fj_wav_resref2 = ~AM0400B3~
      fj_wav_resref3 = ~AM0400B4~
      fj_wav_resref4 = ~AM0400B5~
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1470
      fj_loc_y = 1190
      fj_radius = 500
      fj_volume = 80
      fj_sound_num = 5
      fj_delay = 15
      fj_variation = 10
      fj_flags = 13
    STR_VAR
      fj_structure_type = ambient
      fj_name = ~QH_SPLASH~
      fj_wav_resref0 = ~AM0404B1~
      fj_wav_resref1 = ~AM0404B2~
      fj_wav_resref2 = ~AM0404B3~
      fj_wav_resref3 = ~AM0404B4~
      fj_wav_resref4 = ~AM0404B5~
  END
  LPF fj_are_structure
