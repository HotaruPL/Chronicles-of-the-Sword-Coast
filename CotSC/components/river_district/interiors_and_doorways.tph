  FAIL @20207
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0002LM.BMP~ BEGIN
  FAIL @20208
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0002HT.BMP~ BEGIN
  FAIL @20209
END
// BG0810.ARE uses BG0304 as its WED. BG0810SR/LM/HT do NOT exist
// on this EET install, so use the shared artwork area's maps instead.
// Keep QRSHOP.ARE's WED reference as BG0304 (no WED clone needed).
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0304SR.BMP~ BEGIN
  FAIL @20210
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0304LM.BMP~ BEGIN
  FAIL @20211
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0304HT.BMP~ BEGIN
