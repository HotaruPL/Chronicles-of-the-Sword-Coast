// v27: small worldmap entry adjustment + resilience when Imoen cuts off
// the ritual dialogue. Preserve v25 worldmap reveal and working native door.

// ---------- Integrated milestone: QC: Unicorn Grove - Arrival Correction and Core Dialogue Safety Net~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCCGRV.ARE~ BEGIN FAIL ~Install Unicorn Grove first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QBTAREA.BCS~ BEGIN FAIL ~Install the QCBTEM ritual encounter first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QBTCORE.CRE~ BEGIN FAIL ~Install Core's dragon creature first.~ END

// Unified build: skip legacy v27 patch (misread the container offset).
// Add guards to the existing QBTAREA script, rather than rewriting its
// working character scripts, dialogue files, WED, search maps, or native door.
EXTEND_TOP ~QBTAREA.BCS~ ~CotSC/qc_unicorn_grove/scripts/QBTCORE27.baf~

// Public installer: development progress message omitted.

// v29: repair QCSTART arrival and test initial-session Imoen J-dialogue setup.
// No WED/TIS/PVRZ, search map, portrait, NPC encounter or Core changes.

// ---------- Integrated milestone: QC: Unicorn Grove - Correct Worldmap Arrival and Imoen Session Initialization~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCCGRV.ARE~ BEGIN FAIL ~Unicorn Grove QCCGRV must be installed first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCHLAR.BCS~ BEGIN FAIL ~Nightmare Candlekeep memory areas must be installed first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCJAR.BCS~ BEGIN FAIL ~Dark Jaheira and Khalid area must be installed first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBAR.BCS~ BEGIN FAIL ~Bhaal temple forest encounters must be installed first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QBTAREA.BCS~ BEGIN FAIL ~Final temple encounter must be installed first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~IMOEN2J.DLG~ BEGIN FAIL ~Imoen's SoA joined dialogue is missing.~ END

// Fix an actual ARE offset error in v26/v27: 0x68 is ENTRANCE offset;
// 0x70 is CONTAINER offset. Earlier patches read 0x70 and sometimes added
// duplicate QCSTART entrances, leaving the original centred at (700,880).
// Update EVERY QCSTART, including duplicates, so the engine's choice
// of matching entry no longer matters. Existing exit areas are unaffected.
COPY_EXISTING ~QCCGRV.ARE~ ~override/QCCGRV.ARE~
  READ_LONG 0x68 qc29_entries_off
  READ_LONG 0x6c qc29_entries_num
  PATCH_IF (qc29_entries_num < 1) OR (qc29_entries_num > 512) OR (qc29_entries_off + qc29_entries_num * 0x68 > SOURCE_SIZE) BEGIN
    PATCH_FAIL @20318
  END
  SET qc29_found = 0
  FOR (qc29_i=0; qc29_i<qc29_entries_num; qc29_i+=1) BEGIN
    SET qc29_pos = qc29_entries_off + (qc29_i * 0x68)
    READ_ASCII qc29_pos qc29_label (32) NULL
    PATCH_IF (~%qc29_label%~ STRING_EQUAL_CASE ~QCSTART~) BEGIN
      WRITE_SHORT (qc29_pos + 0x20) 969
      WRITE_SHORT (qc29_pos + 0x22) 1725
      SET qc29_found += 1
    END
  END
  PATCH_IF (qc29_found == 0) BEGIN
    PATCH_FAIL @20319
  END
BUT_ONLY_IF_IT_CHANGES

// Force the actual joined dialogue file into Imoen's CRE when this memory
// area first becomes active. Saving/reloading currently performs equivalent
// initialization in some new-session tests. This is the smallest reversible
// hypothesis test and leaves each NPC's existing content intact.
// The outdoor area currently has no area script: install one only in that case.
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCI29INI.baf~
COPY_EXISTING ~QCCGRV.ARE~ ~override/QCCGRV.ARE~
  READ_ASCII 0x94 qc29_areascript (8) NULL
  PATCH_IF (~%qc29_areascript%~ STRING_EQUAL ~~) BEGIN
    WRITE_ASCII 0x94 ~QCI29INI~ #8
  END ELSE BEGIN
    PATCH_IF (~%qc29_areascript%~ STRING_EQUAL_CASE ~QCI29INI~) BEGIN
    END ELSE BEGIN
      PATCH_WARN @20320
    END
  END
BUT_ONLY_IF_IT_CHANGES

// Other memory areas already have proper area scripts. Extend those at top
