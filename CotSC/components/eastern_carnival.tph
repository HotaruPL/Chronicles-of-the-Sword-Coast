COPY ~CotSC/Quests_and_Challenges/Eastern_Carnival/qcvelm/QCVELMHT.BMP~ ~override/QCVELMHT.BMP~
COPY ~CotSC/Quests_and_Challenges/Eastern_Carnival/qcvelm/QCVELMLM.BMP~ ~override/QCVELMLM.BMP~

// QCCARN -> QCVELM.
// The 96x96 trigger is centered exactly on X=954, Y=867.
// QCVELM receives the party at X=1572, Y=1962 via this entrance.
COPY_EXISTING ~CotSC/Quests_and_Challenges/Eastern_Carnival/qccarncol/QCCARN.ARE~ ~override/QCCARN.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_type       = 2
      fj_box_left   = 906
      fj_box_top    = 819
      fj_box_right  = 1002
      fj_box_bottom = 915
      fj_cursor_idx = 34
      fj_flags      = 4
      fj_vertex_0   = 906  + (819 << 16)
      fj_vertex_1   = 1002 + (819 << 16)
      fj_vertex_2   = 1002 + (915 << 16)
      fj_vertex_3   = 906  + (915 << 16)
    STR_VAR
      fj_structure_type   = region
      fj_name              = CARNQCVELM
      fj_destination_area  = QCVELM
      fj_destination_name  = CARN_ARRIVE
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 1098
      fj_loc_y       = 934
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name           = QCVELM_EXIT
  END
  BUT_ONLY

// QCVELM -> QCCARN.
// The 96x96 trigger is centered exactly on X=1511, Y=2032.
// QCCARN receives the party safely at X=1098, Y=934.
COPY_EXISTING ~CotSC/Quests_and_Challenges/Eastern_Carnival/qcvelm/QCVELM.ARE~ ~override/QCVELM.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_type       = 2
      fj_box_left   = 1463
      fj_box_top    = 1984
      fj_box_right  = 1559
      fj_box_bottom = 2080
      fj_cursor_idx = 34
      fj_flags      = 0
      fj_vertex_0   = 1463 + (1984 << 16)
      fj_vertex_1   = 1559 + (1984 << 16)
      fj_vertex_2   = 1559 + (2080 << 16)
      fj_vertex_3   = 1463 + (2080 << 16)
    STR_VAR
      fj_structure_type   = region
      fj_name              = QCVELMCARN
      fj_destination_area  = QCCARN
      fj_destination_name = QCVELM_EXIT
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 1572
      fj_loc_y       = 1962
      fj_orientation = 8
    STR_VAR
      fj_structure_type = entrance
      fj_name           = CARN_ARRIVE
  END
  BUT_ONLY


