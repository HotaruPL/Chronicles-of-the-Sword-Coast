// ====================================================================
// PART 7/7: v2.4 experimental interior NPCs, encounters, quests and chest contents
// ====================================================================

// This standalone expansion is installed AFTER the working v2.3a interiors.
// Only copies/patches QRHO01..05, QRSHOP, adds new creature/script/dialogue/item resources.
ACTION_FOR_EACH area IN ~QRHO01~ ~QRHO02~ ~QRHO03~ ~QRHO04~ ~QRHO05~ ~QRSHOP~ BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%area%.ARE~ BEGIN
    FAIL @20233
  END
END

// Creature template checks before any changes. EET resource names are case-insensitive.
ACTION_FOR_EACH cre IN ~MTOWBEST~ ~THIEF~ ~THIEFM~ ~HALFG3~ ~FTWBAX_C~ ~FARM~ ~BASILL~ BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%cre%.CRE~ BEGIN
    FAIL @20234
  END
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~RING01.ITM~ BEGIN FAIL ~Missing base ring RING01.ITM~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SHOP06.STO~ BEGIN FAIL ~Missing store SHOP06.STO~ END
ACTION_FOR_EACH itm IN ~AROW01~ ~AROW11~ ~BULL01~ ~MISC07~ ~BOOK32~ ~BOW03~ ~SW1H01~ ~SW1H09~ ~LEAT01~ ~POTN08~ ~POTN10~ ~POTN19~ ~POTN52~ ~DAGG01~ ~RING11~ ~MISC22~ ~MISC27~ ~MISC37~ ~XBOW01~ ~BOLT04~ BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%itm%.ITM~ BEGIN
    FAIL @20235
  END
END
// Validate companions actually required for the interior quests.
// Yoshimo uses YOSHJ.DLG in BG2/EET (NOT YOSHIMJ.DLG).
// His single comment is optional if the resource is absent.
ACTION_FOR_EACH dlg IN ~JAHEIRAJ~ ~NALIAJ~ ~VICONIJ~ ~AERIEJ~ ~MAZZYJ~ ~KELDORJ~ BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%dlg%.DLG~ BEGIN
    FAIL @20236
  END
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~YOSHJ.DLG~ BEGIN
  PRINT @20237
END

// Register both interior stories with the BG2EE/EET quest database.
// The old version only registered Lucky Ring, leaving these in ordinary Journal.
ADD_JOURNAL TITLE (@7009) @100 @104 USING ~CotSC/translation/%LANGUAGE%/qriv_houses/tra/qriv_houses.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~
ADD_JOURNAL TITLE (@7010) @101 @102 USING ~CotSC/translation/%LANGUAGE%/qriv_houses/tra/qriv_houses.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~

// Compile all scripted/companion conversations in ONE unit: no cross-installer labels.
COMPILE ~CotSC/qriv_houses/dialogue/qriv_houses.d~ USING ~CotSC/translation/%LANGUAGE%/qriv_houses/tra/qriv_houses.tra~
COMPILE ~CotSC/qriv_houses/scripts/QRHXZAI.baf~
COMPILE ~CotSC/qriv_houses/scripts/QRHNTAI.baf~
COMPILE ~CotSC/qriv_houses/scripts/QRH02AI.baf~ USING ~CotSC/translation/%LANGUAGE%/qriv_houses/tra/qriv_houses.tra~

// Ring: custom magical accessory sets Charisma to 18 while equipped.
COPY_EXISTING ~RING01.ITM~ ~override/QRVMAG.ITM~
  SAY NAME1 @3024
  SAY NAME2 @3024
  SAY DESC @3025
  SAY UNIDENTIFIED_DESC @3026
  LPF ADD_ITEM_EQEFFECT
    INT_VAR
      opcode = 6
      target = 1
      timing = 2
      parameter1 = 18
      parameter2 = 1
      probability1 = 100
  END
BUT_ONLY_IF_IT_CHANGES

// MTOWBEST's seated animation caused Delgado to remain seated.
// FARM supplies a regular standing male human, while retaining Delgado's
// unique identity, dialogue, location and conversational logic.
COPY_EXISTING ~FARM.CRE~ ~override/QRVDEL.CRE~
  SAY NAME1 @3027
  SAY NAME2 @3027
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x2cc ~QRVDEL~ #8
  WRITE_ASCII 0x280 ~QRVDEL~ #32
  WRITE_LONG 0x20 0
  WRITE_SHORT 0x24 20
  WRITE_SHORT 0x26 20
  REMOVE_CRE_EFFECTS
  WRITE_BYTE 0x270 128 // neutral until explicitly made hostile
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~THIEF.CRE~ ~override/QRVXZO.CRE~
  SAY NAME1 @3028
  SAY NAME2 @3028
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x2cc ~QRVXZO~ #8
  WRITE_ASCII 0x280 ~QRVXZO~ #32
  WRITE_BYTE 0x270 128 // neutral until explicitly made hostile
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  WRITE_ASCII 0x248 ~QRHXZAI~ #8
  WRITE_LONG 0x1c 73
  WRITE_BYTE 0x2d 0
  WRITE_BYTE 0x2e 0
  ADD_CRE_ITEM ~LEAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
  ADD_CRE_ITEM ~XBOW01~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~BOLT04~ #20 #0 #0 ~IDENTIFIED~ ~QUIVER1~
  SET_BG2_PROFICIENCY ~PROFICIENCYCROSSBOW~ 1
  ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM1~
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~THIEFM.CRE~ ~override/QRVNAT.CRE~
