LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

// This component is standalone. It uses the QC prefix for all newly created
// creature/area resources and is intended for Quest and Challenges.

ACTION_IF NOT FILE_EXISTS_IN_GAME ~GHASTF01.CRE~ BEGIN
  FAIL @20156
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~VAMPAT01.CRE~ BEGIN
  FAIL @20157
END
