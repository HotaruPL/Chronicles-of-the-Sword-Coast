  WRITE_ASCII 0x2cc ~QCMM06~ #8
  WRITE_ASCII 0x280 ~QCMM06~ #32
  WRITE_ASCII 0x248 ~~ #40 // clear reused creature AI scripts
  WRITE_BYTE 0x270 128 // neutral
  WRITE_BYTE 0x237 2 // female sex, for voice/casting type
  WRITE_BYTE 0x275 2 // female gender
  WRITE_LONG 0x28 51472

