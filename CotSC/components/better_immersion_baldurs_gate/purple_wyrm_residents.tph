// ---------------------------------------------------------------------------
// PURPLE WYRM INN - CORE NPCS / DIALOGUE - PART 1
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// MERGED BALDUR'S GATE COMPONENT
// Purple Wyrm Inn NPCs/dialogue, Kaeira Spice Raid, Red Fang Marauders
// cave, and PWYTR2 waterfall removal are intentionally part of this
// single Better Immersion for Baldur's Gate component.
// ---------------------------------------------------------------------------

// Attach the Purple Wyrm's area script without touching its frozen collision,
// WED, TIS, lighting/height maps, or BG0800 transition.
COPY_EXISTING ~BIPWYR.ARE~ ~override/BIPWYR.ARE~
  WRITE_ASCII 0x0094 ~PWYRINN~ #8
BUT_ONLY_IF_IT_CHANGES

// Theo the Historian - human commoner, stationary.
COPY_EXISTING ~FARM.CRE~ ~override/PWYTHEO.CRE~
  SAY NAME1 @2049
  SAY NAME2 @2049
  WRITE_ASCII 0x2cc ~PWYTHEO~ #8
  WRITE_ASCII 0x280 ~PWYTHEO~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_ASCII 0x2cc ~PWYTHEO~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

// Kaeira - female commoner voice/CRE chassis, with KIRIAN's visual animation and plate armour.
COPY_EXISTING ~FTWBAX_C.CRE~ ~override/PWYKAE9.CRE~
  SAY NAME1 @2050
  SAY NAME2 @2050
  WRITE_ASCII 0x2cc ~PWYKAEI~ #8
  WRITE_ASCII 0x280 ~PWYKAE9~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REPLACE_CRE_ITEM ~PLAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
  INNER_PATCH_FILE ~KIRIAN.CRE~ BEGIN
    READ_LONG 0x28 pwy_kaeira_animation
  END
  WRITE_LONG 0x28 "%pwy_kaeira_animation%"
BUT_ONLY_IF_IT_CHANGES

// Randalla Brasshorn - use MOOK as the visual/animation basis, with a red-toned palette.
COPY_EXISTING ~MOOK.CRE~ ~override/PWYRAND.CRE~
  SAY NAME1 @2051
  SAY NAME2 @2051
  WRITE_ASCII 0x2cc ~PWYRAND~ #8
  WRITE_ASCII 0x280 ~PWYRAND~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x2d 47
  WRITE_BYTE 0x2e 47
  WRITE_BYTE 0x30 47
  WRITE_BYTE 0x31 47
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

// Lady Delcia Caan - preserve her original appearance/voice, but give her a dedicated script
// so she can approach the party automatically and leave with Hendron afterward.
COPY_EXISTING ~DELCIA.CRE~ ~override/PWYDELC.CRE~
  SAY NAME1 @2052
  SAY NAME2 @2052
  WRITE_ASCII 0x2cc ~PWYDELC~ #8
  WRITE_ASCII 0x280 ~PWYDELC~ #32
  WRITE_ASCII 0x248 ~PWYDELCS~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

// Hendron - KPSOLD01 chassis with his original armour and sword retained.
// His dedicated script handles the departure together with Delcia.
COPY_EXISTING ~KPSOLD01.CRE~ ~override/PWYHEND.CRE~
  SAY NAME1 @2053
  SAY NAME2 @2053
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~PWYHEND~ #32
  WRITE_ASCII 0x248 ~PWYHENDS~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Bartender - use the Enhanced Edition MERC0706 chassis/appearance.
COPY_EXISTING ~MERC0706.CRE~ ~override/PWYBART.CRE~
  SAY NAME1 @2054
  SAY NAME2 @2054
  WRITE_ASCII 0x2cc ~PWYBART~ #8
  WRITE_ASCII 0x280 ~PWYBART~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

// Purple Wyrm Inn service store. INN0119 is an existing inn template with
// room-rental and drinks/ale services, so we reuse its proven store structure.
COPY_EXISTING ~INN0119.STO~ ~override/PWYINN.STO~
  SAY NAME2 @2055
BUT_ONLY_IF_IT_CHANGES

// Wandering female halfling.
COPY_EXISTING ~BIBHAL16.CRE~ ~override/PWYHAL7.CRE~
  SAY NAME1 @2003
  SAY NAME2 @2003
  WRITE_ASCII 0x2cc ~PWYHALF~ #8
  WRITE_ASCII 0x280 ~PWYHAL7~ #32
  WRITE_ASCII 0x248 ~BIBWANDR~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
BUT_ONLY_IF_IT_CHANGES

// Wandering male human commoner.
COPY_EXISTING ~FARM.CRE~ ~override/PWYCMN7.CRE~
  SAY NAME1 @2014
  SAY NAME2 @2014
  WRITE_ASCII 0x2cc ~PWYCMNR~ #8
  WRITE_ASCII 0x280 ~PWYCMN7~ #32
  WRITE_ASCII 0x248 ~BIBWANDR~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
BUT_ONLY_IF_IT_CHANGES

