// QCBHAL approach - one-time protagonist narration and optional party responses.
// Dialogue uses PLAYER1 itself, not an invisible actor or separate proxy.
CHAIN IF ~Global("QCB_INTRO","GLOBAL",1) InParty("Imoen2")~ THEN ~PLAYER1~ QCBWITHIMO
  @1
  == ~JAHEIRAJ~ IF ~IsValidForPartyDialog("Jaheira")~ THEN
     @2
  == ~KORGANJ~ IF ~IsValidForPartyDialog("Korgan")~ THEN
     @3
  == ~MINSCJ~ IF ~IsValidForPartyDialog("Minsc")~ THEN
     @4
END ~IMOEN2J~ QCBIMOASK

// Fresh BG2 party Imoen before the later Imoen2 identity is established.
CHAIN IF ~Global("QCB_INTRO","GLOBAL",1) InParty("Imoen") !InParty("Imoen2")~ THEN ~PLAYER1~ QCBWITHIMO_EARLY
  @5
  == ~JAHEIRAJ~ IF ~IsValidForPartyDialog("Jaheira")~ THEN
     @6
  == ~KORGANJ~ IF ~IsValidForPartyDialog("Korgan")~ THEN
     @7
  == ~MINSCJ~ IF ~IsValidForPartyDialog("Minsc")~ THEN
     @8
END ~IMOENJ~ QCBIMOASK_EARLY

CHAIN IF ~Global("QCB_INTRO","GLOBAL",1) !InParty("Imoen2") !InParty("Imoen")~ THEN ~PLAYER1~ QCBNOIMO
  @9
  == ~JAHEIRAJ~ IF ~IsValidForPartyDialog("Jaheira")~ THEN
     @10
  == ~KORGANJ~ IF ~IsValidForPartyDialog("Korgan")~ THEN
     @11
  == ~MINSCJ~ IF ~IsValidForPartyDialog("Minsc")~ THEN
     @12
DO ~SetGlobal("QCB_INTRO","GLOBAL",2)~ EXIT

APPEND ~IMOEN2J~
  IF ~~ THEN BEGIN QCBIMOASK
    SAY @13
    IF ~~ THEN REPLY @14 GOTO QCBIMOYES
    IF ~~ THEN REPLY @15 GOTO QCBIMONO
  END
  IF ~~ THEN BEGIN QCBIMOYES
    SAY @16
    IF ~~ THEN GOTO QCBIMOCON
  END
  IF ~~ THEN BEGIN QCBIMONO
    SAY @17
    IF ~~ THEN GOTO QCBIMOCON
  END
  IF ~~ THEN BEGIN QCBIMOCON
    SAY @18
    IF ~~ THEN DO ~SetGlobal("QCB_INTRO","GLOBAL",2)~ EXIT
  END
END

APPEND ~IMOENJ~
  IF ~~ THEN BEGIN QCBIMOASK_EARLY
    SAY @19
    IF ~~ THEN REPLY @20 GOTO QCBIMOYES_EARLY
    IF ~~ THEN REPLY @21 GOTO QCBIMONO_EARLY
  END
  IF ~~ THEN BEGIN QCBIMOYES_EARLY
    SAY @22
    IF ~~ THEN GOTO QCBIMOCON_EARLY
  END
  IF ~~ THEN BEGIN QCBIMONO_EARLY
    SAY @23
    IF ~~ THEN GOTO QCBIMOCON_EARLY
  END
  IF ~~ THEN BEGIN QCBIMOCON_EARLY
    SAY @24
    IF ~~ THEN DO ~SetGlobal("QCB_INTRO","GLOBAL",2)~ EXIT
  END
END

BEGIN ~QCBTRIS~
IF ~Global("QCB_TRISS","GLOBAL",0)~ THEN BEGIN HELPNOW
  SAY @25
  IF ~InParty("Imoen2")~ THEN REPLY @26 DO ~SetGlobal("QCB_TRISS","GLOBAL",1)~ EXTERN ~QCBTRIS~ TRISIMO
  IF ~InParty("Imoen") !InParty("Imoen2")~ THEN REPLY @27 DO ~SetGlobal("QCB_TRISS","GLOBAL",1)~ EXTERN ~QCBTRIS~ TRISIMO_EARLY
  IF ~!InParty("Imoen2") !InParty("Imoen")~ THEN REPLY @28 DO ~SetGlobal("QCB_TRISS","GLOBAL",1)~ EXTERN ~QCBTRIS~ TRISNOIMO
END

CHAIN IF ~Global("QCB_TRISS","GLOBAL",1)~ THEN ~QCBTRIS~ TRISIMO
  @29
  == ~JAHEIRAJ~ IF ~IsValidForPartyDialog("Jaheira")~ THEN
     @30
END ~IMOEN2J~ QCBTRIIMO

CHAIN IF ~Global("QCB_TRISS","GLOBAL",1)~ THEN ~QCBTRIS~ TRISIMO_EARLY
  @31
  == ~JAHEIRAJ~ IF ~IsValidForPartyDialog("Jaheira")~ THEN
     @32
END ~IMOENJ~ QCBTRIIMO_EARLY

CHAIN IF ~Global("QCB_TRISS","GLOBAL",1)~ THEN ~QCBTRIS~ TRISNOIMO
  @33
  == ~JAHEIRAJ~ IF ~IsValidForPartyDialog("Jaheira")~ THEN
     @34
DO ~SetGlobal("QCB_TRISS","GLOBAL",2)~ EXIT

APPEND ~IMOEN2J~
IF ~~ THEN BEGIN QCBTRIIMO
  SAY @35
  IF ~~ THEN REPLY @36 GOTO QCBTRIANSWER
END
IF ~~ THEN BEGIN QCBTRIANSWER
  SAY @37
  IF ~IsValidForPartyDialog("Hexxat")~ THEN DO ~SetGlobal("QCB_TRISS","GLOBAL",2)~ EXTERN ~HEXXATJ~ QCBHEXSTART
  IF ~!IsValidForPartyDialog("Hexxat")~ THEN DO ~SetGlobal("QCB_TRISS","GLOBAL",2)~ EXIT
END
END

APPEND ~IMOENJ~
IF ~~ THEN BEGIN QCBTRIIMO_EARLY
  SAY @38
  IF ~~ THEN REPLY @39 GOTO QCBTRIANSWER_EARLY
END
IF ~~ THEN BEGIN QCBTRIANSWER_EARLY
  SAY @40
  IF ~IsValidForPartyDialog("Hexxat")~ THEN DO ~SetGlobal("QCB_TRISS","GLOBAL",2)~ EXTERN ~HEXXATJ~ QCBHEXSTART
  IF ~!IsValidForPartyDialog("Hexxat")~ THEN DO ~SetGlobal("QCB_TRISS","GLOBAL",2)~ EXIT
END
END

APPEND ~HEXXATJ~
IF ~~ THEN BEGIN QCBHEXSTART
  SAY @41
  IF ~~ THEN REPLY @42 GOTO QCBHEXWARN
  IF ~~ THEN REPLY @43 EXIT
END
IF ~~ THEN BEGIN QCBHEXWARN
  SAY @44
  IF ~~ THEN REPLY @45 GOTO QCBHEXGLINT
END
IF ~~ THEN BEGIN QCBHEXGLINT
  SAY @46
  IF ~~ THEN GOTO QCBHEXTRUTH
END
IF ~~ THEN BEGIN QCBHEXTRUTH
  SAY @47
  IF ~~ THEN REPLY @48 GOTO QCBHEXANS1
  IF ~~ THEN REPLY @49 GOTO QCBHEXANS2
  IF ~~ THEN REPLY @50 GOTO QCBHEXANS3
END
IF ~~ THEN BEGIN QCBHEXANS1
  SAY @51
  IF ~~ THEN EXIT
END
IF ~~ THEN BEGIN QCBHEXANS2
  SAY @52
  IF ~~ THEN EXIT
END
IF ~~ THEN BEGIN QCBHEXANS3
  SAY @53
  IF ~~ THEN EXIT
END
END

BEGIN ~QCBMALZ~
IF ~Global("QCB_MAL_TALK","GLOBAL",0)~ THEN BEGIN MALSTART
  SAY @54
  IF ~~ THEN REPLY @55 GOTO MALWARN
  IF ~~ THEN REPLY @56 GOTO MALWARN
  IF ~~ THEN REPLY @57 GOTO MALANGER
END
IF ~~ THEN BEGIN MALWARN
  SAY @58
  IF ~~ THEN GOTO MALWARN2
END
IF ~~ THEN BEGIN MALWARN2
  SAY @59
  IF ~~ THEN REPLY @60 GOTO MALCHILD
  IF ~~ THEN REPLY @61 GOTO MALLEAVE
END
IF ~~ THEN BEGIN MALCHILD
  SAY @62
  IF ~~ THEN GOTO MALMATE
END
IF ~~ THEN BEGIN MALMATE
  SAY @63
  IF ~~ THEN DO ~SetGlobal("QCB_MAL_TALK","GLOBAL",1) SetGlobal("QCB_MAL_SURVIVED","GLOBAL",1) SetGlobal("QCB_MAL_GO","GLOBAL",1)~ EXIT
END
IF ~~ THEN BEGIN MALLEAVE
  SAY @64
  IF ~~ THEN DO ~SetGlobal("QCB_MAL_TALK","GLOBAL",1) SetGlobal("QCB_MAL_SURVIVED","GLOBAL",1) SetGlobal("QCB_MAL_GO","GLOBAL",1)~ EXIT
END
IF ~~ THEN BEGIN MALANGER
  SAY @65
  IF ~~ THEN DO ~SetGlobal("QCB_MAL_TALK","GLOBAL",1) SetGlobal("QCB_MAL_HOSTILE","GLOBAL",1)~ EXIT
END
