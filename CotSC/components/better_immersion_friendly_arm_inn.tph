LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_bg1_towns_carnivals.tra~

// Elven Traveler — based on the same male elf chassis used for Beregost.
COPY_EXISTING ~SARELF01.CRE~ ~override/BIFATRV.CRE~
  SAY NAME1 @1028
  SAY NAME2 @1028
  WRITE_ASCII 0x2cc ~BIFATRV~ #8
  WRITE_ASCII 0x280 ~BIFATRV~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Halfling Commoner — male Gullykin halfling chassis.
COPY_EXISTING ~HALFG3.CRE~ ~override/BIFHAL01.CRE~
