// Elvin the Courier at 4014,1111.  He is spawned once per game.
IF
  Global("BIB_BG0700_ELVIN_SPAWNED","GLOBAL",0)
  !Exists("BGBG0712")
THEN
  RESPONSE #100
    SetGlobal("BIB_BG0700_ELVIN_SPAWNED","GLOBAL",1)
    CreateCreature("BGBG0712",[4014.1111],0)
END

