// Blades enter the fray when Hannibal finishes speaking.
IF
  Global("QH_ALARM","GLOBAL",0)
  See([PC])
THEN
  RESPONSE #100
    SetGlobal("QH_ALARM","GLOBAL",1)
    GlobalShout(9188)
END

IF
  Global("QH_HANN_FIGHT","GLOBAL",1)
  !See([PC])
THEN
  RESPONSE #100
    MoveToObject(Player1)
END

IF
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    AttackReevaluate(NearestEnemyOf(Myself),30)
END
