// Dialogue and scripts for the warehouse stories. Scope limited to cloned
// warehouse ARE, companion dialogue append, and High Hedge's existing script.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~THALAN.DLG~ BEGIN
  FAIL @20239
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG3202.BCS~ BEGIN
  FAIL @20240
END
ADD_JOURNAL TITLE (@7011) @900 @901 @902 @903 @904 USING ~CotSC/translation/%LANGUAGE%/qriv_houses/tra/qriv_werewolf.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~
COMPILE ~CotSC/qriv_houses/dialogue/qriv_v28_quest.d~ USING ~CotSC/translation/%LANGUAGE%/qriv_houses/tra/qriv_werewolf.tra~
COMPILE ~CotSC/qriv_houses/scripts/QRVLEAI.baf~
COMPILE ~CotSC/qriv_houses/scripts/QRVLEFI.baf~
COMPILE ~CotSC/qriv_houses/scripts/QRDPORT.baf~
COMPILE ~CotSC/qriv_houses/scripts/QRDWH01.baf~
// Insert into High Hedge without replacing its normal area script.
EXTEND_TOP ~BG3202.BCS~ ~CotSC/qriv_houses/scripts/QRDHH.baf~
ACTION_IF NOT FILE_EXISTS_IN_GAME ~OGREHA.CRE~ BEGIN FAIL ~River District v2.8 missing template OGREHA.CRE~ END
COPY_EXISTING ~OGREHA.CRE~ ~override/QRVWOR2.CRE~
  SAY NAME1 @3034
  SAY NAME2 @3034
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x280 ~QRVWOR2~ #32
  WRITE_ASCII 0x2cc ~QRVWK2~ #8
  WRITE_LONG 0x20 0
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  
  
BUT_ONLY_IF_IT_CHANGES
