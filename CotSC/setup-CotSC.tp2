// ===== v76 NIGHT SCHEDULE FIX =====
  // v76: NIGHT SCHEDULES for CotSC ambient actors only.
  // This runs after these creatures have been copied/created by this component.
  // Preserve original OVERRIDE/CLASS/RACE/GENERAL/DEFAULT scripts.
  COPY_EXISTING ~BIBGNOME.CRE~ ~override~
    READ_ASCII 0x248 qc76_o0 (8) NULL
    READ_ASCII 0x250 qc76_o1 (8) NULL
    READ_ASCII 0x258 qc76_o2 (8) NULL
    READ_ASCII 0x260 qc76_o3 (8) NULL
    READ_ASCII 0x268 qc76_o4 (8) NULL
    PATCH_IF (~%qc76_o0%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o0 ~~ END
    PATCH_IF (~%qc76_o1%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o1 ~~ END
    PATCH_IF (~%qc76_o2%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o2 ~~ END
    PATCH_IF (~%qc76_o3%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o3 ~~ END
    PATCH_IF (~%qc76_o4%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o4 ~~ END
    PATCH_IF (~%qc76_o0%~ STRING_EQUAL ~~) BEGIN
      WRITE_ASCII 0x248 ~QC75NITE~ #8
    END ELSE PATCH_IF (~%qc76_o1%~ STRING_EQUAL ~~) BEGIN
      WRITE_EVALUATED_ASCII 0x250 ~%qc76_o0%~ #8
      WRITE_ASCII 0x248 ~QC75NITE~ #8
    END ELSE PATCH_IF (~%qc76_o2%~ STRING_EQUAL ~~) BEGIN
      WRITE_EVALUATED_ASCII 0x258 ~%qc76_o1%~ #8
      WRITE_EVALUATED_ASCII 0x250 ~%qc76_o0%~ #8
      WRITE_ASCII 0x248 ~QC75NITE~ #8
    END ELSE PATCH_IF (~%qc76_o3%~ STRING_EQUAL ~~) BEGIN
      WRITE_EVALUATED_ASCII 0x260 ~%qc76_o2%~ #8
      WRITE_EVALUATED_ASCII 0x258 ~%qc76_o1%~ #8
      WRITE_EVALUATED_ASCII 0x250 ~%qc76_o0%~ #8
      WRITE_ASCII 0x248 ~QC75NITE~ #8
    END ELSE PATCH_IF (~%qc76_o4%~ STRING_EQUAL ~~) BEGIN
      WRITE_EVALUATED_ASCII 0x268 ~%qc76_o3%~ #8
      WRITE_EVALUATED_ASCII 0x260 ~%qc76_o2%~ #8
      WRITE_EVALUATED_ASCII 0x258 ~%qc76_o1%~ #8
      WRITE_EVALUATED_ASCII 0x250 ~%qc76_o0%~ #8
      WRITE_ASCII 0x248 ~QC75NITE~ #8
    END ELSE BEGIN
      PATCH_WARN @20016
    END
  BUT_ONLY_IF_IT_CHANGES
  COPY_EXISTING ~BIBHAL01.CRE~ ~override~
    READ_ASCII 0x248 qc76_o0 (8) NULL
    READ_ASCII 0x250 qc76_o1 (8) NULL
    READ_ASCII 0x258 qc76_o2 (8) NULL
    READ_ASCII 0x260 qc76_o3 (8) NULL
    READ_ASCII 0x268 qc76_o4 (8) NULL
    PATCH_IF (~%qc76_o0%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o0 ~~ END
    PATCH_IF (~%qc76_o1%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o1 ~~ END
    PATCH_IF (~%qc76_o2%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o2 ~~ END
    PATCH_IF (~%qc76_o3%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o3 ~~ END
    PATCH_IF (~%qc76_o4%~ STRING_EQUAL ~ ~) BEGIN SPRINT qc76_o4 ~~ END
    PATCH_IF (~%qc76_o0%~ STRING_EQUAL ~~) BEGIN
      WRITE_ASCII 0x248 ~QC75NITE~ #8
    END ELSE PATCH_IF (~%qc76_o1%~ STRING_EQUAL ~~) BEGIN
      WRITE_EVALUATED_ASCII 0x250 ~%qc76_o0%~ #8
      WRITE_ASCII 0x248 ~QC75NITE~ #8
    END ELSE PATCH_IF (~%qc76_o2%~ STRING_EQUAL ~~) BEGIN
      WRITE_EVALUATED_ASCII 0x258 ~%qc76_o1%~ #8
      WRITE_EVALUATED_ASCII 0x250 ~%qc76_o0%~ #8
