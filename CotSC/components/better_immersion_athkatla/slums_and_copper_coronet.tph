// Hostile panther, using the native AR0406 jaguar chassis but the panther
// animation. The QC hostile script guarantees it actually attacks.
COPY_EXISTING ~CATJAG01.CRE~ ~override/QC46PANT.CRE~
  SAY NAME1 @3120
  SAY NAME2 @3120
  WRITE_SHORT 0x28 0x7f0a
  WRITE_BYTE 0x270 255
  WRITE_BYTE 0x272 137
  WRITE_BYTE 0x273 175
  WRITE_ASCII 0x280 ~QC46PANT~ #32
  WRITE_ASCII 0x248 ~QCAHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

