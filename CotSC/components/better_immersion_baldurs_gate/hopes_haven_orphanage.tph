// ---------------------------------------------------------------------------
// ORPHANAGE - HOPE'S HAVEN
// ---------------------------------------------------------------------------
// Integrated from the frozen Better Immersion Orphanage package.
// The area artwork, transitions, NPC/dialogue scripts, flower investigation,
// companion interjections, pet/coin content, and BG0700 map integration are
// copied unchanged. This block is additive to the existing Better Immersion
// component and does not replace any existing component resources.
// ---------------------------------------------------------------------------

ADD_JOURNAL TITLE (@7004) @100 @101 USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/orphanage/dialogue/ORPHAN_QUEST.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~
ADD_JOURNAL TITLE (@7005) @1 @2 USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/orphanage/dialogue/ORPHPET.TRA~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~
ADD_JOURNAL TITLE (@7004) @100 @101 USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/orphanage/dialogue/ORPHAN_QUEST.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~

// Friendly Cat and Strange Coin.
COPY_EXISTING ~CAT.CRE~ ~override/ORPHCAT.CRE~
  SAY NAME1 @2088
  SAY NAME2 @2088
  WRITE_ASCII 0x248 ~ORPHCAT~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_ASCII 0x280 ~ORPHCAT_DEAD~ #32
  WRITE_ASCII 0x2cc ~ORPHCAT~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~MISC62.ITM~ ~override/ORPHCAT.ITM~
  SAY NAME1 @2088
  SAY NAME2 @2088
  SAY DESC @2089
BUT_ONLY_IF_IT_CHANGES

COPY ~CotSC/better_immersion_beregost/orphanage/dialogue/ORPHCOIN.BAM~ ~override/ORPHCOIN.BAM~

COPY_EXISTING ~MISC07.ITM~ ~override/ORPHCOIN.ITM~
  SAY NAME1 @2090
  SAY NAME2 @2090
  SAY DESC @2091
  WRITE_SHORT 0x38 1
  WRITE_ASCII 0x3a ~ORPHCOIN~ #8
  WRITE_ASCII 0x44 ~ORPHCOIN~ #8
BUT_ONLY_IF_IT_CHANGES

