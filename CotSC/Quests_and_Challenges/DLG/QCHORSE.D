BEGIN QCHORSE

IF ~Global("QCHORSE_STATE","GLOBAL",0)~ THEN BEGIN QCH_INTRO
  SAY @2
  IF ~~ THEN REPLY @3 GOTO QCH_LOST
  IF ~~ THEN REPLY @4 GOTO QCH_BUSINESS_UNSTARTED
  IF ~~ THEN REPLY @5 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_ACTIVE
  SAY @2
  IF ~~ THEN REPLY @4 GOTO QCH_BUSINESS_ACTIVE
  IF ~~ THEN REPLY @5 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",3)~ THEN BEGIN QCH_AFTER_KILL
  SAY @40
  IF ~~ THEN REPLY @36 GOTO QCH_KILL_GOOD
  IF ~~ THEN REPLY @37 GOTO QCH_KILL_BAD
END

IF ~OR(2) Global("QCHORSE_STATE","GLOBAL",4) Global("QCHORSE_STATE","GLOBAL",5)~ THEN BEGIN QCH_COMPLETED
  SAY @2
  IF ~~ THEN REPLY @4 GOTO QCH_BUSINESS_COMPLETED
  IF ~~ THEN REPLY @5 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",0)~ THEN BEGIN QCH_LOST
  SAY @6
  IF ~~ THEN REPLY @9 GOTO QCH_ACCEPT
  IF ~~ THEN REPLY @10 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",0)~ THEN BEGIN QCH_BUSINESS_UNSTARTED
  SAY @7
  IF ~~ THEN EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_BUSINESS_ACTIVE
  SAY @7
  IF ~~ THEN EXIT
END

IF ~OR(2) Global("QCHORSE_STATE","GLOBAL",4) Global("QCHORSE_STATE","GLOBAL",5)~ THEN BEGIN QCH_BUSINESS_COMPLETED
  SAY @8
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN QCH_ACCEPT
  SAY @11
  IF ~~ THEN DO ~SetGlobal("QCHORSE_STATE","GLOBAL",1) CreateCreature("QCHASHRK",[74.100],14) CreateCreature("QCHROACH",[126.151],14) SetGlobal("QCHORSE_JOURNAL","GLOBAL",1)~ UNSOLVED_JOURNAL @42 EXIT
END

IF ~~ THEN BEGIN QCH_KILL_GOOD
  SAY @38
  IF ~~ THEN DO ~SetGlobal("QCHORSE_STATE","GLOBAL",4) AddExperienceParty(500) GiveGoldForce(100)~ SOLVED_JOURNAL @45 EXIT
END

IF ~~ THEN BEGIN QCH_KILL_BAD
  SAY @39
  IF ~~ THEN DO ~SetGlobal("QCHORSE_STATE","GLOBAL",5) AddExperienceParty(500) GiveGoldForce(50)~ SOLVED_JOURNAL @44 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",2)~ THEN BEGIN QCH_AFTER_SAVED
  SAY @33
  IF ~~ THEN SOLVED_JOURNAL @43 EXIT
END
