// Human baker at 2617,2545, facing north.
IF
  Global("BIB_BG0600_BAKERY_SPAWNED","GLOBAL",0)
  !Exists("BIBBAK01")
THEN
  RESPONSE #100
    SetGlobal("BIB_BG0600_BAKERY_SPAWNED","GLOBAL",1)
    CreateCreature("BIBBAK01",[2617.2545],8)
END
