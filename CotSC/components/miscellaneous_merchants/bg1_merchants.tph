// Static area actors, no area script or original NPC overwritten.
COPY_EXISTING ~BG3300.ARE~ ~override~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1895
      fj_loc_y = 3429
      fj_dest_x = 1895
      fj_dest_y = 3429
      fj_orientation = 4
      fj_animation = 51456
      fj_wander_dist_actor = 0
      fj_mvmt_dist_actor = 0
    STR_VAR
      fj_structure_type = ~actor~
      fj_name = ~QCMM01_Actor~
      fj_cre_resref = ~QCMM01~
  END

