// Mia / Hope's Haven. Minsc uses the BG1/EET joined-party dialogue resource MINSCJ_.
// The Minsc APPEND and the ORPHMIA BEGIN are deliberately in this same source,
// following the proven Q&C cross-dialogue architecture.

APPEND ~MINSCJ_~
IF ~~ THEN BEGIN ORPH_MIA_MINSC1
  SAY @3
  IF ~~ THEN EXTERN ~ORPHMIA~ ORPH_MIA_MINSC_MIA1
END
IF ~~ THEN BEGIN ORPH_MIA_MINSC2
  SAY @4
  IF ~~ THEN EXTERN ~ORPHMIA~ ORPH_MIA_MINSC_MIA2
END
IF ~~ THEN BEGIN ORPH_MIA_MINSC3
  SAY @5
  IF ~~ THEN EXTERN ~ORPHMIA~ ORPH_MIA_MINSC_MIA3
END
IF ~~ THEN BEGIN ORPH_MIA_MINSC4
  SAY @6
  IF ~~ THEN REPLY @7 EXTERN ~ORPHMIA~ ORPH_MIA_YES
  IF ~~ THEN REPLY @8 EXTERN ~ORPHMIA~ ORPH_MIA_TIME
  IF ~~ THEN REPLY @9 EXTERN ~ORPHMIA~ ORPH_MIA_NO
END
END

BEGIN ORPHMIA

IF ~Global("ORPHAN_PET_PROMISE","GLOBAL",1) Global("ORPHAN_CAT_TAKEN","GLOBAL",1) !Global("ORPHAN_PET_DONE","GLOBAL",1)~ THEN BEGIN ORPH_MIA_CAT
  SAY @10
  IF ~~ THEN REPLY @11 GOTO ORPH_MIA_CAT_GIFT
END

IF ~Global("ORPHAN_PET_PROMISE","GLOBAL",1) Global("ORPHAN_CAT_TAKEN","GLOBAL",1) !Global("ORPHAN_PET_DONE","GLOBAL",1)~ THEN BEGIN ORPH_MIA_CAT_GIFT
  SAY @12
  IF ~~ THEN DO ~TakePartyItem("ORPHCAT") GiveItemCreate("ORPHCOIN",Player1,1,0,0) AddExperienceParty(500) SetGlobal("ORPHAN_PET_DONE","GLOBAL",1)~ SOLVED_JOURNAL @2 EXIT
END

IF ~~ THEN BEGIN ORPH_MIA_MINSC_MIA1
  SAY @13
  IF ~~ THEN EXTERN ~MINSCJ_~ ORPH_MIA_MINSC2
END

IF ~~ THEN BEGIN ORPH_MIA_MINSC_MIA2
  SAY @14
  IF ~~ THEN EXTERN ~MINSCJ_~ ORPH_MIA_MINSC3
END

IF ~~ THEN BEGIN ORPH_MIA_MINSC_MIA3
  SAY @15
  IF ~~ THEN EXTERN ~MINSCJ_~ ORPH_MIA_MINSC4
END


IF ~OR(2) Global("ORPHAN_ALLESIA_MET","GLOBAL",0) Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 0
  SAY @16
  IF ~~ THEN REPLY @17 EXIT
END

IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 1
  SAY @18
  IF ~~ THEN REPLY @19 GOTO 2
  IF ~~ THEN REPLY @20 EXIT
END

IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 2
  SAY @21
  IF ~InParty("Minsc") !StateCheck("Minsc",CD_STATE_NOTVALID)~ THEN EXTERN ~MINSCJ_~ ORPH_MIA_MINSC1
  IF ~!InParty("Minsc")~ THEN GOTO 5
  IF ~StateCheck("Minsc",CD_STATE_NOTVALID)~ THEN GOTO 5
END

IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN ORPH_MIA_YES
  SAY @22
  IF ~~ THEN DO ~SetGlobal("ORPHAN_PET_PROMISE","GLOBAL",1)~ UNSOLVED_JOURNAL @1 GOTO 5
END

IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN ORPH_MIA_TIME
  SAY @23
  IF ~~ THEN DO ~SetGlobal("ORPHAN_PET_PROMISE","GLOBAL",1)~ UNSOLVED_JOURNAL @1 GOTO 5
END

IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN ORPH_MIA_NO
  SAY @24
  IF ~~ THEN GOTO 5
END

IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 5
  SAY @25
  IF ~~ THEN REPLY @26 EXIT
  IF ~~ THEN REPLY @27 EXIT
END
