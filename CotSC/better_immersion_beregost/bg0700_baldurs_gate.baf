// v76: each CotSC civilian now manages its own nighttime removal via QC75NITE.
// Area script remains responsible solely for its original daytime spawn positions.

// ---------------------------------------------------------------------------
// BETTER IMMERSION FOR BALDUR'S GATE - BG0700
// ---------------------------------------------------------------------------

// Female Elven Commoner at 467,1454, facing west.
IF
  TimeGT(5)
  TimeLT(18)
  !Exists("BGBG0701")
THEN
  RESPONSE #100
    CreateCreature("BGBG0701",[467.1454],4)
END

