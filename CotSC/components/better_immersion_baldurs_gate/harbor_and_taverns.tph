  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~QUINN.CRE~ ~override/BIB1202.CRE~
  SAY NAME1 @2026
  SAY NAME2 @2026
  WRITE_ASCII 0x2cc ~BIB1202~ #8
  WRITE_ASCII 0x280 ~BIB1202~ #32
  WRITE_ASCII 0x248 ~BIBWANDR~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

