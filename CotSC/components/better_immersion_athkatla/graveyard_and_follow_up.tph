// Independent potion-only store.  DSHOP01 is used only as a structurally
// valid STO template; every inherited sale item is removed before the potion
// stock is added.  No weapons, armour, scrolls or miscellaneous stock remains.
COPY_EXISTING ~DSHOP01.STO~ ~override/QCDPOTS.STO~
  LPF REMOVE_STORE_ITEM_EX STR_VAR item_name = ~.*~ END

  // Strength/resistance/healing and general utility potions.
  ADD_STORE_ITEM ~POTN02~ LAST #0 #0 #0 IDENTIFIED #5
  ADD_STORE_ITEM ~POTN03~ LAST #0 #0 #0 IDENTIFIED #5
