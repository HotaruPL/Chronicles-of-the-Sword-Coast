COPY ~CotSC/better_immersion_beregost/area/PWYTR2HT.BMP~ ~override/PWYTR2HT.BMP~

// Red Fang Marauder creature resources. They are embedded directly in the
// area so no spawn script can duplicate them. Their base inventories and class
// abilities are preserved; goblins receive higher HP/THAC0 and all goblins/orcs
// get a small random extra loot roll through PWYLOOT.
COPY_EXISTING ~NEGOB01.CRE~ ~override/PWYRGOB.CRE~
  SAY NAME1 @2080
  SAY NAME2 @2080
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~PWYRGOB~ #32
  WRITE_ASCII 0x248 ~PWYLOOT~ #8
  WRITE_BYTE 0x270 255
  WRITE_SHORT 0x24 30
  WRITE_SHORT 0x26 30
  WRITE_BYTE 0x52 15
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~orc01.CRE~ ~override/PWYROCR.CRE~
  SAY NAME1 @2081
  SAY NAME2 @2081
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~PWYROCR~ #32
  WRITE_ASCII 0x248 ~PWYLOOT~ #8
  WRITE_BYTE 0x270 255
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~GORORC03.CRE~ ~override/PWYRSHA.CRE~
  SAY NAME1 @2082
  SAY NAME2 @2082
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~PWYRSHA~ #32
  WRITE_ASCII 0x248 ~PWYLOOT~ #8
  WRITE_BYTE 0x270 255
BUT_ONLY_IF_IT_CHANGES

// Red Queen — based on Lamalha, but with a dedicated encounter AI/dialogue.
// FREEZE: PWYTR1/PWYTR2 audio and the existing Orc Shaman resource are left untouched.
COPY_EXISTING ~LAMALH.CRE~ ~override/PWYREDQ.CRE~
  SAY NAME1 @2083
  SAY NAME2 @2083
  WRITE_ASCII 0x2cc ~PWYREDQ~ #8
  WRITE_ASCII 0x280 ~PWYREDQ~ #32
  WRITE_ASCII 0x248 ~PWYREDQ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 255
  WRITE_SHORT 0x24 120
  WRITE_SHORT 0x26 120
  WRITE_BYTE 0x52 8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~PLAT24~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
  ADD_CRE_ITEM ~SHLD01~ #0 #0 #0 ~IDENTIFIED~ ~SHIELD~
  PATCH_IF (FILE_EXISTS_IN_GAME ~BLUN04.ITM~) BEGIN
    ADD_CRE_ITEM ~BLUN04~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  END ELSE BEGIN
    PATCH_FAIL @20033
  END
  ADD_CRE_ITEM ~PWYSPICE~ #1 #0 #0 ~IDENTIFIED~ ~INV1~

  // Red Queen priest spells: deliberately limited to spells available to a 5th-level cleric.
  // ADD_MEMORIZED_SPELL also ensures the spells are known to the creature.
  ADD_MEMORIZED_SPELL ~SPPR111~ #0 ~priest~ ( 2 ) // Armor of Faith
  ADD_MEMORIZED_SPELL ~SPPR1208~ #1 ~priest~ ( 2 ) // Hold Person
  ADD_MEMORIZED_SPELL ~SPPR1311~ #2 ~priest~ ( 1 ) // Rigid Thinking
  ADD_MEMORIZED_SPELL ~SPPR1314~ #2 ~priest~ ( 2 ) // Unholy Blight
  ADD_MEMORIZED_SPELL ~SPPR1315~ #2 ~priest~ ( 2 ) // Cure Medium Wounds
BUT_ONLY_IF_IT_CHANGES

