BEGIN QCMERLEE

IF ~Global("QCMERLEE","GLOBAL",1) AreaCheck("BG3301")~ THEN BEGIN QCM_SMITHY
  SAY @60
  IF ~~ THEN EXIT
END

IF ~Global("QCMERLEE","GLOBAL",0) AreaCheck("BG3300")~ THEN BEGIN QCM_START
  SAY @61
  IF ~~ THEN REPLY @62 GOTO QCM_STORY
  IF ~~ THEN REPLY @63 GOTO QCM_INSULT
  IF ~~ THEN REPLY @64 EXIT
END

IF ~~ THEN BEGIN QCM_INSULT
  SAY @72
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN QCM_STORY
  SAY @65
  IF ~CheckStatGT(Player1,15,CHR)~ THEN REPLY @66 GOTO QCM_HOPE
  IF ~CheckStatLT(Player1,16,CHR)~ THEN REPLY @66 GOTO QCM_NOHOPE
  IF ~~ THEN REPLY @67 GOTO QCM_EVIL
  IF ~~ THEN REPLY @68 EXIT
END

IF ~~ THEN BEGIN QCM_HOPE
  SAY @69
  IF ~~ THEN DO ~SetGlobal("QCMERLEE","GLOBAL",1) ReputationInc(2) MoveBetweenAreas("BG3301",[264.265],0)~ EXIT
END

IF ~~ THEN BEGIN QCM_NOHOPE
  SAY @70
  IF ~~ THEN DO ~SetGlobal("QCMERLEE","GLOBAL",2) EscapeArea()~ EXIT
END

IF ~~ THEN BEGIN QCM_EVIL
  SAY @71
  IF ~~ THEN DO ~SetGlobal("QCMERLEE","GLOBAL",3) ReputationInc(-2) EscapeArea()~ EXIT
END
