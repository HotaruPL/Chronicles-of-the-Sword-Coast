COPY_EXISTING ~KRYSTI.CRE~ ~override/QRVLESL.CRE~
  SAY NAME1 @3036
  SAY NAME2 @3036
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x280 ~QRVLESL~ #32
  WRITE_ASCII 0x2cc ~QRVLLES~ #8
  WRITE_LONG 0x20 0
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  WRITE_ASCII 0x248 ~QRVLEAI~ #8
  WRITE_LONG 0x1c 0
  WRITE_BYTE 0x2d 0
  WRITE_BYTE 0x2e 0
  ADD_CRE_ITEM ~DAGG02~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  // Borrow a BG2 female Shadow Thief's voice, rather than Krysti's soundset.
  FOR (qr_v_offset = 0xA4; qr_v_offset <= 0x230; qr_v_offset += 4) BEGIN
    INNER_PATCH_FILE ~SHTHASS1.CRE~ BEGIN
      READ_LONG qr_v_offset qr_v_sound
    END
    WRITE_LONG qr_v_offset qr_v_sound
  END
BUT_ONLY_IF_IT_CHANGES
