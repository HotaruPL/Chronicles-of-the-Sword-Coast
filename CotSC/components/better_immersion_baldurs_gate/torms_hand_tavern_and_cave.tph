// ---------------------------------------------------------------------------
// TORM'S HAND - SHRIVELED POTATO TAVERN NPCs
// Ensure the same dialogue-validity state used by the existing Better Immersion interjections.
APPEND ~STATE.IDS~ ~0x80101FEF CD_STATE_NOTVALID~ UNLESS ~CD_STATE_NOTVALID~

// ---------------------------------------------------------------------------
// The area itself is the validated BIBG4801 clone. These are unique CRE/STORE
// copies based on vanilla resources; no vanilla creature resource is replaced.

COPY_EXISTING ~INNKN2.CRE~ ~override/BITBART.CRE~
  SAY NAME1 @2054
  SAY NAME2 @2054
  WRITE_ASCII 0x2cc ~BITBARTD~ #8
  WRITE_ASCII 0x280 ~BITBART~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

