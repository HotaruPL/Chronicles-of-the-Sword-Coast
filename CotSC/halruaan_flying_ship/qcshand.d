BEGIN QCSHAND

IF ~Global("QCSH_IntroDone","GLOBAL",0)~ THEN BEGIN START
  SAY @96
  IF ~~ THEN REPLY @97 DO ~SetGlobal("QCSH_IntroDone","GLOBAL",1)~ GOTO HOME1
  IF ~~ THEN REPLY @98 DO ~SetGlobal("QCSH_IntroDone","GLOBAL",1)~ GOTO TALK0
  IF ~~ THEN REPLY @99 DO ~SetGlobal("QCSH_IntroDone","GLOBAL",1)~ GOTO ISLAND1
  IF ~~ THEN REPLY @100 DO ~SetGlobal("QCSH_IntroDone","GLOBAL",1)~ GOTO FLY1
  IF ~~ THEN REPLY @101 DO ~SetGlobal("QCSH_IntroDone","GLOBAL",1)~ GOTO LEAVE
END

IF ~Global("QCSH_IntroDone","GLOBAL",1)~ THEN BEGIN MAIN_MENU
  SAY @102
  IF ~~ THEN REPLY @103 GOTO HOME1
  IF ~~ THEN REPLY @104 GOTO TALK0
  IF ~~ THEN REPLY @105 GOTO ISLAND1
  IF ~~ THEN REPLY @106 GOTO FLY1
  IF ~~ THEN REPLY @107 GOTO LEAVE
END

IF ~~ THEN BEGIN HOME1
  SAY @108
  IF ~~ THEN GOTO HOME2
END

IF ~~ THEN BEGIN HOME2
  SAY @109
  IF ~~ THEN GOTO HOME3
END

IF ~~ THEN BEGIN HOME3
  SAY @110
  IF ~~ THEN GOTO HOME_MENU
END

IF ~~ THEN BEGIN HOME_MENU
  SAY @111
  IF ~~ THEN REPLY @112 GOTO TALK0
  IF ~~ THEN REPLY @113 GOTO ISLAND1
  IF ~~ THEN REPLY @114 GOTO FLY1
  IF ~~ THEN REPLY @115 GOTO LEAVE
END

IF ~~ THEN BEGIN TALK0
  SAY @116
  IF ~Dead("Resar")~ THEN GOTO TALK_RESAR_DEAD
  IF ~!Dead("Resar")~ THEN GOTO TALK_RESAR_ALIVE
END

IF ~~ THEN BEGIN TALK_RESAR_DEAD
  SAY @117
  IF ~~ THEN REPLY @118 GOTO TALK_DEAD_EXPLAIN
  IF ~~ THEN REPLY @119 GOTO TALK_DEAD_EXPLAIN
END

IF ~~ THEN BEGIN TALK_DEAD_EXPLAIN
  SAY @120
  IF ~~ THEN GOTO TALK_ROD
END

IF ~~ THEN BEGIN TALK_RESAR_ALIVE
  SAY @121
  IF ~~ THEN GOTO TALK_ROD
END

IF ~~ THEN BEGIN TALK_ROD
  SAY @122
  IF ~~ THEN GOTO TALK_FOREST_INTRO
END

IF ~~ THEN BEGIN TALK_FOREST_INTRO
  SAY @123
  IF ~Global("QCFlyShipQuest","GLOBAL",0)~ THEN DO ~SetGlobal("QCFlyShipQuest","GLOBAL",1)
RevealAreaOnMap("QCHALF")
AddWorldmapAreaFlag("QCHALF",7)
AddJournalEntry(@2,QUEST)~ GOTO TALK_AFTER
  IF ~Global("QCFlyShipQuest","GLOBAL",1)~ THEN DO ~AddWorldmapAreaFlag("QCHALF",7)~ GOTO TALK_AFTER
END

IF ~~ THEN BEGIN TALK_AFTER
  SAY @124
  IF ~~ THEN REPLY @125 GOTO HOME1
  IF ~~ THEN REPLY @126 GOTO ISLAND1
  IF ~~ THEN REPLY @127 GOTO FLY1
  IF ~~ THEN REPLY @128 GOTO LEAVE
END

IF ~~ THEN BEGIN ISLAND1
  SAY @129
  IF ~~ THEN GOTO ISLAND2
END

IF ~~ THEN BEGIN ISLAND2
  SAY @130
  IF ~~ THEN GOTO ISLAND3
END

IF ~~ THEN BEGIN ISLAND3
  SAY @131
  IF ~~ THEN GOTO ISLAND4
END

IF ~~ THEN BEGIN ISLAND4
  SAY @132
  IF ~~ THEN GOTO ISLAND5
END

IF ~~ THEN BEGIN ISLAND5
  SAY @133
  IF ~~ THEN GOTO ISLAND6
END

IF ~~ THEN BEGIN ISLAND6
  SAY @134
  IF ~~ THEN GOTO ISLAND7
END

IF ~~ THEN BEGIN ISLAND7
  SAY @135
  IF ~~ THEN GOTO ISLAND8
END

IF ~~ THEN BEGIN ISLAND8
  SAY @136
  IF ~~ THEN GOTO ISLAND9
END

IF ~~ THEN BEGIN ISLAND9
  SAY @137
  IF ~~ THEN GOTO ISLAND10
END

IF ~~ THEN BEGIN ISLAND10
  SAY @138
  IF ~~ THEN GOTO ISLAND_MENU
END

IF ~~ THEN BEGIN ISLAND_MENU
  SAY @139
  IF ~~ THEN REPLY @140 GOTO REGRET1
  IF ~~ THEN REPLY @141 GOTO KILLED1
  IF ~~ THEN REPLY @142 GOTO WARD1
  IF ~~ THEN REPLY @143 GOTO MAIN_MENU
END

IF ~~ THEN BEGIN REGRET1
  SAY @144
  IF ~~ THEN GOTO REGRET2
END

IF ~~ THEN BEGIN REGRET2
  SAY @145
  IF ~~ THEN GOTO ISLAND_FOLLOW
END

IF ~~ THEN BEGIN ISLAND_FOLLOW
  SAY @146
  IF ~~ THEN REPLY @147 GOTO KILLED1
  IF ~~ THEN REPLY @148 GOTO WARD1
  IF ~~ THEN REPLY @149 GOTO MAIN_MENU
END

IF ~~ THEN BEGIN KILLED1
  SAY @150
  IF ~~ THEN GOTO KILLED2
END

IF ~~ THEN BEGIN KILLED2
  SAY @151
  IF ~~ THEN GOTO ISLAND_FOLLOW2
END

IF ~~ THEN BEGIN ISLAND_FOLLOW2
  SAY @152
  IF ~~ THEN REPLY @153 GOTO REGRET1
  IF ~~ THEN REPLY @154 GOTO WARD1
  IF ~~ THEN REPLY @155 GOTO MAIN_MENU
END

IF ~~ THEN BEGIN WARD1
  SAY @156
  IF ~~ THEN GOTO ISLAND_FOLLOW3
END

IF ~~ THEN BEGIN ISLAND_FOLLOW3
  SAY @157
  IF ~~ THEN REPLY @158 GOTO REGRET1
  IF ~~ THEN REPLY @159 GOTO KILLED1
  IF ~~ THEN REPLY @160 GOTO MAIN_MENU
END

IF ~~ THEN BEGIN FLY1
  SAY @161
  IF ~~ THEN GOTO FLY2
END

IF ~~ THEN BEGIN FLY2
  SAY @162
  IF ~~ THEN GOTO FLY3
END

IF ~~ THEN BEGIN FLY3
  SAY @163
  IF ~~ THEN GOTO FLY4
END

IF ~~ THEN BEGIN FLY4
  SAY @164
  IF ~~ THEN GOTO FLY_MENU
END

IF ~~ THEN BEGIN FLY_MENU
  SAY @165
  IF ~~ THEN REPLY @166 GOTO HOME1
  IF ~~ THEN REPLY @167 GOTO TALK0
  IF ~~ THEN REPLY @168 GOTO ISLAND1
  IF ~~ THEN REPLY @169 GOTO LEAVE
END

IF ~~ THEN BEGIN LEAVE
  SAY @170
  IF ~~ THEN EXIT
END
