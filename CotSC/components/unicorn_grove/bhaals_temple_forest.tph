// Keep the existing area structure and its previously fixed WED, textures,
// temple containers, song table and search map. Only patch the ARE.
COPY_EXISTING ~QCBHAL.ARE~ ~override/QCBHAL.ARE~
  WRITE_ASCII 0x94 ~QCBAR~ #8
  ADD_MAP_NOTE #1397 #191 ~gray~ ~Temple of Bhaal~
  // Arrival from the Dark Khalid / Jaheira memory room.
  LPF fj_are_structure
    INT_VAR fj_loc_x = 785 fj_loc_y = 1712 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCBARV
  END
  // Animals
  LPF fj_are_structure
    INT_VAR fj_loc_x = 407 fj_loc_y = 1481 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCBSQ01 fj_cre_resref = QCBSQUI
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 1629 fj_loc_y = 1123 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCBRB01 fj_cre_resref = QCBRAB
  END
  // Conversations and enemies
  LPF fj_are_structure
    INT_VAR fj_loc_x = 1107 fj_loc_y = 1014 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCBTR01 fj_cre_resref = QCBTRIS
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 391 fj_loc_y = 552 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCBCU01 fj_cre_resref = QCBCULT
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 319 fj_loc_y = 483 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCBPR01 fj_cre_resref = QCBPRST
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 2087 fj_loc_y = 998 fj_orientation = 2
    STR_VAR fj_structure_type = actor fj_name = QCBMA01 fj_cre_resref = QCBMALZ
  END
  // Question-mark: praying Bhaal priests / foreboding temple emblem
  LPF fj_are_structure
    INT_VAR fj_type = 1 fj_box_left = 669 fj_box_top = 1328
      fj_box_right = 701 fj_box_bottom = 1364 fj_cursor_idx = 22
      fj_info_point_strref = RESOLVE_STR_REF(~The statues depict priests of Bhaal with their palms pressed together in solemn supplication. As you pass, an unsettling sensation takes hold: their carved eyes seem to follow your every movement.~)
      fj_vertex_0 = 669 + (1328 << 16)
      fj_vertex_1 = 701 + (1328 << 16)
      fj_vertex_2 = 701 + (1364 << 16)
      fj_vertex_3 = 669 + (1364 << 16)
    STR_VAR fj_structure_type = region fj_name = QCBINFO1
  END
  LPF fj_are_structure
    INT_VAR fj_type = 1 fj_box_left = 933 fj_box_top = 1407
      fj_box_right = 965 fj_box_bottom = 1443 fj_cursor_idx = 22
      fj_info_point_strref = RESOLVE_STR_REF(~The statues depict priests of Bhaal with their palms pressed together in solemn supplication. As you pass, an unsettling sensation takes hold: their carved eyes seem to follow your every movement.~)
      fj_vertex_0 = 933 + (1407 << 16)
      fj_vertex_1 = 965 + (1407 << 16)
      fj_vertex_2 = 965 + (1443 << 16)
      fj_vertex_3 = 933 + (1443 << 16)
    STR_VAR fj_structure_type = region fj_name = QCBINFO2
  END
  LPF fj_are_structure
    INT_VAR fj_type = 1 fj_box_left = 1348 fj_box_top = 266
      fj_box_right = 1380 fj_box_bottom = 302 fj_cursor_idx = 22
      fj_info_point_strref = RESOLVE_STR_REF(~Bhaal's insignia looms over the temple entrance. Its forbidding visage stirs a nameless dread, and passing beneath it leaves you feeling strangely helpless, as though the stone itself knows what awaits you within.~)
      fj_vertex_0 = 1348 + (266 << 16)
      fj_vertex_1 = 1380 + (266 << 16)
      fj_vertex_2 = 1380 + (302 << 16)
      fj_vertex_3 = 1348 + (302 << 16)
    STR_VAR fj_structure_type = region fj_name = QCBINFO3
  END
  // Not a transition until the temple interior actually exists.
  LPF fj_are_structure
    INT_VAR fj_type = 1 fj_box_left = 1348 fj_box_top = 477
      fj_box_right = 1392 fj_box_bottom = 513 fj_cursor_idx = 30
      fj_info_point_strref = RESOLVE_STR_REF(~The temple doors stand before you. Whatever lies beyond them belongs to the final, still-unrevealed memory.~)
      fj_vertex_0 = 1348 + (477 << 16)
      fj_vertex_1 = 1392 + (477 << 16)
      fj_vertex_2 = 1392 + (513 << 16)
      fj_vertex_3 = 1348 + (513 << 16)
    STR_VAR fj_structure_type = region fj_name = QCBTDOOR
  END
BUT_ONLY_IF_IT_CHANGES

// Redirect existing QCJHR1 staircase to the new lower-forest arrival point.
COPY_EXISTING ~QCJHR1.ARE~ ~override/QCJHR1.ARE~
  READ_LONG 0x5c qcb_r_off
  READ_SHORT 0x5a qcb_r_num
  SET qcb_r_found = 0
  FOR (qcb_ix = 0; qcb_ix < qcb_r_num; qcb_ix += 1) BEGIN
    SET qcb_r = qcb_r_off + (qcb_ix * 0xc4)
    READ_ASCII qcb_r qcb_rnm (32) NULL
    PATCH_IF (~%qcb_rnm%~ STRING_EQUAL ~QCJNEXT~) BEGIN
      WRITE_ASCII (qcb_r + 0x40) ~QCBARV~ #32
      SET qcb_r_found = 1
    END
  END
  PATCH_IF (qcb_r_found = 0) BEGIN
    PATCH_FAIL @20298
  END
BUT_ONLY_IF_IT_CHANGES

// Public installer: development progress message omitted.

// v20: Preserve the completed QCBHAL render/encounters and replace ONLY
// the search-map collision and normal (day/night) exploration music.
// Install after temple and forest encounters so battle/victory songs are unchanged.

// ---------- Integrated milestone: QC: Bhaal's Temple Forest - Collision and Exploration Music (QCBHAL)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBHAL.ARE~ BEGIN FAIL ~Install Bhaal's Temple area component first.~ END

COPY ~CotSC/qc_unicorn_grove/area/QCBHALSR.BMP~ ~override/QCBHALSR.BMP~

// Same proven EE Vorbis-in-.ACM approach as existing QCHAMB music.
MKDIR ~music/QCBTHM~
COPY ~CotSC/qc_unicorn_grove/music/QCBTHMA.acm~ ~music/QCBTHM/QCBTHMA.acm~
ADD_MUSIC ~QCB_FOREST_THEME~ ~CotSC/qc_unicorn_grove/music/QCBTHM.MUS~
COPY_EXISTING ~QCBHAL.ARE~ ~override/QCBHAL.ARE~
  READ_LONG 0xbc qcb_v20_song_table
  PATCH_IF (qcb_v20_song_table > 0) AND (qcb_v20_song_table + 0x10 <= SOURCE_SIZE) BEGIN
    WRITE_LONG (qcb_v20_song_table + 0) %QCB_FOREST_THEME%
    WRITE_LONG (qcb_v20_song_table + 4) %QCB_FOREST_THEME%
  END ELSE BEGIN
    PATCH_FAIL @20299
  END
BUT_ONLY_IF_IT_CHANGES

// Public installer: development progress message omitted.

// v21: behaviour-only corrections.  Do NOT touch the established area art,
// combat encounters, dialogue/interjections, search map, or music.

// ---------- Integrated milestone: QC: Bhaal's Temple Forest - Triss departure, fair spellcasting and one-way memory~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBHAL.ARE~ BEGIN FAIL ~Install QCBHAL temple components first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBTRIS.CRE~ BEGIN FAIL ~Install QCBHAL forest encounters first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBPRST.CRE~ BEGIN FAIL ~Install QCBHAL forest encounters first.~ END

// Compile only the revised NPC scripts. Existing CRE script slots already
// reference these resrefs, so no creature/portrait/item modifications needed.
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCBTRAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCBPRIA.baf~

// Delete the QCBRET travel region, INCLUDING its vertex data, through the
// native WeiDU fj_are_structure routine. This does not alter the arrival
// entrance or QCJHR1's forward staircase.
COPY_EXISTING ~QCBHAL.ARE~ ~override/QCBHAL.ARE~
  READ_LONG 0x5c qcb21_regions_off
  READ_SHORT 0x5a qcb21_regions_num
  SET qcb21_found = 0
  FOR (qcb21_i = 0; qcb21_i < qcb21_regions_num; qcb21_i += 1) BEGIN
    SET qcb21_r = qcb21_regions_off + (qcb21_i * 0xc4)
    READ_ASCII qcb21_r qcb21_name (32) NULL
    PATCH_IF (~%qcb21_name%~ STRING_EQUAL ~QCBRET~) BEGIN
      LPF fj_are_structure
        INT_VAR fj_delete_mode = qcb21_i
        STR_VAR fj_structure_type = region
      END
      SET qcb21_found = 1
      SET qcb21_i = qcb21_regions_num // stop scanning after deletion
    END
  END
BUT_ONLY_IF_IT_CHANGES

// Public installer: development progress message omitted.

