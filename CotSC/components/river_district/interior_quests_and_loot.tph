COPY_EXISTING ~BASILL.CRE~ ~override/QRVBASI.CRE~
  SAY NAME1 @3030
  SAY NAME2 @3030
  WRITE_ASCII 0x280 ~QRVBASI~ #32
  WRITE_BYTE 0x270 255 // hostile
  WRITE_ASCII 0x2cc ~~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~FARM.CRE~ ~override/QRVTHYL.CRE~
  SAY NAME1 @3031
  SAY NAME2 @3031
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x2cc ~QRVTHYL~ #8
  WRITE_ASCII 0x280 ~QRVTHYL~ #32
  WRITE_BYTE 0x270 128 // neutral until explicitly made hostile
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  // Raw STATE_STONE_DEATH in the CRE header prevented the actor from
  // reliably appearing. Use the game's proper, curable petrification effect.
  WRITE_LONG 0x20 0
  WRITE_SHORT 0x24 20
  WRITE_SHORT 0x26 20
  REMOVE_CRE_EFFECTS
  LPF ADD_CRE_EFFECT
    INT_VAR
      opcode = 134 // genuine petrification; Stone to Flesh (opcode 43) cures it
      target = 1
      timing = 9 // permanent, until cured
      resist_dispel = 0
      probability1 = 100
  END
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~FTWBAX_C.CRE~ ~override/QRVLAR.CRE~
  SAY NAME1 @3032
  SAY NAME2 @3032
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x2cc ~QRVLAR~ #8
  WRITE_ASCII 0x280 ~QRVLAR~ #32
  WRITE_BYTE 0x270 128 // neutral until explicitly made hostile
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
BUT_ONLY_IF_IT_CHANGES

// Use the user's requested merchant model when available.
// FARM is the known-working fallback for unusual EET resource layouts.
ACTION_IF FILE_EXISTS_IN_GAME ~MERC0706.CRE~ BEGIN
  OUTER_SPRINT qr_baldie_base ~MERC0706~
END ELSE BEGIN
  OUTER_SPRINT qr_baldie_base ~FARM~
END
COPY_EXISTING ~%qr_baldie_base%.CRE~ ~override/QRVBAL.CRE~
  SAY NAME1 @3033
  SAY NAME2 @3033
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x2cc ~QRVBAL~ #8
  WRITE_ASCII 0x280 ~QRVBAL~ #32
  WRITE_LONG 0x20 0
  WRITE_SHORT 0x24 20
  WRITE_SHORT 0x26 20
  REMOVE_CRE_EFFECTS
  WRITE_BYTE 0x270 128 // neutral until explicitly made hostile
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
BUT_ONLY_IF_IT_CHANGES

