MKDIR ~music/QCBREW~
COPY ~CotSC/qc_brewery/music/QCBREW/QCBREWA.acm~ ~music/QCBREW/QCBREWA.acm~
ADD_MUSIC ~QBREW_THEME~ ~CotSC/qc_brewery/music/QCBREW.MUS~
COPY_EXISTING ~QCBREW.ARE~ ~override/QCBREW.ARE~
  READ_LONG 0xBC qb_songoff
  PATCH_IF (qb_songoff > 0) AND (qb_songoff + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG qb_songoff %QBREW_THEME%
    WRITE_LONG (qb_songoff + 4) %QBREW_THEME%
    WRITE_LONG (qb_songoff + 0x0c) 129
  END
BUT_ONLY_IF_IT_CHANGES
COPY_EXISTING ~QBRINT.ARE~ ~override/QBRINT.ARE~
  READ_LONG 0xBC qb_songoff
  PATCH_IF (qb_songoff > 0) AND (qb_songoff + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG qb_songoff %QBREW_THEME%
    WRITE_LONG (qb_songoff + 4) %QBREW_THEME%
    WRITE_LONG (qb_songoff + 0x0c) 129
