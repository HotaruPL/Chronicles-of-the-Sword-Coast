    STR_VAR actor_name=QCDELIF script_override=QCDLNEU dlg_file=QCDELIF
  END
  // New exit near X=552,Y=2716 -> QCICEA.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 552
      fj_loc_y = 2716
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name = QCICEAOUT
  END
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 520
      fj_box_top = 2684
      fj_box_right = 584
      fj_box_bottom = 2748
      fj_cursor_idx = 34
      fj_flags = 4
      fj_vertex_0 = 520 + (2684 << 16)
      fj_vertex_1 = 584 + (2684 << 16)
      fj_vertex_2 = 584 + (2748 << 16)
      fj_vertex_3 = 520 + (2748 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = QCICEAEXIT
      fj_destination_area = QCICEA
      fj_destination_name = QCICEAIN
  END
BUT_ONLY_IF_IT_CHANGES

// ============================================================
// Ervin, the gnomish wizard
// ============================================================
// Use the exact proven Kyril method from the working Durlag's Tower
// component: LOVE.CRE is the talking-creature base. We do NOT transplant
// script fields from another creature and we do NOT attach a custom BAF.
// Only the appearance, identity and dialogue are changed.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~LOVE.CRE~ BEGIN
  FAIL @20138
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~MADARC.CRE~ BEGIN
  FAIL @20139
END

COPY_EXISTING ~MADARC.CRE~ ~override/__QCMAD.TMP~
  READ_LONG 0x28 ~qc_mad_anim~
  READ_BYTE 0x2c ~qc_mad_metal~
  READ_BYTE 0x2d ~qc_mad_minor~
  READ_BYTE 0x2e ~qc_mad_major~
  READ_BYTE 0x2f ~qc_mad_skin~
  READ_BYTE 0x30 ~qc_mad_leather~
  READ_BYTE 0x31 ~qc_mad_armor~
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~LOVE.CRE~ ~override/QCERVIN.CRE~
  WRITE_ASCII 0x2e8 ~QCERVIN~ #32
  SAY NAME1 @4016
  SAY NAME2 @4016
  WRITE_LONG 0x28 ~qc_mad_anim~
  WRITE_BYTE 0x2c ~qc_mad_metal~
  WRITE_BYTE 0x2d ~qc_mad_minor~
  WRITE_BYTE 0x2e ~qc_mad_major~
  WRITE_BYTE 0x2f ~qc_mad_skin~
  WRITE_BYTE 0x30 ~qc_mad_leather~
  WRITE_BYTE 0x31 ~qc_mad_armor~
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCERVIN~ #32
  WRITE_ASCII 0x2cc ~QCERVIN~ #8
BUT_ONLY_IF_IT_CHANGES

