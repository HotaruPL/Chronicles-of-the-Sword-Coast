// Non-hostile dog.
COPY_EXISTING ~DOGWIL01.CRE~ ~override/BIFDOG01.CRE~
  SAY NAME1 @1033
  SAY NAME2 @1033
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~BIFDOG01~ #32
  WRITE_ASCII 0x248 ~QCFWAND~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

// Ravoc — exact BDRAVOC chassis; neutral until the third conversation.
COPY_EXISTING ~BDRAVOC.CRE~ ~override/BIFRAVOC.CRE~
