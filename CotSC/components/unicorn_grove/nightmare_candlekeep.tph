COPY_EXISTING ~DREPPI2.CRE~ ~override/QCDREPP.CRE~
  SAY NAME1 @3072
  SAY NAME2 @3072
  WRITE_SHORT 0x24 86
  WRITE_SHORT 0x26 86
  WRITE_BYTE 0x270 255
  WRITE_BYTE 0x27b 35 // neutral evil
  WRITE_BYTE 0x273 2  // Fighter class, not inherited INNOCENT
  WRITE_BYTE 0x7f 0 // BGEE reputation change when killed: none
  WRITE_BYTE 0x44 0
  WRITE_ASCII 0x280 ~QCDREPP~ #32
  WRITE_ASCII 0x248 ~QCHDRAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_LONG 0x20 0x20000000 // BLUR state
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~IMOEN2.CRE~ ~override/QCDIMOE.CRE~
  SAY NAME1 @3073
  SAY NAME2 @3073
  WRITE_LONG 0x14 7000
  WRITE_LONG 0x1c 0
  WRITE_SHORT 0x24 110
  WRITE_SHORT 0x26 110
  WRITE_LONG 0x28 0x6210 // MAGE_FEMALE_HUMAN; soundset remains from IMOEN2.CRE
  WRITE_BYTE 0x270 128 // neutral for dialogue; hostile only after final line
  WRITE_BYTE 0x27b 51 // chaotic evil
  WRITE_BYTE 0x44 0
  WRITE_LONG 0x20 0x20008000 // permanent blur + haste states
  WRITE_ASCII 0x280 ~QCDIMOE~ #32
  WRITE_ASCII 0x2cc ~QCHDARK~ #8
  WRITE_ASCII 0x248 ~QCHDIMAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_ASCII 0x34 ~QCDIMOS~ #8
  WRITE_ASCII 0x3c ~QCDIMOL~ #8
  WRITE_BYTE 0x2c 0 // metal
  WRITE_BYTE 0x2d 0 // minor clothing: black
  WRITE_BYTE 0x2e 0 // major clothing: black
  WRITE_BYTE 0x30 0 // leather: black
  WRITE_BYTE 0x31 0 // armor: black
  WRITE_BYTE 0x32 105 // EET white colour gradient, not the old brown index 39
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~CLCK17~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~ARMOR~ EQUIP
  ADD_CRE_ITEM ~DAGG15~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~WEAPON1~ EQUIP
BUT_ONLY_IF_IT_CHANGES

// Stackable +2 throwing axe for QCHST1, based on the consumable
// stock AX1H04 rather than the returning/non-stackable AX1H05.
COPY_EXISTING ~AX1H04.ITM~ ~override/QCHAX2.ITM~
  SAY NAME1 @3074
  SAY NAME2 @3075
  SAY IDENTIFIED_DESC @3076
  READ_LONG 0x18 qc_axe_flags
  WRITE_LONG 0x18 (qc_axe_flags BOR 0x40) // magical
  WRITE_SHORT 0x38 40                   // stack cap
  WRITE_LONG 0x60 2                     // enchantment +2
  READ_LONG 0x64 qc_axe_ability_offset
  READ_SHORT 0x68 qc_axe_ability_count
  FOR (i = 0; i < qc_axe_ability_count; i += 1) BEGIN
    WRITE_SHORT (qc_axe_ability_offset + i * 0x38 + 0x14) 2 // THAC0 +2
    WRITE_SHORT (qc_axe_ability_offset + i * 0x38 + 0x1a) 2 // damage +2
  END
BUT_ONLY_IF_IT_CHANGES

// No STALKE narration proxy: QCHLAR.BAF performs the arrival narration.
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCHLAR.baf~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/scripts/QCHLAR.tra~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCHINAR.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCHDRAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCHDIMAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/dialogue/QCHINTRO.d~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QCHINTRO.tra~
COMPILE ~CotSC/qc_unicorn_grove/dialogue/QCHIMTR.d~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QCHIMTR.tra~
COMPILE ~CotSC/qc_unicorn_grove/dialogue/QCHDARK.d~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/QCHDARK.tra~

// Only the song table and area-script pointer are overwritten in existing QCHELL ARE data.
COPY_EXISTING ~QCHELL.ARE~ ~override/QCHELL.ARE~
  WRITE_ASCII 0x94 ~QCHLAR~ #8
  READ_LONG 0xbc qch_song_table
  PATCH_IF (qch_song_table > 0) AND (qch_song_table + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG (qch_song_table + 0) %QCH_AMBIENT%
    WRITE_LONG (qch_song_table + 4) %QCH_AMBIENT%
    WRITE_LONG (qch_song_table + 8) %QCH_VICTORY%
    WRITE_LONG (qch_song_table + 12) %QCH_BATTLE%
  END ELSE BEGIN
    PATCH_FAIL @20288
  END
