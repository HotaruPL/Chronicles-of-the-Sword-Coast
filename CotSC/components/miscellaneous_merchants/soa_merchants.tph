// A small independent script slot on the ORIGINAL bartender relays his hostile state.
// No dialogue, existing quests, stores or other scripts are replaced.
COMPILE ~CotSC/QCMM/scripts/QCMMBAR.baf~
COMPILE ~CotSC/QCMM/scripts/QCMMULV.baf~
COPY_EXISTING ~UDDROW22.CRE~ ~override~
  LPF ADD_CRE_SCRIPT STR_VAR script = ~QCMMBAR~ RET success END
  PATCH_IF (success != 1) BEGIN
    PATCH_WARN @20342
  END

