// Brown-palette Half-Elf Commoner.
COPY_EXISTING ~GAXIR.CRE~ ~override/QC10HLF.CRE~
  SAY NAME1 @3015
  SAY NAME2 @3015
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QC10HLF~ #8
  WRITE_ASCII 0x280 ~QC10HLF~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x2d 21
  WRITE_BYTE 0x2e 20
  WRITE_BYTE 0x30 21
  WRITE_BYTE 0x31 20
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
