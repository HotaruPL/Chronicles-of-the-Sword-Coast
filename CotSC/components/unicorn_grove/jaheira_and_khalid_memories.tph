// ---------- Integrated milestone: QC: Distorted Memories of Jaheira and Khalid (QCJHR1)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCHELL.ARE~ BEGIN FAIL ~Install Nightmare Candlekeep before this component.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG2301.WED~ BEGIN FAIL ~Native BG2301 graphics are required (the uploaded BG2301.ARE uses BG2301.WED).~ END
// ARE-to-search/light/height map names follow the new area resref, not its original WED.
// Duplicate native BMPs under QCJHR1 so rendering/pathfinding work with the copied area.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG2301SR.BMP~ BEGIN FAIL ~Original BG2301 search map missing.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG2301LM.BMP~ BEGIN FAIL ~Original BG2301 light map missing.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG2301HT.BMP~ BEGIN FAIL ~Original BG2301 height map missing.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~UDOGRE.CRE~ BEGIN FAIL ~UDOGRE.CRE required for Ogre Warrior.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~ASHIRU.CRE~ BEGIN FAIL ~ASHIRU.CRE required for Ashirukuru; no Shadow substitution will be used.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDBONBAT.CRE~ BEGIN FAIL ~BDBONBAT.CRE required for Bonebats; no Shadow substitution will be used.~ END
COPY_EXISTING ~BG2301SR.BMP~ ~override/QCJHR1SR.BMP~
COPY_EXISTING ~BG2301LM.BMP~ ~override/QCJHR1LM.BMP~
COPY_EXISTING ~BG2301HT.BMP~ ~override/QCJHR1HT.BMP~

// Separate registrations point to the SAME three music files used by QCHELL.
// Component-local ids are required because v14 can be installed separately from component 3.
ADD_MUSIC ~QCJ_AMBIENT~ ~CotSC/qc_unicorn_grove/music/QCHAMB.MUS~
ADD_MUSIC ~QCJ_BATTLE~ ~CotSC/qc_unicorn_grove/music/QCHBTL.MUS~
ADD_MUSIC ~QCJ_VICTORY~ ~CotSC/qc_unicorn_grove/music/QCHEND.MUS~

// The custom +2 sword keeps the base item's stats, adding only acid damage on hit.
COPY_EXISTING ~SW1H41.ITM~ ~override/QCJKWR.ITM~
  SAY NAME1 @3077
  SAY NAME2 @3078
  SAY IDENTIFIED_DESC @3079
  LPF ADD_ITEM_EFFECT INT_VAR type = 1 header = 1 opcode = 12 target = 2 timing = 1 parameter1 = 1 parameter2 = 65536 probability1 = 100 END
BUT_ONLY_IF_IT_CHANGES

// Use the exact real creature templates from this installation. NEVER rename Shadows.
COPY_EXISTING ~ASHIRU.CRE~ ~override/QCJASHI.CRE~
  SAY NAME1 @3080
  SAY NAME2 @3080
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCJASHI~ #32
  WRITE_ASCII 0x248 ~QCJHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~BDBONBAT.CRE~ ~override/QCJBONE.CRE~
  SAY NAME1 @3081
  SAY NAME2 @3081
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCJBONE~ #32
  WRITE_ASCII 0x248 ~QCJHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Devil Shade: prefer an installed exact creature. A substitute is clearly identified if unavailable.
ACTION_IF FILE_EXISTS_IN_GAME ~DEVLSHD.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJDEVS ~DEVLSHD.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~DEVILSHD.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJDEVS ~DEVILSHD.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~DEVSHAD.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJDEVS ~DEVSHAD.CRE~
END ELSE BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~SHADOW01.CRE~ BEGIN
    OUTER_SPRINT qc_src_QCJDEVS ~SHADOW01.CRE~
  END ELSE BEGIN
    OUTER_SPRINT qc_src_QCJDEVS ~QCHSHAD.CRE~
  END
END
COPY_EXISTING ~%qc_src_QCJDEVS%~ ~override/QCJDEVS.CRE~
  SAY NAME1 @3082
  SAY NAME2 @3082
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCJDEVS~ #32
  WRITE_ASCII 0x248 ~QCJHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~QCHSHAD.CRE~ ~override/QCJSHAD.CRE~
  SAY NAME1 @3083
  SAY NAME2 @3083
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCJSHAD~ #32
  WRITE_ASCII 0x248 ~QCJHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~QCHBHOR.CRE~ ~override/QCJBHOR.CRE~
  SAY NAME1 @3084
  SAY NAME2 @3084
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCJBHOR~ #32
  WRITE_ASCII 0x248 ~QCJHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~UDOGRE.CRE~ ~override/QCJOGRE.CRE~
  SAY NAME1 @3085
  SAY NAME2 @3085
  // UDOGRE is a scripted source creature: strip invulnerability and minimum-HP protection.
  READ_LONG 0x96 qcj_ogre_attributes
  WRITE_LONG 0x96 (qcj_ogre_attributes BAND 0xfffffdff) // remove Invulnerable, bit 9
  READ_LONG 0x10 qcj_ogre_flags
  WRITE_LONG 0x10 (qcj_ogre_flags BAND 0xfffdffff) // remove legacy invulnerability flag
  WRITE_SHORT 0x24 95
  WRITE_SHORT 0x26 95
  LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete = 208 END // Minimum HP limit

  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCJOGRE~ #32
  WRITE_ASCII 0x248 ~QCJHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

ACTION_IF FILE_EXISTS_IN_GAME ~JAHEIR.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJJAHR ~JAHEIR.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~JAHEIR2.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJJAHR ~JAHEIR2.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~JAHEIR15.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJJAHR ~JAHEIR15.CRE~
END ELSE BEGIN
  FAIL @20291
END
ACTION_IF FILE_EXISTS_IN_GAME ~KHALID.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJKHAL ~KHALID.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~KHALID2.CRE~ BEGIN
  OUTER_SPRINT qc_src_QCJKHAL ~KHALID2.CRE~
END ELSE BEGIN
  FAIL @20292
END
COPY_EXISTING ~%qc_src_QCJJAHR%~ ~override/QCJJAHR.CRE~
  SAY NAME1 @3086
  SAY NAME2 @3086
  WRITE_LONG 0x14 11000
  WRITE_SHORT 0x24 130
  WRITE_SHORT 0x26 130
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x27b 51
  WRITE_BYTE 0x32 105 // white hair
  WRITE_BYTE 0x2d 110 // pale-major clothing
  WRITE_BYTE 0x2e 110
  WRITE_LONG 0x20 0x20000000 // blur visual state
  WRITE_ASCII 0x280 ~QCJJAHR~ #32
  WRITE_ASCII 0x2cc ~QCJJAHE~ #8
  WRITE_ASCII 0x248 ~QCJJAIA~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~CHAN18~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~ EQUIP
  ADD_CRE_ITEM ~BLUN04~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~
  ADD_CRE_ITEM ~HELM01~ #0 #0 #0 ~IDENTIFIED~ ~HELMET~ EQUIP
  ADD_CRE_ITEM ~SLNG04~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON2~ EQUIP
  ADD_CRE_ITEM ~BULL03~ #30 #0 #0 ~IDENTIFIED~ ~QUIVER1~ EQUIP
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~%qc_src_QCJKHAL%~ ~override/QCJKHAL.CRE~
  SAY NAME1 @3087
  SAY NAME2 @3087
  WRITE_LONG 0x14 11000
  WRITE_SHORT 0x24 140
  WRITE_SHORT 0x26 140
  WRITE_BYTE 0x52 5 // THAC0 5; lower is better, makes him hit reliably
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x27b 51
  WRITE_BYTE 0x2d 0
  WRITE_BYTE 0x2e 0
  WRITE_BYTE 0x238 25 // Strength
  WRITE_LONG 0x20 0x20008000 // blur and permanent haste
  WRITE_ASCII 0x280 ~QCJKHAL~ #32
  WRITE_ASCII 0x2cc ~QCJKHAL~ #8
  WRITE_ASCII 0x248 ~QCJKHAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~PLAT05~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~ EQUIP
  ADD_CRE_ITEM ~SHLD26~ #0 #0 #0 ~IDENTIFIED~ ~SHIELD~ EQUIP
  ADD_CRE_ITEM ~QCJKWR~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/qc_unicorn_grove/scripts/QCJAR.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCJHOST.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCJKHAI.baf~
