LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_bg2_quests_and_districts.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR2000.ARE~ BEGIN
  FAIL @20340
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR2010.ARE~ BEGIN
  FAIL @20341
END

COMPILE ~CotSC/qc_better_immersion_trademeet/scripts/QCTWAND.baf~
COMPILE ~CotSC/qc_better_immersion_trademeet/scripts/QCTACOL.baf~
COMPILE ~CotSC/qc_better_immersion_trademeet/scripts/QCTHODR.baf~
ADD_JOURNAL TITLE (@1) @2 @3 USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_trademeet/dialogue/QCTRADE.tra~
COMPILE ~CotSC/qc_better_immersion_trademeet/dialogue/QCTRADE.d~ USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_trademeet/dialogue/QCTRADE.tra~

// Child's body quest item.
COPY_EXISTING ~MISC54.ITM~ ~override/QCTBODY.ITM~
  SAY NAME1 @3147
  SAY NAME2 @3147
  SAY DESC @3148
  SAY IDENTIFIED_DESC @3148
BUT_ONLY_IF_IT_CHANGES

// Half-Elven Commoner.
COPY_EXISTING ~RINNIE.CRE~ ~override/QCTHCOM.CRE~
  SAY NAME1 @3149
  SAY NAME2 @3149
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QCTHCOM~ #8
  WRITE_ASCII 0x280 ~QCTHCOM~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

