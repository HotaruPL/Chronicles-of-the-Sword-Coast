COPY ~CotSC/better_immersion_beregost/area/TRMCR01.PVRZ~ ~override/TRMCR01.PVRZ~
COPY ~CotSC/better_immersion_beregost/area/TORMCHSR.BMP~ ~override/TORMCHSR.BMP~
