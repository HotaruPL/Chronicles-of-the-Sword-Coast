// v22.1: new final-memory temple interior, crash-fixed page layout.

// ---------- Integrated milestone: QC: Bhaal's Temple - Interior final memory area render test (QCBTEM)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBHAL.ARE~ BEGIN FAIL ~Install the working QCBHAL forest components first.~ END

COPY ~CotSC/qc_unicorn_grove/area/QCBTEM.ARE~ ~override/QCBTEM.ARE~
COPY ~CotSC/qc_unicorn_grove/area/QCBTEM.WED~ ~override/QCBTEM.WED~
COPY ~CotSC/qc_unicorn_grove/area/QCBTEM.TIS~ ~override/QCBTEM.TIS~
COPY ~CotSC/qc_unicorn_grove/area/QCBTEMSR.BMP~ ~override/QCBTEMSR.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCBTEMLM.BMP~ ~override/QCBTEMLM.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCBTEMHT.BMP~ ~override/QCBTEMHT.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QBTEM00.PVRZ~ ~override/QBTEM00.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QBTEM01.PVRZ~ ~override/QBTEM01.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QBTEM02.PVRZ~ ~override/QBTEM02.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QBTEM03.PVRZ~ ~override/QBTEM03.PVRZ~

COPY_EXISTING ~QCBTEM.ARE~ ~override/QCBTEM.ARE~
  READ_LONG 0xbc qcbtem_song_table
  PATCH_IF (qcbtem_song_table > 0) AND (qcbtem_song_table + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG (qcbtem_song_table + 0) %QCB_AMBIENT%
    WRITE_LONG (qcbtem_song_table + 4) %QCB_AMBIENT%
    WRITE_LONG (qcbtem_song_table + 8) %QCB_VICTORY%
    WRITE_LONG (qcbtem_song_table + 12) %QCB_BATTLE%
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 768 fj_loc_y = 965 fj_orientation = 0
    STR_VAR fj_structure_type = entrance fj_name = QBTENTR
  END
  LPF fj_are_structure
    INT_VAR fj_type = 2 fj_box_left = 604 fj_box_top = 980
      fj_box_right = 934 fj_box_bottom = 1110
      fj_cursor_idx = 30 fj_flags = 4
      fj_vertex_0 = 604 + (980 << 16)
      fj_vertex_1 = 934 + (980 << 16)
      fj_vertex_2 = 934 + (1110 << 16)
      fj_vertex_3 = 604 + (1110 << 16)
    STR_VAR fj_structure_type = region fj_name = QBTEXIT
      fj_destination_area = QCBHAL fj_destination_name = QCBTIN
  END
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~QCBHAL.ARE~ ~override/QCBHAL.ARE~
  READ_LONG 0x5c qcbhal_regions_off
  READ_SHORT 0x5a qcbhal_regions_num
  FOR (qcbhal_i = 0; qcbhal_i < qcbhal_regions_num; qcbhal_i += 1) BEGIN
    SET qcbhal_r = qcbhal_regions_off + (qcbhal_i * 0xc4)
    READ_ASCII qcbhal_r qcbhal_name (32) NULL
    PATCH_IF (~%qcbhal_name%~ STRING_EQUAL ~QCBTDOOR~) BEGIN
      LPF fj_are_structure
        INT_VAR fj_delete_mode = qcbhal_i
        STR_VAR fj_structure_type = region
      END
      SET qcbhal_i = qcbhal_regions_num
    END
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 1370 fj_loc_y = 555 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCBTIN
  END
  LPF fj_are_structure
    INT_VAR fj_type = 2 fj_box_left = 1348 fj_box_top = 477
      fj_box_right = 1392 fj_box_bottom = 513 fj_cursor_idx = 30 fj_flags = 4
      fj_vertex_0 = 1348 + (477 << 16)
      fj_vertex_1 = 1392 + (477 << 16)
      fj_vertex_2 = 1392 + (513 << 16)
      fj_vertex_3 = 1348 + (513 << 16)
    STR_VAR fj_structure_type = region fj_name = QCBTDOOR
      fj_destination_area = QCBTEM fj_destination_name = QBTENTR
  END
BUT_ONLY_IF_IT_CHANGES

// Public installer: development progress message omitted.

// v23: The final ritual memory. Does NOT reinstall QCBTEM WED/TIS/PVRZ/SR/LM/HT.

// ---------- Integrated milestone: QC: Bhaal's Temple - Final Memory Ritual Encounter (QCBTEM)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBTEM.ARE~ BEGIN FAIL ~Install the working QCBTEM interior first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBHAL.ARE~ BEGIN FAIL ~Install the forest approach first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~ZEELA.CRE~ BEGIN FAIL ~ZEELA.CRE is required for Alianna.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDMADELE.CRE~ BEGIN FAIL ~BDMADELE.CRE is required for Madele.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~TAUGOS.CRE~ BEGIN FAIL ~TAUGOS.CRE is required for the cultists.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~DAESE.CRE~ BEGIN FAIL ~DAESE.CRE is required for female cultists.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~GORION.CRE~ BEGIN FAIL ~GORION.CRE is required for this memory.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~TANARI01.CRE~ BEGIN FAIL ~TANARI01.CRE is required for the temple guardians.~ END

// Child base resources vary between BGEE/EET installs; never require
// BOY01/CHILD01/GIRL01/CHILD02 to exist.
// Prefer real existing child creatures, then fall back to the creature files
// already REQUIRED by this component. All three resulting actors receive
// actual BOY/GIRL animation IDs below, regardless of the copied base.
ACTION_IF FILE_EXISTS_IN_GAME ~CHILNA.CRE~ BEGIN
 OUTER_SPRINT qbt_boy_base ~CHILNA.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~CHILDULG.CRE~ BEGIN
 OUTER_SPRINT qbt_boy_base ~CHILDULG.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~BOY01.CRE~ BEGIN
 OUTER_SPRINT qbt_boy_base ~BOY01.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~CHILD01.CRE~ BEGIN
 OUTER_SPRINT qbt_boy_base ~CHILD01.CRE~
END ELSE BEGIN
 OUTER_SPRINT qbt_boy_base ~TAUGOS.CRE~
END
ACTION_IF FILE_EXISTS_IN_GAME ~GIRL01.CRE~ BEGIN
 OUTER_SPRINT qbt_girl_base ~GIRL01.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~CHILD02.CRE~ BEGIN
 OUTER_SPRINT qbt_girl_base ~CHILD02.CRE~
END ELSE BEGIN
 OUTER_SPRINT qbt_girl_base ~DAESE.CRE~
END

MKDIR ~music/QBTBOS~
COPY ~CotSC/qc_unicorn_grove/music/QBTBOSA.acm~ ~music/QBTBOS/QBTBOSA.acm~
ADD_MUSIC ~QBT_BOSS~ ~CotSC/qc_unicorn_grove/music/QBTBOS.MUS~

// Clear inherited equipment on the two named ritualists and equip requested items.
COPY_EXISTING ~ZEELA.CRE~ ~override/QBTALIA.CRE~
  SAY NAME1 @3095
  SAY NAME2 @3095
  WRITE_BYTE 0x270 128
  WRITE_LONG 0x20 0
  WRITE_ASCII 0x280 ~QBTALIA~ #32
  WRITE_ASCII 0x2cc ~QBTALIA~ #8
  WRITE_ASCII 0x248 ~QBTALAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~PLAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
  ADD_CRE_ITEM ~SLNG02~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~BULL02~ #50 #0 #0 ~IDENTIFIED~ ~QUIVER1~
  ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM1~
  ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM2~
  ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM3~
  ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~INV1~
  ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~INV2~
BUT_ONLY_IF_IT_CHANGES

