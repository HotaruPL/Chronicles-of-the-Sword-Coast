// v31: Imoen begins dialogue using her actual party slot.
// Dialogue file temporarily overridden, original joined DLG untouched.
// Fallback retries if a conversation cannot start, until dialogue ends (flag=2).
IF
  Global("QCH_ROOM_DONE","GLOBAL",1)
  Global("QCH_IMROOM","GLOBAL",0)
  Name("Imoen2",Player2)
  InMyArea(Player2)
  CombatCounter(0)
THEN
  RESPONSE #100
    SetGlobal("QCH_IMROOM","GLOBAL",1)
    RealSetGlobalTimer("QC31IMRM","GLOBAL",8)
    ActionOverride(Player2,StartDialogOverride("QCHIMTR",Player1))
END
