// ====================================================================
// PART 3/7: v2.2a outdoor dialogue, loot, NPCs
// ====================================================================

// Requires v2.1 already installed. This add-on does not overwrite any area art or music.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCRIVD.ARE~ BEGIN
  FAIL @20176
END
COMPILE ~CotSC/qc_river_people/dialogue/qrivd_npcs.d~ USING ~CotSC/translation/%LANGUAGE%/qc_river_people/dialogue/qrivd_npcs.tra~
COMPILE ~CotSC/qc_river_people/scripts/QRVROAM.baf~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~FTWBAX_C.CRE~ BEGIN
  FAIL @20177
END
COPY_EXISTING ~FTWBAX_C.CRE~ ~override/QRVWF1.CRE~
  SAY NAME1 @3005
  SAY NAME2 @3005
  WRITE_ASCII 0x2cc ~QRVWF1~ #8
  WRITE_ASCII 0x280 ~QRVWF1~ #32
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x2d 47
  WRITE_BYTE 0x2e 47
BUT_ONLY_IF_IT_CHANGES

