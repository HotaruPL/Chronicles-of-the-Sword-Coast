COMPILE ~CotSC/better_immersion_beregost/TORMWAND.baf~
COMPILE ~CotSC/better_immersion_beregost/tormha_npcs.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/tormha_npcs.tra~

COPY ~CotSC/better_immersion_beregost/area/TORMHA.ARE~ ~override/TORMHA.ARE~

// Torm's Hand enterable house interiors. Cleaned copies of vanilla interiors.
COPY ~CotSC/better_immersion_beregost/area/T48A01.ARE~ ~override/T48A01.ARE~
COPY ~CotSC/better_immersion_beregost/area/T18A01.ARE~ ~override/T18A01.ARE~
COPY ~CotSC/better_immersion_beregost/area/T48A02.ARE~ ~override/T48A02.ARE~
COPY ~CotSC/better_immersion_beregost/area/T48B01.ARE~ ~override/T48B01.ARE~

// Torm's Hand tavern: use a dedicated clone of the supplied BG4801 ARE.
// The clone keeps the vanilla BG4801 WED/TIS visual chain, but has no embedded
// actors, no area script, and no item records. The five container objects remain
// in place and are empty.
COPY ~CotSC/better_immersion_beregost/area/BIBG4801.ARE~ ~override/BIBG4801.ARE~
COPY_EXISTING ~BIBG4801.ARE~ ~override/BIBG4801.ARE~
  WRITE_ASCII 0x94 ~BIBTAVSC~ #8
BUT_ONLY_IF_IT_CHANGES


// Torm's Hand - Fortress of Torm custom sanctuary audio.
// Use the supplied BG1 temple playlist and its TEMPLEA ambience.
COPY ~CotSC/better_immersion_beregost/TEMPLEA.ACM~ ~music/TEMPLE/TEMPLEA.ACM~
ADD_MUSIC TORMTEMPLE ~CotSC/better_immersion_beregost/TEMPLE.mus~


// ---------------------------------------------------------------------------
// STAGE 23 - TORMHA WORLD-MAP EXIT REGIONS
// ---------------------------------------------------------------------------
// Two edge travel wheels. These are the actual world-map exits from TORMHA.
// The gear cursor is retained, but the destination fields are deliberately
// blank: these are world-map travel triggers, not direct area transitions.
COPY_EXISTING ~TORMHA.ARE~ ~override/TORMHA.ARE~
  LPF ALTER_AREA_REGION
    INT_VAR
      cursor = 34
    STR_VAR
      region_name = ~TORMWORLDN~
      destination_area = ~ ~
      entrance_name = ~ ~
  END
  LPF ALTER_AREA_REGION
    INT_VAR
      cursor = 34
    STR_VAR
      region_name = ~TORMWORLDS~
      destination_area = ~ ~
      entrance_name = ~ ~
  END
BUT_ONLY_IF_IT_CHANGES

// Torm's Hand - Fortress of Torm custom sanctuary.
// Standalone custom area; no TORMHA source changes are made here.
COPY ~CotSC/better_immersion_beregost/area/TORMFO.ARE~ ~override/TORMFO.ARE~
COPY_EXISTING ~TORMFO.ARE~ ~override/TORMFO.ARE~
  WRITE_ASCII 0x94 ~TORMFOSC~ #8
  READ_LONG 0xBC tormfo_song_off
  WRITE_LONG "%tormfo_song_off%" %TORMTEMPLE%
  WRITE_LONG ("%tormfo_song_off%" + 0x04) %TORMTEMPLE%
  WRITE_SHORT 0x82 0
  // FROZEN: TORMHA -> TORMFO uses TORMBACK at 589,914.
  // TORMCH -> TORMFO gets its own separate entrance below.
  WRITE_SHORT 0x310 589
  WRITE_SHORT 0x312 914
  WRITE_ASCII ("%tormfo_song_off%" + 0x28) ~ ~ #8
  WRITE_ASCII ("%tormfo_song_off%" + 0x30) ~ ~ #8
  WRITE_ASCII ("%tormfo_song_off%" + 0x3C) ~ ~ #8
  WRITE_ASCII ("%tormfo_song_off%" + 0x44) ~ ~ #8
  WRITE_LONG ("%tormfo_song_off%" + 0x38) 0
  WRITE_LONG ("%tormfo_song_off%" + 0x4C) 0

  // Separate arrival point for TORMCH -> TORMFO. This prevents the two
  // different exits from overwriting one another's destination coordinates.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1007
      fj_loc_y = 339
      fj_orientation = 8
    STR_VAR
      fj_structure_type = entrance
      fj_name = TORMCHBACK
  END
BUT_ONLY_IF_IT_CHANGES
COPY ~CotSC/better_immersion_beregost/area/TORMFO.WED~ ~override/TORMFO.WED~
COPY ~CotSC/better_immersion_beregost/area/TORMFO.TIS~ ~override/TORMFO.TIS~
COPY ~CotSC/better_immersion_beregost/area/TRMFO00.PVRZ~ ~override/TRMFO00.PVRZ~
COPY ~CotSC/better_immersion_beregost/area/TRMFO01.PVRZ~ ~override/TRMFO01.PVRZ~
DELETE ~TRMFO02.PVRZ~
DELETE ~TRMFO03.PVRZ~
DELETE ~TRMFO04.PVRZ~
DELETE ~TRMFO05.PVRZ~
DELETE ~TRMFO06.PVRZ~
COPY ~CotSC/better_immersion_beregost/area/TORMFOSR.BMP~ ~override/TORMFOSR.BMP~
COPY ~CotSC/better_immersion_beregost/area/TORMFOLM.BMP~ ~override/TORMFOLM.BMP~
COPY ~CotSC/better_immersion_beregost/area/TORMFOHT.BMP~ ~override/TORMFOHT.BMP~

// TORM'S HAND - circular chamber baseline (artwork only; details to follow)
COPY ~CotSC/better_immersion_beregost/area/TORMCH.ARE~ ~override/TORMCH.ARE~
COPY ~CotSC/better_immersion_beregost/area/TORMCH.WED~ ~override/TORMCH.WED~
