// Gnome Beggar - requested GELLAN chassis, recolored. Some EET installs may not
// contain GELLAN unless the BG1 source/mod that provides it is present, so keep
// a harmless gnome-commoner fallback instead of making the whole component fail.
ACTION_IF FILE_EXISTS_IN_GAME ~GELLAN.CRE~ BEGIN
  COPY_EXISTING ~GELLAN.CRE~ ~override/QC50GBEG.CRE~
    SAY NAME1 @3124
    SAY NAME2 @3124
    WRITE_BYTE 0x270 128
    WRITE_ASCII 0x2cc ~QC50GBEG~ #8
    WRITE_ASCII 0x280 ~QC50GBEG~ #32
    WRITE_ASCII 0x248 ~ ~ #8
    WRITE_ASCII 0x250 ~ ~ #8
    WRITE_ASCII 0x258 ~ ~ #8
    WRITE_ASCII 0x260 ~ ~ #8
    WRITE_ASCII 0x268 ~ ~ #8
    WRITE_BYTE 0x2d 34
    WRITE_BYTE 0x2e 47
    WRITE_BYTE 0x30 34
    WRITE_BYTE 0x31 47
    REMOVE_CRE_ITEMS
    SAY INITIAL_MEETING ~ ~
    SAY SELECT_COMMON1 ~ ~
  BUT_ONLY_IF_IT_CHANGES
END ELSE BEGIN
  COPY_EXISTING ~BENTLY.CRE~ ~override/QC50GBEG.CRE~
    SAY NAME1 @3124
    SAY NAME2 @3124
    WRITE_BYTE 0x270 128
    WRITE_ASCII 0x2cc ~QC50GBEG~ #8
    WRITE_ASCII 0x280 ~QC50GBEG~ #32
    WRITE_ASCII 0x248 ~ ~ #8
    WRITE_ASCII 0x250 ~ ~ #8
    WRITE_ASCII 0x258 ~ ~ #8
    WRITE_ASCII 0x260 ~ ~ #8
    WRITE_ASCII 0x268 ~ ~ #8
    WRITE_BYTE 0x2d 34
    WRITE_BYTE 0x2e 47
    WRITE_BYTE 0x30 34
    WRITE_BYTE 0x31 47
    REMOVE_CRE_ITEMS
    SAY INITIAL_MEETING ~ ~
    SAY SELECT_COMMON1 ~ ~
  BUT_ONLY_IF_IT_CHANGES
END

