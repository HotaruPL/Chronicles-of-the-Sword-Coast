COPY_EXISTING ~AR2000.ARE~ ~override~
  LPF fj_are_structure INT_VAR fj_loc_x=2645 fj_loc_y=2176 fj_dest_x=2645 fj_dest_y=2176 fj_orientation=2 STR_VAR fj_structure_type=actor fj_name=QCTHCOM fj_cre_resref=QCTHCOM fj_dlg_resref=QCTHCOM END
  LPF fj_are_structure INT_VAR fj_loc_x=2606 fj_loc_y=2196 fj_dest_x=2606 fj_dest_y=2196 fj_orientation=10 STR_VAR fj_structure_type=actor fj_name=QCTHUM fj_cre_resref=QCTHUM fj_dlg_resref=QCTHUM END
  LPF fj_are_structure INT_VAR fj_loc_x=2010 fj_loc_y=1930 fj_dest_x=2010 fj_dest_y=1930 fj_orientation=4 STR_VAR fj_structure_type=actor fj_name=QCTORC fj_cre_resref=QCTORC fj_dlg_resref=QCTORC END
  LPF fj_are_structure INT_VAR fj_loc_x=2240 fj_loc_y=1173 fj_dest_x=2240 fj_dest_y=1173 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTGNOL fj_cre_resref=QCTGNOL fj_dlg_resref=QCTGNOL END
  LPF fj_are_structure INT_VAR fj_loc_x=2247 fj_loc_y=1217 fj_dest_x=2247 fj_dest_y=1217 fj_orientation=8 STR_VAR fj_structure_type=actor fj_name=QCTFEM fj_cre_resref=QCTFEM fj_dlg_resref=QCTFEM END
  LPF fj_are_structure INT_VAR fj_loc_x=1487 fj_loc_y=1202 fj_dest_x=1487 fj_dest_y=1202 fj_orientation=4 STR_VAR fj_structure_type=actor fj_name=QCTTIEF fj_cre_resref=QCTTIEF fj_dlg_resref=QCTTIEF END
  LPF fj_are_structure INT_VAR fj_loc_x=1442 fj_loc_y=1197 fj_dest_x=1442 fj_dest_y=1197 fj_orientation=12 STR_VAR fj_structure_type=actor fj_name=QCTHALF fj_cre_resref=QCTHALF fj_dlg_resref=QCTHALF END
  LPF fj_are_structure INT_VAR fj_loc_x=1032 fj_loc_y=2178 fj_dest_x=1032 fj_dest_y=2178 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTDOG fj_cre_resref=QCTDOG fj_bcs_override=QCTWAND END
  LPF fj_are_structure INT_VAR fj_loc_x=1995 fj_loc_y=3012 fj_dest_x=1995 fj_dest_y=3012 fj_orientation=8 STR_VAR fj_structure_type=actor fj_name=QCTKOB1 fj_cre_resref=QCTKOB1 fj_dlg_resref=QCTKOB1 END
  LPF fj_are_structure INT_VAR fj_loc_x=2948 fj_loc_y=1057 fj_dest_x=2948 fj_dest_y=1057 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTKOB2 fj_cre_resref=QCTKOB2 fj_dlg_resref=QCTKOB2 fj_bcs_override=QCTWAND END
  LPF fj_are_structure INT_VAR fj_loc_x=1575 fj_loc_y=260 fj_dest_x=1575 fj_dest_y=260 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTHODR fj_cre_resref=QCTHODR fj_dlg_resref=QCTHODR fj_bcs_override=QCTHODR END
  LPF fj_are_structure INT_VAR fj_loc_x=1516 fj_loc_y=215 fj_dest_x=1516 fj_dest_y=215 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTAC1 fj_cre_resref=QCTAC1 fj_bcs_override=QCTACOL END
  LPF fj_are_structure INT_VAR fj_loc_x=1621 fj_loc_y=213 fj_dest_x=1621 fj_dest_y=213 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTAC2 fj_cre_resref=QCTAC2 fj_bcs_override=QCTACOL END
  LPF fj_are_structure INT_VAR fj_loc_x=1561 fj_loc_y=150 fj_dest_x=1561 fj_dest_y=150 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTAC3 fj_cre_resref=QCTAC3 fj_bcs_override=QCTACOL END
  // Add the Spectre last so its schedule can be patched deterministically.
  LPF fj_are_structure INT_VAR fj_loc_x=2781 fj_loc_y=341 fj_dest_x=2781 fj_dest_y=341 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QCTSPECT fj_cre_resref=QCTSPECT fj_dlg_resref=QCTSPECT END
  READ_LONG 0x54 qct_actor_offset
  READ_SHORT 0x58 qct_actor_count
  // Night only: 20:30-06:29 (hours 20-23 and 0-5).
  WRITE_LONG (qct_actor_offset + ((qct_actor_count - 1) * 0x110) + 0x40) 0x00f0003f
BUT_ONLY_IF_IT_CHANGES

