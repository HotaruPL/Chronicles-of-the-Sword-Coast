// Replace the existing information-marker QCHPEND1 with a *real* entrance.
// Keeps the existing region polygon and changes only its type and destination.
COPY_EXISTING ~QCHELL.ARE~ ~override/QCHELL.ARE~
  READ_LONG 0x5c qcj_region_offset
  READ_SHORT 0x5a qcj_region_count
  SET qcj_found = 0
  FOR (qcj_i = 0; qcj_i < qcj_region_count; qcj_i += 1) BEGIN
    READ_ASCII (qcj_region_offset + qcj_i * 0xc4) qcj_name (32) NULL
    PATCH_IF (~%qcj_name%~ STRING_EQUAL ~QCHPEND1~) BEGIN
      SET qcj_r = qcj_region_offset + qcj_i * 0xc4
      WRITE_SHORT (qcj_r + 0x20) 2
      WRITE_LONG (qcj_r + 0x60) 4 // full party required to travel
      WRITE_ASCII (qcj_r + 0x38) ~QCJHR1~ #8
      WRITE_ASCII (qcj_r + 0x40) ~QCJENT~ #8
      SET qcj_found = 1
    END
  END
  PATCH_IF (qcj_found = 0) BEGIN
    PATCH_FAIL @20294
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 1550 fj_loc_y = 1105 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCJRET
  END
BUT_ONLY_IF_IT_CHANGES

// Public installer: development progress message omitted.

// v15: independent post-v14.2 enhancement. Keeps the existing QCJKHAL.d / Jaheira
// interjection resources unchanged. Requires the QCJHR1 component already installed.

// ---------- Integrated milestone: QC: Bhaal's Temple in the Forest (QCBHAL) + Dark Memory Portraits / Ogre Repair~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCJHR1.ARE~ BEGIN FAIL ~Install QC: Distorted Memories of Jaheira and Khalid before Bhaal's Temple.~ END

// Portraits for the two hostile memory echoes, as supplied by the player.
COPY ~CotSC/qc_unicorn_grove/portraits/QCJJAHS.BMP~ ~override/QCJJAHS.BMP~
COPY ~CotSC/qc_unicorn_grove/portraits/QCJJAHL.BMP~ ~override/QCJJAHL.BMP~
COPY ~CotSC/qc_unicorn_grove/portraits/QCJKHLS.BMP~ ~override/QCJKHLS.BMP~
COPY ~CotSC/qc_unicorn_grove/portraits/QCJKHLL.BMP~ ~override/QCJKHLL.BMP~
COPY_EXISTING ~QCJJAHR.CRE~ ~override/QCJJAHR.CRE~
  WRITE_ASCII 0x34 ~QCJJAHS~ #8
  WRITE_ASCII 0x3c ~QCJJAHL~ #8
BUT_ONLY_IF_IT_CHANGES
COPY_EXISTING ~QCJKHAL.CRE~ ~override/QCJKHAL.CRE~
  WRITE_ASCII 0x34 ~QCJKHLS~ #8
  WRITE_ASCII 0x3c ~QCJKHLL~ #8
BUT_ONLY_IF_IT_CHANGES

// UDOGRE is a special creature. Use a normal mortal Ogre base instead,
// while preserving the Ogre Warrior's position and encounter behaviour.
ACTION_IF FILE_EXISTS_IN_GAME ~OGRE01.CRE~ BEGIN
  OUTER_SPRINT qcb_mortal_ogre ~OGRE01.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~OGRE.CRE~ BEGIN
  OUTER_SPRINT qcb_mortal_ogre ~OGRE.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~OGRE1.CRE~ BEGIN
  OUTER_SPRINT qcb_mortal_ogre ~OGRE1.CRE~
END ELSE BEGIN
  // Safety fallback: this still strips all attached protection effects.
  OUTER_SPRINT qcb_mortal_ogre ~UDOGRE.CRE~
END
COPY_EXISTING ~%qcb_mortal_ogre%~ ~override/QCJOGRE.CRE~
  SAY NAME1 @3085
  SAY NAME2 @3085
  READ_LONG 0x10 qcb_ogre_flags
  WRITE_LONG 0x10 (qcb_ogre_flags BAND 0xffffdfff) // no quest-critical immunity
  WRITE_LONG 0x20 0 // clear states inherited from the creature template
  WRITE_SHORT 0x24 95
  WRITE_SHORT 0x26 95
  WRITE_BYTE 0x52 8
  WRITE_BYTE 0x53 2
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCJOGRE~ #32
  WRITE_ASCII 0x248 ~QCJHOST~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  LPF DELETE_CRE_EFFECT INT_VAR opcode_to_delete = 208 END
BUT_ONLY_IF_IT_CHANGES

// Repair the placed actor too: ARE actor flag bit 2 makes an actor invulnerable.
// Make the previously installed staircase into an actual party travel region.
COPY_EXISTING ~QCJHR1.ARE~ ~override/QCJHR1.ARE~
  READ_LONG 0x54 qcb_actors_off
  READ_SHORT 0x58 qcb_actors_count
  FOR (qcb_i = 0; qcb_i < qcb_actors_count; qcb_i += 1) BEGIN
    SET qcb_actor = qcb_actors_off + (qcb_i * 0x110)
    READ_ASCII qcb_actor qcb_actor_name (32) NULL
    PATCH_IF (~%qcb_actor_name%~ STRING_EQUAL ~QCJX03~) BEGIN
      READ_LONG (qcb_actor + 0x28) qcb_actor_flags
      WRITE_LONG (qcb_actor + 0x28) (qcb_actor_flags BAND 0xfffffffb)
    END
  END
  READ_LONG 0x5c qcb_regions_off
  READ_SHORT 0x5a qcb_regions_count
  SET qcb_stairs_found = 0
  FOR (qcb_j = 0; qcb_j < qcb_regions_count; qcb_j += 1) BEGIN
    SET qcb_r = qcb_regions_off + (qcb_j * 0xc4)
    READ_ASCII qcb_r qcb_r_name (32) NULL
    PATCH_IF (~%qcb_r_name%~ STRING_EQUAL ~QCJNEXT~) BEGIN
      WRITE_SHORT (qcb_r + 0x20) 2  // travel region
      WRITE_LONG (qcb_r + 0x34) 28  // stairs cursor
      WRITE_LONG (qcb_r + 0x60) 4   // entire party
      WRITE_ASCII (qcb_r + 0x38) ~QCBHAL~ #8
      WRITE_ASCII (qcb_r + 0x40) ~QCBENT~ #32
      SET qcb_stairs_found = 1
    END
  END
  PATCH_IF (qcb_stairs_found = 0) BEGIN
    PATCH_FAIL @20295
  END
  // Return spawn next to the staircase, not at the other end of the hall.
  LPF fj_are_structure
    INT_VAR fj_loc_x = 592 fj_loc_y = 875 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCJSTRET
  END
BUT_ONLY_IF_IT_CHANGES

// v17: restored curved, user-painted altar hitbox and two genuine searchable altars.
// SHLD20 (Kiel's Buckler): copy all combat effects, restrictions, icons and other properties unchanged.
COPY_EXISTING ~SHLD20.ITM~ ~override/QCB7REF.ITM~
  SAY NAME1 @3088
  SAY NAME2 @3088
  SAY IDENTIFIED_DESC @3089
BUT_ONLY_IF_IT_CHANGES

// v18: The two unverified, custom priest scroll items were removed from the container.
// SPPR309 and SPPR513 are real SPELL resrefs, not verified stock scroll ITM resrefs.
// No item-resource substitution is made without a verified original from the game.

// Final memory approach: original artwork, rebuilt engine tiles, provisional open collision.
COPY ~CotSC/qc_unicorn_grove/area/QCBHAL.ARE~ ~override/QCBHAL.ARE~
COPY ~CotSC/qc_unicorn_grove/area/QCBHAL.WED~ ~override/QCBHAL.WED~
COPY ~CotSC/qc_unicorn_grove/area/QCBHAL.TIS~ ~override/QCBHAL.TIS~
COPY ~CotSC/qc_unicorn_grove/area/QCBHALSR.BMP~ ~override/QCBHALSR.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCBHALLM.BMP~ ~override/QCBHALLM.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCBHALHT.BMP~ ~override/QCBHALHT.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QBHAL00.PVRZ~ ~override/QBHAL00.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QBHAL01.PVRZ~ ~override/QBHAL01.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QBHAL02.PVRZ~ ~override/QBHAL02.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QBHAL03.PVRZ~ ~override/QBHAL03.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QBHAL04.PVRZ~ ~override/QBHAL04.PVRZ~

// Same tracks as QCHELL and QCJHR1. Separate IDs avoid assuming component-scope variables.
ADD_MUSIC ~QCB_AMBIENT~ ~CotSC/qc_unicorn_grove/music/QCHAMB.MUS~
ADD_MUSIC ~QCB_BATTLE~ ~CotSC/qc_unicorn_grove/music/QCHBTL.MUS~
ADD_MUSIC ~QCB_VICTORY~ ~CotSC/qc_unicorn_grove/music/QCHEND.MUS~
COPY_EXISTING ~QCBHAL.ARE~ ~override/QCBHAL.ARE~
  READ_LONG 0xbc qcb_song_table
  PATCH_IF (qcb_song_table > 0) AND (qcb_song_table + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG (qcb_song_table + 0) %QCB_AMBIENT%
    WRITE_LONG (qcb_song_table + 4) %QCB_AMBIENT%
    WRITE_LONG (qcb_song_table + 8) %QCB_VICTORY%
    WRITE_LONG (qcb_song_table + 12) %QCB_BATTLE%
  END ELSE BEGIN
    PATCH_FAIL @20296
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 740 fj_loc_y = 1377 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCBENT
  END
  LPF fj_are_structure
    INT_VAR fj_type = 2 fj_box_left = 659 fj_box_top = 1423
      fj_box_right = 827 fj_box_bottom = 1491
      fj_cursor_idx = 28 fj_flags = 4
      fj_vertex_0 = 659 + (1423 << 16)
      fj_vertex_1 = 827 + (1423 << 16)
      fj_vertex_2 = 827 + (1491 << 16)
      fj_vertex_3 = 659 + (1491 << 16)
    STR_VAR fj_structure_type = region fj_name = QCBRET
      fj_destination_area = QCJHR1 fj_destination_name = QCJSTRET
  END
BUT_ONLY_IF_IT_CHANGES

