// ---------------------------------------------------------------------------
// SLUMS DISTRICT - AR0400
// ---------------------------------------------------------------------------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0400.ARE~ BEGIN
  FAIL @20324
END

// Orc Beggar - requested ORC01 model, neutral and weaponless.
COPY_EXISTING ~ORC01.CRE~ ~override/QC40OBEG.CRE~
  SAY NAME1 @3112
  SAY NAME2 @3112
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QC40OBEG~ #8
  WRITE_ASCII 0x280 ~QC40OBEG~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

