// ===========================================================
// Version 1.3: THRONE OF BHAAL CONTAINER PROVISIONS (FINAL BATCH)
// Optional Part IX, maintains byte-identical existing content.
// Places new loot in the nearest existing containers to coordinates.
// Uses fj_are_structure to preserve existing container contents.
// ===========================================================
// Former WeiDU component: Miscellaneous Merchants - Part IX: Throne of Bhaal Container Loot (13 locations)

DEFINE_PATCH_FUNCTION QCMM_TOB_CONTAINER_LOOT
  INT_VAR x = 0 y = 0 charge = 1
  STR_VAR item = ~~
BEGIN
  READ_SHORT 0x74 qcmm_tob_cnt
  READ_LONG  0x70 qcmm_tob_off
  PATCH_IF (qcmm_tob_cnt > 0) BEGIN
    SET qcmm_tob_best = 0
    SET qcmm_tob_dist_best = 2147483647
    FOR (qcmm_tob_i = 0; qcmm_tob_i < qcmm_tob_cnt; qcmm_tob_i += 1) BEGIN
      READ_SHORT (qcmm_tob_off + qcmm_tob_i * 0xc0 + 0x20) qcmm_tob_x
      READ_SHORT (qcmm_tob_off + qcmm_tob_i * 0xc0 + 0x22) qcmm_tob_y
      SET qcmm_tob_dx = qcmm_tob_x - x
      SET qcmm_tob_dy = qcmm_tob_y - y
      SET qcmm_tob_dist = qcmm_tob_dx * qcmm_tob_dx + qcmm_tob_dy * qcmm_tob_dy
      PATCH_IF (qcmm_tob_dist < qcmm_tob_dist_best) BEGIN
        SET qcmm_tob_dist_best = qcmm_tob_dist
        SET qcmm_tob_best = qcmm_tob_i
      END
    END
    LPF fj_are_structure
      INT_VAR
        fj_con_itm_idx = qcmm_tob_best
        fj_charge0 = charge
        fj_flags = 1
      STR_VAR
        fj_structure_type = ~itm~
        fj_name = EVAL ~%item%~
    END
  END ELSE BEGIN
    PATCH_PRINT @20466
  END
END


ACTION_IF FILE_EXISTS_IN_GAME ~AR5012.ARE~ BEGIN
  COPY_EXISTING ~AR5012.ARE~ ~override~
    // Nearest container to X=413, Y=350.
    LPF QCMM_TOB_CONTAINER_LOOT INT_VAR x = 413 y = 350 charge = 2 STR_VAR item = ~QCBREAD~ END
END ELSE BEGIN

PRINT @20467

END


