// QCHIN1: area script, five mephits and exit to QCHELL. Containers and search map unaffected.
COPY_EXISTING ~QCHIN1.ARE~ ~override/QCHIN1.ARE~
  WRITE_ASCII 0x94 ~QCHINAR~ #8
  READ_LONG 0xbc qchin_song_table
  PATCH_IF (qchin_song_table > 0) AND (qchin_song_table + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG (qchin_song_table + 0) %QCH_AMBIENT%
    WRITE_LONG (qchin_song_table + 4) %QCH_AMBIENT%
    WRITE_LONG (qchin_song_table + 8) %QCH_VICTORY%
    WRITE_LONG (qchin_song_table + 12) %QCH_BATTLE%
  END ELSE BEGIN
    PATCH_FAIL @20289
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 274 fj_loc_y = 506 fj_orientation = 8
    STR_VAR fj_structure_type = actor fj_name = QCHM01 fj_cre_resref = QCHMSMO
