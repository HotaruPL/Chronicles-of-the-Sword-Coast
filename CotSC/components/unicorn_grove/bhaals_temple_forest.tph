  SAY NAME1 @3045
  SAY NAME2 @3045
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCBSQUI~ #32
  WRITE_ASCII 0x248 ~QCBROAM~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
