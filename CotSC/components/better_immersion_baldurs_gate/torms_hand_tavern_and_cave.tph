COPY ~CotSC/better_immersion_beregost/area/PWYTR2.ARE~ ~override/PWYTR2.ARE~
COPY ~CotSC/better_immersion_beregost/area/PWYTR2.WED~ ~override/PWYTR2.WED~
// Same padded texture-atlas conversion for the Red Fang caves.
COPY ~CotSC/better_immersion_beregost/area/BIPYTR2.TIS~ ~override/BIPYTR2.TIS~
COPY ~CotSC/better_immersion_beregost/area/BPYTR200.PVRZ~ ~override/BPYTR200.PVRZ~
