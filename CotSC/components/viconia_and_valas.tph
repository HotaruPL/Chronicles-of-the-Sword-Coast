LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR2400.ARE~ BEGIN
  FAIL @20276
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDDRIDRM.CRE~ BEGIN
  FAIL @20277
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~VICONIJ.DLG~ BEGIN
  FAIL @20278
END

// Valas is a native SoD/EET male drider, deliberately NEUTRAL at first.
// Clear inherited hostile combat scripts; this is a noncombat encounter
// unless the party chooses the explicit hostile dialogue option.
COPY_EXISTING ~BDDRIDRM.CRE~ ~override/QCVVAL1.CRE~
  SAY NAME1 @5033
  SAY NAME2 @5033
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCVVAL1~ #32
  WRITE_ASCII 0x2cc ~QCVVAL1~ #8
  WRITE_ASCII 0x248 ~QCVV1AI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Second appearance is another instance of the same Drider model.
COPY_EXISTING ~BDDRIDRM.CRE~ ~override/QCVVAL2.CRE~
  SAY NAME1 @5033
  SAY NAME2 @5033
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCVVAL2~ #32
  WRITE_ASCII 0x2cc ~QCVVAL2~ #8
  WRITE_ASCII 0x248 ~QCVV2AI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Add only the first actor. His dialogue schedules the second spawn.
COPY_EXISTING ~AR2400.ARE~ ~override/AR2400.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 2802
      fj_loc_y = 1991
      fj_orientation = 0 // north
    STR_VAR
      fj_structure_type = actor
      fj_name = QCVVAL1
      fj_cre_resref = QCVVAL1
  END
BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/qc_viconia_valas/scripts/QCVV1AI.baf~
COMPILE ~CotSC/qc_viconia_valas/scripts/QCVV2AI.baf~
COMPILE ~CotSC/qc_viconia_valas/dialogue/viconia_valas.d~ USING ~CotSC/translation/%LANGUAGE%/qc_viconia_valas/dialogue/viconia_valas.tra~

// Public installer: development progress message omitted.
