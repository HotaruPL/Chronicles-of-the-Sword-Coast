  // X=1461 Y=733 - female halfling, facing south-east.
  LPF fj_are_structure INT_VAR fj_loc_x=1461 fj_loc_y=733 fj_dest_x=1461 fj_dest_y=733 fj_orientation=14 STR_VAR fj_structure_type=actor fj_name=QCAWHF1 fj_cre_resref=QCAWHF1 fj_dlg_resref=QCAWHF1 END
  // X=1357 Y=518 - dwarf commoner, facing north.
  LPF fj_are_structure INT_VAR fj_loc_x=1357 fj_loc_y=518 fj_dest_x=1357 fj_dest_y=518 fj_orientation=8 STR_VAR fj_structure_type=actor fj_name=QCAWDW2 fj_cre_resref=QCAWDW2 fj_dlg_resref=QCAWDW2 END
BUT_ONLY_IF_IT_CHANGES


