LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG3300.BCS~ BEGIN
  FAIL @4
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BANDIT.CRE~ BEGIN
  FAIL @5
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG3301.ARE~ BEGIN
  FAIL @6
END

COPY_EXISTING ~BANDIT.CRE~ ~override/QCMERLEE.CRE~
  SAY NAME1 @5000
  SAY NAME2 @5000
  WRITE_ASCII 0x2cc ~QCMERLEE~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_SHORT 0x244 0x4000
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x273 2
  WRITE_BYTE 0x27b 0x13
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~LEAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
  ADD_CRE_ITEM ~SW1H07~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
  WRITE_ASCII 0x280 ~QCMERLEE_DEAD~ #32

COMPILE ~CotSC/Quests_and_Challenges/DLG/QCMERLEE.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCMERLEE.TRA~

EXTEND_TOP ~BG3300.BCS~ ~CotSC/Quests_and_Challenges/AREA/BG3300.baf~
