COMPILE ~CotSC/qc_unicorn_grove/scripts/QCUEGAI.baf~

// Only add an actor and area script to the already existing cabin interior.
COPY_EXISTING ~QCGHUT.ARE~ ~override/QCGHUT.ARE~
  WRITE_ASCII 0x94 ~QCUHUT~ #8
  LPF fj_are_structure
    INT_VAR fj_loc_x = 513 fj_loc_y = 298 fj_orientation = 0
    STR_VAR fj_structure_type = actor fj_name = QCUEAG fj_cre_resref = QCUEAG
  END
BUT_ONLY_IF_IT_CHANGES

// Add a map note to the working outdoors, without changing WED graphics or collision.
COPY_EXISTING ~QCCGRV.ARE~ ~override/QCCGRV.ARE~
  ADD_MAP_NOTE #2710 #275 ~blue~ ~Old Cabin~
BUT_ONLY_IF_IT_CHANGES

// Emhrys's BG2 quest requires a visit to Beregost (BG3300).
// Remove the obsolete BG0300 door, return entrance, and old map note if
// re-installing over a previously patched area. Do not touch other geometry.
COPY_EXISTING ~BG0300.ARE~ ~override/BG0300.ARE~
  READ_LONG 0x5c qce_old_region_offset
  READ_SHORT 0x5a qce_old_region_count
  FOR (qce_old_i = qce_old_region_count - 1; qce_old_i >= 0; qce_old_i -= 1) BEGIN
    READ_ASCII (qce_old_region_offset + 0xc4 * qce_old_i) qce_old_region_name (32) NULL
    PATCH_IF (~%qce_old_region_name%~ STRING_EQUAL ~QCEHDOR~) BEGIN
      LPF fj_are_structure
        INT_VAR fj_delete_mode = qce_old_i
        STR_VAR fj_structure_type = region
      END
    END
  END
  READ_LONG 0x68 qce_old_entrance_offset
  READ_LONG 0x6c qce_old_entrance_count
  FOR (qce_old_i = qce_old_entrance_count - 1; qce_old_i >= 0; qce_old_i -= 1) BEGIN
    READ_ASCII (qce_old_entrance_offset + 0x68 * qce_old_i) qce_old_entrance_name (32) NULL
    PATCH_IF (~%qce_old_entrance_name%~ STRING_EQUAL ~QCEHRET~) BEGIN
      LPF fj_are_structure
        INT_VAR fj_delete_mode = qce_old_i
        STR_VAR fj_structure_type = entrance
      END
    END
  END
  READ_LONG 0xc4 qce_old_note_offset
  READ_LONG 0xc8 qce_old_note_count
  FOR (qce_old_i = qce_old_note_count - 1; qce_old_i >= 0; qce_old_i -= 1) BEGIN
    READ_SHORT (qce_old_note_offset + 0x34 * qce_old_i) qce_old_note_x
    READ_SHORT (qce_old_note_offset + 0x34 * qce_old_i + 2) qce_old_note_y
    PATCH_IF (qce_old_note_x == 1157) AND (qce_old_note_y == 1826) BEGIN
      LPF fj_are_structure
        INT_VAR fj_delete_mode = qce_old_i
        STR_VAR fj_structure_type = note
      END
    END
  END
BUT_ONLY_IF_IT_CHANGES

// New entrance in southeastern Beregost and requested map marker.
COPY_EXISTING ~BG3300.ARE~ ~override/BG3300.ARE~
  ADD_MAP_NOTE #3795 #3071 ~blue~ ~Emhrys House~
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 3824
      fj_box_top = 2946
      fj_box_right = 3872
      fj_box_bottom = 2994
      fj_cursor_idx = 30
      fj_flags = 4
      fj_vertex_0 = 3824 + (2946 << 16)
      fj_vertex_1 = 3872 + (2946 << 16)
      fj_vertex_2 = 3872 + (2994 << 16)
      fj_vertex_3 = 3824 + (2994 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = QCEHDOR
      fj_destination_area = QCEH01
      fj_destination_name = Exit0300 // Existing indoor entrance retained.
  END
  LPF fj_are_structure
    INT_VAR fj_loc_x = 3848 fj_loc_y = 3032 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCEHRET
  END
BUT_ONLY_IF_IT_CHANGES

