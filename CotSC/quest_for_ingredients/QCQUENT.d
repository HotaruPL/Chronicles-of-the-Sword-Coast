BEGIN QCQUENT

IF ~!Global("QC_QUENT_ACCEPTED","GLOBAL",1) !Global("QC_QUENT_REFUSED","GLOBAL",1) !Global("QC_QUENT_DONE","GLOBAL",1)~ THEN BEGIN QC_INIT
  SAY @202
  IF ~~ THEN REPLY @203 GOTO QC_INTRO
  IF ~~ THEN REPLY @204 GOTO QC_INTRO
END

IF ~~ THEN BEGIN QC_INTRO
  SAY @205
  IF ~~ THEN GOTO QC_TRAVEL
END

IF ~~ THEN BEGIN QC_TRAVEL
  SAY @206
  IF ~~ THEN GOTO QC_COMPONENTS
END

IF ~~ THEN BEGIN QC_COMPONENTS
  SAY @207
  IF ~~ THEN REPLY @208 GOTO QC_ACCEPT
  IF ~~ THEN REPLY @209 GOTO QC_LOCATIONS
  IF ~~ THEN REPLY @210 GOTO QC_REFUSE
END

IF ~~ THEN BEGIN QC_ACCEPT
  SAY @211
  IF ~~ THEN GOTO QC_LIST
END

IF ~~ THEN BEGIN QC_LOCATIONS
  SAY @212
  IF ~~ THEN GOTO QC_ACCEPT_GOLD
END

IF ~~ THEN BEGIN QC_ACCEPT_GOLD
  SAY @213
  IF ~~ THEN GOTO QC_LIST
END

IF ~~ THEN BEGIN QC_LIST
  SAY @214
  IF ~~ THEN DO ~SetGlobal("QC_QUENT_ACCEPTED","GLOBAL",1) SetGlobal("QC_QUENT_REFUSED","GLOBAL",0) GiveItemCreate("QCQULIST",LastTalkedToBy(),0,0,0) AddJournalEntry(@101,QUEST)~ EXIT
END

IF ~~ THEN BEGIN QC_REFUSE
  SAY @215
  IF ~~ THEN DO ~SetGlobal("QC_QUENT_REFUSED","GLOBAL",1)~ EXIT
END

IF ~Global("QC_QUENT_REFUSED","GLOBAL",1) !Global("QC_QUENT_ACCEPTED","GLOBAL",1)~ THEN BEGIN QC_RETURN
  SAY @216
  IF ~~ THEN REPLY @217 GOTO QC_ACCEPT
  IF ~~ THEN REPLY @218 EXIT
END

IF ~Global("QC_QUENT_ACCEPTED","GLOBAL",1) Global("QC_QUENT_DONE","GLOBAL",0) Global("QC_QF_BWVEN","GLOBAL",1) Global("QC_QF_RIPBK","GLOBAL",1) Global("QC_QF_SPPOI","GLOBAL",1) Global("QC_QF_DSWIN","GLOBAL",1) Global("QC_QF_DBRAN","GLOBAL",1) Global("QC_QF_LURGM","GLOBAL",1) Global("QC_QF_EYBEH","GLOBAL",1) Global("QC_QF_GLROS","GLOBAL",1) Global("QC_QF_TRCLW","GLOBAL",1)~ THEN BEGIN QC_REVEAL
  SAY @219
  IF ~~ THEN GOTO QC_LICH
END

IF ~Global("QC_QUENT_ACCEPTED","GLOBAL",1) Global("QC_QUENT_DONE","GLOBAL",0)~ THEN BEGIN QC_SEARCH
  SAY @220
  IF ~PartyHasItem("QFIBWVEN") !Global("QC_QF_BWVEN","GLOBAL",1)~ THEN REPLY @221 DO ~TakePartyItem("QFIBWVEN") GiveGoldForce(200) SetGlobal("QC_QF_BWVEN","GLOBAL",1) AddJournalEntry(@102,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFIRIPBK") !Global("QC_QF_RIPBK","GLOBAL",1)~ THEN REPLY @222 DO ~TakePartyItem("QFIRIPBK") GiveGoldForce(200) SetGlobal("QC_QF_RIPBK","GLOBAL",1) AddJournalEntry(@103,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFISPPOI") !Global("QC_QF_SPPOI","GLOBAL",1)~ THEN REPLY @223 DO ~TakePartyItem("QFISPPOI") GiveGoldForce(200) SetGlobal("QC_QF_SPPOI","GLOBAL",1) AddJournalEntry(@104,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFIDSWIN") !Global("QC_QF_DSWIN","GLOBAL",1)~ THEN REPLY @224 DO ~TakePartyItem("QFIDSWIN") GiveGoldForce(200) SetGlobal("QC_QF_DSWIN","GLOBAL",1) AddJournalEntry(@105,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFIDBRAN") !Global("QC_QF_DBRAN","GLOBAL",1)~ THEN REPLY @225 DO ~TakePartyItem("QFIDBRAN") GiveGoldForce(200) SetGlobal("QC_QF_DBRAN","GLOBAL",1) AddJournalEntry(@106,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFILURGM") !Global("QC_QF_LURGM","GLOBAL",1)~ THEN REPLY @226 DO ~TakePartyItem("QFILURGM") GiveGoldForce(200) SetGlobal("QC_QF_LURGM","GLOBAL",1) AddJournalEntry(@107,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFIEYBEH") !Global("QC_QF_EYBEH","GLOBAL",1)~ THEN REPLY @227 DO ~TakePartyItem("QFIEYBEH") GiveGoldForce(200) SetGlobal("QC_QF_EYBEH","GLOBAL",1) AddJournalEntry(@108,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFIGLROS") !Global("QC_QF_GLROS","GLOBAL",1)~ THEN REPLY @228 DO ~TakePartyItem("QFIGLROS") GiveGoldForce(200) SetGlobal("QC_QF_GLROS","GLOBAL",1) AddJournalEntry(@109,QUEST)~ GOTO QC_PAID
  IF ~PartyHasItem("QFITRCLW") !Global("QC_QF_TRCLW","GLOBAL",1)~ THEN REPLY @229 DO ~TakePartyItem("QFITRCLW") GiveGoldForce(200) SetGlobal("QC_QF_TRCLW","GLOBAL",1) AddJournalEntry(@110,QUEST)~ GOTO QC_PAID
  IF ~~ THEN REPLY @230 GOTO QC_WAIT
  IF ~~ THEN REPLY @231 DO ~GiveItemCreate("QCQULIST",LastTalkedToBy(),0,0,0)~ EXIT
END

IF ~~ THEN BEGIN QC_PAID
  SAY @232
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN QC_WAIT
  SAY @233
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN QC_LICH
  SAY @234
  IF ~~ THEN REPLY @235 GOTO QC_FAREWELL
END

IF ~~ THEN BEGIN QC_FAREWELL
  SAY @236
  IF ~~ THEN GOTO QC_FINAL_SPEECH
END

IF ~~ THEN BEGIN QC_FINAL_SPEECH
  SAY @237
  IF ~~ THEN REPLY @238 GOTO QC_KILL
  IF ~~ THEN REPLY @239 GOTO QC_CONFRONT
END

IF ~~ THEN BEGIN QC_KILL
  SAY @240
  IF ~~ THEN DO ~SetGlobal("QC_QUENT_DONE","GLOBAL",1) AddExperienceParty(50000) EraseJournalEntry(@101) EraseJournalEntry(@102) EraseJournalEntry(@103) EraseJournalEntry(@104) EraseJournalEntry(@105) EraseJournalEntry(@106) EraseJournalEntry(@107) EraseJournalEntry(@108) EraseJournalEntry(@109) EraseJournalEntry(@110) AddJournalEntry(@111,QUEST_DONE) Kill(Myself)~ EXIT
END

IF ~~ THEN BEGIN QC_NO_ESCAPE
  SAY @241
  IF ~~ THEN REPLY @242 GOTO QC_KILL
END

IF ~~ THEN BEGIN QC_CONFRONT
  SAY @243
  IF ~~ THEN GOTO QC_NO_ESCAPE
END
