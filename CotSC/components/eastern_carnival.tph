// QCVELM working area and its two-way transition with QCCARN.
// QCVELM.TIS remains the original full-tile TIS; the experimental PVRZ atlas
// path is intentionally not used, avoiding atlas-boundary/vertical-seam bleed.
// QCVELMSR uses the proven TORMHA-style occlusion treatment: the isolated
// central obstacle is type 8 while the continuous boundary remains type 0.
COPY ~CotSC/Quests_and_Challenges/Eastern_Carnival/qcvelm/QCVELM.ARE~ ~override/QCVELM.ARE~
COPY ~CotSC/Quests_and_Challenges/Eastern_Carnival/qcvelm/QCVELM.WED~ ~override/QCVELM.WED~
COPY ~CotSC/Quests_and_Challenges/Eastern_Carnival/qcvelm/QCVELM.TIS~ ~override/QCVELM.TIS~
