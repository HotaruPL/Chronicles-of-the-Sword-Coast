// ---------------------------------------------------------------------------
// BETTER IMMERSION FOR BALDUR'S GATE - BG0100
// ---------------------------------------------------------------------------

BEGIN BIB1001
IF ~True()~ THEN BEGIN 0
  SAY @1
  IF ~~ THEN EXIT
END

BEGIN BIB1002
IF ~True()~ THEN BEGIN 0
  SAY @2
  IF ~InParty("Viconia") InMyArea("Viconia") !StateCheck("Viconia",CD_STATE_NOTVALID)~ THEN EXTERN VICONJ BIB_VIC_BG0100
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN BIB_VIC_BG0100_REPLY
  SAY @3
  IF ~~ THEN EXIT
END

APPEND VICONJ
IF WEIGHT #-1 ~False()~ THEN BEGIN BIB_VIC_BG0100
  SAY @4
  IF ~~ THEN EXTERN BIB1002 BIB_VIC_BG0100_REPLY
END
END

BEGIN BIB1003
IF ~True()~ THEN BEGIN 0
  SAY @5
  IF ~~ THEN EXIT
END

BEGIN BIB1004
IF ~True()~ THEN BEGIN 0
  SAY @6
  IF ~~ THEN REPLY @7 GOTO 1
END

IF ~~ THEN BEGIN 1
  SAY @8
  IF ~InParty("Xan") InMyArea("Xan") !StateCheck("Xan",CD_STATE_NOTVALID)~ THEN EXTERN XANJ BIB_XAN_BG0100
  IF ~!InParty("Xan")~ THEN GOTO 2
END

IF ~~ THEN BEGIN 2
  SAY @9
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN BIB_XAN_BG0100_REPLY
  SAY @10
  IF ~~ THEN EXTERN BIB1004 BIB_XAN_BG0100_FINAL
END

IF ~~ THEN BEGIN BIB_XAN_BG0100_FINAL
  SAY @11
  IF ~~ THEN EXIT
END

APPEND XANJ
IF WEIGHT #-1 ~False()~ THEN BEGIN BIB_XAN_BG0100
  SAY @12
  IF ~~ THEN EXTERN BIB1004 BIB_XAN_BG0100_REPLY
END
END

BEGIN BIB1005
IF ~True()~ THEN BEGIN 0
  SAY @13
  IF ~~ THEN EXIT
END

BEGIN BIB1006
IF ~True()~ THEN BEGIN 0
  SAY @14
  IF ~~ THEN EXIT
END

BEGIN BIB1007
IF ~True()~ THEN BEGIN 0
  SAY @15
  IF ~~ THEN EXIT
END

BEGIN BIB1008
IF ~True()~ THEN BEGIN 0
  SAY @16
  IF ~~ THEN EXIT
END
