// v26: place Unicorn Grove's worldmap arrival and precisely limited exit areas.
// Preserve v25's already-working hidden worldmap reveal and all other components.

// ---------- Integrated milestone: QC: Unicorn Grove - Arrival and Two Worldmap Exits (QCCGRV)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCCGRV.ARE~ BEGIN FAIL ~Install the working Unicorn Grove first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCCGRVSR.BMP~ BEGIN FAIL ~Unicorn Grove search map is missing.~ END

// Unified build: QCSTART already exists in the source ARE; the precise
// 969,1725 location is set by the verified v29 0x68 entrance patch.
// Worldmap exits in the Infinity Engine are painted as palette INDEX 14
// in the SR bitmap. We patch only tiny areas around (730,1795) and (345,47).
// This avoids copying an entire SR map and losing collision from other mods.
COPY_EXISTING ~QCCGRVSR.BMP~ ~override/QCCGRVSR.BMP~
  READ_SHORT 0x1c qcwm26_bpp
  READ_LONG 0x12 qcwm26_w
  READ_LONG 0x16 qcwm26_h
  PATCH_IF (qcwm26_bpp != 4) OR (qcwm26_w != 212) OR (qcwm26_h != 160) BEGIN
    PATCH_FAIL @20316
  END
  READ_BYTE 0x530 qcwm26_old
  PATCH_IF (((qcwm26_old BAND 0xF0) / 16) == 4) OR (((qcwm26_old BAND 0xF0) / 16) == 14) BEGIN
    WRITE_BYTE 0x530 ((qcwm26_old BAND 0x0F) BOR 0xE0)
  END
  READ_BYTE 0x4c4 qcwm26_old
  PATCH_IF (((qcwm26_old BAND 0xF0) / 16) == 4) OR (((qcwm26_old BAND 0xF0) / 16) == 14) BEGIN
    WRITE_BYTE 0x4c4 ((qcwm26_old BAND 0x0F) BOR 0xE0)
  END
  READ_BYTE 0x458 qcwm26_old
  PATCH_IF (((qcwm26_old BAND 0xF0) / 16) == 4) OR (((qcwm26_old BAND 0xF0) / 16) == 14) BEGIN
    WRITE_BYTE 0x458 ((qcwm26_old BAND 0x0F) BOR 0xE0)
  END
  READ_BYTE 0x530 qcwm26_old
  PATCH_IF ((qcwm26_old BAND 0x0F) == 4) OR ((qcwm26_old BAND 0x0F) == 14) BEGIN
    WRITE_BYTE 0x530 ((qcwm26_old BAND 0xF0) BOR 0x0E)
  END
  READ_BYTE 0x4c4 qcwm26_old
  PATCH_IF ((qcwm26_old BAND 0x0F) == 4) OR ((qcwm26_old BAND 0x0F) == 14) BEGIN
    WRITE_BYTE 0x4c4 ((qcwm26_old BAND 0xF0) BOR 0x0E)
  END
  READ_BYTE 0x458 qcwm26_old
