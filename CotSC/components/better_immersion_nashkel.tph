// Bouncer — neutral hobgoblin archer at the carnival entrance.
COPY_EXISTING ~HOBGBEG1.CRE~ ~override/BNBOUNCE.CRE~
  SAY NAME1 @1042
  SAY NAME2 @1042
  WRITE_ASCII 0x2cc ~BNBOUNCE~ #8
  WRITE_ASCII 0x280 ~BNBOUNCE~ #32
