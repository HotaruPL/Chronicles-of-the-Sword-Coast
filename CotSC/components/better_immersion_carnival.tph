// Deer — normal deer, preserving its original wandering AI.
COPY_EXISTING ~DEER01.CRE~ ~override/BICDEER1.CRE~
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~BICDEER1~ #32
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

// Dogs — non-hostile, preserving their original wandering AI.
COPY_EXISTING ~DOGWIL01.CRE~ ~override/BICDOG01.CRE~
  SAY NAME1 @1033
  SAY NAME2 @1033
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~BICDOG01~ #32
  WRITE_ASCII 0x248 ~QCIWAND~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~DOGWIL01.CRE~ ~override/BICDOG02.CRE~
