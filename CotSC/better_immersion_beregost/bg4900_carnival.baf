// Like the Nashkel Bouncer's Neira check: if Oopah becomes hostile, order every Carnival guard to attack him.
IF
  Exists("OOPAH")
  Allegiance("OOPAH",ENEMY)
  !Global("BIC_GUARDS_OOPAH","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("BIC_GUARDS_OOPAH","GLOBAL",1)
    ActionOverride("BICGRD01",Attack("OOPAH"))
    ActionOverride("BICGRD02",Attack("OOPAH"))
    ActionOverride("BICGRD03",Attack("OOPAH"))
    ActionOverride("BICGRD04",Attack("OOPAH"))
    ActionOverride("BICGRD05",Attack("OOPAH"))
END

