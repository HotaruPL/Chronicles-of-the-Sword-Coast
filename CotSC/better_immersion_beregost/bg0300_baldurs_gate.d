// ---------------------------------------------------------------------------
// BETTER IMMERSION FOR BALDUR'S GATE - BG0300
// ---------------------------------------------------------------------------

BEGIN BIB0301
IF ~True()~ THEN BEGIN 0
  SAY @1
  IF ~~ THEN EXIT
END

BEGIN BIB0302
IF ~True()~ THEN BEGIN 0
  SAY @2
  IF ~~ THEN EXIT
END

BEGIN BIB0303
IF ~True()~ THEN BEGIN 0
  SAY @3
  IF ~~ THEN EXIT
END

BEGIN BIB0304
IF ~True()~ THEN BEGIN 0
  SAY @4
  IF ~~ THEN REPLY @5 GOTO 1
END

IF ~~ THEN BEGIN 1
  SAY @6
  IF ~~ THEN GOTO 2
END

IF ~~ THEN BEGIN 2
  SAY @7
  IF ~~ THEN GOTO 3
END

IF ~~ THEN BEGIN 3
  SAY @8
  IF ~~ THEN REPLY @9 GOTO 4
END

IF ~~ THEN BEGIN 4
  SAY @10
  IF ~~ THEN EXIT
END

BEGIN BIB0305
IF ~True()~ THEN BEGIN 0
  SAY @11
  IF ~~ THEN EXIT
END

BEGIN BIB0306
IF ~Global("BIB_BG0300_ADAN_RUDE","LOCALS",1)~ THEN BEGIN 0
  SAY @12
  IF ~~ THEN EXIT
END

IF ~Global("BIB_BG0300_ADAN_DONE","LOCALS",1)~ THEN BEGIN 1
  SAY @13
  IF ~~ THEN EXIT
END

IF ~InParty("Alora") InMyArea("Alora") !StateCheck("Alora",CD_STATE_NOTVALID)~ THEN BEGIN 2
  SAY @14
  IF ~~ THEN EXTERN ALORAJ BIB_ADAN_BG0300_MEET
END

IF ~True()~ THEN BEGIN 3
  SAY @15
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN BIB_ADAN_BG0300_REQUEST
  SAY @16
  IF ~OR(2) PartyGold(300) PartyGoldGT(300)~ THEN REPLY @17 GOTO BIB_ADAN_BG0300_PAY
  IF ~~ THEN REPLY @18 GOTO BIB_ADAN_BG0300_NO_MONEY
  IF ~~ THEN REPLY @19 EXTERN ALORAJ BIB_ADAN_BG0300_INSULT
END

IF ~~ THEN BEGIN BIB_ADAN_BG0300_PAY
  SAY @20
  IF ~~ THEN DO ~TakePartyGold(300) ReputationInc(1) SetGlobal("BIB_BG0300_ADAN_DONE","LOCALS",1)~ EXIT
END

IF ~~ THEN BEGIN BIB_ADAN_BG0300_NO_MONEY
  SAY @21
  IF ~~ THEN DO ~SetGlobal("BIB_BG0300_ADAN_DONE","LOCALS",1)~ EXIT
END

IF ~~ THEN BEGIN BIB_ADAN_BG0300_INSULT_ADAN
  SAY @22
  IF ~~ THEN DO ~ReputationInc(-1) SetGlobal("BIB_BG0300_ADAN_RUDE","LOCALS",1)~ EXIT
END

APPEND ALORAJ
IF WEIGHT #-1 ~False()~ THEN BEGIN BIB_ADAN_BG0300_MEET
  SAY @23
  IF ~~ THEN EXTERN BIB0306 BIB_ADAN_BG0300_REQUEST
END

IF WEIGHT #-1 ~InParty("Alora") InMyArea("Alora") !StateCheck("Alora",CD_STATE_NOTVALID)~ THEN BEGIN BIB_ADAN_BG0300_INSULT
  SAY @24
  IF ~~ THEN EXTERN BIB0306 BIB_ADAN_BG0300_INSULT_ADAN
END

END

BEGIN BIB0307
IF ~True()~ THEN BEGIN 0
  SAY @25
  IF ~~ THEN EXIT
END
