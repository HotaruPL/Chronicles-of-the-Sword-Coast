// EXTERN pattern as the proven Alphyra/Edwin component.
IF ~~ THEN BEGIN QCE_ALTAR
  SAY @10
  IF ~InParty("IMOEN2") !StateCheck("Imoen2",CD_STATE_NOTVALID)~ THEN EXTERN IMOEN2_ QCE_IMOEN_REACTION
  IF ~!InParty("IMOEN2") InParty("MINSC") !StateCheck("Minsc",CD_STATE_NOTVALID)~ THEN EXTERN MINSCJ_ QCE_MINSC_REACTION
