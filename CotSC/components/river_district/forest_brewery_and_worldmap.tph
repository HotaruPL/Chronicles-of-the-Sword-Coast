// v1.4: give the Brewer a private copy of a native BG1 tavern DRINKS store.
// Drakon Tavern uses Westgate Ruby Wine and Golden Sands Brews.
// Elfsong Tavern is the EET fallback with those same two drinks.
ACTION_IF FILE_EXISTS_IN_GAME ~TAV0720.STO~ BEGIN
  OUTER_SPRINT qb_tavern_src ~TAV0720~
END ELSE BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~TAV0705.STO~ BEGIN
    OUTER_SPRINT qb_tavern_src ~TAV0705~
  END ELSE BEGIN
    FAIL @20253
  END
END
COPY_EXISTING ~%qb_tavern_src%.STO~ ~override/QBRDRNK.STO~
  READ_LONG 0x10 qb_sto_flags
  WRITE_LONG 0x08 1                         // Tavern: use Drinks tab, not normal goods or an inn
  WRITE_LONG 0x10 (qb_sto_flags BOR 0x40)  // Allow purchase of drinks
  WRITE_LONG 0x5c 0                         // Brewery does not provide lodgings
  SAY 0x0c @3050
BUT_ONLY_IF_IT_CHANGES

// v3.2: Defender of Amn, Larissa's one-time quest reward.
// Keep the native large-shield equip animations and base AC +3 from SHLD19.
// SHLD19 already gives +3 general / +4 total vs missiles; add a further
// -1 missile-only modifier for exactly +5 total missile protection.
// Uses custom artwork adapted from the user's supplied shield image.
COPY ~CotSC/qc_river_district/items/QRAMSHD.BAM~ ~override/QRAMSHD.BAM~
COPY_EXISTING ~SHLD19.ITM~ ~override/QRAMSHD.ITM~
  SAY NAME1 @3051
  SAY NAME2 @3051
  SAY DESC @3052
  WRITE_ASCII 0x3A ~QRAMSHD~ #8
  WRITE_ASCII 0x58 ~QRAMSHD~ #8
  WRITE_SHORT 0x42 0 // Immediately identifiable: no Lore check needed
  LPF ADD_ITEM_EQEFFECT
    INT_VAR opcode = 0 target = 1 timing = 2 parameter1 = 0xFFFFFFFF parameter2 = 2
  END
BUT_ONLY_IF_IT_CHANGES

// v3.1: Two UNIQUE, inert Larissa quest potions using the supplied bottle designs.
// Copying MISC27 avoids inheriting active spell effects from a drinking potion.
COPY ~CotSC/qc_brewery/items/QBLP01.BAM~ ~override/QBLP01.BAM~
COPY ~CotSC/qc_brewery/items/QBLP02.BAM~ ~override/QBLP02.BAM~
COPY_EXISTING ~MISC27.ITM~ ~override/QBLP01.ITM~
  SAY NAME1 @3053
  SAY NAME2 @3053
  SAY DESC @3054
  WRITE_ASCII 0x3a ~QBLP01~ #8
  WRITE_ASCII 0x58 ~QBLP01~ #8
  WRITE_LONG 0x34 60
BUT_ONLY_IF_IT_CHANGES
COPY_EXISTING ~MISC27.ITM~ ~override/QBLP02.ITM~
  SAY NAME1 @3055
  SAY NAME2 @3055
  SAY DESC @3056
  WRITE_ASCII 0x3a ~QBLP02~ #8
  WRITE_ASCII 0x58 ~QBLP02~ #8
  WRITE_LONG 0x34 60
BUT_ONLY_IF_IT_CHANGES

// v3.0: IMPORTANT: DO NOT enable the BreweryEastMap/BreweryNorthMap ARE
// regions. They have EMPTY destination AREA references and intercept clicks.
// QCBREW.ARE intentionally advertises ONLY the house doorway region (count 1).
// The exterior world-map travel is provided natively by the 64 SR search-map
// cells of index 14 along the north and east edges, NOT by travel regions.
// This fixes the "party walks to the wheel icon but nothing happens" symptom.

// EET has BG2's Shadows of Amn map 2283 pixels below BG1 on its merged map.
// Use the BG2 City Gates as the entry and return route.  ARRIVE is an existing
// Brewery entrance, ExitNE is the vanilla AR0020 City Gates entrance.
ACTION_IF GAME_IS ~eet~ BEGIN
  OUTER_SET qb_soa_yoff = 2283
END ELSE BEGIN
  OUTER_SET qb_soa_yoff = 0
END
ACTION_DEFINE_ASSOCIATIVE_ARRAY toNewArea BEGIN
  ~AR0020~ => ~ARRIVE~
END
ACTION_DEFINE_ASSOCIATIVE_ARRAY fromNewArea BEGIN
  ~AR0020~ => ~ExitNE~
END
OUTER_SPRINT qc_wm_qcbrew_name @19004
OUTER_SPRINT qc_wm_qcbrew_desc @19005
LAF sc#addWmpAre
  INT_VAR
    mapIcon = 10
    xCoord = 675
    yCoord = 157 + qb_soa_yoff
    tTime = 1
    inclSv = 0
    visible = 1
    visibleAdjacent = 0
    reachable = 0
    visited = 0
  STR_VAR
    areName = ~QCBREW~
    strName = EVAL ~%qc_wm_qcbrew_name%~
    strDesc = EVAL ~%qc_wm_qcbrew_desc%~
    worldmap = ~worldmap~
END

// v3.1: River District is a permanent world-map location as well. It uses
// the same City Gates links, but has its own ARRIVE at (1670,1593).
// City-side marker is provisional and may be repositioned later if desired.
OUTER_SPRINT qc_wm_qcrivd_name @19006
OUTER_SPRINT qc_wm_qcrivd_desc @19007
LAF sc#addWmpAre
  INT_VAR
    mapIcon = 10
    xCoord = 205
    yCoord = 190 + qb_soa_yoff
    tTime = 0
    inclSv = 0
    visible = 1
    visibleAdjacent = 0
    reachable = 0
    visited = 0
  STR_VAR
    areName = ~QCRIVD~
    strName = EVAL ~%qc_wm_qcrivd_name%~
    strDesc = EVAL ~%qc_wm_qcrivd_desc%~
    worldmap = ~worldmap~
END

// Unlock the River District on first visiting the Athkatla Slums (AR0400),
// and Forest Brewery on reaching the City Gates (AR0020). The v65 version
// only used RevealAreaOnMap; the script now also applies ENABLED/EXPLORABLE
// flags, and restores native City Gates travel after the Slums are entered.
// Keep the original City Gates worldmap links, icons and arrival coordinates.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BALDUR.BCS~ BEGIN
  FAIL @20254
END
EXTEND_TOP ~BALDUR.BCS~ ~CotSC/qc_river_district/scripts/QCRVLOCK.baf~

// v67: container use/interact positions ONLY. These coordinates are distinct
// from the original clickable polygons and trap launch points. Preserve all
// inventory, items, container type, trap, owner and region data.
COPY_EXISTING ~QCBREW.ARE~ ~override/QCBREW.ARE~
  READ_LONG 0x70 q67_coff
  READ_SHORT 0x74 q67_ccount
  FOR (q67_c = 0; q67_c < q67_ccount; q67_c += 1) BEGIN
    SET q67_cp = q67_coff + q67_c * 0xc0
    READ_ASCII q67_cp q67_cname (32) NULL
    PATCH_IF (~%q67_cname%~ STRING_EQUAL_CASE ~QCBRC003~) BEGIN
      WRITE_SHORT (q67_cp + 0x20) 2013
      WRITE_SHORT (q67_cp + 0x22) 1222
    END
    PATCH_IF (~%q67_cname%~ STRING_EQUAL_CASE ~QCBRC002~) BEGIN
      WRITE_SHORT (q67_cp + 0x20) 1358
      WRITE_SHORT (q67_cp + 0x22) 1234
    END
    PATCH_IF (~%q67_cname%~ STRING_EQUAL_CASE ~QCBRC001~) BEGIN
      WRITE_SHORT (q67_cp + 0x20) 960
      WRITE_SHORT (q67_cp + 0x22) 865
    END
  END
BUT_ONLY_IF_IT_CHANGES
COPY_EXISTING ~QCRIVD.ARE~ ~override/QCRIVD.ARE~
  READ_LONG 0x70 q67_roff
  READ_SHORT 0x74 q67_rcount
  FOR (q67_c = 0; q67_c < q67_rcount; q67_c += 1) BEGIN
    SET q67_cp = q67_roff + q67_c * 0xc0
    READ_ASCII q67_cp q67_cname (32) NULL
    PATCH_IF (~%q67_cname%~ STRING_EQUAL_CASE ~QRVC0004~) BEGIN
      WRITE_SHORT (q67_cp + 0x20) 3235
      WRITE_SHORT (q67_cp + 0x22) 679
    END
  END
BUT_ONLY_IF_IT_CHANGES

// Saved-game world maps in EE are held inside BALDUR.SAV.
// Do not enumerate save directories or attempt loose worldmap.wmp writes.
// Only the master WORLDMAP.WMP is updated by sc#addWmpAre (inclSv=0).
// For correct initial lock states, test with a newly created campaign save.


