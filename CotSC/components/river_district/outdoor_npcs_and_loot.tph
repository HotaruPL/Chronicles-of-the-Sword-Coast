// Loot is assigned in approved container order 1..6. Container 6 stays empty.
// Consistent with ADD_AREA_ITEM using 1-based container numbering.
COPY_EXISTING ~QCRIVD.ARE~ ~override/QCRIVD.ARE~
  READ_SHORT 0x74 qr_con_count
  PATCH_IF (qr_con_count != 6) BEGIN
    PATCH_FAIL @20188
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 1
      charges1 = 13
    STR_VAR
      item_to_add = ~MISC07~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 1
      charges1 = 1
    STR_VAR
      item_to_add = ~DAGG01~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 2
      charges1 = 1
    STR_VAR
      item_to_add = ~SCRL69~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 3
      charges1 = 7
    STR_VAR
      item_to_add = ~MISC07~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 4
      charges1 = 1
    STR_VAR
      item_to_add = ~LEAT01~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 4
      charges1 = 1
    STR_VAR
      item_to_add = ~MISC27~
  END
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 5
      charges1 = 1
    STR_VAR
      item_to_add = ~AMUL04~
  END
BUT_ONLY_IF_IT_CHANGES

