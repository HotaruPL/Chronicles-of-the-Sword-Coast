  SAY NAME1 @2000
  SAY NAME2 @2000
  WRITE_ASCII 0x2cc ~BIB0201~ #8
  WRITE_ASCII 0x280 ~BIB0201~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
