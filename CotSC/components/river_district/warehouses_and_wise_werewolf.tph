// ====================================================================
// PART 8/8: v2.8 warehouse loot, NPCs, and the Wise Werewolf
// ====================================================================

// Required resources verified at install time. Do not silently substitute wrong assets.
ACTION_FOR_EACH itm IN ~AMUL11~ ~AROW01~ ~AROW08~ ~AX1H04~ ~BOLT01~ ~BOW06~ ~BULL01~ ~DAGG01~ ~DAGG02~ ~LEAT01~ ~LEAT04~ ~MISC07~ ~MISC16~ ~MISC18~ ~MISC20~ ~MISC26~ ~MISC27~ ~MISC37~ ~MISC43~ ~POTN09~ ~POTN10~ ~POTN39~ ~RING11~ ~SCRL75~ ~STAF01~ ~SW1H07~ BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%itm%.ITM~ BEGIN
    FAIL @20238
  END
END

// QRWH02: 11 item entries, preserving all 10 original container shapes.
