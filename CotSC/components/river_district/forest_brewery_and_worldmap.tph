COPY ~CotSC/qc_brewery/area/QCBREW.ARE~ ~override/QCBREW.ARE~
  // Keep QCBREW's named world-map arrival entry; do not move the interior doorway.
  READ_LONG 0x68 qb_entry_off
  READ_LONG 0x6c qb_entry_count
  PATCH_IF (qb_entry_count < 1) OR (qb_entry_off + 0x68 > SOURCE_SIZE) BEGIN
    PATCH_FAIL @20251
  END
  READ_ASCII qb_entry_off qb_entry_name (32) NULL
  PATCH_IF (~%qb_entry_name%~ STRING_EQUAL_CASE ~ARRIVE~) BEGIN
    WRITE_SHORT (qb_entry_off + 0x20) 1229
    WRITE_SHORT (qb_entry_off + 0x22) 105
  END ELSE BEGIN
    PATCH_FAIL @20252
  END

COPY ~CotSC/qc_brewery/area/QBRINT.ARE~ ~override/QBRINT.ARE~
ACTION_IF FILE_EXISTS_IN_GAME ~BG3317SR.BMP~ BEGIN
  COPY_EXISTING ~BG3317SR.BMP~ ~override/QBRINTSR.BMP~
END ELSE BEGIN
  COPY_EXISTING ~BG3322SR.BMP~ ~override/QBRINTSR.BMP~
END
