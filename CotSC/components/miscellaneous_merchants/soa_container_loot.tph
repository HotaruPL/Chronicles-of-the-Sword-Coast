// ===========================================================
// Version 1.2: SHADOWS OF AMN CONTAINER PROVISIONS
// Optional Part VIII -- preserves every earlier component exactly.
// Patches the nearest existing container to each user-supplied position.
// Preserves pre-existing container contents. No new containers are created.
// OH6100 normalizes the provided 0H6100 typo (letter O, not digit zero).
// "MEAR" and "EGS" normalize to QCMEAT / QCEGGS.
// ===========================================================
// Former WeiDU component: Miscellaneous Merchants - Part VIII: Shadows of Amn Container Loot (73 locations)

DEFINE_PATCH_FUNCTION QCMM_SOA_CONTAINER_LOOT
  INT_VAR x = 0 y = 0 charge = 1
  STR_VAR item = ~~
BEGIN
  READ_SHORT 0x74 qcmm_soa_cnt
  READ_LONG  0x70 qcmm_soa_off
  PATCH_IF (qcmm_soa_cnt > 0) BEGIN
    SET qcmm_soa_best = 0
    SET qcmm_soa_dist_best = 2147483647
    FOR (qcmm_soa_i = 0; qcmm_soa_i < qcmm_soa_cnt; qcmm_soa_i += 1) BEGIN
      READ_SHORT (qcmm_soa_off + qcmm_soa_i * 0xc0 + 0x20) qcmm_soa_x
      READ_SHORT (qcmm_soa_off + qcmm_soa_i * 0xc0 + 0x22) qcmm_soa_y
      SET qcmm_soa_dx = qcmm_soa_x - x
      SET qcmm_soa_dy = qcmm_soa_y - y
      SET qcmm_soa_dist = qcmm_soa_dx * qcmm_soa_dx + qcmm_soa_dy * qcmm_soa_dy
      PATCH_IF (qcmm_soa_dist < qcmm_soa_dist_best) BEGIN
        SET qcmm_soa_dist_best = qcmm_soa_dist
        SET qcmm_soa_best = qcmm_soa_i
      END
    END
    LPF fj_are_structure
      INT_VAR
        fj_con_itm_idx = qcmm_soa_best
        fj_charge0 = charge
        fj_flags = 1
      STR_VAR
        fj_structure_type = ~itm~
        fj_name = EVAL ~%item%~
    END
  END ELSE BEGIN
    PATCH_PRINT @20417
  END
END


ACTION_IF FILE_EXISTS_IN_GAME ~AR0602.ARE~ BEGIN
  COPY_EXISTING ~AR0602.ARE~ ~override~
    // Nearest container to X=3337, Y=839.
    LPF QCMM_SOA_CONTAINER_LOOT INT_VAR x = 3337 y = 839 charge = 1 STR_VAR item = ~QCWATER~ END
    // Nearest container to X=3176, Y=2444.
    LPF QCMM_SOA_CONTAINER_LOOT INT_VAR x = 3176 y = 2444 charge = 2 STR_VAR item = ~QCBREAD~ END
    LPF QCMM_SOA_CONTAINER_LOOT INT_VAR x = 3176 y = 2444 charge = 1 STR_VAR item = ~QCWATER~ END
    // Nearest container to X=1288, Y=1438.
    LPF QCMM_SOA_CONTAINER_LOOT INT_VAR x = 1288 y = 1438 charge = 2 STR_VAR item = ~QCMEAT~ END
END ELSE BEGIN

PRINT @20418

END


