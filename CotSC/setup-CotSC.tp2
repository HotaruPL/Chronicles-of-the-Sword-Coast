// Ulua - working commoner chassis with NEIRA appearance and sound set.
COPY_EXISTING ~FARM.CRE~ ~override/PWYULU5.CRE~
  SAY NAME1 @2056
  SAY NAME2 @2056
  WRITE_ASCII 0x2cc ~PWYULUA~ #8
  WRITE_ASCII 0x280 ~PWYULU5~ #32
  WRITE_ASCII 0x248 ~ ~ #8
