LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/Setup.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~LENDAR.CRE~ BEGIN
  FAIL @72
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~OGREMA02.CRE~ BEGIN
  FAIL @73
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~SCRL3F.ITM~ BEGIN
  FAIL @74
END

COPY_EXISTING ~SCRL3F.ITM~ ~override/QCLDIARY.ITM~
  SAY NAME1 @75
  SAY NAME2 @75
  SAY DESC @76

COPY_EXISTING ~LENDAR.CRE~ ~override/LENDAR.CRE~
  ADD_CRE_ITEM ~QCLDIARY~ #1 #0 #0 ~IDENTIFIED~ ~INV~

COPY_EXISTING ~OGREMA02.CRE~ ~override/OGREMA02.CRE~
  SAY NAME1 @77
  SAY NAME2 @77
