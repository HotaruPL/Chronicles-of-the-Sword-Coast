// ---------------------------------------------------------------------------
// TORM'S HAND - VILLAGE NPCS
// ---------------------------------------------------------------------------

// These are deliberately minimal copies of known-good vanilla CREs.
// The actors themselves are already embedded in TORMHA.ARE; do not use
// fj_are_structure here, avoiding unnecessary runtime actor-section surgery.

COPY_EXISTING ~SHOP03.CRE~ ~override/TORMMER.CRE~
  SAY NAME1 @2061
  SAY NAME2 @2061
  WRITE_ASCII 0x2cc ~TORMMERD~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~FTWBAX_C.CRE~ ~override/TORMFEM.CRE~
  SAY NAME1 @2014
  SAY NAME2 @2014
  WRITE_ASCII 0x2cc ~TORMFEMD~ #8
  WRITE_BYTE 0x270 128
BUT_ONLY_IF_IT_CHANGES

