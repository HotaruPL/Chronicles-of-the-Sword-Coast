BEGIN QCCALPHY

IF ~Global("QCCALPHYRA_STATE","GLOBAL",0)~ THEN BEGIN QCA_INTRO
  SAY @1
  IF ~~ THEN REPLY @2 GOTO QCA_R1
  IF ~~ THEN REPLY @3 GOTO QCA_R2
END

IF ~Global("QCCALPHYRA_STATE","GLOBAL",0)~ THEN BEGIN QCA_R1
  SAY @4
  IF ~~ THEN REPLY @6 GOTO QCA_STORY1
  IF ~~ THEN REPLY @7 GOTO QCA_STORY1
  IF ~~ THEN REPLY @8 EXIT
END

IF ~Global("QCCALPHYRA_STATE","GLOBAL",0)~ THEN BEGIN QCA_R2
  SAY @5
  IF ~~ THEN REPLY @6 GOTO QCA_STORY1
  IF ~~ THEN REPLY @7 GOTO QCA_STORY1
  IF ~~ THEN REPLY @8 EXIT
END

IF ~~ THEN BEGIN QCA_STORY1
  SAY @9
  IF ~~ THEN GOTO QCA_STORY2
END

IF ~~ THEN BEGIN QCA_STORY2
  SAY @10
  IF ~~ THEN REPLY @11 GOTO QCA_STORY3
  IF ~~ THEN REPLY @12 GOTO QCA_CUT_IN
END

IF ~~ THEN BEGIN QCA_CUT_IN
  SAY @13
  IF ~~ THEN GOTO QCA_STORY3
END

IF ~~ THEN BEGIN QCA_STORY3
  SAY @14
  IF ~~ THEN GOTO QCA_STORY4
END

IF ~~ THEN BEGIN QCA_STORY4
  SAY @15
  IF ~~ THEN GOTO QCA_STORY5
END

IF ~~ THEN BEGIN QCA_STORY5
  SAY @16
  IF ~~ THEN GOTO QCA_STORY6
END

IF ~~ THEN BEGIN QCA_STORY6
  SAY @17
  IF ~~ THEN REPLY @18 GOTO QCA_ACCEPT
  IF ~InParty("Edwin") !StateCheck("Edwin",CD_STATE_NOTVALID)~ THEN REPLY @19 EXTERN EDWINJ_ QCA_EDWIN_ADVICE
  IF ~InParty("Dynaheir")~ THEN REPLY @20 EXTERN DYNAHJ QCA_DYNAHE
  IF ~~ THEN REPLY @21 EXIT
END

IF ~~ THEN BEGIN QCA_ACCEPT
  SAY @22
  IF ~~ THEN DO ~SetGlobal("QCCALPHYRA_STATE","GLOBAL",1)~ UNSOLVED_JOURNAL @35 EXIT
END

IF ~Global("QCCALPHYRA_STATE","GLOBAL",1)~ THEN BEGIN QCA_RETURN_PENDING
  SAY @25
  IF ~~ THEN REPLY @27 EXIT
END

IF ~Global("QCCALPHYRA_STATE","GLOBAL",2)~ THEN BEGIN QCA_RETURN_READY
  SAY @25
  IF ~~ THEN REPLY @26 GOTO QCA_COMPLETE
  IF ~~ THEN REPLY @27 EXIT
END

IF ~~ THEN BEGIN QCA_COMPLETE
  SAY @28
  IF ~~ THEN DO ~EraseJournalEntry(@35) EraseJournalEntry(@39) SetGlobal("QCCALPHYRA_STATE","GLOBAL",3) AddExperienceParty(800) GiveGoldForce(200) GiveItemCreate("WAND11",Player1,100,0,0) EscapeArea()~ SOLVED_JOURNAL @36 EXIT
END

IF ~~ THEN BEGIN QCA_EDWIN_OPTIONS
  SAY ~~
  IF ~~ THEN REPLY @18 GOTO QCA_ACCEPT
  IF ~~ THEN REPLY @21 EXIT
END

APPEND EDWINJ_
IF ~~ THEN BEGIN QCA_EDWIN_ADVICE
  SAY @23
  IF ~~ THEN EXTERN QCCALPHY QCA_EDWIN_OPTIONS
END
END

APPEND DYNAHJ
IF ~~ THEN BEGIN QCA_DYNAHE
  SAY @24
  IF ~~ THEN REPLY @18 EXTERN QCCALPHY QCA_ACCEPT
  IF ~~ THEN REPLY @21 EXIT
END
END

EXTEND_BOTTOM HALBAZ 0
  IF ~Global("QCCALPHYRA_STATE","GLOBAL",1)~ THEN REPLY @29 GOTO QCA_HALBAZ
END

APPEND HALBAZ
IF ~~ THEN BEGIN QCA_HALBAZ
  SAY @30
  IF ~PartyGoldGT(4999)~ THEN REPLY @31 DO ~TakePartyGold(5000) SetGlobal("QCCALPHYRA_STATE","GLOBAL",2)~ UNSOLVED_JOURNAL @39 GOTO QCA_HALBAZ_PAID
  IF ~~ THEN REPLY @32 EXIT
END

IF ~~ THEN BEGIN QCA_HALBAZ_PAID
  SAY @37
  IF ~~ THEN EXIT
END
END
