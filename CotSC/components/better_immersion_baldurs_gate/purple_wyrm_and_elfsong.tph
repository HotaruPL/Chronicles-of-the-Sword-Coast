COMPILE ~CotSC/better_immersion_beregost/bg1100_baldurs_gate.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/bg1100_baldurs_gate.tra~

// Kira — based on BDZELMA, with a custom high-damage weapon and a personal
// override script that approaches the party member she first sees.
COPY_EXISTING ~BDZELMA.CRE~ ~override/BIKIRA.CRE~
  SAY NAME1 @2037
  SAY NAME2 @2037
  WRITE_ASCII 0x2cc ~BIKIRA~ #8
  WRITE_ASCII 0x280 ~BIKIRA~ #32
  WRITE_ASCII 0x248 ~BIKIRAA~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
BUT_ONLY_IF_IT_CHANGES

// Kira's weapon — based on the standard two-handed sword, but deliberately
// upgraded to deal very heavy damage when option 3 turns her hostile.
COPY_EXISTING ~SW2H01.ITM~ ~override/BIKIRWPN.ITM~
  READ_LONG 0x64 abilities_offset
  READ_SHORT 0x68 abilities_count
  READ_LONG 0x18 item_flags
  SET patchmelee = 0
  SET ability_index = 0
  WHILE (ability_index < abilities_count) AND (patchmelee = 0) BEGIN
    READ_BYTE (abilities_offset + (ability_index * 0x38)) ability_type
    PATCH_IF ability_type = 1 BEGIN
      WRITE_BYTE (abilities_offset + (ability_index * 0x38) + 0x16) 10
      WRITE_BYTE (abilities_offset + (ability_index * 0x38) + 0x18) 5
      WRITE_SHORT (abilities_offset + (ability_index * 0x38) + 0x1a) 5
      SET patchmelee = 1
    END
    SET ability_index = (ability_index + 1)
  END
  WRITE_LONG 0x18 (item_flags BOR 0x40)
  WRITE_SHORT 0x26 0
  WRITE_LONG 0x60 3
  SAY NAME1 @2038
  SAY NAME2 @2038
BUT_ONLY_IF_IT_CHANGES

