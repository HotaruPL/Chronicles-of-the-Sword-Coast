ADD_CRE_ITEM ~CHAN01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
ADD_CRE_ITEM ~HELM01~ #0 #0 #0 ~IDENTIFIED~ ~HELMET~
ADD_CRE_ITEM ~SHLD01~ #0 #0 #0 ~IDENTIFIED~ ~SHIELD~
ADD_CRE_ITEM ~BLUN02~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
BUT_ONLY_IF_IT_CHANGES

// Durbem - working commoner chassis with KARLAT appearance and sound set.
COPY_EXISTING ~FARM.CRE~ ~override/PWYDRB5.CRE~
  SAY NAME1 @2057
  SAY NAME2 @2057
  WRITE_ASCII 0x2cc ~PWYDURB~ #8
  WRITE_ASCII 0x280 ~PWYDRB5~ #32
