BEGIN QCHALIN

IF ~True()~ THEN BEGIN 0
  SAY @1
  IF ~~ THEN REPLY @2 GOTO NASHKEL
  IF ~~ THEN REPLY @3 GOTO TRAVELERS
  IF ~~ THEN REPLY @4 GOTO RUDE
END

IF ~~ THEN BEGIN NASHKEL
  SAY @5
  IF ~~ THEN GOTO INTRO
END

IF ~~ THEN BEGIN TRAVELERS
  SAY @6
  IF ~~ THEN GOTO INTRO
END

IF ~~ THEN BEGIN RUDE
  SAY @7
  IF ~~ THEN GOTO INTRO
END

IF ~~ THEN BEGIN INTRO
