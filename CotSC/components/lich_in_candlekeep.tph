LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~NEVAZIAH.CRE~ BEGIN
  FAIL @20169
END

COPY_EXISTING ~NEVAZIAH.CRE~ ~override/QCOLMYR.CRE~
  SAY NAME1 @5024
  SAY NAME2 @5024
  WRITE_ASCII 0x280 ~QCOLMYR~ #32
  WRITE_BYTE 0x270 255
  WRITE_BYTE 0x2cc 0
  WRITE_BYTE 0x2cd 0
  WRITE_BYTE 0x2ce 0
  WRITE_BYTE 0x2cf 0
  WRITE_BYTE 0x2d0 0
  WRITE_BYTE 0x2d1 0
  WRITE_BYTE 0x2d2 0
  WRITE_BYTE 0x2d3 0
  WRITE_ASCII 0x248 ~QCOLMYR~ #8

BUT_ONLY_IF_IT_CHANGES

COMPILE ~CotSC/lich_candlekeep/QCOLMYR.BAF~

EXTEND_BOTTOM ~BG2615.BCS~ ~CotSC/lich_candlekeep/BG2615_QCOL.baf~
