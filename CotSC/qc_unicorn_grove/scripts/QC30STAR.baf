// v30 fallback for the storage Candlekeep Imoen scene.
// Original Imoen2 path remains first choice. Only use this when
// IsValidForPartyDialog("Imoen2") is false, without altering her identity or scripts.
IF
  Global("QCH_ST_IMO","GLOBAL",0)
  !IsValidForPartyDialog("Imoen2")
  Name("Imoen2",Player2)
  InMyArea(Player2)
THEN
  RESPONSE #100
    SetGlobal("QCH_ST_IMO","GLOBAL",1)
    ActionOverride(Player2,StartDialog("QCHSTIM",Player1))
END
IF
  Global("QCH_ST_IMO","GLOBAL",0)
  !IsValidForPartyDialog("Imoen2")
  Name("Imoen",Player2)
  InMyArea(Player2)
THEN
  RESPONSE #100
    SetGlobal("QCH_ST_IMO","GLOBAL",1)
    ActionOverride(Player2,StartDialog("QCHSTIM",Player1))
END
