// Custom Potion of Life Saving. Based on the standard healing potion,
// but its healing effect is increased from 9 HP to 80 HP.
COPY_EXISTING ~POTN08.ITM~ ~override/QCLIFE.ITM~
  SAY NAME1 @1012
  SAY NAME2 @1012
  WRITE_LONG 0x34 5000 // Potion of Life Saving base value; existing store modifiers may apply.
  SAY DESC @1013
  WRITE_ASCII 0x3a ~QCLIFE~ #8
  WRITE_ASCII 0x44 ~QCLIFE~ #8
  WRITE_ASCII 0x58 ~QCLIFE~ #8
  // The quick-item slot renders the item ABILITY icon, not the inventory icon.
  READ_LONG 0x64 qc_lifesave_header_offset
  READ_SHORT 0x68 qc_lifesave_header_count
  FOR (qc_lifesave_h = 0; qc_lifesave_h < qc_lifesave_header_count; qc_lifesave_h += 1) BEGIN
    WRITE_ASCII (qc_lifesave_header_offset + qc_lifesave_h * 0x38 + 0x04) ~QCLIFE~ #8
  END
  LPF ALTER_ITEM_EFFECT
    INT_VAR
      check_headers = 1
      check_globals = 0
      match_opcode = 17
      match_parameter1 = 9
      parameter1 = 80
  END
BUT_ONLY_IF_IT_CHANGES

COPY ~CotSC/Quests_and_Challenges/Eastern_Carnival/qccarncol/QCLIFE.BAM~ ~override/QCLIFE.BAM~

