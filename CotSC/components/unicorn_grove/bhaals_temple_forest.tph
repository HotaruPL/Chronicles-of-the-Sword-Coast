COPY_EXISTING ~%qcb_triss_base%~ ~override/QCBTRIS.CRE~
  SAY NAME1 @3091
  SAY NAME2 @3091
  // Ensure the alternate base looks like Triss and cannot transform via
  // inherited display animation or permanent status.
  WRITE_LONG 0x28 0x6110 // FIGHTER_FEMALE_HUMAN avatar
  WRITE_LONG 0x20 0 // no inherited permanent status flags
  WRITE_BYTE 0x275 2 // female gender
  WRITE_BYTE 0x272 1 // human race
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x32 105 // white hair
  WRITE_BYTE 0x2d 18 // green clothing
  WRITE_BYTE 0x2e 110 // pale white clothing
  WRITE_ASCII 0x280 ~QCBTRIS~ #32
  WRITE_ASCII 0x2cc ~QCBTRIS~ #8
  WRITE_ASCII 0x248 ~QCBTRAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~STAF18~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
BUT_ONLY_IF_IT_CHANGES

