LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_bg2_quests_and_districts.tra~
// All original stages in their original installation order; one reversible WeiDU component.

// New area resources only. No world-map links, NPCs, collision fine-tuning or quest yet.
COPY ~CotSC/qc_unicorn_grove/area/QCCGRV.ARE~ ~override/QCCGRV.ARE~
COPY ~CotSC/qc_unicorn_grove/area/QCCGRV.WED~ ~override/QCCGRV.WED~
COPY ~CotSC/qc_unicorn_grove/area/QCCGRV.TIS~ ~override/QCCGRV.TIS~
COPY ~CotSC/qc_unicorn_grove/area/QCCGRVSR.BMP~ ~override/QCCGRVSR.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCCGRVLM.BMP~ ~override/QCCGRVLM.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCCGRVHT.BMP~ ~override/QCCGRVHT.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV00.PVRZ~ ~override/QCGRV00.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV01.PVRZ~ ~override/QCGRV01.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV02.PVRZ~ ~override/QCGRV02.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV03.PVRZ~ ~override/QCGRV03.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV04.PVRZ~ ~override/QCGRV04.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV05.PVRZ~ ~override/QCGRV05.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV06.PVRZ~ ~override/QCGRV06.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QCGRV07.PVRZ~ ~override/QCGRV07.PVRZ~


// v1.8 additions. The approved v1.5 art, v1.6 WED and v1.7 SR are installed
// by the original resource COPY lines above, using their already-patched source files.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~ENDER.CRE~ BEGIN FAIL ~Missing ENDER.CRE (Sirian template).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~STALKE.CRE~ BEGIN FAIL ~Missing STALKE.CRE (invisible unicorn interaction proxy).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SQUIRL.CRE~ BEGIN FAIL ~Missing SQUIRL.CRE (squirrel).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~MOOSE01.CRE~ BEGIN FAIL ~Missing MOOSE01.CRE (moose).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG3317.WED~ BEGIN FAIL ~Missing native BG3317.WED required by BG3319 interior artwork.~ END

// Existing River District method: Vorbis-encoded soundtrack stored as .ACM.
MKDIR ~music/QCGRV~
COPY ~CotSC/qc_unicorn_grove/music/QCGRVA.acm~ ~music/QCGRV/QCGRVA.acm~
ADD_MUSIC ~QCU_MUSIC~ ~CotSC/qc_unicorn_grove/music/QCGRV.MUS~

COPY_EXISTING ~ENDER.CRE~ ~override/QCUSIR.CRE~
  SAY NAME1 @3065
  SAY NAME2 @3065
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x2d 39
  WRITE_BYTE 0x2e 39
  WRITE_BYTE 0x2f 39
  WRITE_BYTE 0x30 39
  WRITE_LONG 0x20 0
  WRITE_ASCII 0x280 ~QCUSIR~ #32
  WRITE_ASCII 0x2cc ~QCUSIR~ #8
  WRITE_ASCII 0x248 ~QCUSIAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Selectable click-only proxies using the naturally invisible STALKE sprite.
// Keep neutral allegiance so the selection circle is blue, no automatic talk AI.
COPY_EXISTING ~STALKE.CRE~ ~override/QCUUNIC.CRE~
  SAY NAME1 @3066
  SAY NAME2 @3066
  WRITE_BYTE 0x270 128
  WRITE_LONG 0x20 0  // Clear mechanical invisibility; STALKE sprite is visually empty.
  WRITE_LONG 0x96 0x200 // Invulnerable, so clicking is dialogue-only.
  FOR (qcu_voice_i = 0; qcu_voice_i < 100; qcu_voice_i += 1) BEGIN
    WRITE_LONG (0xa4 + 4 * qcu_voice_i) 0xffffffff // Clear inherited soundset.
  END
  WRITE_ASCII 0x280 ~QCUUNIC~ #32
  WRITE_ASCII 0x2cc ~QCUUNIC~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~SQUIRL.CRE~ ~override/QCUSQUIR.CRE~
  SAY NAME1 @3045
  SAY NAME2 @3045
  WRITE_BYTE 0x270 128
  WRITE_LONG 0x20 0
  WRITE_ASCII 0x280 ~QCUSQUIR~ #32
  WRITE_ASCII 0x248 ~QCUROAM~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~MOOSE01.CRE~ ~override/QCUMOOSE.CRE~
  SAY NAME1 @3067
  SAY NAME2 @3067
  WRITE_BYTE 0x270 128
  WRITE_LONG 0x20 0
  WRITE_ASCII 0x280 ~QCUMOOSE~ #32
  WRITE_ASCII 0x248 ~QCUROAM~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// The BG3319 copy retains native BG3317 WED/TIS art. It has no original actor
// and its existing exit leads back to QCCGRV at entrance QCUHRET.
COPY ~CotSC/qc_unicorn_grove/interior/QCGHUT.ARE~ ~override/QCGHUT.ARE~
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 1 charges1 = 40
    STR_VAR item_to_add = ~BOLT01~
  END

// Patch the fresh area copy, NEVER the frozen WED/SR/PVRZ resources.
COPY_EXISTING ~QCCGRV.ARE~ ~override/QCCGRV.ARE~
  READ_LONG 0xBC qcu_song_table
  PATCH_IF (qcu_song_table > 0) AND (qcu_song_table + 0x90 <= SOURCE_SIZE) BEGIN
    WRITE_LONG qcu_song_table %QCU_MUSIC%
    WRITE_LONG (qcu_song_table + 4) %QCU_MUSIC%
  END ELSE BEGIN
    PATCH_FAIL @20286
  END
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 857
      fj_loc_y = 1339
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
