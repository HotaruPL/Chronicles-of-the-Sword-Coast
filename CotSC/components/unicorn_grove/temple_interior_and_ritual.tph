// Gorion is not allied to the party's enemies, cannot be recruited, and does not retaliate.
// His very high HP plus passive script prevent ordinary combat deaths; he leaves via script.
COPY_EXISTING ~GORION.CRE~ ~override/QBTGOR.CRE~
  SAY NAME1 @3098
  SAY NAME2 @3098
  WRITE_BYTE 0x270 128
  WRITE_LONG 0x20 0
  WRITE_SHORT 0x24 32000
  WRITE_SHORT 0x26 32000
  READ_LONG 0x10 qbt_gor_flags
  WRITE_LONG 0x10 (qbt_gor_flags BOR 0x2000) // quest critical
  WRITE_ASCII 0x280 ~QBTGOR~ #32
  WRITE_ASCII 0x2cc ~QBTGOR~ #8
  WRITE_ASCII 0x248 ~QBTGORAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~BDROBE01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
BUT_ONLY_IF_IT_CHANGES

