COMPILE ~CotSC/better_immersion_beregost/torm_tavern_npcs.d~ USING ~CotSC/translation/%LANGUAGE%/better_immersion_beregost/torm_tavern_npcs.tra~
COMPILE ~CotSC/better_immersion_beregost/bibtavsc.baf~
COMPILE ~CotSC/better_immersion_beregost/bitfemw.baf~

// ENT_TAVERN is a four-vertex travel region centered on the requested
// TORMHA coordinate 617,607. It enters the cloned BIBG4801 area through
// the original BG4801 entrance Exit4800.
COPY ~CotSC/better_immersion_beregost/area/TORMHA.ARE~ ~override/TORMHA.ARE~
BUT_ONLY_IF_IT_CHANGES

// TORMHA.ARE is supplied by this component with the village NPC actors,
// travel regions, information points, and repaired Fortress entrance already
// embedded. Do not COPY_EXISTING the game area here or those changes would be overwritten.


// Kaeira travel controller. The same Kaeira CRE leaves Purple Wyrm, appears
// at the wilderness site, and later returns with the party to the inn.
COPY_EXISTING ~PWYKAE9.CRE~ ~override/PWYKAE9.CRE~
  WRITE_ASCII 0x248 ~PWYKAES~ #8
BUT_ONLY_IF_IT_CHANGES

// Rare Spices - temporary sack-like icon; a dedicated artwork can replace it
// later without changing the quest logic.
COPY_EXISTING ~BDMISC40.ITM~ ~override/PWYSPICE.ITM~
  READ_LONG 0x18 pwyspice_flags
  SAY NAME1 @2076
  SAY NAME2 @2076
  SAY DESC @2077
  WRITE_LONG 0x18 (pwyspice_flags BOR 1)
  WRITE_SHORT 0x38 1
  WRITE_LONG 0x4c 1
BUT_ONLY_IF_IT_CHANGES

// Kaeira at the caravan attack site.
COPY_EXISTING ~PWYTR1.ARE~ ~override/PWYTR1.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 344
      fj_loc_y = 824
      fj_dest_x = 344
      fj_dest_y = 824
      fj_spawned = 1
      fj_orientation = 12
    STR_VAR
      fj_structure_type = actor
      fj_name = PWYKAE9
      fj_cre_resref = PWYKAE9
      fj_dlg_resref = PWYKTRD
  END

  // Moose.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 720
      fj_loc_y = 425
      fj_dest_x = 720
      fj_dest_y = 425
      fj_spawned = 1
      fj_orientation = 0
