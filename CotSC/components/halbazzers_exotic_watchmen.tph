LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

LOAD_TRA ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCSUND.TRA~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG0703.BCS~ BEGIN
  FAIL @47
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BD0121.BCS~ BEGIN
  FAIL @48
END

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BEHOLD01.CRE~ BEGIN
  FAIL @49
END

// Zothlon: a friendly/neutral beholder watchman. He retains the native evil alignment,
// but his EA value is set to 128 so he uses a blue circle and does not start hostile.
COPY_EXISTING ~BEHOLD01.CRE~ ~override/QCSUNDZ.CRE~
  SAY NAME1 @5002
  SAY NAME2 @5002
  WRITE_ASCII 0x2cc ~QCSUNDZ~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCSUNDZ_DEAD~ #32

// Noxelth: a second friendly/neutral beholder watchman with the same visual chassis.
COPY_EXISTING ~BEHOLD01.CRE~ ~override/QCSUNDN.CRE~
  SAY NAME1 @5003
  SAY NAME2 @5003
  WRITE_ASCII 0x2cc ~QCSUNDN~ #8
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QCSUNDN_DEAD~ #32

COMPILE ~CotSC/Quests_and_Challenges/DLG/QCSUNDZ.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCSUND.TRA~
COMPILE ~CotSC/Quests_and_Challenges/DLG/QCSUNDN.D~ USING ~CotSC/translation/%LANGUAGE%/Quests_and_Challenges/DLG/QCSUND.TRA~
EXTEND_BOTTOM ~BG0703.BCS~ ~CotSC/Quests_and_Challenges/AREA/QCSUND.BAF~
EXTEND_BOTTOM ~BD0121.BCS~ ~CotSC/Quests_and_Challenges/AREA/QCSUND_SOD.BAF~
