LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

// Original potion source: Eastern Carnival, setup-qccol.tp2:597-622.
// Same name, text, icon and 80-HP instant healing effect, but new resource name.
COPY_EXISTING ~POTN08.ITM~ ~override/QCPLIFE.ITM~
  SAY NAME1 @5055
  SAY NAME2 @5055
  SAY DESC @5056
  WRITE_ASCII 0x3a ~QCPLIFE~ #8
  WRITE_ASCII 0x44 ~QCPLIFE~ #8
  WRITE_ASCII 0x58 ~QCPLIFE~ #8
  // The quick-item slot renders the item ABILITY icon, not the inventory icon.
  READ_LONG 0x64 qc_lifesave_header_offset
  READ_SHORT 0x68 qc_lifesave_header_count
  FOR (qc_lifesave_h = 0; qc_lifesave_h < qc_lifesave_header_count; qc_lifesave_h += 1) BEGIN
    WRITE_ASCII (qc_lifesave_header_offset + qc_lifesave_h * 0x38 + 0x04) ~QCPLIFE~ #8
  END
  LPF ALTER_ITEM_EFFECT
    INT_VAR
      check_headers = 1
      check_globals = 0
      match_opcode = 17
      match_parameter1 = 9
      parameter1 = 80
  END
BUT_ONLY_IF_IT_CHANGES

COPY ~CotSC/QCPOLS/bam/QCPLIFE.BAM~ ~override/QCPLIFE.BAM~

// Working nearest-existing-container insertion pattern, as used in QCMM.
// All pre-existing container inventory stays intact; no new containers are created.
DEFINE_PATCH_FUNCTION QCPOLS_NEAREST_CONTAINER
  INT_VAR x = 0 y = 0
BEGIN
  READ_SHORT 0x74 qcpols_cnt
  READ_LONG  0x70 qcpols_off
  PATCH_IF (qcpols_cnt > 0) BEGIN
    SET qcpols_best = 0
    SET qcpols_best_dist = 2147483647
    FOR (qcpols_i = 0; qcpols_i < qcpols_cnt; qcpols_i += 1) BEGIN
      READ_SHORT (qcpols_off + qcpols_i * 0xc0 + 0x20) qcpols_x
      READ_SHORT (qcpols_off + qcpols_i * 0xc0 + 0x22) qcpols_y
      SET qcpols_dx = qcpols_x - x
      SET qcpols_dy = qcpols_y - y
      SET qcpols_dist = qcpols_dx * qcpols_dx + qcpols_dy * qcpols_dy
      PATCH_IF (qcpols_dist < qcpols_best_dist) BEGIN
        SET qcpols_best_dist = qcpols_dist
        SET qcpols_best = qcpols_i
      END
    END
    LPF fj_are_structure
      INT_VAR
        fj_con_itm_idx = qcpols_best
        fj_charge0 = 1
        fj_flags = 1
      STR_VAR
        fj_structure_type = ~itm~
        fj_name = ~QCPLIFE~
    END
  END
  // When an area contains no containers, do nothing: no loot is inserted.
END

// Every target area uses the exact coordinates supplied by the player.
// Missing areas are logged rather than creating substitute containers.

// BG1: BG0514.ARE, nearest existing container to 2652, 602.
ACTION_IF FILE_EXISTS_IN_GAME ~BG0514.ARE~ BEGIN
  COPY_EXISTING ~BG0514.ARE~ ~override~
    LPF QCPOLS_NEAREST_CONTAINER INT_VAR x = 2652 y = 602 END
  BUT_ONLY_IF_IT_CHANGES
END ELSE BEGIN

PRINT @20478

END

