// Positive Hobgoblin response: walk away, then remain available for a brief follow-up line.
IF
  Global("BIB_BG0200_HOBG_LEAVE","LOCALS",1)
  Exists("BIB0207")
THEN
  RESPONSE #100
    SetGlobal("BIB_BG0200_HOBG_LEAVE","LOCALS",2)
    ActionOverride("BIB0207",MoveToPoint([3050.572]))
END
