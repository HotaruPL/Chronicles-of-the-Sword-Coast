// v76: each CotSC civilian now manages its own nighttime removal via QC75NITE.
// Area script remains responsible solely for its original daytime spawn positions.

// ---------------------------------------------------------------------------
// BETTER IMMERSION FOR BALDUR'S GATE - BG1100
// ---------------------------------------------------------------------------

// Kira at 3942,1288.
IF
  Global("BIB_KIRA_SPAWNED","GLOBAL",0)
  !Exists("BIKIRA")
THEN
  RESPONSE #100
    SetGlobal("BIB_KIRA_SPAWNED","GLOBAL",1)
    CreateCreature("BIKIRA",[3942.1288],0)
    ActionOverride("BIKIRA",CreateItem("BIKIRWPN",1,1,0))
    ActionOverride("BIKIRA",EquipItem("BIKIRWPN"))
END

// Orc at 3891,1728.
IF
  TimeGT(5)
  TimeLT(18)
  !Exists("BIBORC11")
THEN
  RESPONSE #100
    CreateCreature("BIBORC11",[3891.1728],0)
END

