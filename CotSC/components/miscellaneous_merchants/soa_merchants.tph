// Add item(s) to the pre-existing container nearest the specified coordinates.
// Uses live ARE container coordinates, so it also works if another mod inserted a container.
DEFINE_PATCH_FUNCTION QCMM_NEAREST_CONTAINER
  INT_VAR x = 0 y = 0 charge = 1
  STR_VAR item = ~~
BEGIN
  READ_SHORT 0x74 qcmm_cnt
  READ_LONG 0x70 qcmm_off
  PATCH_IF (qcmm_cnt < 1) BEGIN
    PATCH_FAIL @20343
  END
  SET qcmm_best = 0 // at least one container exists, verified above
  SET qcmm_best_dist = 2147483647
  FOR (qcmm_i = 0; qcmm_i < qcmm_cnt; qcmm_i += 1) BEGIN
    READ_SHORT (qcmm_off + qcmm_i * 0xc0 + 0x20) qcmm_x
    READ_SHORT (qcmm_off + qcmm_i * 0xc0 + 0x22) qcmm_y
    SET qcmm_dx = qcmm_x - x
    SET qcmm_dy = qcmm_y - y
    SET qcmm_dist = qcmm_dx * qcmm_dx + qcmm_dy * qcmm_dy
    PATCH_IF (qcmm_dist < qcmm_best_dist) BEGIN
      SET qcmm_best_dist = qcmm_dist
      SET qcmm_best = qcmm_i
    END
  END
  PATCH_IF (qcmm_best >= 0) BEGIN
    LPF fj_are_structure
      INT_VAR
        fj_con_itm_idx = qcmm_best
        fj_charge0 = charge
        fj_flags = 1 // identified
      STR_VAR
        fj_structure_type = ~itm~
        fj_name = EVAL ~%item%~
    END
  END
END

// Three pre-existing containers, retain their other loot.
COPY_EXISTING ~AR0406.ARE~ ~override~
  LPF QCMM_NEAREST_CONTAINER INT_VAR x = 215 y = 1054 charge = 2 STR_VAR item = ~QCCOKIE~ END
COPY_EXISTING ~AR1515.ARE~ ~override~
  LPF QCMM_NEAREST_CONTAINER INT_VAR x = 1466 y = 648 charge = 1 STR_VAR item = ~QCWATER~ END
COPY_EXISTING ~AR1902.ARE~ ~override~
  LPF QCMM_NEAREST_CONTAINER INT_VAR x = 0 y = 0 charge = 2 STR_VAR item = ~QCBREAD~ END


