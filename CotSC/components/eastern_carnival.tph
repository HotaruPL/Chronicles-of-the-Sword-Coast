COPY_EXISTING ~MISC03.ITM~ ~override/QCLASLO.ITM~
  SAY NAME1 @1002
  SAY NAME2 @1002
  SAY DESC @1003
  READ_LONG 0x18 item_flags
  WRITE_LONG 0x18 0x00000009
  WRITE_SHORT 0x1c 0
  WRITE_ASCII 0x3a ~QCLASLO~ #8
  WRITE_ASCII 0x44 ~QCLASLO~ #8
  WRITE_ASCII 0x58 ~QCLASLO~ #8
  WRITE_LONG 0x34 0
  WRITE_SHORT 0x38 1
  WRITE_LONG 0x4c 0
  WRITE_SHORT 0x68 0
  WRITE_SHORT 0x70 0
BUT_ONLY_IF_IT_CHANGES


// Two QCCARN containers — v31: exact clickable polygons traced from the
// player's blue-painted shapes on the 3072x2048 original-size grid.
// NOTE: fj_loc_* is container reference/opening position; it is placed
// slightly above the painted object. fj_trap_loc_* is the TRAP LAUNCH point,
// not the character's destination. No SR/WED/TIS/light/height data are changed.
COPY_EXISTING ~QCCARN.ARE~ ~override/QCCARN.ARE~
  // Left barrel: blue 6-sided upright outline, bounds 418..453 / 1025..1077.
  // Container reference point sits just above its top edge, on open ground.
  LPF fj_are_structure
    INT_VAR
      fj_type       = 11
      fj_loc_x      = 434
      fj_loc_y      = 1012
      fj_box_left   = 418
      fj_box_top    = 1025
      fj_box_right  = 453
      fj_box_bottom = 1077
      fj_trap_loc_x = 435
      fj_trap_loc_y = 1052
      fj_vertex_0   = 434 + (1025 << 16)
      fj_vertex_1   = 418 + (1038 << 16)
      fj_vertex_2   = 418 + (1068 << 16)
      fj_vertex_3   = 438 + (1077 << 16)
      fj_vertex_4   = 453 + (1064 << 16)
      fj_vertex_5   = 453 + (1037 << 16)
    STR_VAR
      fj_structure_type = container
      fj_name           = QCBBAR01
  END
  LPF fj_are_structure
    INT_VAR
      fj_con_itm_idx = SHORT_AT 0x74 - 1
      fj_flags       = 1
      fj_charge0    = 2
    STR_VAR
      fj_name           = MISC07
      fj_structure_type = itm
  END
  // Right chest: blue slanted quadrilateral, bounds 1116..1233 / 1134..1191.
  // Reference/opening point offset above the marked blue region, on accessible
  // ground to the left of the fenced display. It is not a trap launch point.
  LPF fj_are_structure
    INT_VAR
      fj_type       = 2
      fj_loc_x      = 1170
      fj_loc_y      = 1121
      fj_box_left   = 1116
      fj_box_top    = 1134
      fj_box_right  = 1233
      fj_box_bottom = 1191
      fj_trap_loc_x = 1175
      fj_trap_loc_y = 1161
      fj_vertex_0   = 1233 + (1158 << 16)
      fj_vertex_1   = 1206 + (1134 << 16)
      fj_vertex_2   = 1116 + (1172 << 16)
      fj_vertex_3   = 1148 + (1191 << 16)
    STR_VAR
      fj_structure_type = container
      fj_name           = QCCHES01
  END
  LPF fj_are_structure
    INT_VAR
      fj_con_itm_idx = SHORT_AT 0x74 - 1
      fj_flags       = 1
    STR_VAR
      fj_name           = STAF01
      fj_structure_type = itm
  END
  LPF fj_are_structure
    INT_VAR
      fj_con_itm_idx = SHORT_AT 0x74 - 1
      fj_flags       = 1
    STR_VAR
      fj_name           = POTN20
      fj_structure_type = itm
  END
  BUT_ONLY_IF_IT_CHANGES

