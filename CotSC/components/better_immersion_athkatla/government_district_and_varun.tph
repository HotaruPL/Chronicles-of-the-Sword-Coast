// ---------------------------------------------------------------------------
// GOVERNMENT DISTRICT - AR1000 + AR1005, VARUN ESCORT QUEST
// ---------------------------------------------------------------------------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR1000.ARE~ BEGIN
  FAIL @20328
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR1005.ARE~ BEGIN
  FAIL @20329
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0020.ARE~ BEGIN
  FAIL @20330
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0020.BCS~ BEGIN
  FAIL @20331
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG4800.ARE~ BEGIN
  FAIL @20332
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG4800.BCS~ BEGIN
  FAIL @20333
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG5600.WED~ BEGIN
  FAIL @20334
END

COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCVGATE.baf~
COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCVAMB.baf~
COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCVAREA.baf~
COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QCVNASH.baf~
ADD_JOURNAL TITLE (@1) @2 @3 USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCGOV.tra~
COMPILE ~CotSC/qc_better_immersion_athkatla/dialogue/QCGOV.d~ USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCGOV.tra~

// Female roaming Halfling Commoner.
COPY_EXISTING ~HALFFG.CRE~ ~override/QC10HAL.CRE~
  SAY NAME1 @3007
  SAY NAME2 @3007
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QC10HAL~ #8
  WRITE_ASCII 0x280 ~QC10HAL~ #32
  WRITE_ASCII 0x248 ~QCAWAND~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Varun in the Government District.
