// ====================================================================
// PART 6/7: v2.3a three warehouses, five houses, temple, shop, nine paired doorways
// ====================================================================

// Requires the existing River District and game-original IE area resources.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCRIVD.ARE~ BEGIN
  FAIL @20198
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QRVTHUG.CRE~ BEGIN
  FAIL @20199
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~DRUFF1.CRE~ BEGIN
  FAIL @20200
END

// These sources already exist in BG2EE/EET; the user supplied ARE/WED templates.
// The cloned WEDs continue referencing the original TIS resources.
// The copied search/light/height maps use each NEW six-character area resref.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG1207SR.BMP~ BEGIN
  FAIL @20201
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG1207LM.BMP~ BEGIN
  FAIL @20202
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BG1207HT.BMP~ BEGIN
  FAIL @20203
END
