      fj_loc_y = 158
      fj_dest_x = 1031
      fj_dest_y = 158
      fj_spawned = 1
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name = PWYWOLF
      fj_cre_resref = PWYWOLF
  END

  // Door transition to the Red Fang cave.
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 1380
      fj_box_top = 149
      fj_box_right = 1424
      fj_box_bottom = 193
      fj_cursor_idx = 30
      fj_flags = 0
      fj_vertex_0 = 1380 + (149 << 16)
      fj_vertex_1 = 1424 + (149 << 16)
      fj_vertex_2 = 1424 + (193 << 16)
      fj_vertex_3 = 1380 + (193 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = PWYTR1CAVE
      fj_destination_area = PWYTR2
      fj_destination_name = PWYTR1IN
  END

  // Forest ambience: stock BG2EE forest/cricket ambient used by working custom areas.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 832
      fj_loc_y = 512
      fj_radius = 1400
      fj_volume = 80
      fj_sound_num = 1
      fj_delay = 18
      fj_variation = 6
