  WRITE_BYTE 0x93 2
  WRITE_ASCII 0x248 ~~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  WRITE_ASCII 0x248 ~QRHXZAI~ #8
