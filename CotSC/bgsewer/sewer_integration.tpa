COPY_EXISTING ~BG2613.TIS~ ~override/QCSEWL.TIS~
COPY_EXISTING ~BG2613SR.BMP~ ~override/QCSEWLSR.BMP~
COPY_EXISTING ~BG2613LM.BMP~ ~override/QCSEWLLM.BMP~
COPY_EXISTING ~BG2613HT.BMP~ ~override/QCSEWLHT.BMP~

COPY ~CotSC/bgsewer/BG2613.WED~ ~override/QCSEWL.WED~
  WRITE_ASCII 0x24 ~QCSEWL~ #8

COPY ~CotSC/bgsewer/BG2613.bcs~ ~override/QCSEWL.BCS~

COPY ~CotSC/bgsewer/BG2613.ARE~ ~override/QCSEWL.ARE~
  // ARE 0x08 = WED resref; ARE 0x94 = area script.
  WRITE_ASCII 0x08 ~QCSEWL~ #8
  WRITE_ASCII 0x94 ~QCSEWL~ #8
  // Exit2613 is the original BG2613 information point whose tooltip is visible
  // in the copied area. Clear its information strref so the old Tethoril text
  // is not carried into QCSEWL.
  WRITE_LONG 0x244 0

  // Use the existing BG2613 travel exit (Door2615), but make it return to QCSEWR.
  LPF ALTER_AREA_REGION
    STR_VAR
      region_name = ~Door2615~
      destination_area = ~QCSEWR~
      entrance_name = ~QCSEWL_RETURN~
  END

  // Remove every original scroll from the three copied containers.
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL83~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL1U~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL2H~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL1B~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL1K~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL1G~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL1Z~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL2A~ END
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~SCRL75~ END

  // Container 1: History of Cormyr + History of Sembia.
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 1
    STR_VAR item_to_add = ~BOOK11~
  END
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 1
    STR_VAR item_to_add = ~BOOK18~
  END

  // Container 2: History of Shadowdale V + History of Tethyr.
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 2
    STR_VAR item_to_add = ~BOOK23~
  END
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 2
    STR_VAR item_to_add = ~BOOK32~
  END

  // Container 3: History of the Drow I + Mirror Image + Secret Word.
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 3
    STR_VAR item_to_add = ~BOOK38~
  END
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 3
    STR_VAR item_to_add = ~SCRL96~
  END
  LPF ADD_AREA_ITEM
    INT_VAR container_to_add_to = 3
    STR_VAR item_to_add = ~SCRL6O~
  END

  // Shante, rescued courtesan, facing north at X=160, Y=290.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 160
      fj_loc_y = 290
      fj_dest_x = 160
      fj_dest_y = 290
      fj_spawned = 1
      fj_orientation = 8
    STR_VAR
      fj_structure_type = actor
      fj_name = Shante
      fj_cre_resref = QCSHANTE
      fj_dlg_resref = QCSHANTE
      fj_bcs_override = QCSHANTE
  END

  // Sewer prisoner/freed NPC 1 beside Shante.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 251
      fj_loc_y = 188
      fj_dest_x = 251
      fj_dest_y = 188
      fj_spawned = 1
      fj_orientation = 8
    STR_VAR
      fj_structure_type = actor
      fj_name = QSEWRF1
      fj_cre_resref = QSEWRF1
  END

  // Sewer prisoner/freed NPC 3 beside Shante.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 298
      fj_loc_y = 193
      fj_dest_x = 298
      fj_dest_y = 193
      fj_spawned = 1
      fj_orientation = 8
    STR_VAR
      fj_structure_type = actor
      fj_name = QSEWRF3
      fj_cre_resref = QSEWRF3
  END

  // Replace the prior copied letter item with the corrected letter-icon version.
  LPF DELETE_AREA_ITEM STR_VAR item_to_delete = ~QCSHLTR~ END

  // The letter goes into the second container alongside the histories.
  LPF ADD_AREA_ITEM
    INT_VAR
      container_to_add_to = 2
    STR_VAR
      item_to_add = ~QCSHLTR~
      flags = IDENTIFIED
  END

  BUT_ONLY

// New entrance/return point in QCSEWR.
COPY_EXISTING ~QCSEWR.ARE~ ~override/QCSEWR.ARE~
  // Travel trigger centered on the requested coordinate X=111, Y=247.
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 91
      fj_box_top = 227
      fj_box_right = 131
      fj_box_bottom = 267
      fj_cursor_idx = 30
      fj_flags = 4
      fj_vertex_0 = 91 + (227 << 16)
      fj_vertex_1 = 131 + (227 << 16)
      fj_vertex_2 = 131 + (267 << 16)
      fj_vertex_3 = 91 + (267 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = ~QCSEWL_ENTRY~
      fj_destination_area = ~QCSEWL~
      fj_destination_name = ~Exit2615~
  END

  // Arrival point back in QCSEWR, kept just outside the travel trigger to avoid
  // an immediate bounce when the party returns from the copied location.
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 111
      fj_loc_y = 280
      fj_orientation = 8
    STR_VAR
      fj_structure_type = entrance
      fj_name = ~QCSEWL_RETURN~
  END

  BUT_ONLY



// -----------------------------------------------------------------------------
// BG0226: restore the working entrance to the custom Slime Tunnels.
// The entrance was previously placed at X=1366, Y=3289 with a
// "To Slime Tunnels" automap note. Do not replace the native BG0226 area;
// patch it in place so the rest of the original sewer area remains intact.

COPY_EXISTING ~BG0226.ARE~ ~override/BG0226.ARE~
  // Travel trigger at the established sewer entrance location.
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 1346
      fj_box_top = 3269
      fj_box_right = 1386
      fj_box_bottom = 3309
      fj_cursor_idx = 30
      fj_flags = 4
      fj_vertex_0 = 1346 + (3269 << 16)
      fj_vertex_1 = 1386 + (3269 << 16)
      fj_vertex_2 = 1386 + (3309 << 16)
      fj_vertex_3 = 1346 + (3309 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = ~QCSEWR_ENTRY~
      fj_destination_area = ~QCSEWR~
      fj_destination_name = ~QCBG0226_ENTRY~
  END

  // Restore the automap marker at the same location.
  ADD_MAP_NOTE #1366 #3289 ~green~
  ~To Slime Tunnels~

  BUT_ONLY

// Matching arrival point inside QCSEWR.
COPY_EXISTING ~QCSEWR.ARE~ ~override/QCSEWR.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1613
      fj_loc_y = 1935
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name = ~QCBG0226_ENTRY~
  END

  // Return transition to BG0226. This is the matching return that was
  // previously working with the Slime Tunnels entrance.
  LPF fj_are_structure
    INT_VAR
      fj_type = 2
      fj_box_left = 1593
      fj_box_top = 1915
      fj_box_right = 1633
      fj_box_bottom = 1955
      fj_cursor_idx = 30
      fj_flags = 4
      fj_vertex_0 = 1593 + (1915 << 16)
      fj_vertex_1 = 1633 + (1915 << 16)
      fj_vertex_2 = 1633 + (1955 << 16)
      fj_vertex_3 = 1593 + (1955 << 16)
    STR_VAR
      fj_structure_type = region
      fj_name = ~SEWER_EXIT~
      fj_destination_area = ~BG0226~
      fj_destination_name = ~SEWER_EXIT~
  END
  BUT_ONLY

// Matching destination entrance in BG0226.
COPY_EXISTING ~BG0226.ARE~ ~override/BG0226.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 1366
      fj_loc_y = 3329
      fj_orientation = 0
    STR_VAR
      fj_structure_type = entrance
      fj_name = ~SEWER_EXIT~
  END
  BUT_ONLY

COMPILE ~CotSC/bgsewer/QCCADOK.baf~
COMPILE ~CotSC/bgsewer/QCCADOK.d~ USING ~CotSC/translation/%LANGUAGE%/bgsewer/QCCADOK.tra~
COMPILE ~CotSC/bgsewer/QCSHANTE.baf~
COMPILE ~CotSC/bgsewer/QCSHANTE.d~ USING ~CotSC/translation/%LANGUAGE%/bgsewer/QCSHANTE.tra~


