// Silence (SILENC) soul-coin dialogue.
//
// The supplied SILENC.DLG has two states with player-visible response lists
// (states 2 and 7). State 2 is the first/hostile-neutral conversation branch;
// state 7 is the later recurring branch. We add the same coin option to both
// and return to the state from which the option was selected.

APPEND ~SILENC~

IF ~PartyHasItem("ORPHCOIN") Global("ORPH_SILENC_COIN_DONE","GLOBAL",0)~ THEN BEGIN ORPH_SILENC_NEGOTIATE_FIRST
  SAY @1
  IF ~~ THEN REPLY @2 GOTO ORPH_SILENC_OFFER_FIRST
  IF ~~ THEN REPLY @3 GOTO ORPH_SILENC_HUMOUR_FIRST
  IF ~~ THEN REPLY @4 GOTO ORPH_SILENC_BACK_FIRST
END

IF ~PartyHasItem("ORPHCOIN")~ THEN BEGIN ORPH_SILENC_OFFER_FIRST
  SAY @5
  IF ~~ THEN REPLY @6 DO ~SetGlobal("ORPH_SILENC_COIN_DONE","GLOBAL",1) TakePartyItem("ORPHCOIN") GiveGoldForce(400)~ EXIT
  IF ~~ THEN REPLY @7 GOTO 2
END

IF ~~ THEN BEGIN ORPH_SILENC_HUMOUR_FIRST
  SAY @8
  IF ~~ THEN GOTO 2
END

IF ~~ THEN BEGIN ORPH_SILENC_BACK_FIRST
  SAY @9
  IF ~~ THEN GOTO 2
END

IF ~PartyHasItem("ORPHCOIN") Global("ORPH_SILENC_COIN_DONE","GLOBAL",0)~ THEN BEGIN ORPH_SILENC_NEGOTIATE_MAIN
  SAY @10
  IF ~~ THEN REPLY @11 GOTO ORPH_SILENC_OFFER_MAIN
  IF ~~ THEN REPLY @12 GOTO ORPH_SILENC_HUMOUR_MAIN
  IF ~~ THEN REPLY @13 GOTO ORPH_SILENC_BACK_MAIN
END

IF ~PartyHasItem("ORPHCOIN")~ THEN BEGIN ORPH_SILENC_OFFER_MAIN
  SAY @14
  IF ~~ THEN REPLY @15 DO ~SetGlobal("ORPH_SILENC_COIN_DONE","GLOBAL",1) TakePartyItem("ORPHCOIN") GiveGoldForce(400)~ EXIT
  IF ~~ THEN REPLY @16 GOTO 7
END

IF ~~ THEN BEGIN ORPH_SILENC_HUMOUR_MAIN
  SAY @17
  IF ~~ THEN GOTO 7
END

IF ~~ THEN BEGIN ORPH_SILENC_BACK_MAIN
  SAY @18
  IF ~~ THEN GOTO 7
END

END

EXTEND_BOTTOM ~SILENC~ 2
  IF ~PartyHasItem("ORPHCOIN") Global("ORPH_SILENC_COIN_DONE","GLOBAL",0)~ THEN REPLY @19 GOTO ORPH_SILENC_NEGOTIATE_FIRST
END

EXTEND_BOTTOM ~SILENC~ 7
  IF ~PartyHasItem("ORPHCOIN") Global("ORPH_SILENC_COIN_DONE","GLOBAL",0)~ THEN REPLY @20 GOTO ORPH_SILENC_NEGOTIATE_MAIN
END
