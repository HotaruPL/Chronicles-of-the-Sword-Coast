// Hodrig, based on Slythe. Replace the Shadow's Blade with DAGG04.
COPY_EXISTING ~SLYTHE.CRE~ ~override/QCTHODR.CRE~
  SAY NAME1 @3152
  SAY NAME2 @3152
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QCTHODR~ #8
  WRITE_ASCII 0x280 ~QCTHODR~ #32
  WRITE_ASCII 0x248 ~QCTHODR~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEM ~SW1H10~
  // v70: strip all inherited Slythe/Sarevok correspondence and invitation.
  // Slythe's original source may be affected by earlier installed content mods;
  // keep his combat equipment but do not import his plot documents into Hodrig.
  REMOVE_CRE_ITEM ~SCRL2I~ // Generic letter sometimes used as a document
  REMOVE_CRE_ITEM ~SCRL2K~ // Letter from Sarevok to Slythe
  REMOVE_CRE_ITEM ~SCRL2L~ // Letter from Slythe to Sarevok, first
  REMOVE_CRE_ITEM ~SCRL2M~ // Letter from Slythe to Sarevok, second
  REMOVE_CRE_ITEM ~MISC78~ // Invitation to the Ducal Palace
  ADD_CRE_ITEM ~DAGG04~ #0 #0 #0 ~NONE~ ~WEAPON1~ EQUIP
  // v69: the recovered child's remains must be lootable if Hodrig dies
  // before his low-HP surrender dialogue can fire.
  ADD_CRE_ITEM ~QCTBODY~ #0 #0 #0 ~IDENTIFIED~ ~INV1~
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Hodrig's three acolytes: PPMUR chassis. They remain neutral until
// Hodrig starts combat. Their QC override immediately attacks the party;
// no invisibility effect to strand them out of combat (v69).
COPY_EXISTING ~PPMUR.CRE~ ~override/QCTAC1.CRE~
  SAY NAME1 @3153
  SAY NAME2 @3153
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x280 ~QCTAC1~ #32
  WRITE_ASCII 0x248 ~QCTACOL~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES
COPY_EXISTING ~PPMUR.CRE~ ~override/QCTAC2.CRE~
  SAY NAME1 @3153
  SAY NAME2 @3153
