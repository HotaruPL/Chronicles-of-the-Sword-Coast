// v19: Bhaal's Temple forest encounters and conversations. Separate component so the
// known-good QCBHAL WED/TIS/PVRZ, container hitboxes and QCJHR1 dialogue stay frozen.

// ---------- Integrated milestone: QC: Bhaal's Temple - Forest Encounters and Dialogue (QCBHAL)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBHAL.ARE~ BEGIN FAIL ~Install the working QCBHAL temple area (component 5) first.~ END

// HARPASS.CRE is not a standard resource in every EET installation.
// Prefer it when installed; otherwise reuse the already-required female
// humanoid DAESE.CRE and explicitly assign Triss a human female avatar.
ACTION_IF FILE_EXISTS_IN_GAME ~HARPASS.CRE~ BEGIN
  OUTER_SPRINT qcb_triss_base ~HARPASS.CRE~
END ELSE BEGIN
  OUTER_SPRINT qcb_triss_base ~DAESE.CRE~
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~TAUGOS.CRE~ BEGIN FAIL ~TAUGOS.CRE missing: needed for Bhaal cultists.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~DAESE.CRE~ BEGIN FAIL ~DAESE.CRE missing: needed for Bhaal priest.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDMURS.CRE~ BEGIN FAIL ~BDMURS.CRE missing: needed for Malzoth.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SQUIRL.CRE~ BEGIN FAIL ~SQUIRL.CRE missing: needed for squirrel.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~HELM10.ITM~ BEGIN FAIL ~HELM10.ITM missing for cultist helmets.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~STAF18.ITM~ BEGIN FAIL ~STAF18.ITM (quarterstaff +2) missing.~ END
ACTION_IF FILE_EXISTS_IN_GAME ~RABBIT.CRE~ BEGIN
  OUTER_SPRINT qcb_rabbit_base ~RABBIT.CRE~
END ELSE ACTION_IF FILE_EXISTS_IN_GAME ~RABBIT01.CRE~ BEGIN
  OUTER_SPRINT qcb_rabbit_base ~RABBIT01.CRE~
END ELSE BEGIN
  FAIL @20297
END

