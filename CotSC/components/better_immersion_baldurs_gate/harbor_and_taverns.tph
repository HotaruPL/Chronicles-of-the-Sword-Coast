// Female Elven Commoner — SARELF04 chassis, static and weaponless.
COPY_EXISTING ~SARELF04.CRE~ ~override/BGBG0701.CRE~
  SAY NAME1 @2012
  SAY NAME2 @2012
  WRITE_ASCII 0x2cc ~BGBG0701~ #8
  WRITE_ASCII 0x280 ~BGBG0701~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x92 12
  WRITE_BYTE 0x93 2
  REMOVE_CRE_ITEMS
BUT_ONLY_IF_IT_CHANGES

