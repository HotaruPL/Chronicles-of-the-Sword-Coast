  FAIL @20158
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~MISTHO01.CRE~ BEGIN
  FAIL @20159
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~MISTCD01.CRE~ BEGIN
  FAIL @20160
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDDEAD01.CRE~ BEGIN
  FAIL @20161
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~SHADOW01.CRE~ BEGIN
  FAIL @20162
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~ICBONE01.CRE~ BEGIN
  FAIL @20163
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BAZGAU01.CRE~ BEGIN
  FAIL @20164
