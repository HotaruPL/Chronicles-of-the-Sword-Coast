// Fergie the Wanderer - potion merchant in QCTENR02.
// The merchant is based on GALTOK only for his gnome appearance.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~GALTOK.CRE~ BEGIN
  FAIL @20010
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~HIGHHED2.STO~ BEGIN
  FAIL @20011
END

COPY_EXISTING ~GALTOK.CRE~ ~override/QCFERGIE.CRE~
  SAY NAME1 @1011
  SAY NAME2 @1011
  WRITE_ASCII 0x2cc ~QCFERGIE~ #8
  WRITE_ASCII 0x280 ~QCFERGIE~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~QCTENT02.ARE~ ~override/QCTENT02.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x       = 249
      fj_loc_y       = 229
      fj_dest_x      = 249
      fj_dest_y      = 229
      fj_orientation = 0
    STR_VAR
      fj_structure_type = actor
      fj_name           = QCFERGIE
      fj_dlg_resref     = QCFERGIE
      fj_cre_resref     = QCFERGIE
  END
  BUT_ONLY_IF_IT_CHANGES

// Fergie's Emporium. Start from an existing potion-capable store structure,
// clear its sale list, then add Fergie's stock. Standard item values are retained
// so the prices remain consistent with the normal game items and other merchants.
COPY_EXISTING ~HIGHHED2.STO~ ~override/QCFERGIE.STO~
  LPF DELETE_STORE_ITEM
    STR_VAR item_to_delete = ~.*~
  END
  ADD_STORE_ITEM ~POTN08~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN52~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN42~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~QCLIFE~ #0 #0 #0 ~IDENTIFIED~ #2
  ADD_STORE_ITEM ~POTN55~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN20~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN29~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN30~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN18~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN24~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN19~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN13~ #0 #0 #0 ~IDENTIFIED~ #2
  ADD_STORE_ITEM ~POTN27~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN45~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN31~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN09~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN10~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN34~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN11~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN35~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN37~ #0 #0 #0 ~IDENTIFIED~ #10
  ADD_STORE_ITEM ~POTN38~ #0 #0 #0 ~IDENTIFIED~ #2
  ADD_STORE_ITEM ~POTN14~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN46~ #0 #0 #0 ~IDENTIFIED~ #5
  ADD_STORE_ITEM ~POTN03~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~POTN12~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~POTN04~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~POTN05~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~POTN06~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~POTN07~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~POTN39~ #0 #0 #0 ~IDENTIFIED~ #2
  ADD_STORE_ITEM ~POTN41~ #0 #0 #0 ~IDENTIFIED~ #2
  ADD_STORE_ITEM ~POTN43~ #0 #0 #0 ~IDENTIFIED~ #2
  ADD_STORE_ITEM ~BAG06~ #0 #0 #0 ~IDENTIFIED~ #1
  ADD_STORE_ITEM ~BAG03~ #0 #0 #0 ~IDENTIFIED~ #1
