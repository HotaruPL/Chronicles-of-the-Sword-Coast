// Ajantis reacts only after CHARNAME finishes the entire conversation with Astarion.
APPEND AJANTJ
IF ~~ THEN BEGIN QCA_ASTAR_AJANTIS_FINAL
  SAY @33
  IF ~~ THEN DO ~LeaveParty() Enemy()~ EXIT
END
END

BEGIN QCASTAR

IF ~Global("QCASTAR_TALKED","LOCALS",1)~ THEN BEGIN QCA_INTRO
  SAY @1
  IF ~~ THEN DO ~SetGlobal("QCASTAR_TALKED","LOCALS",2)~ REPLY @2 GOTO QCA_ADVENTURE
  IF ~~ THEN DO ~SetGlobal("QCASTAR_TALKED","LOCALS",2) Enemy()~ REPLY @3 EXIT
  IF ~~ THEN DO ~SetGlobal("QCASTAR_TALKED","LOCALS",2)~ REPLY @4 EXIT
END

IF ~~ THEN BEGIN QCA_ADVENTURE
  SAY @5
  IF ~~ THEN REPLY @6 GOTO QCA_ADVENTURER
  IF ~~ THEN REPLY @7 GOTO QCA_BLOODSHED
  IF ~~ THEN REPLY @8 EXIT
END

IF ~~ THEN BEGIN QCA_ADVENTURER
  SAY @9
  IF ~~ THEN GOTO QCA_SHARED1
END

IF ~~ THEN BEGIN QCA_BLOODSHED
  SAY @10
  IF ~~ THEN GOTO QCA_SHARED1
END

IF ~~ THEN BEGIN QCA_SHARED1
  SAY @11
  IF ~~ THEN GOTO QCA_SHARED2
END

IF ~~ THEN BEGIN QCA_SHARED2
  SAY @12
  IF ~~ THEN GOTO QCA_SHARED3
END

IF ~~ THEN BEGIN QCA_SHARED3
  SAY @13
  IF ~~ THEN REPLY @14 GOTO QCA_REFUSE
  IF ~~ THEN REPLY @15 GOTO QCA_BARGAIN
  IF ~~ THEN REPLY @16 GOTO QCA_ACCEPT
END

IF ~~ THEN BEGIN QCA_REFUSE
  SAY @17
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN QCA_BARGAIN
  SAY @18
  IF ~~ THEN REPLY @14 GOTO QCA_REFUSE
  IF ~~ THEN REPLY @15 GOTO QCA_BARGAIN
  IF ~~ THEN REPLY @16 GOTO QCA_ACCEPT
END

IF ~~ THEN BEGIN QCA_ACCEPT
  SAY @19
  IF ~~ THEN DO ~SetGlobal("QCDEREK_ACTIVE","GLOBAL",1) SetGlobal("QCASTAR_TALKED","LOCALS",3)~ UNSOLVED_JOURNAL @63 GOTO QCA_QUEST_DONE
END

IF ~~ THEN BEGIN QCA_QUEST_DONE
  SAY @20
  IF ~~ THEN REPLY @21 GOTO QCA_VAMPIRE
  IF ~~ THEN REPLY @22 GOTO QCA_MASTER
  IF ~~ THEN REPLY @23 GOTO QCA_PEACE
  IF ~InParty("Ajantis")~ THEN REPLY @24 EXTERN AJANTJ QCA_ASTAR_AJANTIS_FINAL
  IF ~!InParty("Ajantis")~ THEN REPLY @24 EXIT
END

IF ~~ THEN BEGIN QCA_VAMPIRE
  SAY @25
  IF ~~ THEN GOTO QCA_QUEST_DONE
END

IF ~~ THEN BEGIN QCA_MASTER
  SAY @26
  IF ~~ THEN GOTO QCA_QUEST_DONE
END

IF ~~ THEN BEGIN QCA_PEACE
  SAY @27
  IF ~~ THEN GOTO QCA_QUEST_DONE
END

IF ~Global("QCDEREK_ACTIVE","GLOBAL",1) Global("QCASTAR_TALKED","LOCALS",3)~ THEN BEGIN QCA_RETURN
  SAY @34
  IF ~PartyHasItem("QCDRBODY")~ THEN REPLY @35 GOTO QCA_RETURN_BODY
  IF ~Global("QCDEREK_ESCAPED","GLOBAL",1)~ THEN REPLY @36 GOTO QCA_RETURN_ESCAPE
  IF ~~ THEN REPLY @37 GOTO QCA_RETURN_QUIT
END

IF ~~ THEN BEGIN QCA_RETURN_BODY
  SAY @38
  IF ~~ THEN DO ~DestroyItem("QCDRBODY") SetGlobal("QCDEREK_ACTIVE","GLOBAL",2) SetGlobal("QCASTAR_TALKED","LOCALS",4) AddExperienceParty(500) Enemy() Attack(Player1)~ SOLVED_JOURNAL @66 EXIT
END

IF ~~ THEN BEGIN QCA_RETURN_ESCAPE
  SAY @39
  IF ~~ THEN REPLY @40 GOTO QCA_RETURN_ESCAPE_END
END

IF ~~ THEN BEGIN QCA_RETURN_ESCAPE_END
  SAY @41
  IF ~~ THEN DO ~SetGlobal("QCDEREK_ACTIVE","GLOBAL",2) SetGlobal("QCASTAR_TALKED","LOCALS",4) AddExperienceParty(500) Enemy() Attack(Player1)~ SOLVED_JOURNAL @67 EXIT
END

IF ~~ THEN BEGIN QCA_RETURN_QUIT
  SAY @42
  IF ~~ THEN DO ~SetGlobal("QCDEREK_ACTIVE","GLOBAL",2) SetGlobal("QCASTAR_TALKED","LOCALS",4) Enemy()~ SOLVED_JOURNAL @68 EXIT
END
