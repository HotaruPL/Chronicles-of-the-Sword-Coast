// Gnoll Commoner - converted from proven neutral monster chassis.
COPY_EXISTING ~HOBGBEG1.CRE~ ~override/QC40GNOL.CRE~
  SAY NAME1 @3113
  SAY NAME2 @3113
  WRITE_SHORT 0x28 0x8000
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x272 110    // GNOLL
  WRITE_BYTE 0x273 120    // GNOLL class
  WRITE_ASCII 0x2cc ~QC40GNOL~ #8
  WRITE_ASCII 0x280 ~QC40GNOL~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

