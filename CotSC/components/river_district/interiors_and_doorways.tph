// v4.7: Seven original containers and all v4.6 loot remain unchanged.
// Each trapped chest uses its OWN script, triggered only by Opened([ANYONE]).
// Its trap is detected/disarmed through the native ARE container trap fields.
// The container Trap-resets flag (bit 3) stays clear.
COMPILE ~CotSC/qriv_hannibal/scripts/QRHT02.baf~
COMPILE ~CotSC/qriv_hannibal/scripts/QRHT06.baf~
COPY_EXISTING ~QCHANN.ARE~ ~override/QCHANN.ARE~
  PATCH_IF (SHORT_AT 0x74 != 7) BEGIN
    PATCH_FAIL @20215
  END
  READ_LONG 0x70 q46co
  // Container 2: trapped shelf by x=580,y=955; detectable and removable.
  WRITE_LONG (q46co + 1 * 0xc0 + 0x28) 0 // No reset, no lock.
  WRITE_SHORT (q46co + 1 * 0xc0 + 0x2c) 30
  WRITE_SHORT (q46co + 1 * 0xc0 + 0x2e) 35
  WRITE_SHORT (q46co + 1 * 0xc0 + 0x30) 1
  WRITE_SHORT (q46co + 1 * 0xc0 + 0x32) 0
  WRITE_ASCII (q46co + 1 * 0xc0 + 0x48) ~QRHT02~ #8
  // Container 6: cabinet near x=2680,y=843, locked at 50% and trapped.
  WRITE_SHORT (q46co + 5 * 0xc0 + 0x26) 50
  WRITE_LONG (q46co + 5 * 0xc0 + 0x28) 1 // Locked; no trap-reset bit.
  WRITE_SHORT (q46co + 5 * 0xc0 + 0x2c) 35
  WRITE_SHORT (q46co + 5 * 0xc0 + 0x2e) 40
  WRITE_SHORT (q46co + 5 * 0xc0 + 0x30) 1
  WRITE_SHORT (q46co + 5 * 0xc0 + 0x32) 0
  WRITE_ASCII (q46co + 5 * 0xc0 + 0x48) ~QRHT06~ #8

  // #1 Stairwell barrel: Invisibility and 20 Bolts of Lightning.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 1 charges1 = 1 STR_VAR item_to_add = ~POTN10~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 1 charges1 = 20 STR_VAR item_to_add = ~BOLT03~ END
  // #2 Trapped storage shelf: three ordinary bottles of wine + Haste scroll.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 2 charges1 = 1 STR_VAR item_to_add = ~QRHWINE~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 2 charges1 = 1 STR_VAR item_to_add = ~QRHWINE~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 2 charges1 = 1 STR_VAR item_to_add = ~QRHWINE~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 2 charges1 = 1 STR_VAR item_to_add = ~SCRL1H~ END
  // #3 Floor crate: skull and silver ring.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 3 charges1 = 1 STR_VAR item_to_add = ~MISC50~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 3 charges1 = 1 STR_VAR item_to_add = ~RING11~ END
  // #4 Barracks shelf: 12 gp + Potion of Magic Shielding.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 4 charges1 = 12 STR_VAR item_to_add = ~MISC07~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 4 charges1 = 1 STR_VAR item_to_add = ~POTN35~ END
  // #5 Barracks shelf: Beljuril gem.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 5 charges1 = 1 STR_VAR item_to_add = ~MISC6Z~ END
  // #6 Trapped and locked bedroom cabinet: Felicity's Ring, dagger, 80gp, BDAMUL02.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 6 charges1 = 1 STR_VAR item_to_add = ~QRVFRING~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 6 charges1 = 1 STR_VAR item_to_add = ~DAGG01~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 6 charges1 = 80 STR_VAR item_to_add = ~MISC07~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 6 charges1 = 1 STR_VAR item_to_add = ~BDAMUL02~ END
  // #7 Small bedroom table: 2 gp + Potion of Healing.
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 7 charges1 = 2 STR_VAR item_to_add = ~MISC07~ END
  LPF ADD_AREA_ITEM INT_VAR container_to_add_to = 7 charges1 = 1 STR_VAR item_to_add = ~POTN08~ END
BUT_ONLY_IF_IT_CHANGES

// v4.9: The old Helmite medallion is recoverable from Hannibal's body.
// Use MISC04 artwork/type unchanged; keep this loot separate from the
// Felicity ring/other quest items. Senyan accepts this exact resref.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~MISC04.ITM~ BEGIN
  FAIL @20216
END
COPY_EXISTING ~MISC04.ITM~ ~override/QHHSYM.ITM~
  SAY NAME1 @3018
  SAY NAME2 @3018
  SAY DESC @3019
BUT_ONLY_IF_IT_CHANGES

