// QCHIN1: separate first-render test for the infernal house interior.
// Install this component independently; it does not overwrite QCHELL or the Unicorn Grove quests.

// ---------- Integrated milestone: QC: Infernal House (QCHIN1 area render test)~ ----------

COPY ~CotSC/qc_unicorn_grove/area/QCHIN1.ARE~ ~override/QCHIN1.ARE~
COPY ~CotSC/qc_unicorn_grove/area/QCHIN1.WED~ ~override/QCHIN1.WED~
COPY ~CotSC/qc_unicorn_grove/area/QCHIN1.TIS~ ~override/QCHIN1.TIS~
COPY ~CotSC/qc_unicorn_grove/area/QCHIN1SR.BMP~ ~override/QCHIN1SR.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCHIN1LM.BMP~ ~override/QCHIN1LM.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QCHIN1HT.BMP~ ~override/QCHIN1HT.BMP~
COPY ~CotSC/qc_unicorn_grove/area/QHIN100.PVRZ~ ~override/QHIN100.PVRZ~
COPY ~CotSC/qc_unicorn_grove/area/QHIN101.PVRZ~ ~override/QHIN101.PVRZ~

COPY_EXISTING ~QCHIN1.ARE~ ~override/QCHIN1.ARE~
  LPF fj_are_structure
    INT_VAR fj_loc_x = 623 fj_loc_y = 631 fj_orientation = 8
    STR_VAR fj_structure_type = entrance fj_name = QCINENT
  END
BUT_ONLY_IF_IT_CHANGES

// Public installer: development progress message omitted.

// === Better Immersion: Nightmare Candlekeep memory encounters ===
// Install after QC Unicorn Grove and QCHIN1. This patch changes ARE scripts/actors/regions only.
// Source WED/TIS/PVRZ/SR/LM/HT and QCHIN1 containers are never modified.

// ---------- Integrated milestone: QC: Nightmare Candlekeep encounters, dialogue and battle music (QCHELL + QCHIN1)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCHELL.ARE~ BEGIN FAIL ~Install QC Unicorn Grove (QCHELL) first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCHIN1.ARE~ BEGIN FAIL ~Install QC Infernal House (QCHIN1) first.~ END

// Existing EE trick: Ogg/Vorbis payloads with .acm extension, matching QCGRVA.
MKDIR ~music/QCHBTL~
MKDIR ~music/QCHEND~
COPY ~CotSC/qc_unicorn_grove/music/QCHBTLA.acm~ ~music/QCHBTL/QCHBTLA.acm~
COPY ~CotSC/qc_unicorn_grove/music/QCHENDA.acm~ ~music/QCHEND/QCHENDA.acm~
ADD_MUSIC ~QCH_BATTLE~ ~CotSC/qc_unicorn_grove/music/QCHBTL.MUS~
ADD_MUSIC ~QCH_VICTORY~ ~CotSC/qc_unicorn_grove/music/QCHEND.MUS~
MKDIR ~music/QCHAMB~
COPY ~CotSC/qc_unicorn_grove/music/QCHAMBA.acm~ ~music/QCHAMB/QCHAMBA.acm~
ADD_MUSIC ~QCH_AMBIENT~ ~CotSC/qc_unicorn_grove/music/QCHAMB.MUS~

COPY ~CotSC/qc_unicorn_grove/portraits/QCDIMOS.BMP~ ~override/QCDIMOS.BMP~
COPY ~CotSC/qc_unicorn_grove/portraits/QCDIMOL.BMP~ ~override/QCDIMOL.BMP~

COPY_EXISTING ~BATTHO.CRE~ ~override/QCHBHOR.CRE~
  WRITE_BYTE 0x270 255
  WRITE_ASCII 0x280 ~QCHBHOR~ #32
  WRITE_SHORT 0x24 165
  WRITE_SHORT 0x26 165
BUT_ONLY_IF_IT_CHANGES

ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDDEAD01.CRE~ BEGIN
  FAIL @20287
END
COPY_EXISTING ~BDDEAD01.CRE~ ~override/QCHDRWN.CRE~
  WRITE_BYTE 0x270 255
  WRITE_ASCII 0x280 ~QCHDRWN~ #32
  SAY NAME1 @3070
  SAY NAME2 @3070
BUT_ONLY_IF_IT_CHANGES

