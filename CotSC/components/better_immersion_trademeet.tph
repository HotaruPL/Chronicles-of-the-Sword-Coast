  WRITE_ASCII 0x280 ~QCTAC2~ #32
  WRITE_ASCII 0x248 ~QCTACOL~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES
