LOAD_TRA ~CotSC/translation/%LANGUAGE%/installer_final_small_components.tra~

ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR1600.ARE~ BEGIN FAIL ~Missing AR1600.ARE (Brynnlaw).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR1600.BCS~ BEGIN FAIL ~Missing AR1600.BCS (Brynnlaw area script).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~GBEGG01.CRE~ BEGIN FAIL ~Missing GBEGG01.CRE (beggar creature template).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~GHOLOR01.CRE~ BEGIN FAIL ~Missing GHOLOR01.CRE (Ghoul Lord).~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~LACEDO01.CRE~ BEGIN FAIL ~Missing LACEDO01.CRE (Lacedon).~ END

// Shalvey: neutral and scriptable, with a unique QC death variable.
COPY_EXISTING ~GBEGG01.CRE~ ~override/QCBPSHAL.CRE~
 SAY NAME1 @5042
 SAY NAME2 @5042
 REMOVE_CRE_EFFECTS
 WRITE_LONG 0x20 0
 WRITE_BYTE 0x270 128
 WRITE_ASCII 0x280 ~QCBPSHAL~ #32
 WRITE_ASCII 0x2cc ~QCBPSHAL~ #8
 WRITE_ASCII 0x248 ~QCBPSHAL~ #8
 WRITE_ASCII 0x250 ~ ~ #8
 WRITE_ASCII 0x258 ~ ~ #8
 WRITE_ASCII 0x260 ~ ~ #8
 WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Neutral until the party finishes the first conversation, then attacks with
// his original Ghoul Lord mechanics. Preserve CRE abilities and inventory.
COPY_EXISTING ~GHOLOR01.CRE~ ~override/QCBPGHOL.CRE~
 SAY NAME1 @5043
 SAY NAME2 @5043
 WRITE_LONG 0x20 0
 WRITE_BYTE 0x270 128
 WRITE_ASCII 0x280 ~QCBPGHOL~ #32
 WRITE_ASCII 0x2cc ~QCBPGHOL~ #8
 WRITE_ASCII 0x248 ~QCBPGHOL~ #8
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~LACEDO01.CRE~ ~override/QCBPLACD.CRE~
 SAY NAME1 @5044
 SAY NAME2 @5044
 WRITE_BYTE 0x270 255
 WRITE_ASCII 0x280 ~QCBPLACD~ #32
 WRITE_ASCII 0x2cc ~QCBPLACD~ #8
 WRITE_ASCII 0x248 ~QCBPLACD~ #8
BUT_ONLY_IF_IT_CHANGES

// Append Shalvey to existing area, preserving original inhabitants and exits.
COPY_EXISTING ~AR1600.ARE~ ~override/AR1600.ARE~
 LPF fj_are_structure
   INT_VAR
     fj_loc_x = 1747
     fj_loc_y = 715
     fj_orientation = 2 // northeast: rotated 180 degrees
   STR_VAR
     fj_structure_type = actor
     fj_name = QCBPSHAL
     fj_cre_resref = QCBPSHAL
 END
BUT_ONLY_IF_IT_CHANGES

EXTEND_TOP ~AR1600.BCS~ ~CotSC/qc_beggar_plea/scripts/QCBP1600.baf~
COMPILE ~CotSC/qc_beggar_plea/scripts/QCBPSHAL.baf~
COMPILE ~CotSC/qc_beggar_plea/scripts/QCBPGHOL.baf~
COMPILE ~CotSC/qc_beggar_plea/scripts/QCBPLACD.baf~
ADD_JOURNAL TITLE (@7015) @100 @101 @102 @103 USING ~CotSC/translation/%LANGUAGE%/qc_beggar_plea/tra/beggar.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~
COMPILE ~CotSC/qc_beggar_plea/dialogue/shalvey.d~ USING ~CotSC/translation/%LANGUAGE%/qc_beggar_plea/tra/beggar.tra~

// Public installer: development progress message omitted.
