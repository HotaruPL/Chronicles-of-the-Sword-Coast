BEGIN QCHASHRK

IF ~OR(2) Global("QCHORSE_STATE","GLOBAL",2) Global("QCHORSE_STATE","GLOBAL",5)~ THEN BEGIN QCH_SAVED
  SAY @34
  IF ~~ THEN EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_INTRO
  SAY @14
  IF ~~ THEN REPLY @15 GOTO QCH_STEALER
  IF ~~ THEN REPLY @16 GOTO QCH_STEALER_PEACE
  IF ~~ THEN REPLY @17 GOTO QCH_HOSTILE_1
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_STEALER
  SAY @18
  IF ~~ THEN REPLY @21 GOTO QCH_WHY
  IF ~~ THEN REPLY @22 GOTO QCH_ALONE
  IF ~~ THEN REPLY @23 GOTO QCH_GIVE
  IF ~~ THEN REPLY @24 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_STEALER_PEACE
  SAY @19
  IF ~~ THEN REPLY @21 GOTO QCH_WHY
  IF ~~ THEN REPLY @22 GOTO QCH_ALONE
  IF ~~ THEN REPLY @23 GOTO QCH_GIVE
  IF ~~ THEN REPLY @24 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_WHY
  SAY @25
  IF ~~ THEN REPLY @21 GOTO QCH_WHY
  IF ~~ THEN REPLY @22 GOTO QCH_ALONE
  IF ~~ THEN REPLY @23 GOTO QCH_GIVE
  IF ~~ THEN REPLY @24 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_ALONE
  SAY @26
  IF ~~ THEN REPLY @21 GOTO QCH_WHY
  IF ~~ THEN REPLY @22 GOTO QCH_ALONE
  IF ~~ THEN REPLY @23 GOTO QCH_GIVE
  IF ~~ THEN REPLY @24 EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_GIVE
  SAY @27
  IF ~~ THEN REPLY @28 GOTO QCH_HOSTILE_2
  IF ~~ THEN REPLY @29 GOTO QCH_RETURN
  IF ~~ THEN REPLY @30 GOTO QCH_HOSTILE_3
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_HOSTILE_1
  SAY @20
  IF ~~ THEN DO ~SetGlobal("QCHORSE_STATE","GLOBAL",3) Enemy()~ EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_HOSTILE_2
  SAY @31
  IF ~~ THEN DO ~SetGlobal("QCHORSE_STATE","GLOBAL",3) Enemy()~ EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_HOSTILE_3
  SAY @31
  IF ~~ THEN DO ~SetGlobal("QCHORSE_STATE","GLOBAL",3) Enemy()~ EXIT
END

IF ~Global("QCHORSE_STATE","GLOBAL",1)~ THEN BEGIN QCH_RETURN
  SAY @32
  IF ~~ THEN DO ~SetGlobal("QCHORSE_STATE","GLOBAL",2) DestroySelf() CreateCreature("QCHASHRK",[2164.1665],0)~ EXIT
END
