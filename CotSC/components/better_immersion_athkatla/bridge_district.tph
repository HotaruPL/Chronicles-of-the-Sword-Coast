// ---------------------------------------------------------------------------
// BRIDGE DISTRICT - AR0500 + FIVE FLAGONS - AR0513
// ---------------------------------------------------------------------------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0500.ARE~ BEGIN
  FAIL @20326
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~AR0513.ARE~ BEGIN
  FAIL @20327
END

COMPILE ~CotSC/qc_better_immersion_athkatla/scripts/QC50HOGA.baf~
ADD_JOURNAL TITLE (@1) @2 @3 USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCBRIDGE.tra~
COMPILE ~CotSC/qc_better_immersion_athkatla/dialogue/QCBRIDGE.d~ USING ~CotSC/translation/%LANGUAGE%/qc_better_immersion_athkatla/dialogue/QCBRIDGE.tra~

// Irving's reward drawing: inventory-only misc item using the user's supplied sketch.
COPY ~CotSC/qc_better_immersion_athkatla/items/QCBDRAW.ITM~ ~override/QCBDRAW.ITM~
  SAY NAME1 @3121
  SAY NAME2 @3122
  SAY DESC @3123
  // Plain movable/displayable misc item: no critical/undroppable flag.
  WRITE_LONG 0x18 0x0000000c
COPY ~CotSC/qc_better_immersion_athkatla/items/QCBDRAW.BAM~ ~override/QCBDRAW.BAM~

// Gnome Beggar - requested GELLAN chassis, recolored. Some EET installs may not
// contain GELLAN unless the BG1 source/mod that provides it is present, so keep
// a harmless gnome-commoner fallback instead of making the whole component fail.
ACTION_IF FILE_EXISTS_IN_GAME ~GELLAN.CRE~ BEGIN
  COPY_EXISTING ~GELLAN.CRE~ ~override/QC50GBEG.CRE~
    SAY NAME1 @3124
    SAY NAME2 @3124
    WRITE_BYTE 0x270 128
    WRITE_ASCII 0x2cc ~QC50GBEG~ #8
    WRITE_ASCII 0x280 ~QC50GBEG~ #32
    WRITE_ASCII 0x248 ~ ~ #8
    WRITE_ASCII 0x250 ~ ~ #8
    WRITE_ASCII 0x258 ~ ~ #8
    WRITE_ASCII 0x260 ~ ~ #8
    WRITE_ASCII 0x268 ~ ~ #8
    WRITE_BYTE 0x2d 34
    WRITE_BYTE 0x2e 47
    WRITE_BYTE 0x30 34
    WRITE_BYTE 0x31 47
    REMOVE_CRE_ITEMS
    SAY INITIAL_MEETING ~ ~
    SAY SELECT_COMMON1 ~ ~
  BUT_ONLY_IF_IT_CHANGES
END ELSE BEGIN
  COPY_EXISTING ~BENTLY.CRE~ ~override/QC50GBEG.CRE~
    SAY NAME1 @3124
    SAY NAME2 @3124
    WRITE_BYTE 0x270 128
    WRITE_ASCII 0x2cc ~QC50GBEG~ #8
    WRITE_ASCII 0x280 ~QC50GBEG~ #32
    WRITE_ASCII 0x248 ~ ~ #8
    WRITE_ASCII 0x250 ~ ~ #8
    WRITE_ASCII 0x258 ~ ~ #8
    WRITE_ASCII 0x260 ~ ~ #8
    WRITE_ASCII 0x268 ~ ~ #8
    WRITE_BYTE 0x2d 34
    WRITE_BYTE 0x2e 47
    WRITE_BYTE 0x30 34
    WRITE_BYTE 0x31 47
    REMOVE_CRE_ITEMS
    SAY INITIAL_MEETING ~ ~
    SAY SELECT_COMMON1 ~ ~
  BUT_ONLY_IF_IT_CHANGES
END

// Goblin Fisherman - actual goblin animation/race, neutral and weaponless.
COPY_EXISTING ~HOBGBEG1.CRE~ ~override/QC50GOBF.CRE~
  SAY NAME1 @3125
  SAY NAME2 @3125
  WRITE_SHORT 0x28 0xE400
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x272 161
  WRITE_BYTE 0x273 155
  WRITE_ASCII 0x2cc ~QC50GOBF~ #8
  WRITE_ASCII 0x280 ~QC50GOBF~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Irving - requested GAXIR half-elf chassis, with a different palette and no old scripts/equipment.
COPY_EXISTING ~GAXIR.CRE~ ~override/QC50IRV.CRE~
  SAY NAME1 @3126
  SAY NAME2 @3126
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QC50IRV~ #8
  WRITE_ASCII 0x280 ~QC50IRV~ #32
  WRITE_ASCII 0x248 ~ ~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  WRITE_BYTE 0x2d 19
  WRITE_BYTE 0x2e 54
  WRITE_BYTE 0x30 19
  WRITE_BYTE 0x31 54
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Roaming female Halfling.
COPY_EXISTING ~HALFFG.CRE~ ~override/QC50HALF.CRE~
  SAY NAME1 @3007
  SAY NAME2 @3007
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x2cc ~QC50HALF~ #8
  WRITE_ASCII 0x280 ~QC50HALF~ #32
  WRITE_ASCII 0x248 ~QCAWAND~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

// Half-Ogre. Neutral until the Korgan exchange turns him hostile.
COPY_EXISTING ~HOBGBEG1.CRE~ ~override/QC50HOG.CRE~
  SAY NAME1 @3118
  SAY NAME2 @3118
  WRITE_SHORT 0x28 0x7000
  WRITE_BYTE 0x270 128
  WRITE_BYTE 0x272 113
  WRITE_BYTE 0x273 127
  WRITE_LONG 0x1c 89
  WRITE_ASCII 0x2cc ~QC50HOG~ #8
  WRITE_ASCII 0x280 ~QC50HOG~ #32
  WRITE_ASCII 0x248 ~QC50HOGA~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~RING11~ #0 #0 #0 ~IDENTIFIED~ ~INV~
  SAY INITIAL_MEETING ~ ~
  SAY SELECT_COMMON1 ~ ~
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~HOBGBEG1.CRE~ ~override/QC50HOB.CRE~
  SAY NAME1 @3110
  SAY NAME2 @3110
