COMPILE ~CotSC/qc_unicorn_grove/scripts/QCUSIAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCUUNAI.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCUROAM.baf~
// EE/EET quests require registration in BGEE.LUA to appear under Quests.
// All five updates use the same quest header, Unicorn Grove.
ADD_JOURNAL TITLE (@7016) @100 @101 @102 @103
  USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/unicorn_grove.tra~ ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/eaglehorn.tra~ ~CotSC/translation/%LANGUAGE%/installer_component_names_journal_titles.tra~
COMPILE ~CotSC/qc_unicorn_grove/dialogue/unicorn_grove.d~ USING ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/unicorn_grove.tra~ ~CotSC/translation/%LANGUAGE%/qc_unicorn_grove/dialogue/unicorn_grove.tra~

// Eaglehorn and Emhrys extension below. Never touch frozen PVRZ, WED, TIS or SR.
ACTION_IF NOT FILE_EXISTS_IN_GAME ~FAHRIN.CRE~ BEGIN FAIL ~Missing FAHRIN.CRE for Eaglehorn.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~C6EXTR02.CRE~ BEGIN FAIL ~Missing C6EXTR02.CRE for Emhrys.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~HALB02.ITM~ BEGIN FAIL ~Missing Halberd +1 (HALB02).~ END
COPY_EXISTING ~FAHRIN.CRE~ ~override/QCUEAG.CRE~
  SAY NAME1 @3068
  SAY NAME2 @3068
  WRITE_BYTE 0x270 128
  WRITE_LONG 0x20 0
  WRITE_ASCII 0x280 ~QCUEAG~ #32
  WRITE_ASCII 0x2cc ~QCUEAG~ #8
  WRITE_ASCII 0x248 ~QCUEGAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
  REMOVE_CRE_ITEMS
  ADD_CRE_ITEM ~HALB02~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
BUT_ONLY_IF_IT_CHANGES

COPY_EXISTING ~C6EXTR02.CRE~ ~override/QCUEMH.CRE~
  SAY NAME1 @3069
  SAY NAME2 @3069
  WRITE_BYTE 0x270 128
  WRITE_LONG 0x20 0
  WRITE_BYTE 0x2d 30
  WRITE_BYTE 0x2e 30
  WRITE_BYTE 0x2f 30
  WRITE_BYTE 0x30 30
  WRITE_ASCII 0x280 ~QCUEMH~ #32
  WRITE_ASCII 0x2cc ~QCEEMH~ #8
  WRITE_ASCII 0x248 ~QCUEMAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

COPY ~CotSC/qc_unicorn_grove/interior/QCEH01.ARE~ ~override/QCEH01.ARE~
COPY ~CotSC/qc_unicorn_grove/interior/QCEH02.ARE~ ~override/QCEH02.ARE~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCEH01.baf~
COMPILE ~CotSC/qc_unicorn_grove/scripts/QCUEMAI.baf~
