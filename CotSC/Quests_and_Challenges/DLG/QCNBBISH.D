BEGIN QCNBBISH

IF ~Global("QCNEBBISH","GLOBAL",0)~ THEN BEGIN QCN_START
  SAY @1
  IF ~~ THEN REPLY @2 GOTO QCN_REQUEST
  IF ~~ THEN REPLY @3 EXIT
END

IF ~~ THEN BEGIN QCN_REQUEST
  SAY @4
  IF ~~ THEN REPLY @5 DO ~SetGlobal("QCNEBBISH","GLOBAL",1)~ UNSOLVED_JOURNAL @24 EXIT
  IF ~~ THEN REPLY @6 EXIT
END

IF ~Global("QCNEBBISH","GLOBAL",1) PartyHasItem("QCNKEY")~ THEN BEGIN QCN_RETURN
  SAY @16
  IF ~~ THEN REPLY @17 DO ~TakePartyItem("QCNKEY") AddexperienceParty(200)~ GOTO QCN_REWARD
  IF ~~ THEN REPLY @18 DO ~TakePartyItem("QCNKEY") GiveGoldForce(25) SetGlobal("QCNEBBISH","GLOBAL",2)~ GOTO QCN_PAID
  IF ~~ THEN REPLY @19 DO ~SetGlobal("QCNEBBISH","GLOBAL",2)~ GOTO QCN_REFUSE
END

IF ~Global("QCNEBBISH","GLOBAL",1)~ THEN BEGIN QCN_WAIT
  SAY @32
  IF ~~ THEN EXIT
END

IF ~Global("QCETHON_TOLD","GLOBAL",1)~ THEN BEGIN QCN_BETRAYED
  SAY @33
  IF ~~ THEN EXIT
END

IF ~Global("QCNEBBISH","GLOBAL",2)~ THEN BEGIN QCN_DONE
  SAY @22
  IF ~~ THEN EXIT
END

IF ~~ THEN BEGIN QCN_REWARD
  SAY @20
  IF ~~ THEN DO ~GiveItemCreate("QCCORMYR",LastTalkedToBy(),1,0,0) SetGlobal("QCNEBBISH","GLOBAL",2)~ SOLVED_JOURNAL @25 EXIT
END

IF ~~ THEN BEGIN QCN_PAID
  SAY @21
  IF ~~ THEN SOLVED_JOURNAL @25 EXIT
END

IF ~~ THEN BEGIN QCN_REFUSE
  SAY @22
  IF ~~ THEN SOLVED_JOURNAL @25 EXIT
END

// Ajantis speaks as a one-time interjection before Nebbish's job choices.
// INTERJECT_COPY_TRANS preserves QCN_REQUEST's original player transitions.
INTERJECT_COPY_TRANS QCNBBISH QCN_REQUEST QCAJANTIS_SPOKEN
  == AJANTJ IF ~InParty("Ajantis")~ THEN @9
END
