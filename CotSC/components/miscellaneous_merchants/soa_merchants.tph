// Part III: Shadows of Amn / BG2 areas. The first 3 components are frozen from v0.5.
// Former WeiDU component: Miscellaneous Merchants - Part III: Shadows of Amn (11 NPCs, 3 loot additions)

// Six stores (10 per item), original shops and their resale economics untouched.
COPY ~CotSC/QCMM/stores/QCMS14.STO~ ~override/QCMS14.STO~
  SAY 0x0c @4082
COPY_EXISTING ~MERCH2.CRE~ ~override/QCMM14.CRE~
  SAY NAME1 @4083
  SAY NAME2 @4083
  WRITE_ASCII 0x2cc ~QCMM14~ #8
  WRITE_ASCII 0x280 ~QCMM14~ #32
  WRITE_ASCII 0x248 ~~ #40 // no base creature scripts
  WRITE_BYTE 0x270 128 // neutral
  WRITE_LONG 0x28 25344
  WRITE_BYTE 0x2d 49
  WRITE_BYTE 0x2e 49

