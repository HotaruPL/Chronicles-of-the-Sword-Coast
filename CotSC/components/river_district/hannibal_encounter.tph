COMPILE ~CotSC/qriv_hannibal/dialogue/QHHAN.d~ USING ~CotSC/translation/%LANGUAGE%/qriv_hannibal/dialogue/QHHAN.tra~

// Brigand 1: THIEF2 base; 1329,891; AROW05.
COPY_EXISTING ~THIEF2.CRE~ ~override/QHBG01.CRE~
  SAY NAME1 @3020
  SAY NAME2 @3020
  REMOVE_CRE_ITEMS
  WRITE_ASCII 0x280 ~QHBG01~ #32
  WRITE_ASCII 0x2cc ~~ #8
  WRITE_BYTE 0x270 255
  WRITE_ASCII 0x248 ~QHBRAI~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  WRITE_SHORT 0x24 48
  WRITE_SHORT 0x26 48
  WRITE_BYTE 0x52 12
  WRITE_BYTE 0x53 2
  ADD_CRE_ITEM ~LEAT01~ #0 #0 #0 ~IDENTIFIED~ ~ARMOR~
  ADD_CRE_ITEM ~BOW05~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP TWOHANDED
  ADD_CRE_ITEM ~AROW05~ #20 #0 #0 ~IDENTIFIED~ ~QUIVER1~
  ADD_CRE_ITEM ~SW1H21~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON2~
BUT_ONLY_IF_IT_CHANGES

