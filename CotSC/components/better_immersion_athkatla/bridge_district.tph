COPY_EXISTING ~AR0500.ARE~ ~override~
  // X=3586 Y=255 - Gnome Beggar, south-east.
  LPF fj_are_structure INT_VAR fj_loc_x=3586 fj_loc_y=255 fj_dest_x=3586 fj_dest_y=255 fj_orientation=14 STR_VAR fj_structure_type=actor fj_name=QC50GBEG fj_cre_resref=QC50GBEG fj_dlg_resref=QC50GBEG END
  // X=4954 Y=2062 - Goblin Fisherman.
  LPF fj_are_structure INT_VAR fj_loc_x=4954 fj_loc_y=2062 fj_dest_x=4954 fj_dest_y=2062 fj_orientation=8 STR_VAR fj_structure_type=actor fj_name=QC50GOBF fj_cre_resref=QC50GOBF fj_dlg_resref=QC50GOBF END
  // X=4094 Y=2017 - Irving.
  LPF fj_are_structure INT_VAR fj_loc_x=4094 fj_loc_y=2017 fj_dest_x=4094 fj_dest_y=2017 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC50IRV fj_cre_resref=QC50IRV fj_dlg_resref=QC50IRV END
  // X=3534 Y=1449 - roaming female Halfling.
  LPF fj_are_structure INT_VAR fj_loc_x=3534 fj_loc_y=1449 fj_dest_x=3534 fj_dest_y=1449 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC50HALF fj_cre_resref=QC50HALF fj_dlg_resref=QC50HALF fj_bcs_override=QCAWAND END
  // X=1509 Y=2272 - Half-Ogre.
  LPF fj_are_structure INT_VAR fj_loc_x=1509 fj_loc_y=2272 fj_dest_x=1509 fj_dest_y=2272 fj_orientation=0 STR_VAR fj_structure_type=actor fj_name=QC50HOG fj_cre_resref=QC50HOG fj_dlg_resref=QC50HOG fj_bcs_override=QC50HOGA END
  // X=1026 Y=3599 - Hobgoblin, west.
  LPF fj_are_structure INT_VAR fj_loc_x=1026 fj_loc_y=3599 fj_dest_x=1026 fj_dest_y=3599 fj_orientation=4 STR_VAR fj_structure_type=actor fj_name=QC50HOB fj_cre_resref=QC50HOB fj_dlg_resref=QC50HOB END
  // X=994 Y=3599 - Alina, east.
  LPF fj_are_structure INT_VAR fj_loc_x=994 fj_loc_y=3599 fj_dest_x=994 fj_dest_y=3599 fj_orientation=12 STR_VAR fj_structure_type=actor fj_name=QC50ALIN fj_cre_resref=QC50ALIN fj_dlg_resref=QC50ALIN END
BUT_ONLY_IF_IT_CHANGES

