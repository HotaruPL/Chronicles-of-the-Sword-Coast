BEGIN QCETHEL

IF ~Global("QCE_ETHEL_INTRO","GLOBAL",1)~ THEN BEGIN QCE_EXT_INTRO
  SAY @1
  IF ~~ THEN DO ~
    SetGlobal("QCE_ETHEL_INTRO","GLOBAL",3)
    TriggerActivation("QCSUBH01_ENTRY",TRUE)
    MoveToPointNoInterrupt([3021.1343])
    DestroySelf()
  ~ EXIT
END

IF ~Global("QCE_ETHEL_INTRO","GLOBAL",3)~ THEN BEGIN QCE_INTRO
  SAY @2
  IF ~~ THEN DO ~
    SetGlobal("QCE_ETHEL_INTRO","GLOBAL",4)
  ~ GOTO QCE_MAIN
END

IF ~Global("QCE_ETHEL_INTRO","GLOBAL",4)~ THEN BEGIN QCE_MAIN
  SAY @3
  IF ~~ THEN REPLY @4 GOTO QCE_WHO
  IF ~~ THEN REPLY @5 GOTO QCE_SMELL
  IF ~~ THEN REPLY @6 GOTO QCE_ALTAR
