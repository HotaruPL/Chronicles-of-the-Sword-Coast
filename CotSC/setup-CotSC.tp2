// QCHALI collision is intentionally fully walkable for initial rendering/NPC work.
// ============================================================
// Transitions: QCHALR <-> QCHALI
// ============================================================
// QCHALR arrival from the ship interior.  The destination entrance is
// deliberately outside the travel-region footprint to prevent an immediate
// re-trigger when the party arrives.
COPY_EXISTING ~QCHALR.ARE~ ~override/QCHALR.ARE~
  LPF fj_are_structure
    INT_VAR
      fj_loc_x = 983
      fj_loc_y = 309
      fj_orientation = 0
    STR_VAR
