@1 = ~This component requires Baldur's Gate: Enhanced Edition in EET form.~
@2 = ~Required resource BG3300.BCS was not found.~
@3 = ~Required resource LINDIN.CRE was not found.~
@4 = ~Required resource TELKA.CRE was not found.~
@5 = ~Required resource SCRLNEI.ITM was not found.~
