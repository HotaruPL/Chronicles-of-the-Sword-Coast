// v24: AFTER the working v23 ritual encounter and v22.5 collision.

// ---------- Integrated milestone: QC: Bhaal's Temple - Core Dragon and Unicorn Grove Finale (QCBTEM)~ ----------
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBTEM.ARE~ BEGIN FAIL ~Install the temple interior first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QBTALIA.CRE~ BEGIN FAIL ~Install the working final ritual encounter first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~QCBTRIS.CRE~ BEGIN FAIL ~Install the working forest dialogue and Triss first.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~BDHALAT.CRE~ BEGIN FAIL ~BDHALAT.CRE is required for the Core dragon.~ END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~MISC4P.ITM~ BEGIN FAIL ~The game must contain the key item MISC4P.ITM.~ END

// Native key item, separate resref, short description and normal key inventory type.
COPY_EXISTING ~MISC4P.ITM~ ~override/QBTKEY.ITM~
  SAY NAME1 @3102
  SAY NAME2 @3102
  SAY UNIDENTIFIED_DESC @3103
  SAY DESC @3103
BUT_ONLY_IF_IT_CHANGES

// Keep Alianna's currently tested combat and spells; merely add a physical drop to her pack.
COPY_EXISTING ~QBTALIA.CRE~ ~override/QBTALIA.CRE~
  ADD_CRE_ITEM ~QBTKEY~ #0 #0 #0 ~IDENTIFIED~ ~INV15~
BUT_ONLY_IF_IT_CHANGES

// Triss in the temple: a copy of the already working forest Triss, no new model.
COPY_EXISTING ~QCBTRIS.CRE~ ~override/QBTTRIS.CRE~
  WRITE_BYTE 0x270 128
  WRITE_ASCII 0x280 ~QBTTRIS~ #32
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x248 ~QBTTRAI~ #8
  WRITE_ASCII 0x250 ~ ~ #8
  WRITE_ASCII 0x258 ~ ~ #8
  WRITE_ASCII 0x260 ~ ~ #8
  WRITE_ASCII 0x268 ~ ~ #8
BUT_ONLY_IF_IT_CHANGES

// Halatathlaer is copied verbatim apart from speaker/hostile settings and extra dialogue/voice hooks.
// Preserve all original dragon combat stats, spell resources, inventory, general and class AI.
COPY_EXISTING ~BDHALAT.CRE~ ~override/QBTCORE.CRE~
  SAY NAME1 @3104
  SAY NAME2 @3104
  WRITE_BYTE 0x270 255
  WRITE_ASCII 0x280 ~QBTCORE~ #32
  WRITE_ASCII 0x2cc ~ ~ #8
  WRITE_ASCII 0x248 ~ ~ #8 // Let the original dragon general/class AI run without an overriding generic attack loop
