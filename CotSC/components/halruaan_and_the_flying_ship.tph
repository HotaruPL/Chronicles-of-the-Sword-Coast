  END
  LPF ALTER_AREA_ACTOR
    STR_VAR actor_name=GORMIST2 cre_file=MEPICE01
  END
  LPF ALTER_AREA_ACTOR
    STR_VAR actor_name=QCHELSICE script_general=qcice_helshara dlg_file=QCHLICE
