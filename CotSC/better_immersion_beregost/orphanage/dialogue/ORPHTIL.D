BEGIN ORPHTIL
IF ~OR(2) Global("ORPHAN_ALLESIA_MET","GLOBAL",0) Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 0
  SAY @1
  IF ~~ THEN REPLY @2 EXIT
END
IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 1
  SAY @3
  IF ~~ THEN REPLY @4 GOTO 2
  IF ~~ THEN REPLY @5 EXIT
END
IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 2
  SAY @6
  IF ~~ THEN GOTO 3
END
IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 3
  SAY @7
  IF ~~ THEN REPLY @8 GOTO 4
END
IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 4
  SAY @9
  IF ~~ THEN GOTO 5
END
IF ~Global("ORPHAN_ALLESIA_MET","GLOBAL",1) !Global("ORPHAN_QUEST_DONE","GLOBAL",1)~ THEN BEGIN 5
  SAY @10
  IF ~~ THEN REPLY @11 DO ~SetGlobal("ORPHAN_TILDA","GLOBAL",1) TriggerActivation("ORPHFLOWER",TRUE)~ EXIT
END
